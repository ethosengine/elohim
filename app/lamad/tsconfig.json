{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": ".",
    "typeRoots": ["node_modules/@types"],
    "paths": {
      "@app/lamad/*": ["./src/app/*"],
      // Cross-pillar aliases are RETAINED under the Slice 2.1c composition-root
      // pattern. While lamad source has zero unintentional cross-pillar imports
      // (all remaining imports are documented composition-root or Slice 2.2b
      // deferrals), lamad's app.config.ts imports concrete elohim-app pillar
      // services for LAMAD_* InjectionToken `useExisting` registration. Those
      // imported files transitively reference @app/{shefa,doorway,avodah,
      // generated,testing}/*, so lamad's tsconfig must continue to resolve
      // those alias targets even though lamad itself does not import them.
      // See genesis/docs/architecture/elohim-sdk.md §composition-root.
      "@app/elohim": ["../elohim-app/src/app/elohim/index.ts"],
      "@app/elohim/*": ["../elohim-app/src/app/elohim/*"],
      "@app/imagodei": ["../elohim-app/src/app/imagodei/index.ts"],
      "@app/imagodei/*": ["../elohim-app/src/app/imagodei/*"],
      "@app/qahal": ["../elohim-app/src/app/qahal/index.ts"],
      "@app/qahal/*": ["../elohim-app/src/app/qahal/*"],
      "@app/shefa": ["../elohim-app/src/app/shefa/index.ts"],
      "@app/shefa/*": ["../elohim-app/src/app/shefa/*"],
      "@app/generated/*": ["../elohim-app/src/app/generated/*"],
      "@app/doorway": ["../elohim-app/src/app/doorway/index.ts"],
      "@app/doorway/*": ["../elohim-app/src/app/doorway/*"],
      "@app/avodah": ["../elohim-app/src/app/avodah/index.ts"],
      "@app/avodah/*": ["../elohim-app/src/app/avodah/*"],
      "@app/testing": ["../elohim-app/src/app/testing/mocks/index.ts"],
      "@app/testing/*": ["../elohim-app/src/app/testing/*"],
      "@elohim/identity": ["../elohim-library/projects/elohim-identity/src/public-api.ts"],
      "@elohim/identity/*": ["../elohim-library/projects/elohim-identity/src/*"],
      "@elohim/rea-runtime": ["../elohim-library/projects/elohim-rea-runtime/src/public-api.ts"],
      "@elohim/rea-runtime/*": ["../elohim-library/projects/elohim-rea-runtime/src/*"],
      "@elohim/service": ["../elohim-library/projects/elohim-service/src/index.ts"],
      "@elohim/service/*": ["../elohim-library/projects/elohim-service/src/*"],
      "@elohim/storage-client": ["../elohim-app/node_modules/@elohim/storage-client/dist/index"],
      "@elohim/storage-client/generated": ["../elohim-app/node_modules/@elohim/storage-client/dist/generated/index"],
      "@elohim/storage-client/wire-types": ["../elohim-app/node_modules/@elohim/storage-client/dist/wire-types/index"],
      "@elohim/storage-client/wire-types/*": ["../elohim-app/node_modules/@elohim/storage-client/dist/wire-types/*/index"],
      "@elohim/storage-client/graphql": ["../elohim-app/node_modules/@elohim/storage-client/dist/graphql/index"],
      "@holochain/client": ["../elohim-app/node_modules/@holochain/client"],
      "@holochain/client/*": ["../elohim-app/node_modules/@holochain/client/*"],
      // Force automerge's base64 browser entry (mirrors elohim-app/tsconfig.json).
      // Its default `browser` export is the wasm-bindgen "bundler" entry which
      // Angular's esbuild builder rejects in Zone.js apps; the base64 entry
      // inlines the wasm via atob so it bundles cleanly. Required here because
      // the lamad bundle now pulls in @elohim/service's ContentDocSyncService
      // (which references @elohim/storage-client's AutomergeSync). NOTE: bypasses
      // automerge's package `exports` (hardcodes a dist path) — revisit on
      // automerge upgrades. See the content-sync-plane plan (Task G7a/G7c).
      "@automerge/automerge": [
        "../../node_modules/@automerge/automerge/dist/mjs/entrypoints/fullfat_base64.js"
      ]
    },
    "outDir": "./dist/out-tsc",
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
