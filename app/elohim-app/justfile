# Elohim App - Angular Frontend
#
# Main learning platform UI. Connects to doorway or direct to storage.

set dotenv-load := false

# List available recipes
default:
    @just --list

# Install dependencies
install:
    pnpm install

# Start dev server
dev:
    pnpm start

# Build for production
build:
    pnpm exec ng build --configuration=development

# Run unit tests
test:
    pnpm exec vitest run --config vite.config.ts

# Lint
lint:
    pnpm run lint

# Lint with auto-fix
lint-fix:
    pnpm run lint:fix

# Format check
fmt-check:
    pnpm exec prettier --check "src/**/*.{ts,html,scss}"

# Format
fmt:
    pnpm exec prettier --write "src/**/*.{ts,html,scss}"

# Route-literal link-integrity gate: links are MINTED, never literal.
# Covers both bundles' sources (elohim-app + lamad).
lint-routes:
    node ../scripts/lint-route-literals.mjs src ../lamad/src

# A11y paired-color RATCHET: a new color/background literal must bind to a
# theme-reactive token (--lamad-*/--elohim-*/--el-*/--primary/--accent), so it
# adapts to html[data-theme]. Grandfathers the shell's pre-existing legacy debt
# (genesis backlog: a11y-contrast-gate) and blocks NEW theme-blind colors as they
# land — the static backstop the epr-raw-node dark-on-dark bug lacked. Diffs vs
# the dev integration base; degrades to a no-op when that base isn't fetched.
lint-a11y:
    #!/usr/bin/env bash
    set -euo pipefail
    base=$(git merge-base HEAD origin/dev 2>/dev/null || git merge-base HEAD dev 2>/dev/null || echo "")
    if [ -z "$base" ]; then echo "lint-a11y: no dev base to diff — skipping ratchet"; exit 0; fi
    node ../scripts/lint-a11y-color.mjs --diff "$base" src ../lamad/src

# Run the a11y-color canary in full (non-ratchet) over an already-clean subtree —
# the /epr viewer surface migrated 2026-06-08. Use to CI-conform a clean subtree.
lint-a11y-strict *DIRS:
    node ../scripts/lint-a11y-color.mjs {{DIRS}}

# Rebuild workspace deps that elohim-app consumes via dist/.
# @elohim/storage-client's dist/ is gitignored, so type changes in its
# src/generated/ don't reach consumers until tsc reruns. Fast (~5s).
deps:
    pnpm --filter @elohim/storage-client build

# Quality gate: route-literal lint + a11y-color ratchet + dep freshness + build + test
gate: lint-routes lint-a11y deps build test
