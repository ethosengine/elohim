# Multi-stage build for lamad-ui Storybook static site

# Stage 1: Build the Storybook static site
FROM node:22-alpine AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy workspace root for pnpm workspace resolution
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY elohim-library/ ./elohim-library/

# Install workspace dependencies (scoped to elohim-library)
RUN pnpm install --filter elohim-library --frozen-lockfile

WORKDIR /app/elohim-library

# Build the lamad-ui library
RUN pnpm exec ng build lamad-ui

# Build the Storybook static site
RUN pnpm run build-storybook

# Stage 2: Serve with nginx
FROM nginx:alpine

# Copy built Storybook from builder stage
COPY --from=builder /app/elohim-library/dist/storybook /usr/share/nginx/html/ui-playground

# Copy nginx configuration
COPY elohim-library/images/nginx-lamad-ui-storybook.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
