{
  "manifestVersion": "1.0",
  "pipeline": "elohim-storybook",
  "jenkinsPath": "app/elohim-library/Jenkinsfile",
  "manualOnly": false,
  "triggersGenesis": false,
  "cascades": false,
  "longRunning": true,
  "dependsOn": [],
  "description": "Elohim Storybook static design surface — build, image, deploy",
  "steps": {
    "build-storybook": {
      "description": "Build Storybook 10 static bundle (pnpm --filter elohim-library run build-storybook)",
      "inputs": {
        "sources": [
          "app/elohim-elements/**",
          "app/elohim-library/.storybook/**",
          "app/elohim-library/Jenkinsfile",
          "app/elohim-library/angular.json",
          "app/elohim-library/build-manifest.json",
          "app/elohim-library/package.json",
          "app/elohim-library/projects/**",
          "app/elohim-library/scripts/**",
          "app/elohim-library/tsconfig.json",
          "genesis/a2o/features/auth/*.feature",
          "genesis/a2o/features/auth/recovery/*.feature",
          "genesis/a2o/features/lms/*.feature",
          "genesis/a2o/features/content/*.feature",
          "genesis/a2o/features/qahal/*.feature",
          "genesis/a2o/features/rms/*.feature",
          "genesis/a2o/features/wms/*.feature",
          "genesis/a2o/features/delivery/*.feature",
          "genesis/a2o/features/browser/*.feature",
          "genesis/a2o/features/federation/*.feature",
          "genesis/a2o/features/resilience/*.feature",
          "genesis/a2o/features/deployment/*.feature",
          "genesis/a2o/features/elohim/*.feature",
          "genesis/docs/content/elohim-protocol/manifesto.md",
          "genesis/docs/content/elohim-protocol/constitution.md",
          "genesis/docs/content/elohim-protocol/global-orchestra.md",
          "genesis/docs/content/elohim-protocol/protocol-specification.md",
          "genesis/docs/content/elohim-protocol/governance-layers-architecture.md",
          "genesis/docs/content/elohim-protocol/epr-developer-guide.md",
          "genesis/docs/content/elohim-protocol/hardware-spec.md",
          "genesis/docs/content/elohim-protocol/lamad.md",
          "genesis/docs/content/elohim-protocol/architecture/2026-06-21-elohim-seam-map-concern-routing.md",
          "genesis/graphos/**",
          "genesis/orchestrator/manifests/elohim-storybook/**",
          "pnpm-lock.yaml",
          "package.json"
        ],
        "buildProcess": ["app/elohim-library/Jenkinsfile"]
      },
      "outputs": {
        "artifacts": ["storybook-dist"],
        "verify": "test -f app/elohim-library/dist/storybook/index.html && test -f app/elohim-library/dist/storybook/index.json"
      },
      "depends": [],
      "executor": {
        "stage": "Build Storybook",
        "function": null
      }
    },
    "build-storybook-image": {
      "description": "Package Storybook static bundle into nginx:alpine container image",
      "inputs": {
        "sources": [
          "app/elohim-library/images/**"
        ],
        "buildProcess": ["app/elohim-library/Jenkinsfile"]
      },
      "outputs": {
        "artifacts": ["storybook-image"],
        "verify": null
      },
      "depends": ["build-storybook"],
      "executor": {
        "stage": "Build Image",
        "function": null
      }
    }
  },
  "gate": {
    "projects": {
      "elohim-storybook": {
        "dir": "app/elohim-library",
        "steps": ["build-storybook", "build-storybook-image"],
        "run": { "kind": "root-just", "recipe": "_gate-elohim-storybook" }
      }
    }
  },
  "deployment": {
    "targets": {
      "alpha": { "healthCheck": "https://storybook.elohim.host/index.json" }
    }
  }
}
