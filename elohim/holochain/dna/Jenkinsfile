/**
 * Elohim DNA Pipeline (elohim-holochain)
 *
 * Builds DNA/hApp artifacts only - NO container images, NO deployments.
 * Triggered by orchestrator when elohim/holochain/dna/ or elohim/elohim-cache-core/ change.
 *
 * Artifacts produced:
 *   - elohim.happ (multi-DNA bundle: lamad + imagodei + infrastructure)
 *   - elohim-cache-core WASM module (for elohim-app)
 *
 * Downstream consumers:
 *   - elohim-edge (fetches hApp for container images)
 *   - elohim-app (fetches elohim-cache-core WASM)
 *   - genesis (requires hApp to be deployed before seeding)
 *   - steward (fetches hApp for desktop builds)
 *
 * Direct webhook triggers are ignored - use orchestrator or manual trigger.
 *
 * Sweettest stage W3+W5 active (2026-05-24): the cargo nextest invocation
 * inside `script {}` is replaced by `cargo nextest archive` + 4-way
 * distributed test shards via podTemplate-allocated runners. See helpers
 * `SWEETTEST_SHARD_COUNT` + `runSweettestShard()` above `pipeline {}`.
 * Per-DNA filter from CHANGED_PATHS (orchestrator passthrough, W2)
 * harvested by `tests/sweettest/scripts/build-nextest-filter.sh`.
 * Stash + parallel block sits at workspace-root context (W5 stash-fix).
 * #1279 measured 55m26s wall vs ~74min baseline; #1280 killed by 09 UTC
 * cron-cascade before JUnit fix could be measured — see bug #5 followup.
 * so `includes:` workspace-relative globs resolve correctly.
 */

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

def loadBuildVars() {
    def rootEnv = "${env.WORKSPACE}/build.env"
    def path = fileExists(rootEnv) ? rootEnv : 'build.env'

    if (!fileExists(path)) {
        echo "WARNING: build.env not found at ${path}, using defaults"
        def gitHash = sh(script: 'git rev-parse HEAD | cut -c1-8', returnStdout: true).trim()
        def sanitizedBranch = env.BRANCH_NAME.replaceAll('/', '-')
        return [
            BASE_VERSION: 'dev',
            GIT_COMMIT_HASH: gitHash,
            IMAGE_TAG: "dev-${sanitizedBranch}-${gitHash}",
            BRANCH_NAME: env.BRANCH_NAME
        ]
    }

    return readProperties(file: path)
}

def withBuildVars(props, Closure body) {
    withEnv([
        "BASE_VERSION=${props.BASE_VERSION ?: ''}",
        "GIT_COMMIT_HASH=${props.GIT_COMMIT_HASH ?: ''}",
        "IMAGE_TAG=${props.IMAGE_TAG ?: ''}",
        "BRANCH_NAME=${props.BRANCH_NAME ?: env.BRANCH_NAME}"
    ]) {
        body()
    }
}

def shouldRunStep(String stepName) {
    def steps = (params.STEPS ?: 'all').split(',').collect { it.trim() }
    return steps.contains('all') || steps.contains(stepName)
}

// ============================================================================
// W5 — Distributed sweettest test shards
//
// SWEETTEST_SHARD_COUNT: number of parallel test runner pods. Each consumes
// the same compiled nextest archive (stashed by the compile stage) and runs
// `cargo nextest run --partition hash:N/M`. Hash partitioning evens out
// uneven test runtimes (kitsune2 conductor setup cost varies).
//
// SWEETTEST_SHARD_POD_YAML: minimal pod spec for shard runners. No PVCs
// (compile state is in the stashed archive); same image as compile pod so
// the nix dev shell + linked runtime libs (libsodium, libdatachannel, etc)
// are available. Sized for 1 conductor at a time (--test-threads=1 still
// in force inside each shard).
// ============================================================================
def SWEETTEST_SHARD_COUNT = 4
def SWEETTEST_SHARD_POD_YAML = '''
apiVersion: v1
kind: Pod
spec:
  serviceAccount: ee-jenkins
  affinity:
    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        nodeSelectorTerms:
          - matchExpressions:
              - key: node-type
                operator: In
                values:
                  - operations
                  - edge
  tolerations:
    - key: "workload-type"
      operator: "Equal"
      value: "build"
      effect: "NoSchedule"
  containers:
    - name: builder
      image: harbor.ethosengine.com/ethosengine/ci-builder-nix:latest
      imagePullPolicy: Always
      command: [cat]
      tty: true
      envFrom:
        - secretRef:
            name: sccache-credentials
      resources:
        requests:
          memory: "2Gi"
          cpu: "1"
          # Ephemeral storage sized for the 0.7 line: each shard pod materialises
          # the holonix main-0.7 closure (505 store paths) in its writable layer,
          # plus the 945 MB nextest archive and its extraction, and the conductors'
          # data dirs grow during the run. At 4Gi/8Gi kubelet evicted shards 1-3
          # MID-RUN in #1424/#1425/#1426 ("Pod ephemeral local storage usage
          # exceeds the total limit of containers 8Gi") — only one shard's tests
          # ever counted. The main build pod already runs at 10Gi/20Gi.
          ephemeral-storage: "12Gi"
        limits:
          memory: "4Gi"
          cpu: "2"
          ephemeral-storage: "24Gi"
'''

// Run a single sweettest shard inside its own podTemplate-allocated pod.
// Unstashes the compiled nextest archive + the W3 filter file, runs the
// partition through `nix develop` so runtime libs link, archives the
// per-shard log + JUnit XML for the post.always aggregator.
def runSweettestShard(int n, int total, String shardPodYaml) {
    podTemplate(label: "sweettest-shard-${n}-${total}", yaml: shardPodYaml) {
        node("sweettest-shard-${n}-${total}") {
            container('builder') {
                unstash 'sweettest-shard-input'
                dir('elohim/holochain/tests/sweettest') {
                    sh """#!/usr/bin/env bash
                        set -uo pipefail
                        export HOME=\${HOME:-/root}
                        mkdir -p "\$HOME"
                        # nextest --extract-to requires the dir to exist;
                        # canonicalize() ENOENTs on missing destination.
                        mkdir -p extracted-${n}
                        export SHARD_LOG=sweettest-shard-${n}.log
                        : > "\$SHARD_LOG"
                        nix develop --impure --accept-flake-config "\$WORKSPACE/elohim/holochain/dna/elohim" --command bash -c '
                            set -uo pipefail
                            unset RUSTC_WRAPPER
                            export RUSTFLAGS=""
                            FILTER=\$(cat .nextest-filter)
                            echo "[shard-${n}/${total}] filter: \$FILTER"
                            cargo nextest run \\
                                --archive-file sweettest-archive.tar.zst \\
                                --extract-to extracted-${n} \\
                                --workspace-remap . \\
                                --config-file .config/nextest.toml \\
                                --profile ci \\
                                --no-fail-fast \\
                                --test-threads=1 \\
                                --partition hash:${n}/${total} \\
                                -E "\$FILTER" \\
                                2>&1 | tee "\$SHARD_LOG"
                        '
                        RC=\${PIPESTATUS[0]}
                        # Copy nextest JUnit (cargo target dir is inside the extract dir).
                        # Bug #10 history (2026-05-24/25 sprint):
                        # - #1279/#1281: post-stage junit found nothing (file in shard pod, not orchestrator)
                        # - #1281/#1282: register-in-shard + --config-file still produced no junit.xml
                        # - Final fix: --profile ci + [profile.ci.junit] in .config/nextest.toml
                        #   (canonical nextest CI pattern; the `default` profile's JUnit
                        #   reporter didn't activate via this code path for unclear reasons).
                        # With --profile ci, JUnit lands at extracted-N/target/nextest/ci/junit.xml
                        echo "[shard-${n}/${total}] searching for junit.xml under extracted-${n}/..."
                        find extracted-${n} -name junit.xml -print 2>/dev/null || true
                        find extracted-${n} -name junit.xml -exec cp {} sweettest-shard-${n}-junit.xml \\; 2>/dev/null || true
                        ls -la sweettest-shard-${n}-junit.xml 2>/dev/null || echo "[shard-${n}/${total}] no junit.xml produced"
                        exit \$RC
                    """
                    archiveArtifacts(
                        artifacts: "sweettest-shard-${n}.log,sweettest-shard-${n}-junit.xml",
                        allowEmptyArchive: true
                    )
                    // Register JUnit in the shard pod where the file actually lives.
                    // The post.always junit step on the orchestrator pod can't see
                    // shard-pod files (different workspace). Jenkins aggregates
                    // per-step junit calls into a single build-level test report.
                    junit(
                        allowEmptyResults: true,
                        testResults: "sweettest-shard-${n}-junit.xml"
                    )
                }
            }
        }
    }
}

pipeline {
    agent {
        kubernetes {
            cloud 'kubernetes'
            yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccount: ee-jenkins
  affinity:
    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        nodeSelectorTerms:
          - matchExpressions:
              - key: node-type
                operator: In
                values:
                  - operations
                  - edge
              # No kubernetes.io/hostname pin — cache PVCs are back on
              # openebs-jiva-csi-default (cluster-wide RWO; replicas
              # bounded off shem by JivaVolumePolicy). The hostpath-era
              # intel-nuc pin was removed when the caches moved back to
              # Jiva; cross-pipeline parallelism is now ensured by the
              # cargo-cache-edge / cargo-cache-holochain split alone.
              # See genesis/manifests/nix-cache-pvc.yaml header for the
              # full migration story.
  tolerations:
    - key: "workload-type"
      operator: "Equal"
      value: "build"
      effect: "NoSchedule"
  volumes:
    - name: nix-store
      persistentVolumeClaim:
        claimName: nix-cache-holochain
    - name: cargo-cache
      persistentVolumeClaim:
        claimName: cargo-cache-holochain
    - name: sweettest-target-cache
      persistentVolumeClaim:
        claimName: sweettest-target-cache-holochain
  containers:
    - name: builder
      image: harbor.ethosengine.com/ethosengine/ci-builder-nix:latest
      # imagePullPolicy: Always — the :latest tag is moving (sccache 0.15.0
      # was added 2026-05-09 21:40Z). Without explicit Always, k8s nodes
      # with cached pre-sccache layers can serve stale pods; build #1218
      # presumed sccache present (per shellHook's `[ -x ... ]` check) but
      # tried to exec a non-existent /usr/local/bin/sccache. Forcing pull
      # rules out the cache-staleness branch.
      imagePullPolicy: Always
      command: [cat]
      tty: true
      # sccache S3 (Garage) config — auto-mounted Secret in jenkins ns.
      # Provides AWS_ACCESS_KEY_ID/SECRET, SCCACHE_BUCKET, SCCACHE_ENDPOINT,
      # SCCACHE_S3_USE_SSL, SCCACHE_REGION. The flake.nix devShell's
      # shellHook surfaces /usr/local/bin/sccache and sets RUSTC_WRAPPER
      # when entering `nix develop` (the binary lives outside the nix
      # store on purpose so it survives nix's PATH stripping). Combined
      # with `nix develop --impure` on the build invocations below,
      # SCCACHE_* env vars flow through to cargo's wrapper exec.
      envFrom:
        - secretRef:
            name: sccache-credentials
      resources:
        requests:
          memory: "4Gi"
          cpu: "1"
          ephemeral-storage: "10Gi"
        limits:
          memory: "8Gi"
          cpu: "4"
          ephemeral-storage: "20Gi"
      volumeMounts:
        - name: cargo-cache
          mountPath: /root/.cargo
        - name: sweettest-target-cache
          mountPath: /cargo-target
        # NOTE: nix-store PVC mount intentionally absent. Mounting an empty
        # PVC at /nix/store on first run wipes out the ci-builder-nix image's
        # bundled nix binary. Tracked as followup; sccache via Garage S3 is
        # the planned replacement for cargo build caching once sccache lands
        # in ci-builder-nix:latest (in flight separately).
        # NOTE: sweettest-target-cache is restored 2026-05-24. Build #1212
        # broke when CARGO_TARGET_DIR=/cargo-target was set pod-wide via
        # the `environment {}` block — `hc dna pack` later in the pipeline
        # hard-coded ./target for content_store.wasm lookup and 404'd.
        # CORRECT pattern: set CARGO_TARGET_DIR INSIDE the sweettest
        # `bash -c '...'` block ONLY (see sweettest stage below). DNA-pack
        # stages run in separate `sh` blocks that never see this env, so
        # they continue using ./target. DO NOT lift CARGO_TARGET_DIR back
        # to the pod or stage environment{} — it will break pack again.
'''
        }
    }

    environment {
        BRANCH_NAME = "${env.BRANCH_NAME ?: 'main'}"
        PATH = "/nix/var/nix/profiles/default/bin:${env.PATH}"
        // CARGO_TARGET_DIR is INTENTIONALLY NOT SET at stage/pod scope.
        // It is scoped to the sweettest `bash -c '...'` block only, so the
        // sweettest-target-cache PVC backs warm incremental compile for
        // sweettest WITHOUT redirecting `hc dna pack`'s ./target lookup.
        // See volumeMounts NOTE above and the sweettest stage's inner export.
    }

    parameters {
        booleanParam(
            name: 'FORCE_BUILD',
            defaultValue: false,
            description: 'Force rebuild of DNA even without code changes'
        )
        string(name: 'STEPS', defaultValue: 'all', description: 'Comma-separated build steps to run. "all" runs everything.')
        booleanParam(
            name: 'DEPLOY_ONLY',
            defaultValue: false,
            description: 'No-op for this pipeline. Accepted so the orchestrator can propagate the flag uniformly; orchestrator skips triggering DNA when DEPLOY_ONLY=true.'
        )
        string(
            name: 'CHANGED_PATHS',
            defaultValue: '',
            description: 'Newline-delimited list of changed source paths from orchestrator. Empty value (manual / force / tag dispatch) means run full suite. Read by the sweettest stage harvester to compose a per-DNA nextest binary filter (W3 of the 2026-05-24 stage efficiency design).'
        )
    }

    options {
        // Overall pipeline budget. The dominant cost is the sweettest stage;
        // cold-PVC first build observed at ~97min (build #1270 aborted at the
        // tighter 90min stage cap). 240min gives headroom for cold-first
        // builds + the surrounding WASM + DNA pack + manifest hygiene stages.
        // Once W3 per-DNA filter is active on a single-DNA push, total drops
        // dramatically and we can revisit the budget.
        timeout(time: 240, unit: 'MINUTES')
        // abortPrevious: true — when a new orchestrator dispatch arrives while a
        // previous build of this pipeline is in-flight, abort the old one. Without
        // this, the previous orchestrator's downstream queues up behind the in-flight
        // build (60+ min wait) while the orchestrator itself has already been aborted.
        // See memory: _orchestrator_abort_baseline_rollback.
        disableConcurrentBuilds(abortPrevious: true)
        preserveStashes(buildCount: 5)
        overrideIndexTriggers(false)  // Only orchestrator or manual triggers - no webhook/branch indexing
        // Skip implicit Declarative: Checkout SCM — same fix as elohim-orchestrator;
        // see orchestrator Jenkinsfile options block. #1180 died with `git-remote-https
        // signal 15` after 10:13 because the implicit checkout uses the job-level
        // 10-min timeout on a full clone of this 316MB / 65k-object repo.
        skipDefaultCheckout(true)
    }

    // No triggers - orchestrator handles all webhook events
    // triggers { }

    stages {
        stage('Check Trigger') {
            steps {
                script {
                    // Only allow manual triggers or orchestrator triggers
                    def validTrigger = currentBuild.getBuildCauses().any { cause ->
                        cause._class.contains('UserIdCause') ||      // Manual trigger
                        cause._class.contains('UpstreamCause')       // Triggered by orchestrator
                    }

                    if (!validTrigger) {
                        echo """
                        ═══════════════════════════════════════════════════════════
                        ⏭️ PIPELINE SKIPPED - USE ORCHESTRATOR
                        ═══════════════════════════════════════════════════════════
                        This pipeline is managed by elohim-orchestrator.
                        Direct webhook triggers are disabled.

                        To trigger this pipeline:
                        1. Push to GitHub → orchestrator analyzes → triggers this
                        2. Or manually: Build with Parameters

                        Triggered by: ${currentBuild.getBuildCauses()*.shortDescription.join(', ')}
                        ═══════════════════════════════════════════════════════════
                        """
                        currentBuild.result = 'NOT_BUILT'
                        currentBuild.displayName = "#${env.BUILD_NUMBER} SKIPPED"
                        env.PIPELINE_SKIPPED = 'true'
                    } else {
                        echo "✅ Valid trigger: ${currentBuild.getBuildCauses()*.shortDescription.join(', ')}"
                    }
                }
            }
        }

        stage('Checkout') {
            when { expression { env.PIPELINE_SKIPPED != 'true' } }
            steps {
                container('builder') {
                    script {
                        sh 'git config --global --add safe.directory "*"'

                        // Explicit checkout — bypasses the 10-min default per-attempt
                        // timeout in `checkout scm` (#1180 died "git-remote-https signal 15"
                        // at ~10:13). honorRefspec keeps fetch to the single target branch.
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: "*/${env.BRANCH_NAME ?: 'dev'}"]],
                            extensions: [
                                [$class: 'CloneOption', shallow: true, noTags: true, depth: 200, timeout: 30, honorRefspec: true],
                                [$class: 'CleanBeforeCheckout']
                            ],
                            userRemoteConfigs: [[
                                url: 'https://github.com/ethosengine/elohim.git',
                                credentialsId: 'ee-bot-pat',
                                refspec: "+refs/heads/${env.BRANCH_NAME ?: 'dev'}:refs/remotes/origin/${env.BRANCH_NAME ?: 'dev'}"
                            ]]
                        ])
                        sh 'git clean -fdx'
                        sh 'git reset --hard HEAD'

                        echo "Building Holochain DNA for branch: ${env.BRANCH_NAME}"
                    }
                }
            }
        }

        stage('Setup Version') {
            when { expression { env.PIPELINE_SKIPPED != 'true' } }
            steps {
                container('builder') {
                    script {
                        sh 'git config --global --add safe.directory "*"'

                        // Parse VERSION file in key-value format (APP_VERSION=x.x.x, HAPP_VERSION=x.x.x)
                        def versionContent = readFile('VERSION').trim()
                        def versionMap = [:]
                        versionContent.split('\n').each { line ->
                            def parts = line.split('=')
                            if (parts.length == 2) {
                                versionMap[parts[0].trim()] = parts[1].trim()
                            }
                        }
                        // Use HAPP_VERSION for DNA builds, fall back to APP_VERSION
                        def baseVersion = versionMap['HAPP_VERSION'] ?: versionMap['APP_VERSION'] ?: '1.0.0'

                        def gitHash = sh(script: 'git rev-parse HEAD | cut -c1-8', returnStdout: true).trim()
                        def sanitizedBranch = env.BRANCH_NAME.replaceAll('/', '-')

                        def imageTag = (env.BRANCH_NAME == 'main')
                            ? baseVersion
                            : "${baseVersion}-${sanitizedBranch}-${gitHash}"

                        def buildEnvContent = """BASE_VERSION=${baseVersion}
GIT_COMMIT_HASH=${gitHash}
IMAGE_TAG=${imageTag}
BRANCH_NAME=${env.BRANCH_NAME}"""

                        writeFile file: "${env.WORKSPACE}/build.env", text: buildEnvContent
                        archiveArtifacts artifacts: 'build.env', allowEmptyArchive: false
                    }
                }
            }
        }

        stage('Manifest Hygiene') {
            // Fast schema contract check — pure YAML parse, no conductor,
            // no holochain dep. Runs BEFORE the 20-40 min DNA WASM build so
            // manifest drift fails fast. Registered in
            // elohim/holochain/dna/build-manifest.json as step `manifest-hygiene`.
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { shouldRunStep('manifest-hygiene') }
            }}
            steps {
                container('builder') {
                    script {
                        echo 'Running DNA manifest hygiene schema contract...'
                        sh '''#!/usr/bin/env bash
                            set -euo pipefail

                            export HOME="${HOME:-/root}"
                            mkdir -p "$HOME"
                            echo "[safe]" > "$HOME/.gitconfig"
                            echo "    directory = *" >> "$HOME/.gitconfig"
                            export GIT_CONFIG_GLOBAL="$HOME/.gitconfig"

                            # No holochain dep, but the builder container
                            # doesn't expose cargo on PATH — use `nix develop`
                            # against the flake at elohim/holochain/dna/elohim
                            # to pick up the toolchain. RUSTFLAGS="" overrides
                            # the flake's wasm32 setting for this native test.
                            cd "$WORKSPACE/elohim/holochain/tests/manifest-hygiene"
                            # --impure preserves outer env (SCCACHE_BUCKET,
                            # SCCACHE_ENDPOINT, AWS_* from envFrom) so sccache
                            # can talk to Garage. flake.nix shellHook handles
                            # RUSTC_WRAPPER + PATH for sccache binary.
                            nix develop --impure --accept-flake-config \
                                "$WORKSPACE/elohim/holochain/dna/elohim" \
                                --command bash -c 'RUSTFLAGS="" cargo nextest run'
                        '''
                    }
                }
            }
        }

        stage('Setup Nix Cache') {
            when { expression { env.PIPELINE_SKIPPED != 'true' } }
            steps {
                container('builder') {
                    script {
                        echo 'Configuring Nix with Holochain Cachix...'

                        sh '''
                            nix --version
                            echo "Nix config:"
                            nix show-config | grep -E "(substituters|trusted-public-keys)" || true

                            echo ""
                            echo "Testing cache connectivity..."
                            nix-store --query --requisites /nix/store/*.drv 2>/dev/null | head -5 || echo "Cache ready"
                        '''
                    }
                }
            }
        }

        stage('Build WASM Cache Core') {
            when { expression { env.PIPELINE_SKIPPED != 'true' } }
            steps {
                container('builder') {
                    dir('elohim/holochain/dna/elohim') {
                        script {
                            echo 'Building elohim-cache-core WASM module...'

                            sh '''#!/usr/bin/env bash
                                set -euo pipefail

                                export HOME="${HOME:-/root}"
                                mkdir -p "$HOME"
                                echo "[safe]" > "$HOME/.gitconfig"
                                echo "    directory = *" >> "$HOME/.gitconfig"
                                export GIT_CONFIG_GLOBAL="$HOME/.gitconfig"

                                echo "=== Entering Nix development shell for WASM build ==="

                                # --impure preserves SCCACHE_* env vars from
                                # the pod's envFrom Secret mount; flake.nix
                                # shellHook activates sccache wrapper.
                                nix develop --impure --accept-flake-config --command bash -c '
                                    set -euo pipefail

                                    echo "=== Rust toolchain ready ==="
                                    rustc --version
                                    cargo --version
                                    wasm-pack --version

                                    echo ""
                                    echo "=== Building elohim-cache-core WASM ==="
                                    cd ../../../elohim-cache-core
                                    wasm-pack build --target web --release

                                    echo ""
                                    echo "=== WASM Build artifacts ==="
                                    ls -lh pkg/
                                '
                            '''
                        }
                    }
                    dir('elohim/elohim-cache-core') {
                        archiveArtifacts artifacts: 'pkg/**', allowEmptyArchive: false
                        stash name: 'wasm-cache-core', includes: 'pkg/**'
                        echo "elohim-cache-core WASM module built and archived"
                    }
                }
            }
        }

        stage('Build DNA') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { shouldRunStep('build-dna-wasm') }
            }}
            steps {
                container('builder') {
                    dir('elohim/holochain/dna/elohim') {
                        script {
                            echo 'Building Holochain DNA with Nix...'
                            echo 'First build may take 20-40 minutes. Subsequent builds use cache.'

                            sh '''#!/usr/bin/env bash
                                set -euo pipefail

                                export HOME="${HOME:-/root}"
                                mkdir -p "$HOME"
                                echo "[safe]" > "$HOME/.gitconfig"
                                echo "    directory = *" >> "$HOME/.gitconfig"
                                export GIT_CONFIG_GLOBAL="$HOME/.gitconfig"

                                # Collects one `role=hash` line per packed DNA for the
                                # DNA Hash Guard stage (scripts/ci/dna-hash-guard.sh) —
                                # see the INCIDENT comment on each zome's build.rs.
                                export DNA_HASH_FILE="$(pwd)/dna-hashes.actual"
                                : > "$DNA_HASH_FILE"

                                echo "=== Entering Nix development shell ==="
                                echo "This will download/build Holochain toolchain from Cachix..."

                                # --impure preserves SCCACHE_* env vars; sccache
                                # speeds up cargo invocations the build script makes.
                                nix develop --impure --accept-flake-config --command bash -c '
                                    set -euo pipefail

                                    echo "=== Holochain toolchain ready ==="
                                    hc --version
                                    rustc --version
                                    cargo --version

                                    echo ""
                                    echo "=== Building lamad DNA (elohim) ==="
                                    cargo build --release --target wasm32-unknown-unknown
                                    hc dna pack . -o workdir/lamad.dna
                                    _h_lamad=$(hc dna hash workdir/lamad.dna)
                                    echo "DNA-HASH lamad ${_h_lamad}"
                                    echo "lamad=${_h_lamad}" >> "$DNA_HASH_FILE"
                                    echo "   ✅ lamad.dna"

                                    echo ""
                                    echo "=== Building imagodei DNA ==="
                                    cd ../imagodei
                                    cargo build --release --target wasm32-unknown-unknown
                                    hc dna pack . -o ../elohim/workdir/imagodei.dna
                                    _h_imagodei=$(hc dna hash ../elohim/workdir/imagodei.dna)
                                    echo "DNA-HASH imagodei ${_h_imagodei}"
                                    echo "imagodei=${_h_imagodei}" >> "$DNA_HASH_FILE"
                                    echo "   ✅ imagodei.dna"

                                    echo ""
                                    echo "=== Building infrastructure DNA ==="
                                    cd ../infrastructure
                                    cargo build --release --target wasm32-unknown-unknown
                                    hc dna pack . -o ../elohim/workdir/infrastructure.dna
                                    _h_infrastructure=$(hc dna hash ../elohim/workdir/infrastructure.dna)
                                    echo "DNA-HASH infrastructure ${_h_infrastructure}"
                                    echo "infrastructure=${_h_infrastructure}" >> "$DNA_HASH_FILE"
                                    echo "   ✅ infrastructure.dna"

                                    echo ""
                                    echo "=== Building node-registry DNA ==="
                                    cd ../node-registry
                                    cargo build --release --target wasm32-unknown-unknown
                                    hc dna pack . -o node-registry.dna
                                    _h_node_registry=$(hc dna hash node-registry.dna)
                                    echo "DNA-HASH node_registry ${_h_node_registry}"
                                    echo "node_registry=${_h_node_registry}" >> "$DNA_HASH_FILE"
                                    echo "   ✅ node-registry.dna"

                                    # --- node-registry v2 (lineage-witness feature variant) ---
                                    # Holochain Evolution Epic §2/§8 successor artifact. The
                                    # `lineage-witness` cargo feature adds the NotarizationWitness
                                    # entry type, so this pack has a DIFFERENT DNA hash BY DESIGN.
                                    # Its hash is PRINTED but deliberately NOT appended to
                                    # $DNA_HASH_FILE: the DNA Hash Guard baseline covers the
                                    # DEFAULT build only (see the 2026-09-02 incident comment on
                                    # that stage). NOTE: this whole body runs inside bash -c
                                    # SINGLE quotes, so no apostrophes anywhere in it.
                                    # ORDER MATTERS — this must come AFTER the default pack above,
                                    # because it overwrites the shared target/ wasm with
                                    # feature-built bytes. Nothing downstream re-packs
                                    # node-registry.dna from wasm (the happ pack and the sweettest
                                    # stash both consume the already-written .dna file).
                                    echo ""
                                    echo "=== Building node-registry v2 (lineage-witness variant) ==="
                                    cargo build --release --target wasm32-unknown-unknown --features lineage-witness
                                    hc dna pack . -o node-registry-v2.dna
                                    _h_node_registry_v2=$(hc dna hash node-registry-v2.dna)
                                    echo "DNA-HASH node_registry_v2 ${_h_node_registry_v2}"
                                    echo "   ✅ node-registry-v2.dna (feature variant — NOT in the hash baseline)"

                                    echo ""
                                    echo "=== Building mishpat DNA (governance) ==="
                                    cd ../mishpat
                                    cargo build --release --target wasm32-unknown-unknown
                                    hc dna pack . -o ../elohim/workdir/mishpat.dna
                                    _h_mishpat=$(hc dna hash ../elohim/workdir/mishpat.dna)
                                    echo "DNA-HASH mishpat ${_h_mishpat}"
                                    echo "mishpat=${_h_mishpat}" >> "$DNA_HASH_FILE"
                                    echo "   ✅ mishpat.dna"

                                    echo ""
                                    echo "=== Injecting version metadata into hApp manifest ==="
                                    cd ../elohim
                                    _hv=$(grep HAPP_VERSION ../../../../VERSION | cut -d= -f2)
                                    _gc=$(git -C ../../../.. rev-parse HEAD | cut -c1-8)
                                    sed -i "2a # Build: HAPP_VERSION=${_hv} commit=${_gc}" workdir/happ.yaml

                                    echo "=== Packaging hApp (all 4 DNAs) ==="
                                    hc app pack workdir -o elohim.happ

                                    echo ""
                                    echo "=== Build artifacts ==="
                                    ls -lh elohim.happ workdir/*.dna
                                '
                            '''

                            archiveArtifacts artifacts: 'elohim.happ,workdir/*.dna,dna-hashes.actual', allowEmptyArchive: false
                            stash name: 'happ-bundle', includes: 'elohim.happ'

                            // Holochain Evolution Epic §8: the successor artifact is packed in
                            // the node-registry directory, outside this dir() scope, so it needs
                            // its own archive step. It is deliberately NOT stashed for the
                            // sweettest stage: the lineage probes need a v1 bundle too, and
                            // shipping v2 alone would turn their clean SKIP into a red.
                            dir("${env.WORKSPACE}/elohim/holochain/dna/node-registry") {
                                archiveArtifacts artifacts: 'node-registry-v2.dna', allowEmptyArchive: true
                            }

                            def props = loadBuildVars()

                            echo """
                            ═══════════════════════════════════════════════════════════
                            hApp ARTIFACT ARCHIVED
                            ═══════════════════════════════════════════════════════════

                            Artifact URL (for downstream consumers):
                            ${env.BUILD_URL}artifact/elohim.happ

                            Build Details:
                            - Version: ${props.IMAGE_TAG ?: 'unknown'}
                            - Branch: ${env.BRANCH_NAME}
                            - Commit: ${props.GIT_COMMIT_HASH ?: 'unknown'}

                            Downstream pipelines can fetch this artifact:
                            - elohim-edge: Container images
                            - elohim-app: WASM cache core
                            - steward: Desktop app builds
                            ═══════════════════════════════════════════════════════════
                            """
                        }
                    }
                }
            }
        }

        // Guards against the 2026-09-02 incident: commit 03f331f21 added an
        // unconditional wasm-ld link arg believed hash-neutral in CI. It
        // moved every packed INTEGRITY wasm's bytes instead, moving all five
        // DNA hashes and orphaning the fleet's installed hApp + source
        // chains. Bash body lives in scripts/ci/dna-hash-guard.sh (Jenkinsfile
        // stays heredoc-free per repo rules — see build.rs on each zome for
        // the incident detail this guard exists to catch).
        stage('DNA Hash Guard') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { shouldRunStep('build-dna-wasm') }
            } }
            steps {
                container('builder') {
                    script {
                        sh 'git config --global --add safe.directory "*"'
                        sh "bash '${env.WORKSPACE}/scripts/ci/dna-hash-guard.sh' '${env.WORKSPACE}/elohim/holochain/dna/dna-hashes.baseline' '${env.WORKSPACE}/elohim/holochain/dna/elohim/dna-hashes.actual'"
                    }
                }
            }
        }

        stage('DNA Integration (bootstrap-steward)') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { shouldRunStep('build-dna-wasm') }
            } }
            options {
                // Cold sweettest compile is ~30min by itself before any test runs.
                // Each test spins up a real conductor + kitsune2 stack and is run
                // serialized (--test-threads=1), so the full suite can take 30+ min
                // on top. Stage timeout sized for cold-cache worst case; warm runs
                // will finish in ~10–15min.
                timeout(time: 150, unit: 'MINUTES')
            }
            steps {
                container('builder') {
                    dir('elohim/holochain/tests/sweettest') {
                        script {
                            sh '''#!/usr/bin/env bash
                                set -uo pipefail

                                export HOME="${HOME:-/root}"
                                mkdir -p "$HOME"
                                [ -f "$HOME/.gitconfig" ] || printf "[safe]\\n    directory = *\\n" > "$HOME/.gitconfig"
                                export GIT_CONFIG_GLOBAL="$HOME/.gitconfig"

                                # LOG is exported (not just set) so the inner
                                # `bash -c '...'` invocation inherits it via
                                # `nix develop --impure` env preservation.
                                export LOG="$(pwd)/dna-integration.log"
                                : > "$LOG"

                                # Resource guards:
                                #   CARGO_BUILD_JOBS=2  — caps compile parallelism; prevents the
                                #                         ~6-8 GB RAM spike when linking holochain.
                                #   --test-threads=1    — one conductor at a time (~1 GB runtime peak).
                                #   --release           — slower compile, ~30% less runtime RAM.
                                # Sweettest is IN-PROCESS: each test spins up a full kitsune2 p2p
                                # stack + SQLite + keystore. Serializing keeps peak flat. See
                                # stage comment in tests/sweettest/README.md for the trade-off.
                                # Flake-ref is explicit — tests/sweettest/ has no flake.nix
                                # so nix would otherwise search parents and bail.
                                # --impure preserves SCCACHE_* env vars from pod
                                # envFrom; flake shellHook activates sccache wrapper.
                                # Sweettest re-enabled with full daemon log capture
                                # (see SCCACHE_LOG_FILE below) so if the build-script
                                # bug recurs we have ground truth in dna-integration-
                                # sccache-daemon.log instead of guessing.
                                # bash -c single-quoted: inner is verbatim through
                                # Groovy + outer bash; inner bash expands $VARS, no
                                # \$ or \" escapes needed. Constraint: no literal
                                # apostrophes in this block. Double-quoted variant
                                # broke at #1222 and #1224 on quoting edge cases.

                                # W3+W5: run the harvester ONCE in outer shell; write
                                # filter to .nextest-filter so the stashed file flows
                                # to every shard pod unchanged. No need to re-grep
                                # markers 4x.
                                NEXTEST_FILTER=$("$WORKSPACE/elohim/holochain/tests/sweettest/scripts/build-nextest-filter.sh")
                                echo "[sweettest] nextest -E (for shards): $NEXTEST_FILTER"
                                printf "%s" "$NEXTEST_FILTER" > .nextest-filter

                                nix develop --impure --accept-flake-config "$WORKSPACE/elohim/holochain/dna/elohim" --command bash -c '
                                    set -uo pipefail
                                    # sccache daemon log capture — written by sccache
                                    # daemon itself, not by cargo. SCCACHE_LOG=info
                                    # (escalated from warn) gives request-level detail.
                                    # The file is archived as a Jenkins artifact in
                                    # post.always so we can analyze cache hit/miss
                                    # patterns and surface any S3 write errors that
                                    # sccache silently swallows.
                                    # sccache DISABLED for sweettest only — see #1225 RCA.
                                    # 32/1857 rustc invocations hit ENOENT on sccache
                                    # (build-script subprocess class — same bug efbac2938
                                    # originally fixed by disabling). Re-enable when
                                    # tiered-quilt substrate hardens that path.
                                    unset RUSTC_WRAPPER
                                    export SCCACHE_LOG=info
                                    export SCCACHE_LOG_FILE="$WORKSPACE/elohim/holochain/tests/sweettest/dna-integration-sccache-daemon.log"
                                    : > "$SCCACHE_LOG_FILE"
                                    export CARGO_INCREMENTAL=0
                                    # Daemon kept running for stats/log visibility.
                                    sccache --stop-server >/dev/null 2>&1 || true
                                    sccache --start-server
                                    sccache --zero-stats
                                    export CARGO_BUILD_JOBS=2
                                    # The flake exports RUSTFLAGS=--cfg getrandom_backend=custom
                                    # for WASM zome builds (Holochain provides the host RNG fn).
                                    # Sweettest is a NATIVE build — that flag makes the linker
                                    # search for __getrandom_v03_custom which does not exist off-WASM.
                                    # See CLAUDE.md §RUSTFLAGS Override Required.
                                    export RUSTFLAGS=""
                                    # Scoped to this bash -c only; pod-wide broke hc dna
                                    # pack in #1212 (./target hard-coded). See volumeMounts.
                                    export CARGO_TARGET_DIR=/cargo-target

                                    # W5: build the test archive (compile + bundle ALL
                                    # binaries). Shards apply the W3 -E filter at run
                                    # time, so archive is cache-friendly (same content
                                    # regardless of changeset).
                                    cargo nextest archive --release \\
                                        --archive-file "$(pwd)/sweettest-archive.tar.zst" \\
                                        2>&1 | tee "$LOG"
                                    CARGO_RC=${PIPESTATUS[0]}
                                    # Capture sccache hit/miss/write stats to the
                                    # build log (visible immediately) and a sidecar
                                    # file (archived). Stop the daemon so its log
                                    # gets fully flushed before archive.
                                    echo ""
                                    echo "=== sccache stats (sweettest stage) ==="
                                    sccache --show-stats 2>&1 | tee "$WORKSPACE/elohim/holochain/tests/sweettest/dna-integration-sccache-stats.txt"
                                    sccache --stop-server >/dev/null 2>&1 || true
                                    exit $CARGO_RC
                                '
                                RC=${PIPESTATUS[0]}

                                # Happy path — surface the nextest summary line.
                                if [ "$RC" -eq 0 ]; then
                                    echo "--- DNA Integration: PASSED ---"
                                    grep -E "^ *Summary " "$LOG" || true
                                    exit 0
                                fi

                                # Failure — extract summary + failed test names + captured stdout/stderr.
                                # nextest prints one "Summary [duration] N tests run: ..." line at the end,
                                # FAIL lines per failed test, and "--- STDOUT: target::name ---" /
                                # "--- STDERR: target::name ---" blocks for captured output.
                                echo "--- DNA Integration: FAILED ---"
                                echo ""
                                echo "Summary:"
                                grep -E "^ *Summary " "$LOG" || true
                                echo ""
                                echo "Failed tests:"
                                grep -E "^ *FAIL " "$LOG" || true
                                echo ""
                                echo "Failure output (first 200 lines from first STDOUT/STDERR marker):"
                                awk "/^--- STDOUT:|^--- STDERR:/{p=1} p" "$LOG" | head -200
                                echo ""
                                echo "(full log archived as dna-integration.log)"
                                exit $RC
                            '''
                        }
                    }

                    // W5 stash + parallel — OUTSIDE the dir('elohim/.../sweettest')
                    // block. stash() inside dir() resolved workspace-relative
                    // `includes:` against the dir's cwd → produced "No files
                    // included in stash" failure on #1272 even though the
                    // archive was confirmed present. Workspace-root context
                    // here is what stash expects, and the shard helper's
                    // unstash → dir(sweettest) → sh sequence then finds the
                    // files at the right relative paths inside each shard pod.
                    script {
                        // Confirm archive landed where stash expects.
                        sh '''ls -lh elohim/holochain/tests/sweettest/sweettest-archive.tar.zst elohim/holochain/tests/sweettest/.nextest-filter'''

                        // Stash compiled archive + filter + workspace source +
                        // flake files + DNA artifacts. nextest's archive contains
                        // test binaries + metadata only — it needs the original
                        // Cargo.toml + src/ on the runtime machine so
                        // `--workspace-remap` can map binaries→tests. Include all
                        // of sweettest/ (small without target/) so the shard has
                        // full workspace.
                        // flake.nix + flake.lock are at dna/elohim/ — needed by
                        // `nix develop` on the shard pod.
                        // .dna files: fixtures.rs::dna_path() resolves DNAs via
                        // three candidates relative to elohim/holochain/dna/:
                        //   (1) <name>/workdir/<name>.dna
                        //   (2) elohim/workdir/<name>.dna   ← shared happ workdir
                        //   (3) <hyphen-name>/<hyphen-name>.dna  (node-registry)
                        // DNA build stage writes to (2) for shared DNAs +
                        // (3) for node-registry. Include both so shards resolve.
                        // (Bug #9 of 2026-05-24 sweettest sprint — #1278 FAILURE.)
                        stash(
                            includes: 'elohim/holochain/tests/sweettest/**,elohim/holochain/dna/elohim/flake.nix,elohim/holochain/dna/elohim/flake.lock,elohim/holochain/dna/elohim/workdir/*.dna,elohim/holochain/dna/node-registry/node-registry.dna',
                            excludes: 'elohim/holochain/tests/sweettest/target/**,elohim/holochain/tests/sweettest/extracted-*/**',
                            name: 'sweettest-shard-input'
                        )

                        // Run shards in parallel — each in its own pod
                        // (SWEETTEST_SHARD_POD_YAML, no PVC mounts). hash:k/N
                        // partitioning evens out runtime per-shard. Failed shard
                        // doesn't kill peers (failFast default off) → full test
                        // signal across all shards.
                        def shards = [:]
                        for (int i = 1; i <= SWEETTEST_SHARD_COUNT; i++) {
                            int n = i
                            shards["sweettest-shard-${n}/${SWEETTEST_SHARD_COUNT}"] = {
                                runSweettestShard(n, SWEETTEST_SHARD_COUNT, SWEETTEST_SHARD_POD_YAML)
                            }
                        }
                        parallel shards
                    }
                }
            }
            post {
                always {
                    archiveArtifacts(
                        artifacts: 'elohim/holochain/tests/sweettest/dna-integration.log,elohim/holochain/tests/sweettest/dna-integration-sccache-daemon.log,elohim/holochain/tests/sweettest/dna-integration-sccache-stats.txt,elohim/holochain/tests/sweettest/.nextest-filter',
                        allowEmptyArchive: true
                    )
                    // Aggregate per-shard JUnit. allowEmptyResults: pre-merge builds
                    // (no shards yet) or filter-empty shards won't fail this.
                    junit(
                        allowEmptyResults: true,
                        testResults: 'elohim/holochain/tests/sweettest/sweettest-shard-*-junit.xml'
                    )
                    // Clean leaked temp conductor dirs (panicked tests can skip Drop).
                    sh 'find /tmp -maxdepth 2 -name "sweet_conductor_*" -mtime +0 -exec rm -rf {} + 2>/dev/null || true'
                }
            }
        }

        // Rung-1 coordinator hot-swap vehicle (backlog
        // upgrade-propagation-p2p-design-arc): after a dev-branch bundle passes
        // integration, roll it across the alpha fleet's storage nodes via
        // POST /admin/coordinators/sync. Coordinator-only diffs hot-swap in
        // minutes (no pod roll, no re-key); integrity diffs are refused per
        // role by the endpoint's DNA-lineage guard; no-drift builds no-op.
        // Warn-only while the vehicle earns trust: the dispatch script always
        // exits 0 (COORDSWAP_ENABLE=false is the kill-switch). Peers still on
        // a pre-endpoint storage binary answer 404 and read as failed-apply —
        // expected until the edge roll that ships the endpoint.
        stage('Fleet Coordinator Hot-Swap') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                branch 'dev'
            } }
            options { timeout(time: 30, unit: 'MINUTES') }
            steps {
                container('builder') {
                    script {
                        // Derive the roster HERE with readJSON — the builder
                        // container has no jq (first fleet contact, build
                        // #1410, hit `jq: command not found` and skipped).
                        // Mirrors the edge Jenkinsfile's suspended filter +
                        // computeStorageUrls DNS shape.
                        def deployments = readJSON(file: 'genesis/orchestrator/data/deployments.json')
                        def peers = deployments.humans
                            .findAll { !(it.suspended ?: false) }
                            .collect { "${it.name}=http://elohim-${it.name}-alpha.elohim-alpha.svc.cluster.local:8090" }
                            .join(',')
                        withEnv(["COORDSWAP_PEERS=${peers}"]) {
                            sh "bash '${env.WORKSPACE}/scripts/ci/fleet-coordswap-dispatch.sh' '${env.WORKSPACE}/elohim/holochain/dna/elohim/elohim.happ' alpha"
                        }
                    }
                }
            }
        }

        stage('Push to Harbor') {
            when { expression { env.PIPELINE_SKIPPED != 'true' } }
            steps {
                container('builder') {
                    dir('elohim/holochain/dna/elohim') {
                        script {
                            def props = loadBuildVars()
                            def version = props.IMAGE_TAG ?: 'dev'

                            echo "Pushing artifacts to Harbor with version: ${version}"

                            // Install oras CLI if not present
                            sh '''
                                if ! command -v oras &> /dev/null; then
                                    echo "Installing oras CLI..."
                                    curl -LO https://github.com/oras-project/oras/releases/download/v1.1.0/oras_1.1.0_linux_amd64.tar.gz
                                    tar -xzf oras_1.1.0_linux_amd64.tar.gz
                                    chmod +x oras
                                    mv oras /usr/local/bin/
                                    rm oras_1.1.0_linux_amd64.tar.gz
                                fi
                                oras version
                            '''

                            // Determine floating tag for K8s manifests
                            def floatingTag = (env.BRANCH_NAME == 'main') ? 'latest' : 'dev-latest'

                            // Push hApp and WASM to Harbor
                            withCredentials([usernamePassword(
                                credentialsId: 'harbor-robot-registry',
                                usernameVariable: 'HARBOR_USER',
                                passwordVariable: 'HARBOR_PASS'
                            )]) {
                                sh """
                                    oras login harbor.ethosengine.com -u \$HARBOR_USER -p \$HARBOR_PASS

                                    echo "Pushing hApp to Harbor..."
                                    oras push harbor.ethosengine.com/ethosengine/elohim-happ:${version} \\
                                        elohim.happ:application/octet-stream

                                    echo "Pushing hApp floating tag: ${floatingTag}..."
                                    oras push harbor.ethosengine.com/ethosengine/elohim-happ:${floatingTag} \\
                                        elohim.happ:application/octet-stream

                                    echo "Pushing WASM cache core to Harbor..."
                                    cd ../../../elohim-cache-core/pkg
                                    oras push harbor.ethosengine.com/ethosengine/elohim-wasm-cache-core:${version} \\
                                        elohim_cache_core_bg.wasm:application/wasm \\
                                        elohim_cache_core.js:application/javascript \\
                                        elohim_cache_core.d.ts:text/plain \\
                                        elohim_cache_core_bg.wasm.d.ts:text/plain \\
                                        package.json:application/json

                                    echo "Pushing WASM floating tag: ${floatingTag}..."
                                    oras push harbor.ethosengine.com/ethosengine/elohim-wasm-cache-core:${floatingTag} \\
                                        elohim_cache_core_bg.wasm:application/wasm \\
                                        elohim_cache_core.js:application/javascript \\
                                        elohim_cache_core.d.ts:text/plain \\
                                        elohim_cache_core_bg.wasm.d.ts:text/plain \\
                                        package.json:application/json
                                """
                            }

                            echo """
                            ═══════════════════════════════════════════════════════════
                            ARTIFACTS PUSHED TO HARBOR
                            ═══════════════════════════════════════════════════════════

                            hApp: harbor.ethosengine.com/ethosengine/elohim-happ:${version}
                                  harbor.ethosengine.com/ethosengine/elohim-happ:${floatingTag}
                            WASM: harbor.ethosengine.com/ethosengine/elohim-wasm-cache-core:${version}
                                  harbor.ethosengine.com/ethosengine/elohim-wasm-cache-core:${floatingTag}

                            K8s manifests should use floating tag: ${floatingTag}
                            ═══════════════════════════════════════════════════════════
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo """
            ═══════════════════════════════════════════════════════════
            DNA BUILD SUCCEEDED
            ═══════════════════════════════════════════════════════════
            Branch: ${env.BRANCH_NAME}
            Build: ${env.BUILD_NUMBER}

            Artifacts available at:
            ${env.BUILD_URL}artifact/

            To trigger infrastructure rebuild:
            - Push to doorway/**, elohim/holochain/edgenode/**
            - Or run elohim-edge with FORCE_BUILD=true
            ═══════════════════════════════════════════════════════════
            """
        }
        failure {
            echo """
            ═══════════════════════════════════════════════════════════
            DNA BUILD FAILED
            ═══════════════════════════════════════════════════════════
            Check the build logs for errors.

            Common issues:
            - Nix cache unavailable (retry)
            - Rust compilation errors (check DNA code)
            - Out of disk space (check ephemeral-storage limits)
            ═══════════════════════════════════════════════════════════
            """
        }
        // Note: No cleanWs needed - k8s pod agents are ephemeral
    }
}
