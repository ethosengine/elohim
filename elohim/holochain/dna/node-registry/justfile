# Node Registry DNA - P2P Node Registration
#
# RUSTFLAGS is baked in — just `just build` and go.

set dotenv-load := false

export RUSTFLAGS := '--cfg getrandom_backend="custom" -C link-arg=--import-undefined'

# 2026-09-02: --import-undefined is a local rustc-1.98/lld need only —
# CI (elohim/holochain/dna/Jenkinsfile) invokes cargo directly and must
# never see this, or the INTEGRITY wasm bytes move (2026-09-02: the zome build.rs
# variant of this flag moved every DNA hash in CI and was removed; RUSTFLAGS here is local-only).

wasm_target := "wasm32-unknown-unknown"
dna_name    := "node-registry"

# List available recipes
default:
    @just --list

# Build WASM zomes (release)
build:
    cargo build --release --target {{wasm_target}}

# Run tests
test:
    cargo test

# Type-check without building
check:
    cargo check --target {{wasm_target}}

# Lint with clippy
clippy:
    cargo clippy --target {{wasm_target}} -- -D warnings

# Format code
fmt:
    cargo fmt

# Check formatting without modifying
fmt-check:
    cargo fmt --check

# Remove build artifacts
clean:
    cargo clean

# Build WASM zomes (alias for build)
wasm: build

# Build WASM + pack DNA
pack: build
    hc dna pack . -o {{dna_name}}.dna

# Build the `lineage-witness` feature variant (Holochain Evolution Epic §2:
# NotarizationWitness entry type + EntryToWitness link, off by default so the
# plain `build`/`pack` recipes above stay DNA-hash-neutral) and pack it to
# node-registry-v2.dna — the successor artifact `happ_lineage_migration.rs`
# reads via NODE_REGISTRY_V2_DNA (or the in-repo default).
build-witness:
    cargo build --release --target {{wasm_target}} --features lineage-witness
    hc dna pack . -o node-registry-v2.dna

# The SWEETTEST-facing successor: the same DNA plus the test-only externs
# (`carry_page_for_test`), which are fenced behind a SECOND feature so the
# deployable bundle above cannot carry them — a hand-built-page injection point
# is not something a running conductor should answer. The two bundles are
# DNA-hash-IDENTICAL (the difference is coordinator-only), which is what makes
# the sweettest a measurement of the DNA the fleet actually runs.
# `happ_lineage_migration.rs` reads this one by default.
build-witness-test:
    cargo build --release --target {{wasm_target}} --features "lineage-witness lineage-test"
    hc dna pack . -o node-registry-v2-test.dna

# Pack the one-role successor hApp bundle around node-registry-v2.dna
# (Holochain Evolution Epic Task 9). The role's `lineage` property here is an
# EMPTY placeholder: the real predecessor DNA hash is only knowable at install
# time, so the vehicle overrides `modifiers.properties` then. Depends on
# `build-witness` having produced ../node-registry-v2.dna.
build-witness-happ: build-witness
    hc app pack workdir-v2 -o node-registry-v2.happ
