{
  "manifestVersion": "1.0",
  "pipeline": "elohim-holochain",
  "jenkinsPath": "elohim/holochain/dna/Jenkinsfile",
  "manualOnly": false,
  "triggersGenesis": true,
  "cascades": true,
  "longRunning": true,
  "dependsOn": [],
  "description": "Holochain DNA compilation — WASM zomes and hApp packaging",
  "steps": {
    "build-dna-wasm": {
      "description": "Compile integrity and coordinator zomes to WASM",
      "inputs": {
        "sources": [
          "elohim/holochain/dna/**/*.rs",
          "elohim/holochain/dna/**/Cargo.toml",
          "elohim/holochain/dna/**/Cargo.lock",
          "elohim/holochain/dna/**/*.nix",
          "elohim/elohim-cache-core/**",
          "elohim/holochain/rna/**",
          "elohim/sdk/domains/*/types/**",
          "elohim/elohim-agent/gate-client-zome/**",
          "elohim/elohim-agent/gate-types/**",
          "elohim/Cargo.toml",
          "crates/doorway-client/**",
          "crates/seam-contracts/**",
          "bridges/pkarr/Cargo.toml",
          "bridges/pkarr/pkarr-bridge/**",
          "VERSION"
        ],
        "buildProcess": [
          "elohim/holochain/dna/Jenkinsfile"
        ]
      },
      "outputs": {
        "artifacts": ["dna-wasm"],
        "verify": null
      },
      "depends": [],
      "executor": {
        "stage": "Build DNA",
        "function": null
      }
    },
    "build-happ": {
      "description": "Package compiled zomes into .happ bundle",
      "inputs": {
        "sources": [
          "elohim/holochain/dna/**/happ.yaml",
          "elohim/holochain/dna/**/dna.yaml"
        ],
        "buildProcess": []
      },
      "outputs": {
        "artifacts": ["elohim.happ"],
        "verify": null
      },
      "depends": ["build-dna-wasm"],
      "executor": {
        "stage": "Build DNA",
        "function": null
      }
    },
    "schema-dna": {
      "description": "Verify DNA constants match protocol schema enums",
      "inputs": {
        "sources": [
          "elohim/holochain/dna/**",
          "elohim/sdk/schemas/**"
        ],
        "buildProcess": []
      },
      "outputs": {
        "artifacts": [],
        "verify": null
      },
      "depends": [],
      "executor": {
        "stage": "Schema DNA Check",
        "function": null
      }
    },
    "manifest-hygiene": {
      "description": "DNA manifest hygiene schema contract (wave-1 §7) — pure YAML parse, no conductor",
      "inputs": {
        "sources": [
          "elohim/holochain/dna/*/dna.yaml",
          "elohim/holochain/dna/elohim/workdir/happ.yaml",
          "elohim/holochain/tests/manifest-hygiene/**"
        ],
        "buildProcess": []
      },
      "outputs": {
        "artifacts": [],
        "verify": null
      },
      "depends": [],
      "executor": {
        "stage": "Manifest Hygiene",
        "function": null
      }
    },
    "sweettest-check": {
      "description": "Sweettest compile-check — catches extern-signature drift before Jenkins-time integration run. See spec §3 (noisy-husky Gate 2).",
      "inputs": {
        "sources": [
          "elohim/holochain/dna/*/zomes/**/src/*.rs",
          "elohim/holochain/dna/*/zomes/**/Cargo.toml",
          "elohim/holochain/tests/sweettest/src/**",
          "elohim/holochain/tests/sweettest/Cargo.toml",
          "elohim/holochain/dna/*/Cargo.toml",
          "elohim/holochain/dna/*/Cargo.lock",
          "elohim/holochain/rna/rust/**",
          "elohim/sdk/domains/*/types/**",
          "elohim/elohim-agent/gate-client-zome/**",
          "elohim/elohim-agent/gate-types/**",
          "elohim/Cargo.toml",
          "crates/doorway-client/**",
          "crates/seam-contracts/**",
          "bridges/pkarr/Cargo.toml",
          "bridges/pkarr/pkarr-bridge/**"
        ],
        "buildProcess": []
      },
      "outputs": {
        "artifacts": [],
        "verify": null
      },
      "depends": [],
      "executor": {
        "stage": "Sweettest Compile Check",
        "function": null
      }
    },
    "dna-extern-lints": {
      "description": "extern-fails-loud, enforced: clippy over the five coordinator crates (wasm32-unknown-unknown) denying clippy::todo, clippy::unimplemented and clippy::let_underscore_must_use. Integrity crates are out of scope. See elohim/holochain/dna/.epr-meta/manifest.md rule extern-fails-loud.",
      "inputs": {
        "sources": [
          "elohim/holochain/dna/elohim/zomes/content_store/**",
          "elohim/holochain/dna/imagodei/zomes/imagodei/**",
          "elohim/holochain/dna/infrastructure/zomes/infrastructure/**",
          "elohim/holochain/dna/node-registry/zomes/node_registry_coordinator/**",
          "elohim/holochain/dna/mishpat/zomes/mishpat/**",
          "elohim/holochain/dna/*/zomes/*_integrity/**",
          "elohim/holochain/dna/*/Cargo.toml",
          "elohim/holochain/dna/*/Cargo.lock",
          "elohim/holochain/rna/rust/**",
          "elohim/sdk/domains/*/types/**",
          "elohim/elohim-agent/gate-client-zome/**",
          "elohim/elohim-agent/gate-types/**",
          "elohim/Cargo.toml",
          "crates/doorway-client/**",
          "crates/seam-contracts/**",
          "bridges/pkarr/Cargo.toml",
          "bridges/pkarr/pkarr-bridge/**"
        ],
        "buildProcess": []
      },
      "outputs": {
        "artifacts": [],
        "verify": null
      },
      "depends": [],
      "executor": {
        "stage": "DNA Extern Lints",
        "function": null
      }
    }
  },
  "gate": {
    "projects": {
      "schema-dna": {
        "dir": ".",
        "steps": ["schema-dna"],
        "run": { "kind": "root-just", "recipe": "_gate-schema-dna" }
      },
      "manifest-hygiene": {
        "dir": ".",
        "steps": ["manifest-hygiene"],
        "run": {
          "kind": "root-just",
          "recipe": "_gate-manifest-hygiene",
          "cargo": { "targetDir": "/tmp/manifest-hygiene-gate-target", "profile": "dev", "rustflags": "" }
        }
      },
      "sweettest-check": {
        "dir": ".",
        "steps": ["sweettest-check"],
        "run": {
          "kind": "root-just",
          "recipe": "_gate-sweettest-check",
          "cargo": {
            "workspace": "elohim/holochain/tests/sweettest",
            "profile": "dev",
            "rustflags": ""
          }
        }
      },
      "dna-extern-lints": {
        "dir": ".",
        "steps": ["dna-extern-lints"],
        "run": { "kind": "root-just", "recipe": "_gate-dna-extern-lints" }
      }
    }
  },
  "deployment": {}
}
