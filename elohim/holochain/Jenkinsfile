/**
 * Elohim Edge Infrastructure Pipeline (elohim-edge)
 *
 * Builds container images and deploys Edge Node to dev/prod environments.
 * Triggered by orchestrator when doorway/, elohim/elohim-storage/, or elohim/holochain/edgenode/ change.
 *
 * What this pipeline builds:
 *   - elohim-doorway (HTTP gateway)
 *   - elohim-storage (blob storage sidecar)
 *   - elohim-edgenode (Holochain conductor)
 *   - elohim-happ-installer (bootstrap sidecar)
 *
 * Environment Architecture (branch → doorways deployed):
 *   - dev branch     → ALPHA env, deploys BOTH federation peers:
 *                        · doorway-alpha.elohim.host (doorway-A, on-prem)
 *                        · elohim.host               (doorway-B / alpha-b federation
 *                          peer, shem apex — alpha-b.yaml, deploy elohim-doorway-alpha-b)
 *                      Both peers track dev in lockstep so the federation runs matched
 *                      code + DNA (mismatched hashes → split DHT → can't federate).
 *   - staging branch → doorway-staging.elohim.host (+ staging-read)
 *   - main branch    → doorway.elohim.host (legacy prod doorway — NOT elohim.host)
 *
 * Trigger behavior:
 *   - Only runs when triggered by orchestrator or manual
 *   - Shows NOT_BUILT when triggered directly by webhook
 *
 * Artifact dependency:
 *   - Fetches elohim.happ from elohim-holochain pipeline
 *   - Fallback: current branch → dev → main
 *
 * @see genesis/orchestrator/Jenkinsfile for central trigger logic
 * @see elohim/holochain/dna/Jenkinsfile for DNA builds
 */

// ============================================================================
// HELPER FUNCTIONS
// ============================================================================

def loadBuildVars() {
    def rootEnv = "${env.WORKSPACE}/build.env"
    def path = fileExists(rootEnv) ? rootEnv : 'build.env'

    if (!fileExists(path)) {
        echo "WARNING: build.env not found at ${path}, using defaults"
        def gitHash = sh(script: 'git rev-parse HEAD | cut -c1-8', returnStdout: true).trim()
        def sanitizedBranch = env.BRANCH_NAME.replaceAll('/', '-')
        return [
            BASE_VERSION: 'dev',
            GIT_COMMIT_HASH: gitHash,
            IMAGE_TAG: "dev-${sanitizedBranch}-${gitHash}",
            BRANCH_NAME: env.BRANCH_NAME
        ]
    }

    return readProperties(file: path)
}

def withBuildVars(props, Closure body) {
    withEnv([
        "BASE_VERSION=${props.BASE_VERSION ?: ''}",
        "GIT_COMMIT_HASH=${props.GIT_COMMIT_HASH ?: ''}",
        "IMAGE_TAG=${props.IMAGE_TAG ?: ''}",
        "EDGENODE_TAG=${props.EDGENODE_TAG ?: props.IMAGE_TAG ?: ''}",
        "DOORWAY_TAG=${props.DOORWAY_TAG ?: props.IMAGE_TAG ?: ''}",
        "STORAGE_TAG=${props.STORAGE_TAG ?: props.IMAGE_TAG ?: ''}",
        "HAPP_INSTALLER_TAG=${props.HAPP_INSTALLER_TAG ?: props.IMAGE_TAG ?: ''}",
        "DOORWAY_APP_TAG=${props.DOORWAY_APP_TAG ?: props.IMAGE_TAG ?: ''}",
        "AGENT_SDK_TAG=${props.AGENT_SDK_TAG ?: props.IMAGE_TAG ?: ''}",
        "HAPP_TAG=${props.HAPP_TAG ?: props.IMAGE_TAG ?: ''}",
        "BRANCH_NAME=${props.BRANCH_NAME ?: env.BRANCH_NAME}"
    ]) {
        body()
    }
}

/**
 * Parse VERSION file in key-value format (APP_VERSION=x.x.x, HAPP_VERSION=x.x.x)
 * Returns a map of version keys to values
 */
def parseVersionFile() {
    def versionContent = readFile('VERSION').trim()
    def versionMap = [:]
    versionContent.split('\n').each { line ->
        def parts = line.split('=')
        if (parts.length == 2) {
            versionMap[parts[0].trim()] = parts[1].trim()
        }
    }
    return versionMap
}

/**
 * Get the floating hApp tag published by the DNA pipeline.
 * DNA pushes both a commit-specific tag and a floating tag on every build:
 *   main  → 'latest'
 *   other → 'dev-latest'
 */
def getHappFloatingTag() {
    return (env.BRANCH_NAME == 'main') ? 'latest' : 'dev-latest'
}

/**
 * Fetch hApp artifact from Harbor registry
 * Returns true if hApp was successfully fetched, false otherwise
 */
def fetchHappFromHarbor(String destPath, String version = null) {
    // Use floating tag from DNA pipeline (dev-latest / latest)
    if (!version) {
        version = getHappFloatingTag()
    }

    echo "Fetching hApp from Harbor: harbor.ethosengine.com/ethosengine/elohim-happ:${version}"

    // Install oras CLI if not present
    sh '''
        if ! command -v oras &> /dev/null; then
            echo "Installing oras CLI..."
            curl -sLO https://github.com/oras-project/oras/releases/download/v1.1.0/oras_1.1.0_linux_amd64.tar.gz
            tar -xzf oras_1.1.0_linux_amd64.tar.gz
            chmod +x oras
            mv oras /usr/local/bin/
            rm oras_1.1.0_linux_amd64.tar.gz
        fi
    '''

    def success = false
    withCredentials([usernamePassword(
        credentialsId: 'harbor-robot-registry',
        usernameVariable: 'HARBOR_USER',
        passwordVariable: 'HARBOR_PASS'
    )]) {
        def destDir = sh(script: "dirname '${destPath}'", returnStdout: true).trim()
        def destFile = sh(script: "basename '${destPath}'", returnStdout: true).trim()
        def result = sh(script: """
            oras login harbor.ethosengine.com -u \$HARBOR_USER -p \$HARBOR_PASS
            mkdir -p '${destDir}'
            cd '${destDir}'
            oras pull harbor.ethosengine.com/ethosengine/elohim-happ:${version}
            # Rename if needed (oras downloads as elohim.happ)
            if [ -f elohim.happ ] && [ "elohim.happ" != "${destFile}" ]; then
                mv elohim.happ '${destFile}'
            fi
            ls -la
        """, returnStatus: true)

        if (result == 0 && fileExists(destPath)) {
            echo "✅ hApp fetched from Harbor: ${version}"
            success = true
        }
    }

    if (!success) {
        echo "❌ Failed to fetch hApp from Harbor"
    }
    return success
}

/**
 * Federation-peer public-boundary health (alpha-b / elohim.host), non-blocking.
 * Every post-deploy probe used to point at the PRIMARY only, so a deploy that
 * left the federation peer publicly unhealthy was invisible (the alpha-b APPLY
 * has junit shape in deployDoorwaysWithTestShape, but nothing verified the
 * public boundary). Content-level divergence assertions live in the Dataplane
 * Validation stage (@concern:federation-deploy). Top-level def = own CPS
 * method — the pipeline block sits against the JVM 64KB hard limit.
 */
// Extracted from the deploy script{} block (its own CPS method — that block
// sat at 11,139 B against the 11,000 hard method-size ceiling).
def logAndWriteTopology(String strategy, List allHumans) {
    echo "Resolved topology (${strategy}):"
    allHumans.each { h ->
        echo "  ${h.name} (${h.humanLabel}) -> ${h.env} (${h.namespace}/${h.resourcePrefix})"
    }

    // Write topology.json for downstream pipelines (genesis seeder)
    def topologyJson = groovy.json.JsonOutput.prettyPrint(
        groovy.json.JsonOutput.toJson([
            strategy: strategy,
            generatedAt: new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'"),
            generatedBy: "elohim-edge/${env.BUILD_NUMBER}",
            humans: allHumans.collect { h -> [
                name: h.name,
                role: h.role,
                humanId: h.humanId,
                env: h.env,
                namespace: h.namespace,
                resourcePrefix: h.resourcePrefix,
                storageUrl: "http://${h.resourcePrefix}.${h.namespace}.svc.cluster.local:8090",
                genesisPeer: (h.genesisPeer == true),
            ]}
        ])
    )
    writeFile file: 'genesis/orchestrator/environments/topology.json', text: topologyJson
    echo "Wrote topology.json"
}

def checkFederationPeerPublicHealth(boolean alphaDeployed) {
    if (!alphaDeployed) {
        return
    }
    if (checkEdgeNodeHealth('https://elohim.host')) {
        echo "Federation peer healthy: https://elohim.host/health"
    } else {
        echo "WARNING: federation peer (elohim.host / alpha-b) failed its public /health check — peer may be down or running a stale deploy; see Dataplane Validation"
    }
}

/**
 * Check if edge node is healthy
 */
def checkEdgeNodeHealth(String url) {
    def result = sh(
        script: "curl -sf -o /dev/null -w '%{http_code}' '${url}/health' 2>/dev/null || echo '000'",
        returnStdout: true
    ).trim()
    return result == '200'
}

/**
 * Quality Gate: Storage — CI home for the elohim-storage lib suite (1835
 * tests incl. the CRDT sync/heal proofs). Before this gate the pipeline only
 * BUILT the storage image, so a storage-logic regression rode to prod as long
 * as it compiled (found 2026-07-01, crdt-content-dataplane handoff §3).
 * Mirrors Quality Gate: Doorway — the Dockerfile's `check` target reuses the
 * BuildKit dep cache, no Rust toolchain needed in the CI builder. Non-blocking
 * (unstable) while the gate stabilizes; flip to blocking once green streak
 * established. Top-level def = own CPS method (pipeline block at 64KB limit).
 */
def runStorageQualityGate() {
    try {
        // Stage-local timeout: a runaway gate (cold dep-graph compile, hung
        // test) degrades to UNSTABLE instead of eating the global 120-min
        // budget and aborting the deploy stages behind it.
        timeout(time: 45, unit: 'MINUTES') {
            sh "bash '${env.WORKSPACE}/scripts/ci/storage-quality-gate.sh'"
        }
    } catch (Exception e) {
        echo "Quality Gate: Storage - failures (non-blocking while stabilizing): ${e.message}"
        unstable('Storage quality gate failed')
    }
}

/**
 * Direct feature-matrix gate for the standalone Rust SDK crate. Keep the Bash
 * body out of this file: the pipeline's declarative stages method is already
 * close to the JVM bytecode ceiling.
 */
def runElohimSdkFeatureMatrix() {
    // 30 min: a cold sdk-check image layer compiles the SDK dep graph 8 times
    // over the feature matrix; warm BuildKit layers finish in seconds.
    timeout(time: 30, unit: 'MINUTES') {
        sh "bash '${env.WORKSPACE}/scripts/ci/elohim-sdk-feature-matrix.sh'"
    }
}

/**
 * Whole body of the Build Storage stage. Branching lives HERE, not in the
 * stage's steps block — every element added to the declarative stages model
 * compiles into the one CPS method that sits against the JVM 64KB bytecode
 * ceiling (edge #1134, edge #1351 both died there at compile).
 */
def runStorageStageBody() {
    if (shouldRunStep('sdk-feature-matrix')) {
        runElohimSdkFeatureMatrix()
    }
    if (shouldRunStep('cargo-build-storage')) {
        runStorageQualityGate()
        buildStorageImage()
    }
}

/**
 * Build Storage — script body extracted verbatim from the stage (own CPS
 * method; the pipeline block sits against the JVM 64KB hard limit).
 */
def buildStorageImage() {
    def props = loadBuildVars()

    withBuildVars(props) {
        echo "Building elohim-storage: ${IMAGE_TAG}"
        // Bash body in scripts/ci (Jenkinsfile-size canon: helpers stay
        // heredoc-free); reads IMAGE_TAG/GIT_COMMIT_HASH from withBuildVars env.
        sh "bash '${env.WORKSPACE}/scripts/ci/build-storage-image.sh'"
    }
}

/**
 * hc-mesh-in-CI quiesce measure (minutes-quiesce plan §3 W4.2, task Q9:
 * genesis/docs/superpowers/plans/2026-08-16-minutes-quiesce-fixture-trust-swarm-plan.md).
 *
 * A per-commit, minutes-scale measure of the protocol's convergence machinery
 * on a 3-peer mesh THIS PIPELINE OWNS, in TWO phases with distinct semantics:
 *
 *   PHASE 1 · QUIESCE (bootstrap) — stands the mesh up from the storage/doorway
 *     binaries + elohim.happ already produced earlier in this same run (nothing
 *     is compiled here), seeds the fixture corpus under its declared stakes
 *     grant, authors the landing head, runs the fleet-quiesce gate with a 600s
 *     deadline, prints `MESH-QUIESCE: PASS rate=<n> rows/min`. Because the mesh
 *     is ours, the DID-NOT-MEASURE class cannot exist: a gate that does not
 *     reach sustained PASS FAILS the build — churning IS the regression signal.
 *   PHASE 2 · E2E (runtime validation) — only after phase 1 passes, on the
 *     quiesced substrate: `cucumber-js --profile saga` (26 scenarios), printing
 *     `MESH-E2E: n/26 scenarios`. Its writes are the SUBJECT, so it never
 *     re-asserts global quiesce metrics, and it is UNSTABLE-grade (reports, does
 *     not fail) while the global-quiesce step-debt in the saga steps is open.
 *
 * A container that cannot host conductors prints one loud
 * SKIPPED-NO-CONDUCTOR line instead of measuring.
 *
 * WHY IT IS NOT ITS OWN STAGE: the declarative `stages {}` model is a single
 * CPS method at the JVM 64KB ceiling (edge #1134 died at 4423 units / 20
 * stages; the in-repo size hook HARD-caps this file at 4400 and a new stage
 * costs ~40). So the measure rides at the tail of `Build Edge Node Image` —
 * the first point where the storage image, doorway image AND the Harbor-
 * fetched elohim.happ all exist — via this one-line top-level def, which is
 * its own CPS method. It still lands where it must: after every build,
 * BEFORE `Push to Harbor` and every Deploy stage, with no fleet dependence.
 * Give it its own stage the moment the stage model has headroom again.
 */
def runMeshQuiesceMeasure() {
    // First-landing grade: UNSTABLE, never build-fatal — a new measure stage
    // hard-failing inside Build Edge Node Image would block the edge deploys
    // that ship its own fixes (the cascade-deadlock class, cf. runE2ETests'
    // catchError precedent). Flip to a bare sh call once proven green.
    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
        sh "bash '${env.WORKSPACE}/scripts/ci/run-mesh-quiesce-stage.sh'"
    }
}

/**
 * Run P2P simulation test (advisory — failures don't block pipeline).
 * Requires Docker Compose and the elohim-storage Dockerfile.
 */
def runSimulationTest() {
    dir('steward/node/simulation') {
        sh './simulate.sh test'
    }
}

/**
 * Deploy edge node using environment manifest for per-component tags.
 * Reads tag values from envFile, substitutes named placeholders in the manifest template,
 * validates no placeholders remain, then applies to Kubernetes.
 */
def deployEdgeWithManifest(String env, String namespace, String manifestTemplate, String envFile, String resourceName = 'elohim-edgenode') {
    def versions = readProperties(file: envFile)
    def deployVersion = sh(script: 'git rev-parse HEAD | cut -c1-8', returnStdout: true).trim()
    // Digest-pinned doorway ref (tag@sha256:…) when the push captured one —
    // Harbor retention strips this repo's SHA tags, digests can't be untagged.
    def doorwayRef = ((versions.DOORWAY_DIGEST ?: '') ==~ /sha256:[a-f0-9]{64}/) ? "${versions.DOORWAY_TAG}@${versions.DOORWAY_DIGEST}" : versions.DOORWAY_TAG
    def sedArgs = [
        "s/EDGENODE_TAG_PLACEHOLDER/${versions.EDGENODE_TAG}/g",
        "s/DOORWAY_TAG_PLACEHOLDER/${doorwayRef}/g",
        "s/STORAGE_TAG_PLACEHOLDER/${versions.STORAGE_TAG}/g",
        "s/HAPP_INSTALLER_TAG_PLACEHOLDER/${versions.HAPP_INSTALLER_TAG}/g",
        "s/DOORWAY_APP_TAG_PLACEHOLDER/${versions.DOORWAY_APP_TAG}/g",
        "s/HAPP_TAG_PLACEHOLDER/${versions.HAPP_TAG}/g",
        "s/AGENT_SDK_TAG_PLACEHOLDER/${versions.AGENT_SDK_TAG ?: versions.EDGENODE_TAG}/g",
        "s/DEPLOY_VERSION_PLACEHOLDER/${deployVersion}/g"
    ].collect { "-e '${it}'" }.join(' ')

    def outputFile = manifestTemplate.replace('.yaml', "-${env}.rendered.yaml")
    sh "sed ${sedArgs} ${manifestTemplate} > ${outputFile}"

    // Fail fast if any placeholders remain
    def remaining = sh(script: "grep -c '_PLACEHOLDER' ${outputFile} || true", returnStdout: true).trim()
    if (remaining != '0') {
        error "Unresolved placeholders in ${outputFile}!"
    }

    // Preview what we're deploying
    sh """
        echo '==== Manifest preview: ${resourceName}-${env} ===='
        grep 'image:\\|happ-version:\\|app.kubernetes.io/version:' ${outputFile} | head -5
        echo '==============================='
    """

    // Pre-deploy: check for ingress hostname conflicts
    sh "bash genesis/orchestrator/scripts/check-ingress-conflicts.sh ${outputFile} ${namespace}"

    sh "kubectl apply -f ${outputFile}"
    def resourceType = sh(
        script: "grep -q 'kind: StatefulSet' ${manifestTemplate} && echo 'statefulset' || echo 'deployment'",
        returnStdout: true
    ).trim()
    sh "kubectl rollout restart ${resourceType}/${resourceName}-${env} -n ${namespace}"
    sh "kubectl rollout status ${resourceType}/${resourceName}-${env} -n ${namespace} --timeout=600s"

    // Post-deploy: detect stale resources (advisory only)
    def componentName = resourceName.replace('elohim-', '')
    sh "bash genesis/orchestrator/scripts/detect-stale-resources.sh ${namespace} ${deployVersion} ${componentName} || true"
}

// ============================================================================
// TOPOLOGY-AWARE DEPLOYMENT HELPERS
// ============================================================================

/**
 * Fixed identity attributes for all protocol humans deployed to K8s.
 * Human-intrinsic values that never change regardless of deployment topology.
 *
 * Source of truth: genesis/orchestrator/data/deployments.json. Each record
 * declares a deployment `pattern` (legacy | consolidated), which manifest
 * or template renders it, node affinity, device archetype, and per-human
 * edgenode resource sizing.
 *
 * Adam is the genesis peer and currently the only human on the consolidated
 * elohim-node single-container pattern. The other 5 remain on the legacy
 * 4-container pattern until the conductor 0.0.0.0 binding is verified
 * (see genesis/plans/2026-04-16-elohim-node-consolidation-design.md).
 */
def getHumanRegistry() {
    def data = readJSON(file: 'genesis/orchestrator/data/deployments.json')
    return data.humans
}

/**
 * Resolve deployment strategy to concrete human-environment assignments.
 * Returns list of maps with both identity and topology fields.
 */
def resolveHumanAssignments(String strategy, String customAssignments) {
    // Filter suspended humans from the registry. cleanupOrphanedHumans (later in
    // this file) will scale their StatefulSets to 0 because they no longer
    // appear in allHumans. See genesis/orchestrator/data/deployments.json
    // $suspendedComment for the per-human reason. To re-enable a human,
    // remove "suspended": true from their deployments.json record.
    def registry = getHumanRegistry().findAll { !it.suspended }
    def assignments = [:]

    switch (strategy) {
        case 'alpha-concentration':
            registry.each { h -> assignments[h.name] = 'alpha' }
            break
        case 'distributed':
            // shem decommissioned 2026-05-04: adam, pete, frank suspended at
            // human-level. pete-staging and frank-prod were on intel-nuc
            // (healthy) but are also gated — accepted simplification per plan
            // Q-A (default A2). When shem replacement lands, restoring those
            // entries here is part of the un-suspend workflow.
            def fullDistribution = [adam: 'alpha', matthew: 'alpha', jessica: 'alpha', james: 'alpha', pete: 'staging', frank: 'prod']
            assignments = fullDistribution.findAll { name, _env -> registry.any { it.name == name } }
            break
        case 'custom':
            customAssignments.split(',').each { pair ->
                def parts = pair.trim().split(':')
                if (parts.length == 2) {
                    assignments[parts[0].trim()] = parts[1].trim()
                }
            }
            // Drop assignments for suspended humans even if user provided them.
            assignments = assignments.findAll { name, _env -> registry.any { it.name == name } }
            break
        default:
            error "Unknown deploy strategy: ${strategy}"
    }

    return registry.collect { h ->
        def targetEnv = assignments[h.name]
        if (!targetEnv) error "No environment assigned for human: ${h.name}"
        def namespace = "elohim-${targetEnv}"
        def resourcePrefix = "elohim-${h.name}-${targetEnv}"
        def instance = "${h.name}-${targetEnv}"
        h + [env: targetEnv, namespace: namespace, resourcePrefix: resourcePrefix, instance: instance]
    }
}

/**
 * Per-environment configuration (doorway URLs, manifest paths, env files).
 */
def getEnvConfig() {
    return [
        alpha: [
            // Single-doorway fallback bootstrap/signal — used by deployHumanManifest
            // when an env doesn't declare per-doorway sub-maps. Points at doorway-A
            // (the on-prem doorway) so anything pre-federation keeps the historical
            // behavior; alpha's per-human routing rule overrides this for both
            // family-three and remote personas via doorwayA/doorwayB below.
            bootstrapUrl: 'https://doorway-alpha.elohim.host/bootstrap',
            signalUrl: 'wss://signal.alpha.elohim.host',
            // Per-human primary doorway routing (alpha only — staging/prod still
            // run single-doorway envs and use the fallback pair above). Selection
            // rule lives in deployHumanManifest: humanConfig.nodeTypes containing
            // 'remote' → doorwayB (shem apex, elohim.host); else → doorwayA
            // (on-prem, doorway-alpha.elohim.host). Hostnames MUST match the
            // doorway manifests' ingress declarations (alpha.yaml + alpha-b.yaml)
            // — change in lockstep with those files if either side moves.
            doorwayA: [
                bootstrapUrl: 'https://doorway-alpha.elohim.host/bootstrap',
                signalUrl: 'wss://signal.alpha.elohim.host',
            ],
            doorwayB: [
                bootstrapUrl: 'https://elohim.host/bootstrap',
                signalUrl: 'wss://signal.elohim.host',
            ],
            doorwayManifest: 'genesis/orchestrator/manifests/doorway/alpha.yaml',
            envFile: 'genesis/orchestrator/environments/alpha.env',
            infraManifests: ['genesis/orchestrator/manifests/infra/alpha-mongodb.yaml', 'genesis/orchestrator/manifests/infra/alpha-nats.yaml', 'genesis/orchestrator/manifests/infra/alpha-iroh-connection-ratio-grafana-dashboard.yaml', 'genesis/orchestrator/manifests/infra/alpha-coturn-operations.yaml', 'genesis/orchestrator/manifests/infra/alpha-coturn-shem.yaml'],
            healthUrl: 'https://doorway-alpha.elohim.host',
        ],
        staging: [
            bootstrapUrl: 'https://doorway-staging.elohim.host/bootstrap',
            signalUrl: 'wss://signal.doorway-staging.elohim.host',
            doorwayManifest: 'genesis/orchestrator/manifests/doorway/staging.yaml',
            envFile: 'genesis/orchestrator/environments/staging.env',
            infraManifests: ['genesis/orchestrator/manifests/infra/staging-mongodb.yaml', 'genesis/orchestrator/manifests/infra/staging-nats.yaml'],
            healthUrl: 'https://doorway-staging.elohim.host',
        ],
        prod: [
            bootstrapUrl: 'https://doorway.elohim.host/bootstrap',
            signalUrl: 'wss://signal.doorway.elohim.host',
            doorwayManifest: 'genesis/orchestrator/manifests/doorway/prod.yaml',
            envFile: 'genesis/orchestrator/environments/prod.env',
            infraManifests: [],
            healthUrl: 'https://doorway.elohim.host',
        ],
    ]
}

/**
 * Compute P2P bootstrap nodes for a given human based on current topology.
 * Full mesh within same namespace; 1 bridge peer per other active namespace.
 */
def computeP2PBootstrapNodes(Map currentHuman, List allHumans) {
    def peers = allHumans.findAll { it.name != currentHuman.name }
    def sameNs = peers.findAll { it.namespace == currentHuman.namespace }
    def otherNs = peers.findAll { it.namespace != currentHuman.namespace }

    // Full mesh for same-namespace peers
    def nodes = sameNs.collect { peer ->
        "/dns4/${peer.resourcePrefix}-0.${peer.resourcePrefix}-headless.${peer.namespace}.svc.cluster.local/tcp/9876"
    }

    // One bridge peer per other namespace
    def seenNamespaces = [] as Set
    otherNs.each { peer ->
        if (!seenNamespaces.contains(peer.namespace)) {
            nodes.add("/dns4/${peer.resourcePrefix}-0.${peer.resourcePrefix}-headless.${peer.namespace}.svc.cluster.local/tcp/9876")
            seenNamespaces.add(peer.namespace)
        }
    }

    return nodes.join(',')
}

/**
 * Compute conductor WebSocket URLs for a doorway in a given environment.
 *
 * Both deployment patterns expose the conductor's app WS on containerPort
 * 8445 (mapped from Holochain's 127.0.0.1:4445):
 *   - legacy (edgenode + socat):      socat bridges 0.0.0.0:8445 → 127.0.0.1:4445
 *   - consolidated (elohim-node):     Rust forwarder bridges 0.0.0.0:8445 → 127.0.0.1:4445
 * Headless-service pod-direct DNS bypasses Service port mapping, so we must
 * name the container port directly. Doorway derives the admin URL as
 * app-port minus 1 → :8444, which both patterns also expose.
 */
def computeConductorUrls(String targetEnv, List allHumans) {
    def envHumans = allHumans.findAll { it.env == targetEnv }
    return envHumans.collect { h ->
        "ws://${h.resourcePrefix}-0.${h.resourcePrefix}-headless.elohim-${targetEnv}.svc.cluster.local:8445"
    }.join(',')
}

/**
 * Compute storage HTTP URLs for a doorway in a given environment.
 */
def computeStorageUrls(String targetEnv, List allHumans) {
    def envHumans = allHumans.findAll { it.env == targetEnv }
    return envHumans.collect { h ->
        "http://${h.resourcePrefix}.elohim-${targetEnv}.svc.cluster.local:8090"
    }.join(',')
}

/**
 * Scale orphaned StatefulSets to 0 replicas when topology changes.
 * Preserves PVCs for rollback.
 */
def cleanupOrphanedHumans(List allHumans) {
    def namespaces = ['elohim-alpha', 'elohim-staging', 'elohim-prod']
    def activeResources = allHumans.collect { "${it.namespace}/${it.resourcePrefix}" } as Set
    def undrained = []   // orphans found but NOT scaled to 0 — RBAC drift, must not phantom-green

    namespaces.each { ns ->
        def existing = sh(
            script: "kubectl get statefulset -n ${ns} -l app=elohim-edgenode -o jsonpath='{.items[*].metadata.name}' 2>/dev/null || true",
            returnStdout: true
        ).trim()

        if (existing) {
            existing.split(/\s+/).each { stsName ->
                if (!activeResources.contains("${ns}/${stsName}")) {
                    echo "Scaling orphaned StatefulSet to 0: ${ns}/${stsName}"
                    // Capture the exit status instead of masking with `|| true`. A Forbidden here
                    // (jenkins-deployer missing statefulsets/scale) previously phantom-greened the
                    // deploy while suspended personas kept running and churned the DHT. Non-blocking
                    // by design: surface as UNSTABLE, do NOT hard-fail — a hard-fail must wait until
                    // the RBAC grant lands, else every edge deploy breaks while any persona is
                    // suspended. See genesis/data/timeline/backlog/ci-rbac-jenkins-deployer.md (recurrence 4).
                    def rc = sh(script: "kubectl scale statefulset/${stsName} -n ${ns} --replicas=0", returnStatus: true)
                    if (rc != 0) { undrained << "${ns}/${stsName}" }
                }
            }
        }
    }

    if (undrained) {
        echo "⚠️  RBAC DRIFT: could not scale ${undrained.size()} orphaned StatefulSet(s) to 0: ${undrained.join(', ')}. " +
             "Cause: jenkins-deployer lacks statefulsets/scale patch. These suspended personas keep running " +
             "on a stale image and churn the DHT. Operator: grant statefulsets/scale, then drop this guard; " +
             "interim manual: kubectl scale statefulset/<name> -n <ns> --replicas=0. " +
             "Tracking: genesis/data/timeline/backlog/ci-rbac-jenkins-deployer.md"
        unstable("RBAC drift: ${undrained.size()} orphaned StatefulSet(s) not scaled to 0 (jenkins-deployer missing statefulsets/scale)")
    }
}

/**
 * Deploy all humans in parallel. Each branch runs deployHumanManifest
 * (apply + rollout restart + `kubectl rollout status --timeout=600s`).
 *
 * Sequential deploy of N humans = N × ~10min worst case (rollout-status
 * wait dominates on cold-start statefulsets). Parallel collapses to the
 * slowest single human. This was the dominant factor in the 60min edge
 * pipeline timeout that aborted #958, #962, #964.
 *
 * Each per-peer rollout is treated as a test case (not a build step). A
 * partial cluster-side failure (one peer's StatefulSet doesn't reach Ready
 * within the rollout-status timeout, or kubectl apply fails on an immutable
 * field, etc.) marks the parent stage UNSTABLE instead of FAILURE — so the
 * orchestrator can settle UNSTABLE-or-better and downstream pipelines see
 * the actual per-peer truth rather than a blank-cascade. junit XML is
 * emitted (one testcase per peer) so Jenkins surfaces partial failures in
 * the test report tab. Rationale: a single peer's resource floor being too
 * tight (e.g. the 2026-05-22 james OOM that drove edge #983–#985 FAILURE
 * even though 14/15 peers were healthy) is a per-peer test failure, not a
 * pipeline-broken-shape problem.
 *
 * Localizes humanConfig per closure to avoid Groovy's capture-by-reference
 * trap in loops.
 */
def deployHumansInParallel(List humans, String envFile, List allHumans) {
    if (!humans) {
        echo "deployHumansInParallel: no humans to deploy — skipping"
        return
    }
    // Synchronized map: parallel branches each write their own key, no
    // collisions, but the wrapper guarantees memory visibility on read.
    def outcomes = java.util.Collections.synchronizedMap([:])
    def branches = [:]
    humans.each { humanConfig ->
        def hc = humanConfig
        branches["deploy-${hc.resourcePrefix}"] = {
            catchError(
                buildResult: 'UNSTABLE',
                stageResult: 'UNSTABLE',
                message: "deploy ${hc.resourcePrefix}: rollout failed — see junit testcase (kubectl describe pod -n ${hc.namespace} -l app.kubernetes.io/name=${hc.resourcePrefix} for cluster-side reason)",
            ) {
                deployHumanManifest(hc, envFile, allHumans)
                // Only reached on clean return — catchError swallows
                // exceptions before this line on any failure path.
                outcomes[hc.resourcePrefix] = true
            }
        }
    }
    parallel(branches)
    emitDeployJunit((humans[0]?.env ?: 'unknown'), humans, outcomes)
}

/**
 * Emit a junit-style XML report for the parallel per-peer deploy. One
 * testcase per peer, classname = `elohim-edge.deploy.<env>`. Archived as
 * a build artifact and registered via `junit` so Jenkins' test-report tab
 * surfaces partial failures (and the `getTestResults` MCP / API can read
 * per-peer outcomes without scraping logs).
 *
 * outcomes[resourcePrefix] == true iff the peer's rollout returned cleanly
 * inside the catchError block. Absent or non-true = failed.
 */
def emitDeployJunit(String envName, List humans, Map outcomes) {
    def cases = humans.collect { hc ->
        [
            name: hc.resourcePrefix,
            archetype: (hc.deviceArchetype ?: 'unknown'),
            passed: outcomes[hc.resourcePrefix] == true,
        ]
    }
    def passed = cases.count { it.passed }
    def failed = cases.size() - passed

    def lines = cases.collect { c ->
        def attrs = "classname=\"elohim-edge.deploy.${envName}\" name=\"${c.name}\" time=\"0\""
        if (c.passed) {
            "  <testcase ${attrs}/>"
        } else {
            def msg = "StatefulSet ${c.name} (archetype=${c.archetype}) did not reach Ready within rollout-status timeout, or kubectl apply failed. See build log for the specific kubectl error; run `kubectl describe pod -l app.kubernetes.io/name=${c.name}` against the alpha cluster for the pod-level reason (OOMKilled, CrashLoopBackOff, ImagePullBackOff, PVC pending, etc.)."
            // Minimal XML escape for the attribute value.
            msg = msg.replace('&', '&amp;').replace('<', '&lt;').replace('"', '&quot;')
            "  <testcase ${attrs}><failure message=\"${msg}\" type=\"rollout-failed\"/></testcase>"
        }
    }
    def xml = [
        '<?xml version="1.0" encoding="UTF-8"?>',
        "<testsuite name=\"elohim-edge.deploy.${envName}\" tests=\"${cases.size()}\" failures=\"${failed}\">",
        lines.join('\n'),
        '</testsuite>',
    ].join('\n')

    def reportFile = "deploy-${envName}-junit.xml"
    writeFile(file: reportFile, text: xml)
    archiveArtifacts(artifacts: reportFile, allowEmptyArchive: true)
    junit(testResults: reportFile, allowEmptyResults: true)
    echo "Edge deploy result for ${envName}: ${passed}/${cases.size()} peers Ready"
    if (failed > 0) {
        def failedNames = cases.findAll { !it.passed }.collect { it.name }.join(', ')
        echo "Edge deploy partial failure: ${failed}/${cases.size()} peers did not reach Ready — ${failedNames}. Stage marked UNSTABLE (test-result shape); downstream pipelines proceed."
    }
}

/**
 * Resolve the floating hApp tag to its immutable content digest from Harbor.
 *
 * HAPP_TAG is mutable: a DNA-pipeline rebuild moves dev-latest/latest to new
 * hApp bytes with NO edge commit. Stamping the resolved digest into the pod
 * template makes that move surface as a StatefulSet spec change ("configured"),
 * so the genesis-peer surge guard's rollout-restart skip stays correct (a
 * byte-identical STS on a real DNA move would skip the restart on the bootstrap
 * pair → DNA-hash divergence → DHT partition).
 *
 * Bash body lives in genesis/orchestrator/scripts/resolve-happ-digest.sh —
 * Jenkinsfile helpers stay heredoc-free (this pipeline sits near the 64KB CPS
 * method-size limit). Reuses the harbor-robot-registry credential the hApp fetch
 * path already uses.
 *
 * FAIL SAFE: on any resolution failure (registry unreachable, tag missing)
 * returns a unique build-specific marker so the rendered STS still changes and
 * the restart proceeds — never returns empty or a stale value (either would
 * silently reopen the skew hole). `|| true` keeps a resolution failure from
 * aborting the deploy; the fallback path handles it loudly instead.
 */
def resolveHappDigest(String happTag, String deployVersion) {
    def digest = ''
    withCredentials([usernamePassword(
        credentialsId: 'harbor-robot-registry',
        usernameVariable: 'HARBOR_USER',
        passwordVariable: 'HARBOR_PASS',
    )]) {
        digest = sh(
            script: "bash '${env.WORKSPACE}/genesis/orchestrator/scripts/resolve-happ-digest.sh' '${happTag}' || true",
            returnStdout: true,
        ).trim()
    }
    if (digest ==~ /sha256:[a-f0-9]{64}/) {
        echo "Resolved hApp digest for tag '${happTag}': ${digest}"
        return digest
    }
    def fallback = "unresolved-${deployVersion}-${System.currentTimeMillis()}"
    echo "WARNING: could not resolve hApp digest for tag '${happTag}' — FAILING SAFE with unique marker '${fallback}'. The StatefulSet pod-template will read 'configured', so the genesis-peer rollout restart proceeds (surge guard intentionally bypassed this deploy). Investigate Harbor reachability / tag existence; a persistent failure means the genesis pair restarts on every deploy."
    return fallback
}

/**
 * Wave 2 relay-sovereignty (D2): the iroh-generation relay is a per-doorway
 * concern, exactly like signalUrl — so it's keyed off the SAME signalUrl
 * deployHumanManifest already resolved from primaryDoorway. Inert under tx5
 * today (relay_url isn't read until the transport-iroh flip). Explicit
 * mapping, never a silent default (D1): an unrecognized signalUrl means a
 * topology this mapping doesn't know about, and must abort the render rather
 * than guess a relay host.
 */
def resolveRelayUrl(String signalUrl, String humanName, String humanEnv) {
    switch (signalUrl) {
        case 'wss://signal.alpha.elohim.host':
            return 'https://relay.alpha.elohim.host'
        case 'wss://signal.elohim.host':
            return 'https://relay.elohim.host'
        default:
            error "No relay_url mapping for signalUrl '${signalUrl}' (human: ${humanName}, env: ${humanEnv}) — add a case to resolveRelayUrl before deploying this topology."
    }
}

// Wave-2 Stage 1 is an alpha-namespace-atomic transport flip. The iroh
// conductor is embedded in this storage image; staging/prod keep their
// environment storage tags as the rollback wave.
//
// PER-COMMIT since 2026-08-07 (edge #1319 RCA). alpha used to return the
// one-time artifact `elohim-storage-iroh:hc-elohim-0.6.3-iroh`, built once on
// 2026-08-06 by the che-devworkspaces edgenode job. A static tag never moves:
// pods restarted on every deploy and re-pulled the same frozen digest, so every
// storage-side merge to dev after the flip was silently inert on alpha (the
// honesty-floor gauge elohim_projection_reconcile_converged_blocked_by could not
// appear, and the fail-closed quiesce gate read actionable=None → DID NOT
// MEASURE). alpha now tracks dev on the iroh lane, built per commit by
// scripts/ci/push-storage-iroh.sh from storage-iroh/Dockerfile.
//
// The frozen tag is NOT retired: it stays in Harbor as the ratified rollback
// line for the wave (design doc 2026-08-05-wave2-relay-sovereignty-design.md D9,
// checklist item 8) and nothing in this pipeline writes it. Rollback is still a
// single image-tag repoint.
//
// Namespace-atomicity (D10) is unchanged: this is keyed on env, not on the
// human, so all 7 alpha humans resolve to the same image and a partial flip —
// which would transport-partition the DHT, tx5 peers being unable to dial an
// iroh peer URL and vice-versa — stays unexpressible.
def resolveStorageImage(String humanEnv, versions) {
    if (humanEnv == 'alpha') {
        return "harbor.ethosengine.com/ethosengine/elohim-storage-iroh:${versions.STORAGE_TAG}"
    }
    return "harbor.ethosengine.com/ethosengine/elohim-storage:${versions.STORAGE_TAG}"
}

/**
 * The shared non-prod-true rendering for operator/seed lever gates
 * (DNA reinstall, shard-manifest seed, adopt-before-author, network-stakes
 * seed). Its own CPS method keeps deployHumanManifest under the method-size
 * ceiling.
 */
def nonProdTrueGate(String env) {
    return (env == 'prod') ? 'false' : 'true'
}

/**
 * Deploy a human manifest with topology-aware placeholder substitution.
 * Uses | as sed delimiter because URLs contain /.
 */
def deployHumanManifest(Map humanConfig, String envFile, List allHumans) {
    def versions = readProperties(file: envFile)
    def deployVersion = sh(script: 'git rev-parse HEAD | cut -c1-8', returnStdout: true).trim()
    def storageImage = resolveStorageImage(humanConfig.env, versions)
    // Resolve the floating hApp tag to its content digest so a DNA-pipeline tag
    // move (new hApp bytes, no edge commit) surfaces as an STS spec change and
    // the genesis-peer surge guard lets the rollout restart proceed. FAIL SAFE
    // by construction — see resolveHappDigest.
    def happDigest = resolveHappDigest(versions.HAPP_TAG, deployVersion)
    def envConfig = getEnvConfig()[humanConfig.env]
    def p2pNodes = computeP2PBootstrapNodes(humanConfig, allHumans)

    // Pick source manifest. Adam is the historical consolidated reference
    // with a hand-crafted manifest (`manifest:` field, no placeholders since
    // it's already fully rendered). All other humans — legacy pattern AND
    // newly-migrated consolidated humans — use a shared template with
    // per-human placeholders (`template:` field), rendered via the sed
    // pipeline below. Prefer `manifest:` when present (Adam's path), fall
    // back to `template:` for everyone else regardless of pattern.
    def sourceFile = humanConfig.manifest ?: humanConfig.template
    if (!sourceFile) {
        error "Human ${humanConfig.name}: neither 'manifest' nor 'template' resolved (pattern=${humanConfig.pattern})"
    }

    // Render nodeTypes list as an inline YAML flow-style sequence.
    // Produces: ["performance"] or ["operations", "edge"].
    def nodeTypeValues = '[' + (humanConfig.nodeTypes ?: []).collect { "\"${it}\"" }.join(', ') + ']'

    // Strip the `device-` prefix from the deployments.json archetype to match the
    // DEVICE_ARCHETYPE env-var form Adam's hand-rendered manifest uses
    // (e.g. `device-family-node-base` → `family-node-base`).
    def deviceArchetype = (humanConfig.deviceArchetype ?: '').replaceFirst(/^device-/, '')

    // Household identifier — one per human by convention (`household-<name>`).
    // Matches Adam's hand-rendered value (`household-adam`).
    def householdId = "household-${humanConfig.name}"

    // Node role: Adam is the genesis peer / archival anchor; everyone else
    // runs as `edge`. Kept explicit-by-name because the topology is small and
    // the mapping is load-bearing (P2P bootstrap vs. leaf). Revisit when a
    // second archival peer joins.
    def nodeRole = humanConfig.name == 'adam' ? 'archival' : 'edge'

    // Region is uniform across the cluster today. Hardcoded until a human
    // deploys outside us-central — at that point, move to deployments.json.
    def region = 'us-central'

    // One non-prod-true gate value feeds the four operator/seed levers:
    // DNA-content drift auto-reinstall (happ_manager; prod DNA upgrades go
    // through migration/lineage, never a blind reinstall that mints a new
    // agent identity), the /admin/seed/shard-manifest lever, the
    // adopt-before-author canonical-head exit, and the declared
    // network-stakes seed lever (corpus trustBootstrap grants ->
    // ManifestStakesResolver adoption-ceremony pricing; the endpoint
    // additionally refuses simulacra outside environment=preproduction).
    // Per-lever rationale lives in the template's inline comments.
    def nonProdGate = nonProdTrueGate(humanConfig.env)

    // Per-human primary doorway selection. When the env declares doorwayA +
    // doorwayB sub-maps (alpha today), route based on nodeTypes containing
    // 'remote': shem-side personas → doorwayB (elohim.host / signal.elohim.host),
    // on-prem family-three → doorwayA (doorway-alpha.elohim.host /
    // signal.alpha.elohim.host). Single-doorway envs (staging, prod)
    // fall back to envConfig.bootstrapUrl/signalUrl. This is the single-primary
    // shape — multi-registration / DNS failover deferred pending the federation
    // audit (see genesis/docs/superpowers/sprints/2026-05-27-federation-wiring-audit.md
    // and memory project_multi_doorway_human_registration). The genesis pair
    // (matthew on-prem, adam shem) end up co-located with their respective
    // doorway, which removes the cross-WireGuard signaling hop the previous
    // single-doorway-for-everyone shape forced.
    def isRemote = (humanConfig.nodeTypes ?: []).contains('remote')
    def primaryDoorway
    if (envConfig.doorwayA && envConfig.doorwayB) {
        primaryDoorway = isRemote ? envConfig.doorwayB : envConfig.doorwayA
    } else {
        primaryDoorway = [bootstrapUrl: envConfig.bootstrapUrl, signalUrl: envConfig.signalUrl]
    }

    // shem's GFiber router hairpin-intercepts hairpinned 443 for the apex
    // hostnames (elohim.host, signal.elohim.host) back to its own WAN IP —
    // the router answers with its self-signed web UI cert
    // (ssl_verify_result=18) instead of proxying through. Route shem-placed
    // conductors straight to shem's own ingress+coturn node (10.99.0.2)
    // instead of out through the WAN and back. Scoped to exactly the humans
    // whose primaryDoorway IS doorwayB (i.e. bootstrap_url/signal_url render
    // to the hairpinned apex hostnames) — never matthew/jessica/james
    // (doorwayA) and never staging/prod (no doorwayB split there, and
    // 10.99.0.2 is shem's alpha-specific IP). See
    // genesis/data/timeline/backlog/shem-conductors-signal-hairpin-suspect-dht-silent.md.
    def hostAliases = (envConfig.doorwayA && envConfig.doorwayB && isRemote)
        ? '[{ip: "10.99.0.2", hostnames: ["elohim.host", "signal.elohim.host", "relay.elohim.host"]}]'
        : '[]'
    // relay.elohim.host added 2026-08-09: Wave 2 homed shem conductors to the
    // doorway-B iroh relay on the hairpinned apex, but the alias list predates
    // the relay — so shem endpoints could never reach their HOME relay and
    // kitsune2 failed 100% of initiations with "Connection attempted before
    // home relay URL is known" (backlog susan-kitsune2-gossip-never-attempts
    // §residual; same ingress 10.99.0.2 serves the relay host — verified
    // manifests/doorway/alpha-b.yaml Ingress host list).

    // Relay URL (Wave 2 relay-sovereignty, D2) — keyed off signalUrl; see
    // resolveRelayUrl's doc comment for the fail-loud rationale.
    def relayUrl = resolveRelayUrl(primaryDoorway.signalUrl, humanConfig.name, humanConfig.env)

    // Doorway ORIGIN (scheme + host, no path) for the storage-side iroh bootstrap:
    // elohim-storage's transport-manifest announcer POSTs to, and its joiner reads,
    // `${ELOHIM_DOORWAY_URL}/p2p/manifests`. Without this env every fleet storage has
    // doorway_base_url() == None and never announces — measured 2026-08-30: with the
    // board open, its only entry was an outside workspace peer's. Derived from the
    // bootstrap URL so the two can never name different doorways (inlined below in
    // the sed list: `bootstrapUrl - '/bootstrap'` — this method sits at the CPS
    // size ceiling, so no extra def).

    // Digest-pinned doorway ref — see deployEdgeWithManifest note.
    def doorwayRef = ((versions.DOORWAY_DIGEST ?: '') ==~ /sha256:[a-f0-9]{64}/) ? "${versions.DOORWAY_TAG}@${versions.DOORWAY_DIGEST}" : versions.DOORWAY_TAG
    def sedArgs = [
        // Image tag placeholders
        "s|EDGENODE_TAG_PLACEHOLDER|${versions.EDGENODE_TAG}|g",
        "s|DOORWAY_TAG_PLACEHOLDER|${doorwayRef}|g",
        "s|STORAGE_IMAGE_PLACEHOLDER|${storageImage}|g",
        "s|HAPP_INSTALLER_TAG_PLACEHOLDER|${versions.HAPP_INSTALLER_TAG}|g",
        "s|DOORWAY_APP_TAG_PLACEHOLDER|${versions.DOORWAY_APP_TAG}|g",
        "s|HAPP_TAG_PLACEHOLDER|${versions.HAPP_TAG}|g",
        // Resolved hApp content digest — stamped into the pod-template annotation
        // so a floating-tag move (new DNA bytes, no edge commit) changes the STS
        // spec and the genesis-peer restart-skip stays correct. Digest contains
        // no `|`, so it's safe with the sed `|` delimiter.
        "s|HAPP_DIGEST_PLACEHOLDER|${happDigest}|g",
        "s|AGENT_SDK_TAG_PLACEHOLDER|${versions.AGENT_SDK_TAG ?: versions.EDGENODE_TAG}|g",
        "s|DEPLOY_VERSION_PLACEHOLDER|${deployVersion}|g",
        // Topology placeholders
        "s|NAMESPACE_PLACEHOLDER|${humanConfig.namespace}|g",
        "s|ENV_PLACEHOLDER|${humanConfig.env}|g",
        "s|ALLOW_DNA_REINSTALL_PLACEHOLDER|${nonProdGate}|g",
        "s|ALLOW_SEED_SHARD_MANIFEST_PLACEHOLDER|${nonProdGate}|g",
        "s|ALLOW_SEED_NETWORK_STAKES_PLACEHOLDER|${nonProdGate}|g",
        "s|ALLOW_SEED_DELEGATES_COMPUTE_PLACEHOLDER|${nonProdGate}|g",
        "s|ADOPT_BEFORE_AUTHOR_PLACEHOLDER|${nonProdGate}|g",
        "s|RESOURCE_PREFIX_PLACEHOLDER|${humanConfig.resourcePrefix}|g",
        "s|INSTANCE_PLACEHOLDER|${humanConfig.instance}|g",
        "s|BOOTSTRAP_URL_PLACEHOLDER|${primaryDoorway.bootstrapUrl}|g",
        "s|SIGNAL_URL_PLACEHOLDER|${primaryDoorway.signalUrl}|g",
        "s|RELAY_URL_PLACEHOLDER|${relayUrl}|g",
        "s|DOORWAY_ORIGIN_PLACEHOLDER|${primaryDoorway.bootstrapUrl - '/bootstrap'}|g",
        "s|HOST_ALIASES_PLACEHOLDER|${hostAliases}|g",
        "s|P2P_BOOTSTRAP_NODES_PLACEHOLDER|${p2pNodes}|g",
        // Node-local storage class — P2P dataplane owns replication, not k8s.
        "s|STORAGE_CLASS_PLACEHOLDER|openebs-hostpath|g",
        // Per-human placeholders (no-ops on the consolidated manifest, which
        // has these values hand-coded for Adam).
        "s|HUMAN_LABEL_PLACEHOLDER|${humanConfig.humanLabel}|g",
        "s|HUMAN_ID_PLACEHOLDER|${humanConfig.humanId}|g",
        "s|NODE_TYPE_VALUES_PLACEHOLDER|${nodeTypeValues}|g",
        "s|AFFINITY_COMMENT_PLACEHOLDER|${humanConfig.affinityComment ?: ''}|g",
        "s|EDGENODE_MEMORY_REQUEST_PLACEHOLDER|${humanConfig.edgenodeMemoryRequest ?: ''}|g",
        "s|EDGENODE_MEMORY_LIMIT_PLACEHOLDER|${humanConfig.edgenodeMemoryLimit ?: ''}|g",
        "s|EDGENODE_CPU_REQUEST_PLACEHOLDER|${humanConfig.edgenodeCpuRequest ?: ''}|g",
        "s|EDGENODE_CPU_LIMIT_PLACEHOLDER|${humanConfig.edgenodeCpuLimit ?: ''}|g",
        // SQLite pool size (consolidated template only). Defaults to '10' (the
        // code default) so an unset node never leaves an unresolved placeholder.
        "s|STORAGE_DB_POOL_SIZE_PLACEHOLDER|${humanConfig.edgenodeDbPoolSize ?: '10'}|g",
        // k2Gossip round-timeout / accepted-rounds (consolidated template only).
        // Defaults 60000/4 preserve the household slow-WAN profile baked into
        // the template for every human that doesn't override — an unset node
        // renders byte-identically to before this placeholder existed. Per
        // adam-firstman.yaml's ARC-CONVERGENCE comment, that profile is wrong
        // for multi-tenant shem conductors; deployments.json overrides
        // gertrude/susan/eve to adam's proven 15000/10 (2026-08-09: zero
        // storage-arc-to-full events in 24h at 60000/4 vs 23-24 on household
        // pods).
        "s|K2_ROUND_TIMEOUT_PLACEHOLDER|${humanConfig.k2GossipRoundTimeoutMs ?: '60000'}|g",
        "s|K2_MAX_ACCEPTED_ROUNDS_PLACEHOLDER|${humanConfig.k2GossipMaxAcceptedRounds ?: '4'}|g",
        // Authority arc factor (consolidated template only). Default '1' (full arc =
        // kitsune2 default) so an unset node never leaves an unresolved placeholder;
        // '0' = leecher (deploy-time arc-shrink for a non-anchor OOMing on the full arc).
        "s|TARGET_ARC_FACTOR_PLACEHOLDER|${humanConfig.edgenodeArcFactor ?: '1'}|g",
        // Consolidated-template env-var placeholders (no-ops on the legacy
        // template and on Adam's hand-rendered manifest, which either omit
        // these tokens entirely or pre-bake their values).
        "s|DEVICE_ARCHETYPE_PLACEHOLDER|${deviceArchetype}|g",
        "s|HOUSEHOLD_ID_PLACEHOLDER|${householdId}|g",
        "s|NODE_ROLE_PLACEHOLDER|${nodeRole}|g",
        "s|REGION_PLACEHOLDER|${region}|g",
    ].collect {
        // Each sed expression is wrapped in single quotes for the shell, so any
        // apostrophe inside the expression (e.g. "Matthew's role" in an affinity
        // comment) closes the shell string prematurely. Escape `'` → `'\''`
        // (close, escape, reopen) to embed it safely inside single quotes.
        "-e '${it.replace("'", "'\\''")}'"
    }.join(' ')

    // Output path uses resourcePrefix so multiple humans sharing a template
    // don't collide on a single rendered file.
    def outputFile = "genesis/orchestrator/manifests/humans/${humanConfig.resourcePrefix}-rendered.yaml"
    sh "sed ${sedArgs} ${sourceFile} > ${outputFile}"

    // Fail fast if any placeholders remain
    def remaining = sh(script: "grep -c '_PLACEHOLDER' ${outputFile} || true", returnStdout: true).trim()
    if (remaining != '0') {
        sh "grep '_PLACEHOLDER' ${outputFile} || true"
        error "Unresolved placeholders in ${outputFile}!"
    }

    sh """
        echo '==== Manifest preview: ${humanConfig.resourcePrefix} ===='
        grep 'image:\\|happ-version:\\|app.kubernetes.io/version:\\|namespace:\\|P2P_BOOTSTRAP' ${outputFile} | head -8
        echo '==============================='
    """

    sh "bash genesis/orchestrator/scripts/check-ingress-conflicts.sh ${outputFile} ${humanConfig.namespace}"

    // Seam-smoke gate: the conductor's webrtc_config must parse into tx5's
    // camelCase contract with real ICE servers — catches the dead-key class
    // (ice_servers ran the fleet with ZERO ICE servers until 2026-07-11).
    // Alpha renders the transport-iroh image above, so its render gate must
    // enforce the self-hosted relay contract. Other environments remain on
    // tx5 and keep the validator's default ICE checks only.
    sh "IROH_TARGET=${humanConfig.env == 'alpha' ? '1' : '0'} bash scripts/ci/validate-conductor-config.sh ${outputFile}"

    def resetHumans = (params.RESET_HUMANS ?: false) == true
    if (resetHumans) {
        echo "RESET_HUMANS: deleting StatefulSet ${humanConfig.resourcePrefix} before reapply"
        sh "kubectl delete statefulset/${humanConfig.resourcePrefix} -n ${humanConfig.namespace} --ignore-not-found=true"
    }

    // Apply with forbidden-field drift fallback. StatefulSet spec fields like
    // volumeClaimTemplates, selector, serviceName, and podManagementPolicy are
    // immutable after creation. When a template change touches one, kubectl apply
    // returns a 'Forbidden: updates to statefulset spec' error. We orphan-delete
    // the StatefulSet (pods + PVCs remain — the manifest sets
    // persistentVolumeClaimRetentionPolicy: Retain) and reapply, which re-adopts
    // the existing pods and PVCs under the new spec. No data loss.
    def applyLog = "/tmp/kubectl-apply-${humanConfig.resourcePrefix}.log"
    def applyCode = sh(
        script: "kubectl apply -f ${outputFile} > ${applyLog} 2>&1",
        returnStatus: true,
    )
    sh "cat ${applyLog}"
    if (applyCode != 0) {
        // Read the log via `sh returnStdout` (agent side) rather than
        // readFile (master side) — the log lives in /tmp on the agent and
        // Jenkins master's readFile can't see it, which trips
        // NoSuchFileException. This path is only exercised when kubectl
        // apply fails (usually Forbidden-field drift on StatefulSet spec
        // changes — the case we're trying to handle).
        def applyOutput = sh(
            script: "cat ${applyLog}",
            returnStdout: true,
        ).trim()
        if (applyOutput.contains('Forbidden: updates to statefulset spec')) {
            echo "Forbidden-field drift detected — orphan-deleting StatefulSet ${humanConfig.resourcePrefix} (pods + PVCs retained) and reapplying"
            sh "kubectl delete statefulset/${humanConfig.resourcePrefix} -n ${humanConfig.namespace} --cascade=orphan --ignore-not-found=true"
            sh "kubectl apply -f ${outputFile}"
        } else {
            error "kubectl apply failed for ${humanConfig.resourcePrefix}:\n${applyOutput}"
        }
    }
    // Genesis-peer surge guard. The genesis pair (adam+matthew, genesisPeer:true)
    // anchor the DHT's full authority arc; a rollout restart of a full-arc anchor
    // triggers a re-gossip / re-validation surge across the whole corpus — the
    // sustained conductor read-pool saturation class
    // (adam-genesis-anchor-sustained-saturation-post-storm). Every real-change
    // channel now moves the STS spec: container image tags are per-commit
    // (dev-<branch>-<gitHash>), AND the mutable floating hApp tag is resolved to
    // its content digest and stamped into the pod-template `elohim.host/happ-digest`
    // annotation at render time (resolveHappDigest). So a REAL storage/DNA change
    // — including a DNA-pipeline hApp rebuild that moves dev-latest/latest with NO
    // edge commit — makes `kubectl apply` report the StatefulSet "configured" (or
    // takes the delete+reapply path), and the restart below still proceeds. That
    // closes the earlier hole where a floating-tag move rendered a byte-identical
    // STS ("unchanged"), skipping the genesis-pair restart while non-genesis peers
    // pulled the new DNA → DNA-hash divergence on the bootstrap pair → DHT
    // partition. Only a genuinely no-op deploy (doorway-only, no image/DNA change)
    // now reports UNCHANGED, and for that the explicit restart is a gratuitous
    // bounce; skip it for genesis peers so we don't induce the surge. Non-genesis
    // (reduced-arc) peers always restart — surge is cheap.
    // (Shell grep, not Groovy =~, to avoid the CPS Matcher-serialization gotcha.)
    def ssUnchanged = false
    if (applyCode == 0) {
        def grepCode = sh(
            script: "grep -Eq 'statefulset\\.apps/${humanConfig.resourcePrefix}[[:space:]]+unchanged' ${applyLog}",
            returnStatus: true,
        )
        ssUnchanged = (grepCode == 0)
    }
    if (humanConfig.genesisPeer == true && ssUnchanged) {
        echo "Skipping conductor rollout restart for genesis peer ${humanConfig.resourcePrefix}: StatefulSet unchanged (no image/config change) — avoiding a gratuitous full-arc re-gossip surge."
    } else {
        sh "kubectl rollout restart statefulset/${humanConfig.resourcePrefix} -n ${humanConfig.namespace}"
    }
    sh "kubectl rollout status statefulset/${humanConfig.resourcePrefix} -n ${humanConfig.namespace} --timeout=600s"

    def componentName = humanConfig.resourcePrefix.replace('elohim-', '')
    sh "bash genesis/orchestrator/scripts/detect-stale-resources.sh ${humanConfig.namespace} ${deployVersion} ${componentName} || true"
}

/**
 * Deploy doorway manifest with topology-computed conductor/storage URLs.
 * Includes explicit rollout restart for doorway to pick up new env vars.
 * Optional manifestOverride and deploymentName for read replicas.
 */
def deployDoorwayManifest(String targetEnv, String envFile, List allHumans, String manifestOverride = null, String deploymentName = null) {
    def envConfig = getEnvConfig()[targetEnv]
    def manifest = manifestOverride ?: envConfig.doorwayManifest
    def depName = deploymentName ?: "elohim-doorway-${targetEnv}"
    def conductorUrls = computeConductorUrls(targetEnv, allHumans)
    def storageUrls = computeStorageUrls(targetEnv, allHumans)
    def versions = readProperties(file: envFile)
    def deployVersion = sh(script: 'git rev-parse HEAD | cut -c1-8', returnStdout: true).trim()

    // Digest-pinned doorway ref — see deployEdgeWithManifest note.
    def doorwayRef = ((versions.DOORWAY_DIGEST ?: '') ==~ /sha256:[a-f0-9]{64}/) ? "${versions.DOORWAY_TAG}@${versions.DOORWAY_DIGEST}" : versions.DOORWAY_TAG
    def sedArgs = [
        "s|EDGENODE_TAG_PLACEHOLDER|${versions.EDGENODE_TAG}|g",
        "s|DOORWAY_TAG_PLACEHOLDER|${doorwayRef}|g",
        "s|STORAGE_TAG_PLACEHOLDER|${versions.STORAGE_TAG}|g",
        "s|HAPP_INSTALLER_TAG_PLACEHOLDER|${versions.HAPP_INSTALLER_TAG}|g",
        "s|DOORWAY_APP_TAG_PLACEHOLDER|${versions.DOORWAY_APP_TAG}|g",
        "s|HAPP_TAG_PLACEHOLDER|${versions.HAPP_TAG}|g",
        "s|AGENT_SDK_TAG_PLACEHOLDER|${versions.AGENT_SDK_TAG ?: versions.EDGENODE_TAG}|g",
        "s|DEPLOY_VERSION_PLACEHOLDER|${deployVersion}|g",
        "s|CONDUCTOR_URLS_PLACEHOLDER|${conductorUrls}|g",
        "s|STORAGE_URLS_PLACEHOLDER|${storageUrls}|g",
    ].collect { "-e '${it}'" }.join(' ')

    def outputFile = manifest.replace('.yaml', "-rendered.yaml")
    sh "sed ${sedArgs} ${manifest} > ${outputFile}"

    def remaining = sh(script: "grep -c '_PLACEHOLDER' ${outputFile} || true", returnStdout: true).trim()
    if (remaining != '0') {
        sh "grep '_PLACEHOLDER' ${outputFile} || true"
        error "Unresolved placeholders in ${outputFile}!"
    }

    sh """
        echo '==== Doorway preview: ${depName} ===='
        grep 'image:\\|CONDUCTOR_URLS\\|STORAGE_URLS\\|app.kubernetes.io/version:' ${outputFile} | head -6
        echo '==============================='
    """

    sh "bash genesis/orchestrator/scripts/check-ingress-conflicts.sh ${outputFile} elohim-${targetEnv}"
    // Tolerates ONLY the known podmonitors RBAC drift (loudly) so the rollout wait
    // below still runs — a poisoned apply exit hid a real doorway-B outage in
    // edge #1306/#1308/#1309. Everything else still fails the deploy.
    sh "bash '${env.WORKSPACE}/scripts/ci/apply-doorway-manifest.sh' ${outputFile}"
    sh "kubectl rollout restart deployment/${depName} -n elohim-${targetEnv}"
    sh "kubectl rollout status deployment/${depName} -n elohim-${targetEnv} --timeout=300s"
}

/**
 * Deploy the canonical doorway for an environment + (alpha-only) the alpha-b
 * federation peer, with each deploy treated as one test case. A failure in
 * either (ingress hostname conflict, broken manifest, hub PVC pending, etc.)
 * marks the parent stage UNSTABLE rather than FAILURE — matching the
 * per-human deploy shape from deployHumansInParallel — so the orchestrator
 * can settle UNSTABLE-or-better when humans are healthy but federation is
 * mid-cutover. Emits a junit XML report (testsuite name
 * `elohim-edge.deploy.<env>-doorway`) so Jenkins' test-report tab surfaces
 * which doorway-shape deploy failed.
 *
 * Extracted from the Deploy Edge Node - Alpha stage to keep that stage's
 * CPS method body under the JVM 64KB size limit (cf. edge #922
 * method-too-large + the 11000-byte HARD limit enforced by the
 * jenkinsfile-method-size.py pre-commit hook).
 */
def deployDoorwaysWithTestShape(String targetEnv, String envFile, List allHumans) {
    def outcomes = java.util.Collections.synchronizedMap([:])
    def cases = [
        [resourcePrefix: "elohim-doorway-${targetEnv}", env: targetEnv, deviceArchetype: "doorway-${targetEnv}"],
    ]
    catchError(
        buildResult: 'UNSTABLE',
        stageResult: 'UNSTABLE',
        message: "doorway-${targetEnv} deploy failed (see junit testcase)",
    ) {
        deployDoorwayManifest(targetEnv, envFile, allHumans)
        outcomes["elohim-doorway-${targetEnv}"] = true
    }
    if (targetEnv == 'alpha') {
        cases.add([resourcePrefix: 'elohim-doorway-alpha-b', env: 'alpha', deviceArchetype: 'doorway-alpha-federation'])
        catchError(
            buildResult: 'UNSTABLE',
            stageResult: 'UNSTABLE',
            message: 'doorway-alpha-b federation peer deploy failed (see junit testcase — common cause: ingress hostname conflict on elohim.host)',
        ) {
            deployDoorwayManifest('alpha', envFile, allHumans,
                'genesis/orchestrator/manifests/doorway/alpha-b.yaml',
                'elohim-doorway-alpha-b')
            outcomes['elohim-doorway-alpha-b'] = true
        }
    }
    emitDeployJunit("${targetEnv}-doorway", cases, outcomes)
}

// DEPLOY_ONLY pre-flight: Setup Version was skipped, so loadBuildVars'
// computed-from-HEAD tags were never built/pushed (cf. edge #920 ImagePullBackOff
// post-mortem). Reuse the env file's existing tags and verify each exists in
// Harbor before kubectl apply (~1s per tag, fail-fast on missing manifest).
// Extracted from per-environment deploy stages to keep each stage's CPS
// method body under the JVM 64KB size limit (cf. edge #922 method-too-large).
def deployOnlyEnvFilePreflight(String envFile, String targetEnv) {
    echo "DEPLOY_ONLY=true — preserving existing tags in ${envFile} (no overwrite)"
    def existing = readProperties(file: envFile)
    echo "  EDGENODE_TAG=${existing.EDGENODE_TAG}"
    echo "  DOORWAY_TAG=${existing.DOORWAY_TAG}"
    echo "  STORAGE_TAG=${existing.STORAGE_TAG}"
    echo "  HAPP_INSTALLER_TAG=${existing.HAPP_INSTALLER_TAG}"
    echo "  DOORWAY_APP_TAG=${existing.DOORWAY_APP_TAG}"
    echo "  HAPP_TAG=${existing.HAPP_TAG}"
    // Doorway: verify by digest when the env file carries one — its SHA tags
    // are retention-stripped, so the tag 404ing is expected while the digest
    // (what the deploy actually renders) is the real availability check.
    def doorwayCheckRef = ((existing.DOORWAY_DIGEST ?: '') ==~ /sha256:[a-f0-9]{64}/) ? existing.DOORWAY_DIGEST : existing.DOORWAY_TAG
    def checks = [
        ['elohim-edgenode', existing.EDGENODE_TAG],
        ['elohim-doorway', doorwayCheckRef],
        ['elohim-storage', existing.STORAGE_TAG],
        ['elohim-happ-installer', existing.HAPP_INSTALLER_TAG],
        ['elohim-doorway-app', existing.DOORWAY_APP_TAG],
    ]
    // alpha renders the iroh LANE of the same STORAGE_TAG (resolveStorageImage).
    // A DEPLOY_ONLY run reusing an env file written before the per-commit iroh
    // lane existed would otherwise resolve a tag that was never pushed and
    // ImagePullBackOff the namespace — the failure mode this check exists for.
    if (targetEnv == 'alpha') {
        checks << ['elohim-storage-iroh', existing.STORAGE_TAG]
    }
    def missing = []
    checks.each { repo, tag ->
        if (!tag || tag == 'null') return
        def rc = sh(
            script: "curl -sf -o /dev/null 'https://harbor.ethosengine.com/v2/ethosengine/${repo}/manifests/${tag}'",
            returnStatus: true,
        )
        if (rc != 0) {
            missing << "${repo}:${tag}"
        }
    }
    if (missing) {
        error "DEPLOY_ONLY pre-flight failed — missing Harbor manifests: ${missing.join(', ')}. Update ${envFile} or run a non-DEPLOY_ONLY build first."
    }
    echo "✅ Harbor pre-flight passed — all tags exist"
}

def shouldRunStep(String stepName) {
    def steps = (params.STEPS ?: 'all').split(',').collect { it.trim() }
    return steps.contains('all') || steps.contains(stepName)
}

// VALIDATE_ONLY trigger surface (params coalesced — MultiBranch params are
// null pre-first-run) OR an [edge:validate-only] HEAD commit-message tag,
// mirroring the orchestrator's [build:*]/[skip ci] commit-message idiom.
// Called once from Checkout (needs the checked-out repo for `git log`);
// stashes the result in env.EDGE_VALIDATE_ONLY for every later `when` to read
// via isValidateOnly() below — kept as top-level defs so the per-stage cost
// added to the CPS stages-model is just a function call, not inline logic.
def computeValidateOnly() {
    def commitMsg = sh(script: 'git log -1 --format=%B', returnStdout: true).trim()
    env.EDGE_VALIDATE_ONLY = ((params.VALIDATE_ONLY ?: false) ||
        commitMsg.contains('[edge:validate-only]')) ? 'true' : 'false'
    if (env.EDGE_VALIDATE_ONLY == 'true') {
        echo "VALIDATE_ONLY — skipping build/deploy stages; running Dataplane Validation only"
    }
}

def isValidateOnly() {
    env.EDGE_VALIDATE_ONLY == 'true'
}

// Every build-only stage already gates on `params.DEPLOY_ONLY != true`
// (DEPLOY_ONLY skips exactly this stage set). VALIDATE_ONLY needs the same
// stages skipped, so fold both into one call — replaces the DEPLOY_ONLY
// expression at each site instead of adding a second one (CPS stage-model
// budget on this file has near-zero headroom; see jenkinsfile-method-size
// hook). Deploy stages are gated separately via isValidateOnly() directly,
// since DEPLOY_ONLY must NOT skip those.
def skipBuildStage() {
    (params.DEPLOY_ONLY == true) || isValidateOnly()
}

pipeline {
    agent {
        kubernetes {
            cloud 'kubernetes'
            yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccount: jenkins-deployer
  affinity:
    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        nodeSelectorTerms:
          - matchExpressions:
              - key: node-type
                operator: In
                values:
                  - operations
                  - edge
              # No kubernetes.io/hostname pin — cache PVCs are
              # openebs-jiva-csi-default (cluster-wide RWO) and the
              # JivaVolumePolicy bounds replicas off shem, so any
              # ops/edge node is a valid landing spot. The static
              # hostname pin from 2026-05-27 was a hostpath-era
              # workaround for "volume node affinity conflict" thrash
              # (edge #1010); it was removed when the cargo caches
              # moved back to Jiva.
  tolerations:
    - key: "workload-type"
      operator: "Equal"
      value: "build"
      effect: "NoSchedule"
  volumes:
    - name: containerd-sock
      hostPath:
        path: /var/snap/microk8s/common/run/containerd.sock
        type: Socket
    - name: buildkit-run
      emptyDir: {}
    - name: nix-store
      persistentVolumeClaim:
        claimName: nix-cache-holochain
    - name: cargo-cache
      persistentVolumeClaim:
        # Split from cargo-cache-holochain on 2026-05-26 so the edge pipeline
        # can bind its own openebs-hostpath PVC on its own node and run in
        # parallel with the DNA pipeline (which keeps cargo-cache-holochain,
        # shared with steward — those two are sequential per the orchestrator
        # dependsOn chain). Pre-split + pre-hostpath, the cross-pipeline
        # contention surfaced as a Jiva orphan-unmount-loop FailedMount.
        # See genesis/manifests/nix-cache-pvc.yaml for the full rationale.
        claimName: cargo-cache-edge
  containers:
    - name: builder
      image: harbor.ethosengine.com/ethosengine/ci-builder-nix:latest
      # Always: :latest is a moving tag — a cached node can silently serve a stale
      # toolchain (#1218 shape). Freshness > outage-resilience (operator, 2026-06-07).
      imagePullPolicy: Always
      command: [cat]
      tty: true
      resources:
        requests:
          memory: "4Gi"
          cpu: "1"
          ephemeral-storage: "5Gi"
        limits:
          memory: "8Gi"
          cpu: "4"
          ephemeral-storage: "10Gi"
      volumeMounts:
        - name: containerd-sock
          mountPath: /run/containerd/containerd.sock
        - name: buildkit-run
          mountPath: /run/buildkit
        - name: cargo-cache
          mountPath: /root/.cargo
    - name: buildkitd
      image: moby/buildkit:v0.12.5
      securityContext:
        privileged: true
      resources:
        requests:
          memory: "256Mi"
          cpu: "100m"
        limits:
          memory: "1Gi"
          cpu: "1"
      args:
        - --addr
        - unix:///run/buildkit/buildkitd.sock
        - --oci-worker=true
        - --containerd-worker=false
      volumeMounts:
        - name: containerd-sock
          mountPath: /run/containerd/containerd.sock
        - name: buildkit-run
          mountPath: /run/buildkit
'''
        }
    }

    environment {
        BRANCH_NAME = "${env.BRANCH_NAME ?: 'main'}"
        HAPP_NAME = "elohim"
        PATH = "/nix/var/nix/profiles/default/bin:${env.PATH}"
        NPM_TOKEN = credentials('ee-nexus-npm-token')
        // Pipeline state tracking
        IMAGES_PUSHED = 'false'
        HAPP_AVAILABLE = 'false'
        EDGE_NODE_HEALTHY = 'false'
    }

    parameters {
        booleanParam(
            name: 'FORCE_BUILD',
            defaultValue: false,
            description: 'Force rebuild of all images even without code changes'
        )
        booleanParam(
            name: 'FORCE_DEPLOY',
            defaultValue: false,
            description: 'Force deployment even if no new images (restarts pods with existing images)'
        )
        choice(
            name: 'DEPLOY_STRATEGY',
            choices: ['alpha-concentration', 'distributed', 'custom'],
            description: 'alpha-concentration: all 5 in alpha. distributed: 2 alpha, 2 staging, 1 prod. custom: manual.'
        )
        string(
            name: 'HUMAN_ASSIGNMENTS',
            defaultValue: 'matthew:alpha,adam:alpha,jessica:alpha,james:alpha,pete:alpha',
            description: 'name:env pairs. Only used when DEPLOY_STRATEGY=custom.'
        )
        booleanParam(
            name: 'RESET_HUMANS',
            defaultValue: false,
            description: 'Delete and recreate human StatefulSets before deploying. Use when changing topology or for clean state.'
        )
        string(name: 'STEPS', defaultValue: 'all', description: 'Comma-separated build steps to run. "all" runs everything.')
        booleanParam(
            name: 'SKIP_LEGACY_IMAGES',
            defaultValue: false,
            description: 'Skip building edgenode and happ-installer images (humans using consolidated elohim-node mode)'
        )
        booleanParam(
            name: 'DEPLOY_ONLY',
            defaultValue: false,
            description: 'Skip all build stages and run only Deploy Edge Node - <Env>. Tags are read from genesis/orchestrator/environments/{env}.env. Use after manifest/RBAC-only changes when Harbor tags are already valid.'
        )
        booleanParam(
            name: 'VALIDATE_ONLY',
            defaultValue: false,
            description: 'Skip build/deploy; run only Dataplane Validation against the deployed alpha cluster. Decouples validation timing from deploy-restart windows. Also settable via [edge:validate-only] commit tag.'
        )
    }

    options {
        timeout(time: 120, unit: 'MINUTES')
        // abortPrevious: true — when a new orchestrator dispatch arrives while a
        // previous build of this pipeline is in-flight, abort the old one. Without
        // this, the previous orchestrator's downstream queues up behind the in-flight
        // build (60+ min wait) while the orchestrator itself has already been aborted.
        // See memory: _orchestrator_abort_baseline_rollback.
        disableConcurrentBuilds(abortPrevious: true)
        preserveStashes(buildCount: 5)
        overrideIndexTriggers(false)  // Only orchestrator or manual triggers - no webhook/branch indexing
        // Skip implicit Declarative: Checkout SCM — same fix as elohim-orchestrator;
        // see orchestrator Jenkinsfile options block.
        skipDefaultCheckout(true)
    }

    // No triggers - orchestrator handles all webhook events

    stages {
        stage('Check Trigger') {
            steps {
                script {
                    // Only allow manual triggers or orchestrator triggers
                    def validTrigger = currentBuild.getBuildCauses().any { cause ->
                        cause._class.contains('UserIdCause') ||      // Manual trigger
                        cause._class.contains('UpstreamCause')       // Triggered by orchestrator
                    }

                    if (!validTrigger) {
                        echo """
                        ═══════════════════════════════════════════════════════════
                        ⏭️ PIPELINE SKIPPED - USE ORCHESTRATOR
                        ═══════════════════════════════════════════════════════════
                        This pipeline is managed by elohim-orchestrator.
                        Direct webhook triggers are disabled.

                        To trigger this pipeline:
                        1. Push to GitHub → orchestrator analyzes → triggers this
                        2. Or manually: Build with Parameters

                        Triggered by: ${currentBuild.getBuildCauses()*.shortDescription.join(', ')}
                        ═══════════════════════════════════════════════════════════
                        """
                        currentBuild.result = 'NOT_BUILT'
                        currentBuild.displayName = "#${env.BUILD_NUMBER} SKIPPED"
                        env.PIPELINE_SKIPPED = 'true'
                    } else {
                        echo "✅ Valid trigger: ${currentBuild.getBuildCauses()*.shortDescription.join(', ')}"
                    }
                }
            }
        }

        stage('Checkout') {
            when { expression { env.PIPELINE_SKIPPED != 'true' } }
            steps {
                container('builder') {
                    script {
                        sh 'git config --global --add safe.directory "*"'

                        // Explicit checkout — bypasses the 10-min default per-attempt
                        // timeout in `checkout scm` that has been exhausting on this repo
                        // (#1179 died "git-remote-https signal 15" at ~10:15).
                        // honorRefspec keeps fetch to single branch (orchestrator #787 spent
                        // 27min on +refs/heads/* even at depth:200).
                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: "*/${env.BRANCH_NAME ?: 'dev'}"]],
                            extensions: [
                                [$class: 'CloneOption', shallow: true, noTags: true, depth: 200, timeout: 30, honorRefspec: true],
                                [$class: 'CleanBeforeCheckout']
                            ],
                            userRemoteConfigs: [[
                                url: 'https://github.com/ethosengine/elohim.git',
                                credentialsId: 'ee-bot-pat',
                                refspec: "+refs/heads/${env.BRANCH_NAME ?: 'dev'}:refs/remotes/origin/${env.BRANCH_NAME ?: 'dev'}"
                            ]]
                        ])
                        sh 'git clean -fdx'
                        sh 'git reset --hard HEAD'

                        computeValidateOnly()

                        echo "Building Holochain infrastructure for branch: ${env.BRANCH_NAME}"
                    }
                }
            }
        }

        stage('Setup Version') {
            // build.env is unused by Dataplane Validation — skippable here.
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { !isValidateOnly() }
            }}
            steps {
                container('builder') {
                    script {
                        sh 'git config --global --add safe.directory "*"'

                        // Parse VERSION file with component-specific versions
                        def versionMap = parseVersionFile()
                        def gitHash = sh(script: 'git rev-parse HEAD | cut -c1-8', returnStdout: true).trim()
                        def sanitizedBranch = env.BRANCH_NAME.replaceAll('/', '-')

                        // Compute tag: main→baseVersion, others→baseVersion-branch-hash
                        def computeTag = { String baseVer ->
                            (env.BRANCH_NAME == 'main') ? baseVer : "${baseVer}-${sanitizedBranch}-${gitHash}"
                        }

                        // Per-component tags
                        def edgenodeTag = computeTag(versionMap['EDGENODE_VERSION'] ?: '1.0.0')
                        def doorwayTag = computeTag(versionMap['DOORWAY_VERSION'] ?: '1.0.0')
                        def storageTag = computeTag(versionMap['STORAGE_VERSION'] ?: '1.0.0')
                        def happInstallerTag = computeTag(versionMap['HAPP_INSTALLER_VERSION'] ?: '1.0.0')
                        def doorwayAppTag = computeTag(versionMap['DOORWAY_APP_VERSION'] ?: '1.0.0')
                        def agentSdkTag = computeTag(versionMap['AGENT_SDK_VERSION'] ?: '0.1.0')
                        // hApp is built by DNA pipeline — use floating tag, not commit-specific
                        def happTag = getHappFloatingTag()

                        // Backward compat: IMAGE_TAG = edgenode tag (primary image)
                        def baseVersion = versionMap['HAPP_VERSION'] ?: versionMap['APP_VERSION'] ?: '1.0.0'

                        def buildEnvContent = """BASE_VERSION=${baseVersion}
GIT_COMMIT_HASH=${gitHash}
IMAGE_TAG=${edgenodeTag}
EDGENODE_TAG=${edgenodeTag}
DOORWAY_TAG=${doorwayTag}
STORAGE_TAG=${storageTag}
HAPP_INSTALLER_TAG=${happInstallerTag}
DOORWAY_APP_TAG=${doorwayAppTag}
AGENT_SDK_TAG=${agentSdkTag}
HAPP_TAG=${happTag}
BRANCH_NAME=${env.BRANCH_NAME}"""

                        writeFile file: "${env.WORKSPACE}/build.env", text: buildEnvContent
                        archiveArtifacts artifacts: 'build.env', allowEmptyArchive: false

                        echo "Component tags:"
                        echo "  EDGENODE_TAG=${edgenodeTag}"
                        echo "  DOORWAY_TAG=${doorwayTag}"
                        echo "  STORAGE_TAG=${storageTag}"
                        echo "  HAPP_INSTALLER_TAG=${happInstallerTag}"
                        echo "  DOORWAY_APP_TAG=${doorwayAppTag}"
                        echo "  AGENT_SDK_TAG=${agentSdkTag}"
                        echo "  HAPP_TAG=${happTag}"
                    }
                }
            }
        }

        stage('Setup Nix Cache') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { !isValidateOnly() }
            }}
            steps {
                container('builder') {
                    script {
                        echo 'Configuring Nix with Holochain Cachix...'

                        sh '''
                            nix --version
                            echo "Nix config:"
                            nix show-config | grep -E "(substituters|trusted-public-keys)" || true

                            echo ""
                            echo "Testing cache connectivity..."
                            nix-store --query --requisites /nix/store/*.drv 2>/dev/null | head -5 || echo "Cache ready"
                        '''
                    }
                }
            }
        }

        // NOTE: Build WASM Cache Core and Build DNA stages moved to elohim/holochain/dna/Jenkinsfile
        // This pipeline now only builds infrastructure (container images)

        stage('Quality Gate: Doorway') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { !skipBuildStage() }
            }}
            steps {
                container('builder') {
                    script {
                        try {
                            sh """#!/bin/bash
                                set -euo pipefail
                                buildctl --addr unix:///run/buildkit/buildkitd.sock debug workers > /dev/null

                                # Run fmt/clippy/test inside the Dockerfile's 'check' target
                                # Reuses BuildKit dep cache — no Rust needed in CI builder image
                                BUILDKIT_HOST=unix:///run/buildkit/buildkitd.sock \\
                                    nerdctl -n k8s.io build \\
                                    --target check \\
                                    -f doorway/doorway-service/Dockerfile .
                            """
                        } catch (Exception e) {
                            echo "Quality Gate: Doorway - issues found (non-blocking): ${e.message}"
                            unstable('Doorway quality gate has warnings')
                        }
                    }
                }
            }
        }

        stage('Build Doorway') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { !skipBuildStage() }
                expression { shouldRunStep('cargo-build-doorway') }
            }}
            steps {
                container('builder') {
                    script {
                        def props = loadBuildVars()

                        withBuildVars(props) {
                            echo "Building Doorway Gateway: ${IMAGE_TAG}"

                            sh """#!/bin/bash
                                set -euo pipefail

                                buildctl --addr unix:///run/buildkit/buildkitd.sock debug workers > /dev/null

                                # Build from repo root with doorway/doorway-service/Dockerfile
                                BUILDKIT_HOST=unix:///run/buildkit/buildkitd.sock \\
                                    nerdctl -n k8s.io build \\
                                    --build-arg GIT_COMMIT_SHORT=\$(echo ${GIT_COMMIT_HASH} | cut -c1-7) \\
                                    --build-arg GIT_COMMIT_FULL=${GIT_COMMIT_HASH} \\
                                    --build-arg BUILD_TIMESTAMP=\$(date -u +'%Y-%m-%dT%H:%M:%SZ') \\
                                    -t elohim-doorway:${IMAGE_TAG} \\
                                    -f doorway/doorway-service/Dockerfile .

                                nerdctl -n k8s.io tag elohim-doorway:${IMAGE_TAG} elohim-doorway:${GIT_COMMIT_HASH}
                            """
                        }
                    }
                }
            }
        }

        stage('Quality Gate: Doorway App') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { !skipBuildStage() }
            }}
            steps {
                container('builder') {
                    script {
                        try {
                            dir('doorway/doorway-app') {
                                sh 'pnpm install --frozen-lockfile && pnpm exec eslint src --ext .ts,.html'
                            }
                        } catch (Exception e) {
                            echo "Quality Gate: Doorway App - issues found (non-blocking): ${e.message}"
                            unstable('Doorway App quality gate has warnings')
                        }
                    }
                }
            }
        }

        stage('Build Doorway App') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { !skipBuildStage() }
            }}
            steps {
                container('builder') {
                    script {
                        def props = loadBuildVars()

                        withBuildVars(props) {
                            echo "Building Doorway Operator Dashboard: ${IMAGE_TAG}"

                            sh """#!/bin/bash
                                set -euo pipefail

                                buildctl --addr unix:///run/buildkit/buildkitd.sock debug workers > /dev/null

                                # Angular build happens HERE in the pnpm workspace:
                                # doorway-app needs @elohim/identity (workspace:* +
                                # tsconfig paths into app/elohim-library), unreachable
                                # from the docker context (#1057). The image is a
                                # thin nginx copy of dist/.
                                pnpm install --frozen-lockfile --filter doorway-app...
                                pnpm --filter doorway-app build

                                cd doorway/doorway-app

                                BUILDKIT_HOST=unix:///run/buildkit/buildkitd.sock \\
                                    nerdctl -n k8s.io build \\
                                    -t doorway-app:${IMAGE_TAG} \\
                                    -f Dockerfile .

                                nerdctl -n k8s.io tag doorway-app:${IMAGE_TAG} doorway-app:${GIT_COMMIT_HASH}
                            """
                        }
                    }
                }
            }
        }

        stage('Build Agent SDK') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { !skipBuildStage() }
            }}
            steps {
                container('builder') {
                    script {
                        def props = loadBuildVars()

                        withBuildVars(props) {
                            echo "Building Elohim Agent SDK sidecar: ${AGENT_SDK_TAG}"

                            sh """#!/bin/bash
                                set -euo pipefail

                                buildctl --addr unix:///run/buildkit/buildkitd.sock debug workers > /dev/null

                                cd elohim/elohim-agent/elohim-agent-sdk

                                BUILDKIT_HOST=unix:///run/buildkit/buildkitd.sock \\
                                    nerdctl -n k8s.io build \\
                                    -t elohim-agent-sdk:${IMAGE_TAG} \\
                                    -f Dockerfile .

                                nerdctl -n k8s.io tag elohim-agent-sdk:${IMAGE_TAG} elohim-agent-sdk:${GIT_COMMIT_HASH}
                            """

                            // Beacon build (scripts/ci); UNSTABLE-isolated so it can't abort critical delivery.
                            catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                                sh "bash '${env.WORKSPACE}/scripts/ci/build-relay-addr-beacon.sh'"
                            }

                            // Iroh Relay build (scripts/ci); UNSTABLE-isolated, same pattern as the beacon.
                            catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                                sh "bash '${env.WORKSPACE}/scripts/ci/build-iroh-relay.sh'"
                            }
                        }
                    }
                }
            }
        }

        stage('Build Storage') {
            // ONE expression, no allOf/anyOf: every declarative when-clause
            // element compiles into the stages-model CPS method, and this model
            // sits AGAINST the JVM 64KB bytecode limit — the nested anyOf form
            // of this clause is what broke edge #1351 at compile
            // (MethodTooLargeException, stageless 2.5s death), same class as
            // edge #1134.
            when { expression {
                env.PIPELINE_SKIPPED != 'true' && !skipBuildStage() &&
                (shouldRunStep('cargo-build-storage') || shouldRunStep('sdk-feature-matrix'))
            } }
            // Gate rides INSIDE this stage (not its own stage) and ALL
            // branching lives in the helper (runStorageStageBody), keeping the
            // steps block to a single call: adding model elements here is what
            // breaches the ceiling — string-byte proxies undercount model
            // bytecode. The SDK matrix is blocking; the stabilizing storage
            // gate remains non-blocking, then the release build runs.
            steps { container('builder') { script { runStorageStageBody() } } }
        }

        stage('P2P Simulation Test') {
            when {
                allOf {
                    expression { env.PIPELINE_SKIPPED != 'true' }
                    expression { !skipBuildStage() }
                    anyOf {
                        changeset "elohim/elohim-storage/src/p2p/**"
                        changeset "steward/node/simulation/**"
                        expression { params.FORCE_BUILD }
                    }
                }
            }
            steps {
                container('builder') {
                    script {
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            runSimulationTest()
                        }
                    }
                }
            }
        }

        stage('Build Edge Node Image') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { !skipBuildStage() }
                expression { shouldRunStep('build-edge-image') }
                expression { params.SKIP_LEGACY_IMAGES != true }
            }}
            steps {
                container('builder') {
                    script {
                        def props = loadBuildVars()

                        withBuildVars(props) {
                            echo "Building Edge Node image: ${IMAGE_TAG}"

                            // Fetch hApp from elohim-holochain pipeline (DNA is built separately)
                            echo "Fetching hApp from elohim-holochain pipeline..."
                            def haveHapp = fetchHappFromHarbor('elohim/holochain/edgenode/elohim.happ')

                            if (haveHapp) {
                                // DNA version awareness (Sprint 5)
                                def versionMap = parseVersionFile()
                                def expectedHappVersion = versionMap['HAPP_VERSION'] ?: 'unknown'
                                def happTag = getHappFloatingTag()
                                echo """
    ═══════════════════════════════════════════
    DNA ARTIFACT INFO
    ═══════════════════════════════════════════
    Expected HAPP_VERSION: ${expectedHappVersion}
    Fetched via tag:       ${happTag}
    ═══════════════════════════════════════════"""

                                env.HAPP_AVAILABLE = 'true'
                                sh """#!/bin/bash
                                    set -euo pipefail

                                    buildctl --addr unix:///run/buildkit/buildkitd.sock debug workers > /dev/null

                                    cd elohim/holochain/edgenode

                                    BUILDKIT_HOST=unix:///run/buildkit/buildkitd.sock \\
                                        nerdctl -n k8s.io build \\
                                        -t elohim-edgenode:${IMAGE_TAG} \\
                                        -f Dockerfile .

                                    nerdctl -n k8s.io tag elohim-edgenode:${IMAGE_TAG} elohim-edgenode:${GIT_COMMIT_HASH}
                                """
                                echo "Edge Node image built successfully"
                            } else {
                                echo "Skipping Edge Node image build - no hApp available"
                                echo "Run the pipeline with FORCE_BUILD after ensuring DNA artifacts exist"
                            }

                            // Per-commit convergence measure on a mesh we own.
                            // Rides here (not its own stage) because the stages
                            // model is at the 64KB CPS ceiling — see the def.
                            runMeshQuiesceMeasure()
                        }
                    }
                }
            }
        }

        stage('Build hApp Installer') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { !skipBuildStage() }
                expression { params.SKIP_LEGACY_IMAGES != true }
            }}
            steps {
                container('builder') {
                    script {
                        def props = loadBuildVars()

                        withBuildVars(props) {
                            echo "Building hApp Installer image: ${IMAGE_TAG}"

                            // Fetch hApp from elohim-holochain pipeline (DNA is built separately)
                            echo "Fetching hApp from elohim-holochain pipeline..."
                            def haveHapp = fetchHappFromHarbor('elohim/holochain/edgenode/scripts/elohim.happ')

                            if (haveHapp) {
                                sh """#!/bin/bash
                                    set -euo pipefail

                                    buildctl --addr unix:///run/buildkit/buildkitd.sock debug workers > /dev/null

                                    cd elohim/holochain/edgenode/scripts

                                    BUILDKIT_HOST=unix:///run/buildkit/buildkitd.sock \\
                                        nerdctl -n k8s.io build \\
                                        -t elohim-happ-installer:${IMAGE_TAG} \\
                                        -f Dockerfile .

                                    nerdctl -n k8s.io tag elohim-happ-installer:${IMAGE_TAG} elohim-happ-installer:${GIT_COMMIT_HASH}
                                """
                                echo "hApp Installer image built successfully"
                            } else {
                                // This stage was triggered but no hApp is available
                                error """
                                ═══════════════════════════════════════════════════════════
                                CANNOT BUILD HAPP INSTALLER: No hApp artifact available
                                ═══════════════════════════════════════════════════════════
                                Could not fetch hApp from elohim-holochain pipeline.

                                Ensure elohim-holochain pipeline has run successfully first.
                                Check: https://jenkins.ethosengine.com/job/elohim-holochain/
                                ═══════════════════════════════════════════════════════════
                                """
                            }
                        }
                    }
                }
            }
        }

        stage('Push to Harbor') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { !skipBuildStage() }
            }}
            steps {
                container('builder') {
                    script {
                        def props = loadBuildVars()

                        withBuildVars(props) {
                            withCredentials([usernamePassword(credentialsId: 'harbor-robot-registry', passwordVariable: 'HARBOR_PASSWORD', usernameVariable: 'HARBOR_USERNAME')]) {
                                sh 'echo $HARBOR_PASSWORD | nerdctl -n k8s.io login harbor.ethosengine.com -u $HARBOR_USERNAME --password-stdin'

                                // Push each component with its own tag.
                                // Bash bodies extracted to scripts/ci/ (2026-07-30, Jenkinsfile Size Limit —
                                // see CLAUDE.md) — see those scripts' headers for the exact preserved
                                // error-propagation semantics of the tracked (edgenode/doorway, via
                                // returnStatus) vs untracked (storage/happ-installer/doorway-app/agent-sdk)
                                // push patterns.
                                def edgeNodePushed = sh(
                                    script: "bash '${env.WORKSPACE}/scripts/ci/push-harbor-tracked.sh' elohim-edgenode elohim-edgenode '${EDGENODE_TAG}' 'Edge Node'",
                                    returnStatus: true
                                ) == 0

                                if (edgeNodePushed) {
                                    env.IMAGES_PUSHED = 'true'
                                }

                                def doorwayPushed = sh(
                                    script: "bash '${env.WORKSPACE}/scripts/ci/push-harbor-tracked.sh' elohim-doorway elohim-doorway '${DOORWAY_TAG}' 'Doorway'",
                                    returnStatus: true
                                ) == 0

                                if (doorwayPushed) {
                                    env.IMAGES_PUSHED = 'true'
                                    // Harbor retention strips this repo's SHA tags after push
                                    // (backlog: harbor-retention-strips-doorway-sha-tags) — carry
                                    // the push-time digest so deploys pin tag@digest and a
                                    // stripped tag can't strand rollouts in ImagePullBackOff.
                                    def dwDigest = sh(script: "cat '${env.WORKSPACE}/elohim-doorway.digest' 2>/dev/null || true", returnStdout: true).trim()
                                    if (dwDigest ==~ /sha256:[a-f0-9]{64}/) {
                                        env.DOORWAY_DIGEST = dwDigest
                                        echo "Doorway deploy pin: ${DOORWAY_TAG}@${dwDigest}"
                                    }
                                }

                                sh "bash '${env.WORKSPACE}/scripts/ci/push-harbor-untracked.sh' elohim-storage elohim-storage '${STORAGE_TAG}' 'elohim-storage'"

                                // Wave-2 iroh transport lane — MUST run after the tx5-lane push
                                // above: it overlays the iroh conductor onto the storage image
                                // that push just put in Harbor. NOT catchError-isolated (unlike
                                // the relay/beacon builds): resolveStorageImage points every
                                // alpha human at elohim-storage-iroh:${STORAGE_TAG}, so a
                                // missing tag must abort here rather than ImagePullBackOff the
                                // namespace. See scripts/ci/push-storage-iroh.sh.
                                sh "bash '${env.WORKSPACE}/scripts/ci/push-storage-iroh.sh'"

                                sh "bash '${env.WORKSPACE}/scripts/ci/push-harbor-untracked.sh' elohim-happ-installer elohim-happ-installer '${HAPP_INSTALLER_TAG}' 'hApp Installer'"

                                sh "bash '${env.WORKSPACE}/scripts/ci/push-harbor-untracked.sh' doorway-app doorway-app '${DOORWAY_APP_TAG}' 'Doorway App'"

                                sh "bash '${env.WORKSPACE}/scripts/ci/push-harbor-untracked.sh' elohim-agent-sdk elohim-agent-sdk '${AGENT_SDK_TAG}' 'Agent SDK'"

                                // Relay Addr Beacon push+alias — scripts/ci/push-relay-addr-beacon.sh
                                sh "bash '${env.WORKSPACE}/scripts/ci/push-relay-addr-beacon.sh'"

                                // Iroh Relay push+alias — scripts/ci/push-iroh-relay.sh
                                sh "bash '${env.WORKSPACE}/scripts/ci/push-iroh-relay.sh'"

                                // Also push dev-latest aliases on dev branch for backward compat
                                if (env.BRANCH_NAME == 'dev') {
                                    sh "bash '${env.WORKSPACE}/scripts/ci/push-harbor-dev-latest-aliases.sh'"
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Deploy Edge Node - Alpha') {
            when {
                allOf {
                    expression { env.PIPELINE_SKIPPED != 'true' }
                    expression { !isValidateOnly() }
                    anyOf {
                        branch 'dev'
                        allOf {
                            anyOf {
                                changeset "doorway/**"
                                changeset "elohim/elohim-storage/**"
                                changeset "elohim/holochain/edgenode/**"
                            }
                            anyOf {
                                expression { env.BRANCH_NAME ==~ /feat-.+/ }
                                expression { env.BRANCH_NAME ==~ /claude\/.+/ }
                            }
                        }
                        expression { params.FORCE_DEPLOY }
                        expression { params.FORCE_BUILD }
                    }
                }
            }
            steps {
                container('builder') {
                    script {
                        def props = loadBuildVars()

                        withBuildVars(props) {
                            // Check if we have a reason to deploy
                            def shouldDeploy = (env.IMAGES_PUSHED == 'true') ||
                                               params.FORCE_DEPLOY || params.FORCE_BUILD || params.DEPLOY_ONLY

                            if (!shouldDeploy) {
                                echo "No new images pushed and no force flags - checking edge node health..."
                                if (checkEdgeNodeHealth('https://doorway-alpha.elohim.host')) {
                                    echo "Edge node is healthy - skipping deployment"
                                    env.EDGE_NODE_HEALTHY = 'true'
                                    return
                                }

                                // Edge node unhealthy - check if we have images to deploy
                                echo "Edge node unhealthy - checking if dev-latest images exist in Harbor..."
                                def imageExists = sh(
                                    script: '''
                                        curl -sf -o /dev/null \
                                            "https://harbor.ethosengine.com/v2/ethosengine/elohim-edgenode/manifests/dev-latest" \
                                            2>/dev/null
                                    ''',
                                    returnStatus: true
                                ) == 0

                                if (!imageExists) {
                                    echo """
                                    ═══════════════════════════════════════════════════════════
                                    CANNOT AUTO-HEAL: No images available in Harbor
                                    ═══════════════════════════════════════════════════════════
                                    Edge node is unhealthy but no dev-latest images exist.

                                    To fix this, run the pipeline with FORCE_BUILD=true after
                                    ensuring the DNA has been successfully built and archived.

                                    Current hApp availability: ${env.HAPP_AVAILABLE}
                                    ═══════════════════════════════════════════════════════════
                                    """
                                    // Don't fail the pipeline - just skip deployment
                                    return
                                }

                                echo "Found dev-latest images - attempting auto-heal restart"
                                shouldDeploy = true
                            }

                            def strategy = (params.DEPLOY_STRATEGY ?: 'alpha-concentration')
                            def customAssignments = (params.HUMAN_ASSIGNMENTS ?: 'matthew:alpha,adam:alpha,jessica:alpha,james:alpha,pete:alpha')
                            def allHumans = resolveHumanAssignments(strategy, customAssignments)
                            def allEnvConfig = getEnvConfig()

                            echo """
                            ═══════════════════════════════════════════════════════════
                            DEPLOYING EDGE NODE TO DEV (Topology-Aware)
                            ═══════════════════════════════════════════════════════════
                            Image Tag: ${IMAGE_TAG}
                            Images Pushed: ${env.IMAGES_PUSHED}
                            Force Deploy: ${params.FORCE_DEPLOY}
                            Deploy Strategy: ${strategy}
                            ═══════════════════════════════════════════════════════════
                            """

                            logAndWriteTopology(strategy, allHumans)

                            // Group humans by environment and deploy each active env
                            def humansByEnv = allHumans.groupBy { it.env }

                            humansByEnv.each { targetEnv, envHumans ->
                                def ec = allEnvConfig[targetEnv]
                                if (!ec) {
                                    error "Unknown environment: ${targetEnv}"
                                }

                                echo "=== Deploying ${envHumans.size()} humans to ${targetEnv} ==="

                                // DEPLOY_ONLY: reuse the env file's existing tags (the
                                // currently-deployed/known-good ones from a prior real build).
                                // Build stages were skipped, so EDGENODE_TAG/DOORWAY_TAG/etc.
                                // from Setup Version's loadBuildVars are computed-from-HEAD
                                // and have NEVER been built or pushed to Harbor — applying
                                // them to k8s would cause ImagePullBackOff (cf. edge #920
                                // post-mortem). Skip the rewrite; readProperties(envFile)
                                // downstream picks up the unchanged dev-latest tags.
                                if (params.DEPLOY_ONLY) {
                                    deployOnlyEnvFilePreflight(ec.envFile, targetEnv)
                                } else {
                                    // Normal build: write env file with current build tags (preserve SITE_TAG)
                                    def currentSiteTag = readProperties(file: ec.envFile).SITE_TAG ?: 'dev-latest'
                                    writeFile file: ec.envFile, text: """# ${targetEnv.capitalize()} Environment - auto-updated by pipeline after each deploy
# Format: COMPONENT_TAG=harbor-image-tag
SITE_TAG=${currentSiteTag}
EDGENODE_TAG=${EDGENODE_TAG}
DOORWAY_TAG=${DOORWAY_TAG}
DOORWAY_DIGEST=${env.DOORWAY_DIGEST ?: ''}
STORAGE_TAG=${STORAGE_TAG}
HAPP_INSTALLER_TAG=${HAPP_INSTALLER_TAG}
DOORWAY_APP_TAG=${DOORWAY_APP_TAG}
HAPP_TAG=${HAPP_TAG}
AGENT_SDK_TAG=${AGENT_SDK_TAG}
"""
                                }

                                // Deploy infra (idempotent)
                                ec.infraManifests.each { manifest ->
                                    sh "kubectl apply -f ${manifest}"
                                }

                                // The doorway PodMonitor — scrapes BOTH doorways.
                                // Applied through the tolerant helper rather than the
                                // strict loop above, because jenkins-deployer's grant on
                                // monitoring.coreos.com/podmonitors is operator-applied and
                                // may be absent (backlog ci-rbac-jenkins-deployer); a
                                // Forbidden here must not red an otherwise-good deploy,
                                // and the helper fails on anything that is NOT that
                                // Forbidden. Nothing applied this file before, which is why
                                // the 2026-08-20 selector fix (8a4fe1ab1 — matchLabels
                                // `app: elohim-doorway` silently excluded doorway B, whose
                                // pods label themselves `elohim-doorway-b`) never reached
                                // the cluster, and doorway B still had NO scrape target
                                // during the investigation of its own outage.
                                if (targetEnv == 'alpha') {
                                    sh "bash '${env.WORKSPACE}/scripts/ci/apply-doorway-manifest.sh' genesis/orchestrator/manifests/infra/alpha-doorway-podmonitor.yaml"
                                }

                                // Deploy each human in parallel — see deployHumansInParallel
                                // for rationale. Per-peer test-result shape; partial
                                // failures → UNSTABLE (stage), junit XML per peer.
                                deployHumansInParallel(envHumans, ec.envFile, allHumans)

                                // Deploy doorway + (alpha-only) alpha-b federation peer with
                                // the same test-result shape — see deployDoorwaysWithTestShape.
                                deployDoorwaysWithTestShape(targetEnv, ec.envFile, allHumans)
                            }

                            // Cleanup orphaned StatefulSets from previous topology
                            cleanupOrphanedHumans(allHumans)

                            sh 'sleep 15'

                            // Health check on primary environment
                            def primaryEnv = humansByEnv.keySet().first()
                            def primaryConfig = allEnvConfig[primaryEnv]
                            def healthy = checkEdgeNodeHealth(primaryConfig.healthUrl)
                            if (healthy) {
                                env.EDGE_NODE_HEALTHY = 'true'
                                echo "Edge Node deployed and healthy: ${primaryConfig.healthUrl}"
                            } else {
                                echo "Edge Node deployed but health check failed - may need more time"
                            }

                            // Federation-peer public health (alpha-b); keyed on alpha IN the deploy set.
                            checkFederationPeerPublicHealth(humansByEnv.containsKey('alpha'))
                        }
                    }
                }
            }
        }

        // Advisory @dataplane cucumber suite — bash body in scripts/ci/run-dataplane-validation.sh.
        // catchError->UNSTABLE: red concerns and zero-scenario measurements surface
        // without blocking the orchestrator cascade; zero scenarios is never SUCCESS.
        // Flip to FAILURE once all concerns go green on dev.
        stage('Dataplane Validation') {
            when {
                allOf {
                    expression { env.PIPELINE_SKIPPED != 'true' }
                    anyOf {
                        branch 'dev'
                        allOf {
                            anyOf {
                                changeset 'doorway/**'
                                changeset 'elohim/elohim-storage/**'
                                changeset 'elohim/holochain/edgenode/**'
                            }
                            anyOf {
                                expression { env.BRANCH_NAME ==~ /feat-.+/ }
                                expression { env.BRANCH_NAME ==~ /claude\/.+/ }
                            }
                        }
                        expression { params.FORCE_DEPLOY }
                        expression { params.FORCE_BUILD }
                        expression { isValidateOnly() }
                    }
                }
            }
            steps {
                container('builder') {
                    // Substrate seam smoke — one named check per communication
                    // seam (bootstrap-sharing / relay-reachability / peer-store /
                    // n0-contamination / no-lingering-tx5 / dht-fetch) so a red
                    // names ITSELF instead of surfacing as
                    // an unexplained convergence failure. Advisory while
                    // scenario 2 stabilizes; flip to --gate after green ×2.
                    catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                        sh "bash '${env.WORKSPACE}/scripts/ci/substrate-seam-smoke.sh' https://doorway-alpha.elohim.host https://elohim.host"
                    }
                    // QUIESCE_DEADLINE_SECS is 2700 on BOTH paths since 2026-08-07.
                    // The post-deploy path used to get 900 on the theory that only a
                    // validate-only recording run needs a long bounded wait — but it is
                    // the post-deploy path that just restarted the whole fleet, and
                    // conductor restart churn is ~20min (substrate trust-contract
                    // runbook). 900s therefore expired mid-churn and systematically
                    // produced DID-NOT-MEASURE exactly where the measurement matters
                    // most. The gate is bounded and fail-closed either way; a longer
                    // bound only costs wall-clock on a fleet that is genuinely stuck.
                    catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                        withEnv(["E2E_DOORWAY_ALPHA=https://doorway-alpha.elohim.host", "QUIESCE_DEADLINE_SECS=2700"]) {
                            sh "bash '${env.WORKSPACE}/scripts/ci/run-dataplane-validation.sh'"
                        }
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'genesis/a2o/reports/sprint-report-dataplane.*', allowEmptyArchive: true
                }
            }
        }

        stage('Deploy Edge Node - Staging') {
            when {
                allOf {
                    expression { env.PIPELINE_SKIPPED != 'true' }
                    expression { !isValidateOnly() }
                    anyOf {
                        branch 'staging'
                        expression { env.BRANCH_NAME ==~ /staging-.+/ }
                    }
                }
            }
            steps {
                container('builder') {
                    script {
                        def props = loadBuildVars()

                        withBuildVars(props) {
                            echo "Deploying Edge Node to Staging: ${IMAGE_TAG}"

                            // Resolve topology: staging branch uses distributed strategy
                            def allHumans = resolveHumanAssignments('distributed', '')
                            def stagingHumans = allHumans.findAll { it.env == 'staging' }

                            def envFile = 'genesis/orchestrator/environments/staging.env'
                            if (params.DEPLOY_ONLY) {
                                deployOnlyEnvFilePreflight(envFile, 'staging')
                            } else {
                                def currentSiteTag = readProperties(file: envFile).SITE_TAG ?: 'dev-latest'
                                writeFile file: envFile, text: """# Staging Environment - auto-updated by pipeline after each deploy
# Format: COMPONENT_TAG=harbor-image-tag
SITE_TAG=${currentSiteTag}
EDGENODE_TAG=${EDGENODE_TAG}
DOORWAY_TAG=${DOORWAY_TAG}
DOORWAY_DIGEST=${env.DOORWAY_DIGEST ?: ''}
STORAGE_TAG=${STORAGE_TAG}
HAPP_INSTALLER_TAG=${HAPP_INSTALLER_TAG}
DOORWAY_APP_TAG=${DOORWAY_APP_TAG}
HAPP_TAG=${HAPP_TAG}
AGENT_SDK_TAG=${AGENT_SDK_TAG}
"""
                            }
                            // Deploy infra (MongoDB + NATS) — idempotent
                            sh "kubectl apply -f genesis/orchestrator/manifests/infra/staging-mongodb.yaml"
                            sh "kubectl apply -f genesis/orchestrator/manifests/infra/staging-nats.yaml"

                            // Per-human manifests — topology-aware, parallelized.
                            deployHumansInParallel(stagingHumans, envFile, allHumans)

                            // Doorway + read replica — topology-aware
                            deployDoorwayManifest('staging', envFile, allHumans)
                            deployDoorwayManifest('staging', envFile, allHumans, 'genesis/orchestrator/manifests/doorway/staging-read.yaml', 'elohim-doorway-read-staging')

                            sh 'sleep 15'
                            if (checkEdgeNodeHealth('https://doorway-staging.elohim.host')) {
                                echo "Edge Node Staging deployed and healthy"
                            }
                        }
                    }
                }
            }
        }

        // NOTE: Seeding is handled by genesis/Jenkinsfile, auto-triggered by the orchestrator

        stage('Deploy Edge Node - Prod') {
            when {
                allOf {
                    expression { env.PIPELINE_SKIPPED != 'true' }
                    expression { !isValidateOnly() }
                    anyOf {
                        branch 'main'
                        allOf {
                            expression { params.FORCE_DEPLOY }
                            branch 'main'
                        }
                    }
                }
            }
            steps {
                container('builder') {
                    script {
                        def props = loadBuildVars()

                        withBuildVars(props) {
                            def shouldDeploy = (env.IMAGES_PUSHED == 'true') ||
                                               params.FORCE_DEPLOY || params.FORCE_BUILD || params.DEPLOY_ONLY

                            if (!shouldDeploy) {
                                if (checkEdgeNodeHealth('https://doorway.elohim.host')) {
                                    echo "Prod edge node is healthy - skipping deployment"
                                    return
                                }

                                // Edge node unhealthy - check if we have images to deploy
                                echo "Prod edge node unhealthy - checking if latest images exist in Harbor..."
                                def imageExists = sh(
                                    script: '''
                                        curl -sf -o /dev/null \
                                            "https://harbor.ethosengine.com/v2/ethosengine/elohim-edgenode/manifests/latest" \
                                            2>/dev/null
                                    ''',
                                    returnStatus: true
                                ) == 0

                                if (!imageExists) {
                                    echo """
                                    ═══════════════════════════════════════════════════════════
                                    CANNOT AUTO-HEAL PROD: No images available in Harbor
                                    ═══════════════════════════════════════════════════════════
                                    Production edge node is unhealthy but no latest images exist.

                                    To fix: Run pipeline on main branch with FORCE_BUILD=true
                                    ═══════════════════════════════════════════════════════════
                                    """
                                    return
                                }

                                echo "Found latest images - attempting auto-heal restart"
                                shouldDeploy = true
                            }

                            echo """
                            ═══════════════════════════════════════════════════════════
                            DEPLOYING EDGE NODE TO PRODUCTION
                            ═══════════════════════════════════════════════════════════
                            Image Tag: ${IMAGE_TAG}
                            ═══════════════════════════════════════════════════════════
                            """

                            // Resolve topology: main branch uses distributed strategy
                            def allHumans = resolveHumanAssignments('distributed', '')
                            def prodHumans = allHumans.findAll { it.env == 'prod' }

                            def envFile = 'genesis/orchestrator/environments/prod.env'
                            if (params.DEPLOY_ONLY) {
                                deployOnlyEnvFilePreflight(envFile, 'prod')
                            } else {
                                def currentSiteTag = readProperties(file: envFile).SITE_TAG ?: 'latest'
                                writeFile file: envFile, text: """# Production Environment - auto-updated by pipeline after each deploy
# Format: COMPONENT_TAG=harbor-image-tag
SITE_TAG=${currentSiteTag}
EDGENODE_TAG=${EDGENODE_TAG}
DOORWAY_TAG=${DOORWAY_TAG}
DOORWAY_DIGEST=${env.DOORWAY_DIGEST ?: ''}
STORAGE_TAG=${STORAGE_TAG}
HAPP_INSTALLER_TAG=${HAPP_INSTALLER_TAG}
DOORWAY_APP_TAG=${DOORWAY_APP_TAG}
HAPP_TAG=${HAPP_TAG}
AGENT_SDK_TAG=${AGENT_SDK_TAG}
"""
                            }
                            // Per-human manifests — topology-aware, parallelized.
                            deployHumansInParallel(prodHumans, envFile, allHumans)

                            // Doorway — topology-aware
                            deployDoorwayManifest('prod', envFile, allHumans)

                            sh 'sleep 15'

                            if (checkEdgeNodeHealth('https://doorway.elohim.host')) {
                                echo "Edge Node Prod deployed and healthy: https://doorway.elohim.host"
                            } else {
                                echo "Edge Node deployed but health check failed"
                            }
                        }
                    }
                }
            }
        }

        stage('Cleanup') {
            when { expression { env.PIPELINE_SKIPPED != 'true' } }
            steps {
                container('builder') {
                    script {
                        def props = loadBuildVars()

                        withBuildVars(props) {
                            sh """
                                nerdctl -n k8s.io rmi elohim-edgenode:${IMAGE_TAG} || true
                                nerdctl -n k8s.io rmi harbor.ethosengine.com/ethosengine/elohim-edgenode:${IMAGE_TAG} || true
                                nerdctl -n k8s.io rmi elohim-doorway:${IMAGE_TAG} || true
                                nerdctl -n k8s.io rmi harbor.ethosengine.com/ethosengine/elohim-doorway:${IMAGE_TAG} || true
                                nerdctl -n k8s.io rmi elohim-storage:${IMAGE_TAG} || true
                                nerdctl -n k8s.io rmi harbor.ethosengine.com/ethosengine/elohim-storage:${IMAGE_TAG} || true
                                nerdctl -n k8s.io rmi elohim-happ-installer:${IMAGE_TAG} || true
                                nerdctl -n k8s.io rmi harbor.ethosengine.com/ethosengine/elohim-happ-installer:${IMAGE_TAG} || true
                                nerdctl -n k8s.io rmi elohim-agent-sdk:${IMAGE_TAG} || true
                                nerdctl -n k8s.io rmi harbor.ethosengine.com/ethosengine/elohim-agent-sdk:${IMAGE_TAG} || true
                                nerdctl -n k8s.io system prune -af --volumes || true
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                def props = loadBuildVars()

                def summary = """
                ═══════════════════════════════════════════════════════════
                HOLOCHAIN PIPELINE SUMMARY
                ═══════════════════════════════════════════════════════════
                Branch: ${env.BRANCH_NAME}
                Image Tag: ${props.IMAGE_TAG ?: 'N/A'}

                Pipeline State:
                  - hApp Available: ${env.HAPP_AVAILABLE == 'true' ? 'Yes' : 'No'}
                  - Images Pushed: ${env.IMAGES_PUSHED == 'true' ? 'Yes' : 'Skipped'}
                  - Edge Node Healthy: ${env.EDGE_NODE_HEALTHY == 'true' ? 'Yes' : 'Unknown'}

                Parameters Used:
                  - Force Build: ${params.FORCE_BUILD}
                  - Force Deploy: ${params.FORCE_DEPLOY}
                  - Deploy Strategy: ${params.DEPLOY_STRATEGY ?: 'alpha-concentration'}
                  - Reset Humans: ${params.RESET_HUMANS ?: false}

                Note: Seeding handled by genesis/Jenkinsfile
                ═══════════════════════════════════════════════════════════
                """

                echo summary

                currentBuild.description = [
                    env.HAPP_AVAILABLE == 'true' ? 'hApp:OK' : 'hApp:NO',
                    env.IMAGES_PUSHED == 'true' ? 'Push:OK' : 'Push:Skip',
                    env.EDGE_NODE_HEALTHY == 'true' ? 'Deploy:OK' : 'Deploy:?'
                ].join(' | ')
            }
        }
        success {
            echo "Holochain infrastructure pipeline completed successfully"
        }
        failure {
            echo "Holochain infrastructure pipeline failed"
            echo "Check the logs above for details. Common issues:"
            echo "  - hApp artifact not found: Run with FORCE_BUILD after DNA build succeeds"
            echo "  - Nix build timeout: First build needs more time for cache population"
            echo "  - Edge node unhealthy: Check Kubernetes pod logs"
        }
    }
}
