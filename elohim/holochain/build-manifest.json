{
  "manifestVersion": "1.0",
  "pipeline": "elohim-edge",
  "jenkinsPath": "elohim/holochain/Jenkinsfile",
  "manualOnly": false,
  "triggersGenesis": true,
  "dependsOn": [
    "elohim-holochain",
    "elohim-conductor"
  ],
  "description": "Edge services \u2014 doorway gateway, storage, conductor, edge image",
  "steps": {
    "cargo-build-doorway": {
      "description": "Build doorway gateway container image (Rust binary compiled inside Docker)",
      "inputs": {
        "sources": [
          "doorway/doorway-service/src/**",
          "doorway/doorway-service/Cargo.toml",
          "doorway/doorway-service/Cargo.lock",
          "doorway/doorway-service/Dockerfile",
          "vendor/**",
          "crates/doorway-client/**",
          "crates/seam-contracts/**",
          "elohim/elohim-render/**",
          "elohim/elohim-views/**",
          "elohim/elohim-cache-core/**",
          "elohim/elohim-compute/**",
          "elohim/elohim-agent/**",
          "elohim/elohim-peer-fabric/**",
          "elohim/Cargo.lock",
          "relay-addr-beacon/**",
          "iroh-relay/**"
        ],
        "buildProcess": [
          "elohim/holochain/Jenkinsfile"
        ]
      },
      "outputs": {
        "artifacts": [
          "doorway-binary"
        ],
        "verify": null
      },
      "depends": [],
      "executor": {
        "stage": "Build Doorway",
        "function": null
      }
    },
    "cargo-build-storage": {
      "description": "Build elohim-storage container image (Rust binary compiled inside Docker)",
      "inputs": {
        "sources": [
          "elohim/elohim-storage/src/**",
          "elohim/elohim-storage/benches/**",
          "elohim/elohim-storage/migrations/**",
          "elohim/elohim-storage/Cargo.toml",
          "elohim/elohim-storage/Cargo.lock",
          "elohim/elohim-storage/Dockerfile",
          "storage-iroh/**",
          "scripts/ci/push-storage-iroh.sh",
          "vendor/**",
          "elohim/sdk/**",
          "elohim/epr/**",
          "elohim/elohim-views/**",
          "elohim/elohim-facings/**",
          "elohim/elohim-peer-fabric/**",
          "elohim/elohim-render/**",
          "elohim/elohim-chrome-asset/**",
          "elohim/constitution/**",
          "crates/**",
          "bridges/**",
          "elohim/Cargo.lock"
        ],
        "buildProcess": [
          "elohim/holochain/Jenkinsfile"
        ]
      },
      "outputs": {
        "artifacts": [
          "storage-binary"
        ],
        "verify": null
      },
      "depends": [
        "elohim-conductor:build-conductor-image"
      ],
      "executor": {
        "stage": "Build Storage",
        "function": null
      }
    },
    "sdk-feature-matrix": {
      "description": "Run elohim-sdk tests across its advertised feature sets, plus fmt and clippy",
      "inputs": {
        "sources": [
          "crates/elohim-sdk/**",
          "crates/elohim-storage-client/**",
          "crates/doorway-client/**",
          "crates/seam-contracts/**",
          "elohim/elohim-views/**",
          "scripts/ci/elohim-sdk-feature-matrix.sh"
        ],
        "buildProcess": [
          "elohim/holochain/Jenkinsfile"
        ]
      },
      "outputs": {
        "artifacts": [],
        "verify": null
      },
      "depends": [],
      "executor": {
        "stage": "Build Storage",
        "function": "runElohimSdkFeatureMatrix"
      }
    },
    "build-edge-image": {
      "description": "Package doorway + storage + conductor into edge container image",
      "inputs": {
        "sources": [
          "elohim/holochain/edgenode/**",
          "elohim/holochain/*.yaml"
        ],
        "buildProcess": [
          "elohim/holochain/Jenkinsfile"
        ]
      },
      "outputs": {
        "artifacts": [
          "edge-image"
        ],
        "verify": null
      },
      "depends": [
        "cargo-build-doorway",
        "cargo-build-storage",
        "elohim-holochain:build-happ"
      ],
      "executor": {
        "stage": "Build Edge Node Image",
        "function": null
      }
    },
    "deploy-manifests": {
      "description": "k8s manifests + render-time data applied during edge deploy. Listed here so manifest-only or deployment-record-only changes mark elohim-edge stale; actual kubectl apply runs in the existing Deploy Edge Node stages. genesis/orchestrator/data/** covers deployments.json (per-human StatefulSet records consumed by elohim/holochain/Jenkinsfile line 243 via readJSON to render edge nodes).",
      "inputs": {
        "sources": [
          "genesis/orchestrator/manifests/doorway/**",
          "genesis/orchestrator/manifests/infra/**",
          "genesis/orchestrator/manifests/humans/**",
          "genesis/orchestrator/environments/**",
          "genesis/orchestrator/data/**"
        ],
        "buildProcess": [
          "elohim/holochain/Jenkinsfile"
        ]
      },
      "outputs": {
        "artifacts": [],
        "verify": null
      },
      "depends": [
        "build-edge-image"
      ],
      "executor": {
        "stage": "Deploy Edge Node - Alpha",
        "function": null
      }
    },
    "dataplane-validation": {
      "description": "Advisory @dataplane cucumber suite against deployed alpha (scripts/ci/run-dataplane-validation.sh), producing the per-concern sprint-report the agentic-developer loop measures against. Declared with no build/deploy dependency and no artifacts \u2014 the Jenkinsfile stage's own `when { branch 'dev' || ... }` already runs it on every dev-branch pipeline execution regardless of what triggered that execution; this entry's only job is making sure the PIPELINE ITSELF gets triggered when only the a2o test surface changes (2026-07-03: an a2o-only push was silently skipped end-to-end because no elohim-edge step declared these paths as sources \u2014 the suite went unmeasured, not merely unchanged).",
      "inputs": {
        "sources": [
          "genesis/a2o/steps/**",
          "genesis/a2o/features/dataplane/**",
          "genesis/a2o/features/resilience/**",
          "scripts/ci/run-dataplane-validation.sh"
        ],
        "buildProcess": [
          "elohim/holochain/Jenkinsfile"
        ]
      },
      "outputs": {
        "artifacts": [],
        "verify": null
      },
      "depends": [],
      "executor": {
        "stage": "Dataplane Validation",
        "function": null
      }
    }
  },
  "gate": {
    "projects": {
      "elohim-sdk": {
        "dir": "crates/elohim-sdk",
        "steps": [
          "sdk-feature-matrix"
        ]
      },
      "doorway": {
        "dir": "doorway/doorway-service",
        "steps": [
          "cargo-build-doorway"
        ]
      },
      "elohim-storage": {
        "dir": "elohim/elohim-storage",
        "steps": [
          "cargo-build-storage"
        ]
      }
    }
  },
  "deployment": {
    "targets": {
      "alpha": {
        "healthCheck": "https://doorway-alpha.elohim.host/health"
      },
      "staging": {
        "healthCheck": "https://doorway-staging.elohim.host/health"
      }
    }
  }
}
