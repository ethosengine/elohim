# Invoked through the manifest gate runner, which supplies the native pool slot.
gate:
    bash ../../genesis/orchestrator/gate-steps.sh \
      fmt -- cargo fmt --check -p elohim-placement-core \
      ::: lint -- node ../../genesis/orchestrator/cargo-lint.mjs -p elohim-placement-core --all-targets --all-features -- -D warnings \
      ::: test -- cargo test -p elohim-placement-core --all-features \
      ::: test-runtime -- cargo test -p elohim-compute --no-default-features \
      ::: lint-runtime -- node ../../genesis/orchestrator/cargo-lint.mjs -p elohim-compute --no-default-features --all-targets -- -D warnings
