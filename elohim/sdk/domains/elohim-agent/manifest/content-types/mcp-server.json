{
  "description": "A reusable, non-secret MCP server capability definition that runtime projection bindings can register for agent use.",
  "metadataSchema": { "$ref": "./schemas/mcp-server-metadata.schema.json" },
  "coupling": {
    "knowledge": {
      "relationships": {
        "USES": ["agent", "agent-spec", "mcp-profile"],
        "GOVERNS": ["policy"],
        "PROJECTS": ["projection-binding"]
      }
    },
    "value": {
      "onConsume": {
        "action": "use",
        "resourceConformsTo": "agentic-tool-provider",
        "recognition": "capability-standing"
      }
    },
    "governance": {
      "defaultReach": "community",
      "minimumReach": "private",
      "governanceModel": "steward-consent",
      "signalTypes": ["capability-used", "projection-drift-detected"]
    },
    "claims": [
      {
        "asserts": "capability-usable",
        "contradictedBy": "projection-drift",
        "validityHorizon": "P90D",
        "leg": "governance"
      }
    ]
  }
}
