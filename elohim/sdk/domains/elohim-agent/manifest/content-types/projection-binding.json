{
  "description": "A mapping from canonical agentic capability artifacts to runtime-specific surfaces such as skill folders, agent config files, hooks, or plugin manifests.",
  "metadataSchema": { "$ref": "./schemas/projection-binding-metadata.schema.json" },
  "coupling": {
    "knowledge": {
      "relationships": {
        "PROJECTS": ["skill", "agent", "agent-spec", "hook", "policy", "validator"],
        "VALIDATES": ["validator"]
      }
    },
    "value": {
      "onConsume": {
        "action": "use",
        "resourceConformsTo": "runtime-projection",
        "recognition": "capability-standing"
      }
    },
    "governance": {
      "defaultReach": "community",
      "minimumReach": "private",
      "governanceModel": "steward-consent",
      "signalTypes": ["projection-drift-detected", "validation-executed"]
    },
    "claims": [
      { "asserts": "capability-usable", "contradictedBy": "projection-drift", "validityHorizon": "P90D", "leg": "knowledge" }
    ]
  }
}
