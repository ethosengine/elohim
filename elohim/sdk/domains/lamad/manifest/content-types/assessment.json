{
  "description": "A graded evaluation of learner understanding. Produces mastery attestations and drives the mastery level progression.",
  "metadataSchema": {
    "$ref": "./schemas/assessment-metadata.schema.json"
  },
  "coupling": {
    "knowledge": {
      "relationships": {
        "VALIDATES": [
          "concept",
          "lesson"
        ],
        "BELONGS_TO": [
          "path",
          "course-module"
        ],
        "REQUIRES": [
          "concept"
        ]
      }
    },
    "value": {
      "onConsume": {
        "action": "use",
        "resourceConformsTo": "evaluation",
        "recognition": "mastery-credit"
      },
      "onComplete": {
        "action": "produce",
        "resourceConformsTo": "mastery-attestation",
        "recognition": "mastery-credit"
      }
    },
    "governance": {
      "defaultReach": "commons",
      "minimumReach": "community",
      "governanceModel": "steward-consent",
      "signalTypes": [
        "assessment-completed",
        "mastery-achieved"
      ]
    },
    "claims": [
      {
        "asserts": "knowledge-retention",
        "contradictedBy": "retention-failure",
        "validityHorizon": "P30D",
        "leg": "knowledge"
      },
      {
        "asserts": "mastery-attestation-meaningful",
        "contradictedBy": "downstream-prerequisite-failure",
        "validityHorizon": "P90D",
        "leg": "value"
      }
    ]
  }
}
