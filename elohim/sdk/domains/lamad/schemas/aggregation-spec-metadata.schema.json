{
  "$id": "lamad:schema:metadata:aggregation-spec",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AggregationSpecMetadata",
  "description": "Parameter artifact for `aggregate-attestations` step type (spec §2.1). Declares how a step queries the DHT attestation graph and reduces results into a scalar output. Example: reach-gate's community/public/protocol threshold computation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["specName", "version", "attestationKinds", "reduction"],
  "properties": {
    "specName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+$",
      "description": "Kebab-case aggregation spec name (e.g., reach-level-v1)."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of this aggregation spec."
    },
    "description": {
      "type": "string",
      "description": "What this aggregation computes."
    },
    "attestationKinds": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Which attestation kinds (or content-addressed attestation shape names) feed this aggregation."
    },
    "subjectScope": {
      "type": "string",
      "enum": ["content-node", "agent", "gate-decision", "app-manifest"],
      "description": "What the aggregation's subject represents."
    },
    "timeWindow": {
      "type": ["string", "null"],
      "description": "ISO 8601 duration limiting the aggregation window (e.g., P180D). Null = all time."
    },
    "reduction": {
      "$ref": "#/$defs/Reduction",
      "description": "How query results reduce to a scalar."
    },
    "outputShape": {
      "type": "string",
      "description": "Shape of the reduced output (e.g., ReachLevel enum, numeric threshold, weighted score)."
    }
  },
  "$defs": {
    "Reduction": {
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "count" },
            "requiredCount": { "type": "integer", "minimum": 0 }
          },
          "required": ["kind", "requiredCount"]
        },
        {
          "properties": {
            "kind": { "const": "weighted-sum" },
            "weights": {
              "type": "object",
              "additionalProperties": { "type": "number" },
              "description": "Map of attestation-kind to weight."
            },
            "threshold": { "type": "number" }
          },
          "required": ["kind", "weights", "threshold"]
        },
        {
          "properties": {
            "kind": { "const": "threshold-ladder" },
            "tiers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["level", "minCount"],
                "properties": {
                  "level": { "type": "string", "description": "Output value at this tier (e.g., community, public, protocol)." },
                  "minCount": { "type": "integer", "minimum": 0 }
                }
              },
              "description": "Ordered tiers, highest-qualified wins."
            }
          },
          "required": ["kind", "tiers"]
        }
      ]
    }
  }
}
