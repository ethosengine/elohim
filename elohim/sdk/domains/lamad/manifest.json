{
  "id": "manifest-lamad",
  "name": "lamad",
  "version": "1.0.0",
  "description": "Learning and mastery platform — knowledge discovery, assessment, paths, and stewardship",
  "vocabulary": {
    "contentTypes": {
      "concept": {
        "description": "A fundamental idea or principle in the knowledge graph. Concepts are the atomic units of understanding that learners build mastery over.",
        "metadataSchema": { "$ref": "./schemas/concept-metadata.schema.json" },
        "coupling": {
          "knowledge": {
            "relationships": {
              "CONTAINS": ["concept", "exercise", "assessment"],
              "RELATES_TO": ["concept", "lesson", "article"],
              "DEPENDS_ON": ["concept"],
              "REFERENCES": ["article", "book-chapter"]
            }
          },
          "value": {
            "onConsume": {
              "action": "use",
              "resourceConformsTo": "learning-content",
              "recognition": "mastery-credit"
            },
            "onComplete": {
              "action": "produce",
              "resourceConformsTo": "mastery-attestation",
              "recognition": "mastery-credit"
            }
          },
          "governance": {
            "defaultReach": "commons",
            "minimumReach": "community",
            "governanceModel": "steward-consent",
            "signalTypes": ["learning-signal", "mastery-achieved"]
          },
          "claims": [
            { "asserts": "knowledge-retention", "contradictedBy": "retention-failure", "validityHorizon": "P30D", "leg": "knowledge" },
            { "asserts": "content-relevant", "contradictedBy": "content-outdated", "validityHorizon": "P180D", "leg": "knowledge" }
          ]
        }
      },
      "lesson": {
        "description": "A structured teaching unit that guides learners through a topic with explanations, examples, and practice opportunities.",
        "coupling": {
          "knowledge": {
            "relationships": {
              "CONTAINS": ["concept", "exercise", "assessment", "reflection"],
              "BELONGS_TO": ["path", "course-module"],
              "FOLLOWS": ["lesson"],
              "REQUIRES": ["concept"]
            }
          },
          "value": {
            "onConsume": {
              "action": "use",
              "resourceConformsTo": "learning-content",
              "recognition": "mastery-credit"
            },
            "onComplete": {
              "action": "produce",
              "resourceConformsTo": "mastery-attestation",
              "recognition": "mastery-credit"
            }
          },
          "governance": {
            "defaultReach": "commons",
            "minimumReach": "community",
            "governanceModel": "steward-consent",
            "signalTypes": ["learning-signal", "mastery-achieved"]
          },
          "claims": [
            { "asserts": "knowledge-retention", "contradictedBy": "retention-failure", "validityHorizon": "P30D", "leg": "knowledge" },
            { "asserts": "content-relevant", "contradictedBy": "content-outdated", "validityHorizon": "P180D", "leg": "knowledge" }
          ]
        }
      },
      "assessment": {
        "description": "A graded evaluation of learner understanding. Produces mastery attestations and drives the mastery level progression.",
        "metadataSchema": { "$ref": "./schemas/assessment-metadata.schema.json" },
        "coupling": {
          "knowledge": {
            "relationships": {
              "VALIDATES": ["concept", "lesson"],
              "BELONGS_TO": ["path", "course-module"],
              "REQUIRES": ["concept"]
            }
          },
          "value": {
            "onConsume": {
              "action": "use",
              "resourceConformsTo": "evaluation",
              "recognition": "mastery-credit"
            },
            "onComplete": {
              "action": "produce",
              "resourceConformsTo": "mastery-attestation",
              "recognition": "mastery-credit"
            }
          },
          "governance": {
            "defaultReach": "commons",
            "minimumReach": "community",
            "governanceModel": "steward-consent",
            "signalTypes": ["assessment-completed", "mastery-achieved"]
          },
          "claims": [
            { "asserts": "knowledge-retention", "contradictedBy": "retention-failure", "validityHorizon": "P30D", "leg": "knowledge" },
            { "asserts": "mastery-attestation-meaningful", "contradictedBy": "downstream-prerequisite-failure", "validityHorizon": "P90D", "leg": "value" }
          ]
        }
      },
      "exercise": {
        "description": "A practice activity that reinforces understanding. Unlike assessments, exercises are ungraded and focus on skill building.",
        "coupling": {
          "knowledge": {
            "relationships": {
              "BELONGS_TO": ["lesson", "concept"],
              "VALIDATES": ["concept"],
              "RELATES_TO": ["exercise"]
            }
          },
          "value": {
            "onConsume": {
              "action": "use",
              "resourceConformsTo": "practice",
              "recognition": "mastery-credit"
            }
          },
          "governance": {
            "defaultReach": "commons",
            "minimumReach": "community",
            "governanceModel": "steward-consent",
            "signalTypes": ["practice-engagement", "learning-signal"]
          },
          "claims": [
            { "asserts": "knowledge-retention", "contradictedBy": "retention-failure", "validityHorizon": "P30D", "leg": "knowledge" }
          ]
        }
      },
      "experience-story": {
        "description": "A durable narrative junction representing (subject, role, feature) — the persona's experience with a feature in a given role. Accumulates value via :story-point attestations over time.",
        "metadataSchema": { "$ref": "./schemas/experience-story-metadata.schema.json" },
        "coupling": {
          "knowledge": {
            "relationships": {
              "HAS_SUBJECT": ["human", "collective"],
              "IN_ROLE": ["role"],
              "EXERCISES": ["feature"]
            }
          },
          "value": {
            "onAttest": { "action": "produce", "resourceConformsTo": "experience-evidence" }
          },
          "governance": { "defaultReach": "self", "governanceModel": "steward-consent" },
          "claims": [
            {
              "asserts": "community-value-confirmed",
              "contradictedBy": "content-misleading",
              "validityHorizon": "P90D",
              "leg": "knowledge"
            }
          ]
        }
      },
      "experience-moment": {
        "description": "One persona's first-person recording of one scenario at one moment. Agent-scoped (private source-chain entry). Projected locally per persona; never gossipped.",
        "metadataSchema": { "$ref": "./schemas/experience-moment-metadata.schema.json" },
        "coupling": {
          "knowledge": { "relationships": { "ATTESTS_TO": ["experience-story"] } },
          "value": {},
          "governance": { "defaultReach": "self", "governanceModel": "agent-scoped" },
          "claims": [
            {
              "asserts": "community-value-confirmed",
              "contradictedBy": "content-misleading",
              "validityHorizon": "P30D",
              "leg": "knowledge"
            }
          ]
        }
      },
      "reflection": {
        "description": "An open-ended prompt for self-reflection and metacognition. Not graded — produces qualitative insight rather than scores.",
        "coupling": {
          "knowledge": {
            "relationships": {
              "BELONGS_TO": ["lesson", "path"],
              "RELATES_TO": ["concept", "discussion"]
            }
          },
          "value": {
            "onConsume": {
              "action": "use",
              "resourceConformsTo": "learning-content",
              "recognition": "mastery-credit"
            }
          },
          "governance": {
            "defaultReach": "commons",
            "minimumReach": "community",
            "governanceModel": "steward-consent",
            "signalTypes": ["learning-signal"]
          },
          "claims": [
            { "asserts": "content-relevant", "contradictedBy": "content-outdated", "validityHorizon": "P180D", "leg": "knowledge" }
          ]
        }
      },
      "discussion": {
        "description": "A collaborative dialogue space tied to content. Enables peer learning and community sensemaking around topics.",
        "coupling": {
          "knowledge": {
            "relationships": {
              "RELATES_TO": ["concept", "lesson", "article"],
              "BELONGS_TO": ["path", "course-module"]
            }
          },
          "value": {
            "onConsume": {
              "action": "use",
              "resourceConformsTo": "learning-content",
              "recognition": "mastery-credit"
            },
            "onContribute": {
              "action": "produce",
              "resourceConformsTo": "contribution",
              "recognition": "contribution-record"
            }
          },
          "governance": {
            "defaultReach": "community",
            "minimumReach": "intimate",
            "governanceModel": "community-vote",
            "signalTypes": ["learning-signal", "contribution-created"]
          },
          "claims": [
            { "asserts": "community-value-confirmed", "contradictedBy": "engagement-decline", "validityHorizon": "P90D", "leg": "value" }
          ]
        }
      },
      "article": {
        "description": "Long-form written content — essays, explainers, deep dives. The primary narrative format for knowledge sharing.",
        "coupling": {
          "knowledge": {
            "relationships": {
              "DESCRIBES": ["concept", "epic"],
              "REFERENCES": ["article", "book-chapter"],
              "RELATES_TO": ["lesson", "concept"]
            }
          },
          "value": {
            "onConsume": {
              "action": "use",
              "resourceConformsTo": "learning-content",
              "recognition": "mastery-credit"
            },
            "onContribute": {
              "action": "produce",
              "resourceConformsTo": "contribution",
              "recognition": "stewardship-standing"
            }
          },
          "governance": {
            "defaultReach": "commons",
            "minimumReach": "community",
            "governanceModel": "steward-consent",
            "signalTypes": ["learning-signal", "contribution-created"]
          },
          "claims": [
            { "asserts": "content-relevant", "contradictedBy": "content-outdated", "validityHorizon": "P180D", "leg": "knowledge" },
            { "asserts": "stewardship-distributed", "contradictedBy": "stewardship-concentrated", "validityHorizon": "P180D", "leg": "governance" }
          ]
        }
      },
      "path": {
        "description": "A curated learning journey — an ordered sequence of steps through content. Paths are EPR composites that reference other content types.",
        "metadataSchema": { "$ref": "./schemas/path-metadata.schema.json" },
        "coupling": {
          "knowledge": {
            "relationships": {
              "CONTAINS": ["concept", "lesson", "assessment", "exercise", "reflection", "article", "simulation"],
              "FOLLOWS": ["path"],
              "REQUIRES": ["path", "concept"]
            }
          },
          "value": {
            "onConsume": {
              "action": "use",
              "resourceConformsTo": "learning-content",
              "recognition": "mastery-credit"
            },
            "onComplete": {
              "action": "produce",
              "resourceConformsTo": "path-completion",
              "recognition": "mastery-credit"
            },
            "onContribute": {
              "action": "produce",
              "resourceConformsTo": "contribution",
              "recognition": "stewardship-standing"
            }
          },
          "governance": {
            "defaultReach": "commons",
            "minimumReach": "community",
            "governanceModel": "steward-consent",
            "signalTypes": ["path-completed", "learning-signal"]
          },
          "claims": [
            { "asserts": "learning-outcome-achieved", "contradictedBy": "path-completion-without-retention", "validityHorizon": "P90D", "leg": "knowledge" },
            { "asserts": "content-relevant", "contradictedBy": "content-outdated", "validityHorizon": "P180D", "leg": "knowledge" },
            { "asserts": "stewardship-distributed", "contradictedBy": "stewardship-concentrated", "validityHorizon": "P180D", "leg": "governance" }
          ]
        }
      },
      "epic": {
        "description": "A high-level narrative arc that organizes features and scenarios into a coherent story. Epics frame the why behind learning content.",
        "coupling": {
          "knowledge": {
            "relationships": {
              "CONTAINS": ["feature", "scenario", "article"],
              "DESCRIBES": ["concept", "path"],
              "RELATES_TO": ["epic"]
            }
          },
          "value": {
            "onConsume": {
              "action": "use",
              "resourceConformsTo": "learning-content",
              "recognition": "mastery-credit"
            }
          },
          "governance": {
            "defaultReach": "commons",
            "minimumReach": "community",
            "governanceModel": "steward-consent",
            "signalTypes": ["learning-signal"]
          },
          "claims": [
            { "asserts": "content-relevant", "contradictedBy": "content-outdated", "validityHorizon": "P365D", "leg": "knowledge" }
          ]
        }
      },
      "scenario": {
        "description": "A BDD scenario specifying observable behavior — Given/When/Then. Scenarios are executable specifications that validate learning outcomes.",
        "coupling": {
          "knowledge": {
            "relationships": {
              "BELONGS_TO": ["epic", "feature"],
              "VALIDATES": ["concept", "lesson"],
              "IMPLEMENTS": ["epic"]
            }
          },
          "value": {
            "onConsume": {
              "action": "use",
              "resourceConformsTo": "learning-content",
              "recognition": "mastery-credit"
            }
          },
          "governance": {
            "defaultReach": "commons",
            "minimumReach": "community",
            "governanceModel": "steward-consent",
            "signalTypes": ["learning-signal"]
          },
          "claims": [
            { "asserts": "content-relevant", "contradictedBy": "content-outdated", "validityHorizon": "P365D", "leg": "knowledge" }
          ]
        }
      },
      "discovery-assessment": {
        "description": "Self-discovery quiz (Enneagram, learning style, values inventory). Ungraded — produces psychometric insights rather than scores.",
        "coupling": {
          "knowledge": {
            "relationships": {
              "RELATES_TO": ["concept", "instrument"],
              "BELONGS_TO": ["path"]
            }
          },
          "value": {
            "onConsume": {
              "action": "use",
              "resourceConformsTo": "evaluation",
              "recognition": "mastery-credit"
            },
            "onComplete": {
              "action": "produce",
              "resourceConformsTo": "self-knowledge",
              "recognition": "mastery-credit"
            }
          },
          "governance": {
            "defaultReach": "commons",
            "minimumReach": "community",
            "governanceModel": "steward-consent",
            "signalTypes": ["assessment-completed", "learning-signal"]
          },
          "claims": [
            { "asserts": "content-relevant", "contradictedBy": "content-outdated", "validityHorizon": "P365D", "leg": "knowledge" }
          ]
        }
      },
      "instrument": {
        "description": "A psychometric instrument definition — subscales, scoring rules, and display configuration for discovery assessments.",
        "coupling": {
          "knowledge": {
            "relationships": {
              "DESCRIBES": ["discovery-assessment"],
              "RELATES_TO": ["concept"]
            }
          },
          "value": {
            "onContribute": {
              "action": "produce",
              "resourceConformsTo": "contribution",
              "recognition": "stewardship-standing"
            }
          },
          "governance": {
            "defaultReach": "commons",
            "minimumReach": "community",
            "governanceModel": "steward-consent",
            "signalTypes": ["contribution-created"]
          },
          "claims": [
            { "asserts": "content-relevant", "contradictedBy": "content-outdated", "validityHorizon": "P365D", "leg": "knowledge" }
          ]
        }
      },
      "quiz": {
        "description": "A lightweight graded question set — simpler than a full assessment, typically embedded within lessons or used for quick knowledge checks.",
        "coupling": {
          "knowledge": {
            "relationships": {
              "VALIDATES": ["concept", "lesson"],
              "BELONGS_TO": ["lesson", "course-module"]
            }
          },
          "value": {
            "onConsume": {
              "action": "use",
              "resourceConformsTo": "evaluation",
              "recognition": "mastery-credit"
            },
            "onComplete": {
              "action": "produce",
              "resourceConformsTo": "mastery-attestation",
              "recognition": "mastery-credit"
            }
          },
          "governance": {
            "defaultReach": "commons",
            "minimumReach": "community",
            "governanceModel": "steward-consent",
            "signalTypes": ["assessment-completed", "mastery-achieved"]
          },
          "claims": [
            { "asserts": "knowledge-retention", "contradictedBy": "retention-failure", "validityHorizon": "P30D", "leg": "knowledge" },
            { "asserts": "mastery-attestation-meaningful", "contradictedBy": "downstream-prerequisite-failure", "validityHorizon": "P90D", "leg": "value" }
          ]
        }
      },
      "course-module": {
        "description": "A thematic grouping of lessons, exercises, and assessments within a path. Provides intermediate structure between path and individual content.",
        "coupling": {
          "knowledge": {
            "relationships": {
              "CONTAINS": ["lesson", "assessment", "exercise", "quiz"],
              "BELONGS_TO": ["path"],
              "FOLLOWS": ["course-module"],
              "REQUIRES": ["course-module", "concept"]
            }
          },
          "value": {
            "onConsume": {
              "action": "use",
              "resourceConformsTo": "learning-content",
              "recognition": "mastery-credit"
            },
            "onComplete": {
              "action": "produce",
              "resourceConformsTo": "mastery-attestation",
              "recognition": "mastery-credit"
            }
          },
          "governance": {
            "defaultReach": "commons",
            "minimumReach": "community",
            "governanceModel": "steward-consent",
            "signalTypes": ["learning-signal", "mastery-achieved"]
          },
          "claims": [
            { "asserts": "learning-outcome-achieved", "contradictedBy": "path-completion-without-retention", "validityHorizon": "P90D", "leg": "knowledge" },
            { "asserts": "content-relevant", "contradictedBy": "content-outdated", "validityHorizon": "P180D", "leg": "knowledge" }
          ]
        }
      },
      "module": {
        "description": "A generic content module — a reusable, self-contained unit that can be composed into different paths and course structures.",
        "coupling": {
          "knowledge": {
            "relationships": {
              "CONTAINS": ["lesson", "concept", "exercise"],
              "BELONGS_TO": ["path", "course-module"],
              "RELATES_TO": ["module"]
            }
          },
          "value": {
            "onConsume": {
              "action": "use",
              "resourceConformsTo": "learning-content",
              "recognition": "mastery-credit"
            }
          },
          "governance": {
            "defaultReach": "commons",
            "minimumReach": "community",
            "governanceModel": "steward-consent",
            "signalTypes": ["learning-signal"]
          },
          "claims": [
            { "asserts": "learning-outcome-achieved", "contradictedBy": "path-completion-without-retention", "validityHorizon": "P90D", "leg": "knowledge" },
            { "asserts": "content-relevant", "contradictedBy": "content-outdated", "validityHorizon": "P180D", "leg": "knowledge" }
          ]
        }
      },
      "community": {
        "description": "A community group or collective in the learning network. App-layer rendering hint for community identity and membership.",
        "coupling": {
          "knowledge": {
            "relationships": {
              "CONTAINS": ["path", "article", "discussion"],
              "RELATES_TO": ["community"]
            }
          },
          "value": {
            "onContribute": {
              "action": "produce",
              "resourceConformsTo": "contribution",
              "recognition": "stewardship-standing"
            }
          },
          "governance": {
            "defaultReach": "community",
            "minimumReach": "intimate",
            "governanceModel": "community-vote",
            "signalTypes": ["contribution-created"]
          },
          "claims": [
            { "asserts": "community-value-confirmed", "contradictedBy": "engagement-decline", "validityHorizon": "P90D", "leg": "value" }
          ]
        }
      },
      "tool": {
        "description": "An external tool or utility referenced in the learning context. Provides metadata and links for tools learners need during their journey.",
        "coupling": {
          "knowledge": {
            "relationships": {
              "RELATES_TO": ["concept", "lesson", "exercise"],
              "REFERENCES": ["article"]
            }
          },
          "value": {
            "onConsume": {
              "action": "use",
              "resourceConformsTo": "learning-content",
              "recognition": "mastery-credit"
            }
          },
          "governance": {
            "defaultReach": "commons",
            "minimumReach": "community",
            "governanceModel": "steward-consent",
            "signalTypes": ["learning-signal"]
          },
          "claims": [
            { "asserts": "content-relevant", "contradictedBy": "content-outdated", "validityHorizon": "P365D", "leg": "knowledge" }
          ]
        }
      },
      "placeholder": {
        "description": "A placeholder for missing or errored content. Shown when content cannot be loaded — ensures the graph remains navigable.",
        "coupling": {
          "value": {},
          "governance": {
            "defaultReach": "private",
            "minimumReach": "private",
            "governanceModel": "steward-consent"
          },
          "claims": [
            { "asserts": "content-relevant", "contradictedBy": "content-outdated", "validityHorizon": "P1D", "leg": "knowledge" }
          ]
        }
      },
      "simulation": {
        "description": "An interactive HTML5 simulation or game that teaches through experiential learning. Served via iframe from doorway.",
        "coupling": {
          "knowledge": {
            "relationships": {
              "VALIDATES": ["concept"],
              "BELONGS_TO": ["lesson", "path"],
              "RELATES_TO": ["exercise"]
            }
          },
          "value": {
            "onConsume": {
              "action": "use",
              "resourceConformsTo": "learning-content",
              "recognition": "mastery-credit"
            },
            "onComplete": {
              "action": "produce",
              "resourceConformsTo": "mastery-attestation",
              "recognition": "mastery-credit"
            }
          },
          "governance": {
            "defaultReach": "commons",
            "minimumReach": "community",
            "governanceModel": "steward-consent",
            "signalTypes": ["practice-engagement", "learning-signal"]
          },
          "claims": [
            { "asserts": "knowledge-retention", "contradictedBy": "retention-failure", "validityHorizon": "P30D", "leg": "knowledge" }
          ]
        }
      },
      "feature": {
        "description": "A BDD feature file grouping related scenarios. Maps to Gherkin Feature blocks and organizes executable specifications.",
        "coupling": {
          "knowledge": {
            "relationships": {
              "BELONGS_TO": ["epic"],
              "CONTAINS": ["scenario"],
              "IMPLEMENTS": ["epic"]
            }
          },
          "value": {
            "onConsume": {
              "action": "use",
              "resourceConformsTo": "learning-content",
              "recognition": "mastery-credit"
            }
          },
          "governance": {
            "defaultReach": "commons",
            "minimumReach": "community",
            "governanceModel": "steward-consent",
            "signalTypes": ["learning-signal"]
          },
          "claims": [
            { "asserts": "content-relevant", "contradictedBy": "content-outdated", "validityHorizon": "P365D", "leg": "knowledge" }
          ]
        }
      },
      "practice": {
        "description": "A structured practice activity with specific skill-building objectives. More guided than an exercise, with defined success criteria.",
        "coupling": {
          "knowledge": {
            "relationships": {
              "VALIDATES": ["concept"],
              "BELONGS_TO": ["lesson", "path"],
              "REQUIRES": ["concept"]
            }
          },
          "value": {
            "onConsume": {
              "action": "use",
              "resourceConformsTo": "practice",
              "recognition": "mastery-credit"
            },
            "onComplete": {
              "action": "produce",
              "resourceConformsTo": "mastery-attestation",
              "recognition": "mastery-credit"
            }
          },
          "governance": {
            "defaultReach": "commons",
            "minimumReach": "community",
            "governanceModel": "steward-consent",
            "signalTypes": ["practice-engagement", "mastery-achieved"]
          },
          "claims": [
            { "asserts": "knowledge-retention", "contradictedBy": "retention-failure", "validityHorizon": "P30D", "leg": "knowledge" },
            { "asserts": "mastery-attestation-meaningful", "contradictedBy": "downstream-prerequisite-failure", "validityHorizon": "P90D", "leg": "value" }
          ]
        }
      }
    },
    "contentFormats": {
      "markdown": {
        "description": "Markdown documents with optional YAML frontmatter. The primary narrative format for written content.",
        "renderer": "markdown-renderer",
        "mimeTypes": ["text/markdown", "text/x-markdown"],
        "extensions": ["md", "markdown"]
      },
      "gherkin": {
        "description": "Behavior-Driven Development feature files with Given/When/Then syntax. Executable specifications.",
        "renderer": "gherkin-renderer",
        "mimeTypes": ["text/x-gherkin"],
        "extensions": ["feature"]
      },
      "sophia-quiz-json": {
        "description": "Sophia psychometric assessment format for mastery quizzes, discovery assessments, and reflection prompts.",
        "renderer": "sophia-renderer",
        "mimeTypes": ["application/vnd.sophia.assessment+json"],
        "extensions": ["sophia.json", "sophia-quiz.json"],
        "aliases": ["sophia", "perseus-quiz-json"]
      },
      "html5-app": {
        "description": "Interactive HTML5 applications served from doorway. Content is extracted from zip archives and cached for iframe embedding.",
        "renderer": "iframe-renderer",
        "mimeTypes": ["application/zip", "application/x-zip-compressed"],
        "extensions": ["zip"]
      },
      "spa-bundle": {
        "description": "Single-page application served as a doorway's root web surface. ZIP archive extracted and cached by doorway with SPA routing (unmatched paths serve index.html).",
        "renderer": null,
        "mimeTypes": ["application/zip", "application/x-zip-compressed"],
        "extensions": ["zip"]
      },
      "epr-composite": {
        "description": "EPR composite layout — a content node whose body references other EPRs. Used for paths, curated collections, and landing pages.",
        "renderer": "path-renderer",
        "bodySchema": { "$ref": "./schemas/epr-composite-body.schema.json" }
      },
      "html": {
        "description": "HTML content rendered directly. Falls back to the markdown renderer for consistent styling.",
        "renderer": "markdown-renderer",
        "mimeTypes": ["text/html"],
        "extensions": ["html", "htm"]
      },
      "plaintext": {
        "description": "Plain text content with no formatting. Rendered through the markdown renderer for consistent layout.",
        "renderer": "markdown-renderer",
        "mimeTypes": ["text/plain"],
        "extensions": ["txt"]
      },
      "video-embed": {
        "description": "Embedded video content from external providers (YouTube, Vimeo). Rendered in an iframe with appropriate sizing.",
        "renderer": "iframe-renderer",
        "mimeTypes": ["text/x-video-embed"]
      },
      "json": {
        "description": "Raw JSON data format. Used for structured content that doesn't fit other format categories."
      }
    },
    "relationships": {
      "CONTAINS": {
        "description": "Parent-child hierarchical containment. The source contains the target as a sub-element.",
        "sourceTypes": ["path", "epic", "course-module", "module", "lesson", "concept", "community", "feature"],
        "targetTypes": ["concept", "lesson", "assessment", "exercise", "reflection", "discussion", "article", "scenario", "quiz", "simulation", "feature", "path"],
        "inverse": "BELONGS_TO"
      },
      "BELONGS_TO": {
        "description": "Reverse of CONTAINS — the source is a child of the target.",
        "sourceTypes": ["concept", "lesson", "assessment", "exercise", "reflection", "discussion", "scenario", "quiz", "simulation", "feature", "module"],
        "targetTypes": ["path", "epic", "course-module", "module", "lesson", "community", "feature"],
        "inverse": "CONTAINS"
      },
      "DESCRIBES": {
        "description": "High-level narrative describes a lower-level implementation. The source provides context or explanation for the target.",
        "sourceTypes": ["epic", "article", "instrument"],
        "targetTypes": ["concept", "lesson", "path", "discovery-assessment"]
      },
      "IMPLEMENTS": {
        "description": "Implementation realizes a narrative. The source concretely implements what the target describes.",
        "sourceTypes": ["scenario", "feature", "exercise"],
        "targetTypes": ["epic", "concept"]
      },
      "VALIDATES": {
        "description": "The source tests or verifies understanding of the target. Assessments validate concepts, scenarios validate features.",
        "sourceTypes": ["assessment", "quiz", "exercise", "scenario", "simulation", "practice"],
        "targetTypes": ["concept", "lesson", "feature"]
      },
      "RELATES_TO": {
        "description": "Generic bidirectional association between content. Used when a more specific relationship type does not apply.",
        "sourceTypes": ["concept", "lesson", "article", "discussion", "exercise", "tool", "module", "community", "discovery-assessment", "instrument", "simulation"],
        "targetTypes": ["concept", "lesson", "article", "discussion", "exercise", "tool", "module", "community", "epic", "instrument"]
      },
      "REFERENCES": {
        "description": "The source cites or references the target. A weaker form of RELATES_TO indicating directional citation.",
        "sourceTypes": ["article", "lesson", "concept", "tool"],
        "targetTypes": ["article", "book-chapter", "concept"]
      },
      "DEPENDS_ON": {
        "description": "The source depends on the target for correctness or completeness. Implies the target should exist for the source to be meaningful.",
        "sourceTypes": ["concept", "lesson", "assessment"],
        "targetTypes": ["concept", "lesson"]
      },
      "REQUIRES": {
        "description": "The source has a prerequisite relationship with the target. Learners must complete the target before the source.",
        "sourceTypes": ["lesson", "assessment", "path", "course-module", "practice"],
        "targetTypes": ["concept", "lesson", "path", "course-module"]
      },
      "FOLLOWS": {
        "description": "Sequential ordering — the source comes after the target in a learning sequence. Suggests but does not require completion order.",
        "sourceTypes": ["lesson", "path", "course-module"],
        "targetTypes": ["lesson", "path", "course-module"]
      },
      "ATTACHED_TO": {
        "description": "Attachment link — the source is attached supplementary material for the target (e.g., a story with attached media).",
        "sourceTypes": ["article", "simulation", "exercise"],
        "targetTypes": ["lesson", "concept", "path", "epic"]
      }
    },
    "signals": {
      "learning-signal": {
        "description": "Emitted when a learner engages with content — views, reads, or interacts. The foundational attention signal for the learning economy.",
        "substrateSignal": "attention",
        "economicAction": "use",
        "resourceType": "learning"
      },
      "mastery-achieved": {
        "description": "Emitted when a learner levels up in mastery for a concept. Produces a mastery attestation that flows value to content stewards.",
        "substrateSignal": "attention",
        "economicAction": "produce",
        "resourceType": "mastery-attestation"
      },
      "assessment-completed": {
        "description": "Emitted when a learner completes an assessment or quiz. Triggers evaluation resource accounting and recognition flows.",
        "substrateSignal": "compute",
        "economicAction": "use",
        "resourceType": "evaluation"
      },
      "path-completed": {
        "description": "Emitted when a learner completes all steps in a learning path. A major milestone that produces path-completion attestation.",
        "substrateSignal": "attention",
        "economicAction": "produce",
        "resourceType": "path-completion"
      },
      "practice-engagement": {
        "description": "Emitted when a learner actively practices with exercises, simulations, or interactive content. Distinct from passive viewing.",
        "substrateSignal": "attention",
        "economicAction": "use",
        "resourceType": "practice"
      },
      "contribution-created": {
        "description": "Emitted when a steward creates, curates, or reviews content. Produces a contribution record that builds stewardship standing.",
        "substrateSignal": "compute",
        "economicAction": "produce",
        "resourceType": "contribution"
      },
      "experience-attestation": {
        "substrateSignal": "attention",
        "economicAction": "produce",
        "resourceType": "experience-attestation",
        "description": "A :story-point attestation minted by the discernment gate when meaningful evidence is recognized. Emitted alongside the Holochain Link; dual-encoded as an EconomicEvent in shefa."
      },
      "peer-review-completed": {
        "description": "Emitted when a peer review of content is completed. Produces a peer attestation that strengthens content trust and steward standing.",
        "substrateSignal": "compute",
        "economicAction": "produce",
        "resourceType": "peer-attestation"
      }
    },
    "observations": {
      "knowledge-retention": {
        "description": "Learner can recall and apply concept after interval",
        "instrument": "retention-check",
        "polarity": "positive"
      },
      "retention-failure": {
        "description": "Learner cannot recall or apply concept after interval",
        "instrument": "retention-check",
        "polarity": "negative"
      },
      "mastery-attestation-meaningful": {
        "description": "Mastery-attested learners succeed in downstream prerequisites",
        "instrument": "outcome-correlation",
        "polarity": "positive"
      },
      "downstream-prerequisite-failure": {
        "description": "Mastery-attested learners fail in downstream content they should be prepared for",
        "instrument": "outcome-correlation",
        "polarity": "negative"
      },
      "stewardship-distributed": {
        "description": "Content domain has diverse steward participation",
        "instrument": "distribution-health",
        "polarity": "positive"
      },
      "stewardship-concentrated": {
        "description": "Single steward controls disproportionate share of domain content",
        "instrument": "distribution-health",
        "polarity": "negative"
      },
      "content-relevant": {
        "description": "Content is current and referenced by active learning paths",
        "instrument": "outcome-correlation",
        "polarity": "positive"
      },
      "content-outdated": {
        "description": "Content no longer reflects current understanding (human-reported or instrument-detected)",
        "instrument": "community-report",
        "polarity": "negative"
      },
      "content-misleading": {
        "description": "Content framing does not match substance (human-reported)",
        "instrument": "community-report",
        "polarity": "negative"
      },
      "learning-outcome-achieved": {
        "description": "Learner demonstrates competence in the domain a path covers after completion",
        "instrument": "outcome-correlation",
        "polarity": "positive"
      },
      "path-completion-without-retention": {
        "description": "Learner completed path but cannot demonstrate competence in its domain",
        "instrument": "outcome-correlation",
        "polarity": "negative"
      },
      "community-value-confirmed": {
        "description": "Community contributions produce engagement and downstream learning",
        "instrument": "outcome-correlation",
        "polarity": "positive"
      },
      "engagement-decline": {
        "description": "Community contributions are not producing engagement or downstream learning",
        "instrument": "outcome-correlation",
        "polarity": "negative"
      }
    }
  },
  "rendering": {
    "markdown-renderer": {
      "component": "MarkdownRendererComponent",
      "formats": ["markdown", "html", "plaintext"],
      "platform": "angular"
    },
    "gherkin-renderer": {
      "component": "GherkinRendererComponent",
      "formats": ["gherkin"],
      "platform": "angular"
    },
    "sophia-renderer": {
      "component": "SophiaRendererComponent",
      "formats": ["sophia-quiz-json"],
      "platform": "angular"
    },
    "iframe-renderer": {
      "component": "IframeRendererComponent",
      "formats": ["html5-app", "video-embed"],
      "platform": "angular"
    },
    "path-renderer": {
      "component": "PathViewerComponent",
      "formats": ["epr-composite"],
      "platform": "angular"
    }
  }
}
