{
  "id": "manifest-infrastructure",
  "name": "infrastructure",
  "version": "1.0.0",
  "description": "Substrate infrastructure — device health, doorway health, observation-layer heartbeats, and derived attestations.",
  "vocabulary": {
    "contentTypes": {}
  },
  "attestations": {
    "attestation:device-health": {
      "description": "Derived device-health attestation from observation-layer heartbeat data. Replaces HealthAttestation entry type. Raw heartbeats stay on the observation layer per spec §6.4.",
      "subject_kinds": ["device"],
      "metadata_schema": { "$ref": "../../schemas/v1/attestation/subtypes/device-health-metadata.schema.json" },
      "uniqueness_anchor": "attestation:device-health:{subject_cid}:{period_start}:{health_metric}",
      "revocable_by": ["issuer"]
    },
    "attestation:doorway-health-summary": {
      "description": "Periodic doorway health summary. Replaces DoorwayHeartbeatSummary entry type. Raw DoorwayHeartbeat entries remain operational on the observation layer.",
      "subject_kinds": ["device"],
      "metadata_schema": { "$ref": "../../schemas/v1/attestation/subtypes/doorway-health-summary-metadata.schema.json" },
      "uniqueness_anchor": "attestation:doorway-health-summary:{subject_cid}:{period_start}",
      "revocable_by": ["issuer"]
    }
  },
  "observation_kinds": [
    {
      "kind": "infrastructure:doorway-heartbeat",
      "namespace": "elohim/observations/infrastructure",
      "schema": {
        "doorway_id": "Cid",
        "peer_count": "u32",
        "uptime_secs": "u64"
      },
      "retention_class": "operational",
      "reach": "community",
      "diversity_threshold": { "distinct_households": 3, "min_count": 5 },
      "graduates_to": "attestation:doorway-health-summary",
      "graduation_window_seconds": 3600,
      "graduation_policy": "diversity-threshold"
    },
    {
      "kind": "infrastructure:blob-served",
      "namespace": "elohim/observations/infrastructure",
      "schema": {
        "blob_cid": "Cid",
        "bytes": "u64",
        "peer_cid": "Cid"
      },
      "retention_class": "operational",
      "reach": "community",
      "diversity_threshold": null,
      "graduates_to": "event:served-blob-summary",
      "graduation_window_seconds": 3600,
      "graduation_policy": "summarize"
    },
    {
      "kind": "infrastructure:system-sample",
      "namespace": "elohim/observations/infrastructure",
      "schema": {
        "cpu_pct": "f32",
        "mem_used_bytes": "u64",
        "disk_used_bytes": "u64",
        "disk_total_bytes": "u64"
      },
      "retention_class": "operational",
      "reach": "agent-private",
      "diversity_threshold": null,
      "graduates_to": null,
      "graduation_policy": null
    }
  ]
}
