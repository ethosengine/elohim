{
  "$id": "avodah:schema:metadata:work-story",
  "title": "WorkStoryMeta",
  "description": "Metadata for work-story content type. Project task with cadence and attestation gates.",
  "type": "object",
  "properties": {
    "projectId": { "type": "string" },
    "status": { "type": "string", "enum": ["backlog", "todo", "in-progress", "review", "done"] },
    "visibility": { "type": "string", "enum": ["private", "community", "exchange"] },
    "priority": { "type": "string", "enum": ["low", "medium", "high", "urgent"] },
    "storyPoints": { "type": "number" },
    "assigneeId": { "type": "string" },
    "attestationGates": {
      "type": "array",
      "description": "Lamad content IDs that must be mastered before this task can be started",
      "items": { "type": "string" }
    },
    "exchangeRequestId": { "type": "string", "description": "Shefa ServiceRequest ID — set when published to exchange" },
    "cadence": {
      "type": "object",
      "properties": {
        "interval": { "type": "string", "enum": ["daily", "weekly", "monthly", "custom"] },
        "customIntervalDays": { "type": "number" },
        "resetToStatus": { "type": "string", "enum": ["backlog", "todo"] },
        "nextOccurrence": { "type": "string", "description": "ISO date of next cadence reset" }
      }
    }
  },
  "additionalProperties": true
}
