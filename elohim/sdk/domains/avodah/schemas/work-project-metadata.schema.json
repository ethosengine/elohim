{
  "$id": "avodah:schema:metadata:work-project",
  "title": "WorkProjectMeta",
  "description": "Metadata for work-project content type. Container for work stories with board configuration.",
  "type": "object",
  "properties": {
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "color": { "type": "string" },
          "isTerminal": { "type": "boolean", "description": "Terminal columns trigger cadence reset when story moves here" }
        }
      }
    },
    "visibility": { "type": "string", "enum": ["private", "community"] },
    "memberIds": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
