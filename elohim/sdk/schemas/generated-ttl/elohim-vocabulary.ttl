<epr:schema:enum:coupling-leg> a skos:ConceptScheme ;
  skos:prefLabel "CouplingLeg" ;
  dct:description "The three legs of the ThreeLegCoupling defined by the graph substrate spec §4.1. Source of truth: elohim-epr protocol constants. Category A — enumeration values are part of the DNA-notarized protocol vocabulary. knowledge = knowledge graph binding (Claim EPR CID); value = economic event binding (EconomicEvent EPR CID); governance = governance attestation binding (Governance EPR CID). Serialized lowercase by serde." ;
  <epr:vocab#ordered> false ;
  skos:hasTopConcept <epr:schema:enum:coupling-leg#knowledge>, <epr:schema:enum:coupling-leg#value>, <epr:schema:enum:coupling-leg#governance> .

<epr:schema:enum:coupling-leg#knowledge> a skos:Concept ;
  skos:inScheme <epr:schema:enum:coupling-leg> ;
  skos:prefLabel "knowledge" ;
  skos:notation "knowledge" .

<epr:schema:enum:coupling-leg#value> a skos:Concept ;
  skos:inScheme <epr:schema:enum:coupling-leg> ;
  skos:prefLabel "value" ;
  skos:notation "value" .

<epr:schema:enum:coupling-leg#governance> a skos:Concept ;
  skos:inScheme <epr:schema:enum:coupling-leg> ;
  skos:prefLabel "governance" ;
  skos:notation "governance" .

<epr:schema:enum:decision> a skos:ConceptScheme ;
  skos:prefLabel "Decision" ;
  dct:description "The three-valued verdict discriminator of the protocol's verdict spine. `permit` and `refuse` are the two mechanical outcomes a deterministic check can reach. `refer` is the ceiling marker: a first-class 'this is not decidable by rule; it routes to the named layer with a stated reason'. WHO resolves there (elohim counsel, human, quorum) is governed routing — deployment policy, never vocabulary — bounded by constitutional floors that guarantee value conflicts and irreversible acts reach humans — never a fallthrough, a timeout, or an error. Every gradient axis that classifies a claim (reach today, epistemic standing this slice, compute/trust variance and retention downstream) narrows onto this same spine. Source of truth: elohim/epr/src/verdict.rs (`Decision` enum — Rust is the wire authority, this schema is its projection). Spec: reach-ontology-vocabulary-split-spec §2a." ;
  <epr:vocab#ordered> false ;
  skos:hasTopConcept <epr:schema:enum:decision#permit>, <epr:schema:enum:decision#refuse>, <epr:schema:enum:decision#refer> .

<epr:schema:enum:decision#permit> a skos:Concept ;
  skos:inScheme <epr:schema:enum:decision> ;
  skos:prefLabel "permit" ;
  skos:notation "permit" .

<epr:schema:enum:decision#refuse> a skos:Concept ;
  skos:inScheme <epr:schema:enum:decision> ;
  skos:prefLabel "refuse" ;
  skos:notation "refuse" .

<epr:schema:enum:decision#refer> a skos:Concept ;
  skos:inScheme <epr:schema:enum:decision> ;
  skos:prefLabel "refer" ;
  skos:notation "refer" .

