  skos:prefLabel "DeviceArchetype" ;
  dct:description "Hardware/deployment archetype of the device presenting an AgentPeerBinding. Source of truth: DHT (Notarized, Category A — imagodei integrity zome). DNA-notarized as part of the AgentPeerBinding entry type. Values: 'node' = dedicated elohim-node server/blade; 'desktop' = Tauri desktop app (workstation or laptop); 'mobile' = mobile client (phone or tablet); 'steward' = steward process managing collective infrastructure." ;
  <epr:vocab#ordered> false ;
  skos:hasTopConcept <epr:schema:enum:device-archetype#node>, <epr:schema:enum:device-archetype#desktop>, <epr:schema:enum:device-archetype#mobile>, <epr:schema:enum:device-archetype#steward> .

