# Elohim Protocol — vocabulary projection (SKOS).
#
# GENERATED from elohim/sdk/schemas/v1/. Do not hand-edit: run
#   node elohim/sdk/schemas/scripts/codegen-ttl.mjs
#
# This file is a PROJECTION OUTWARD, never a source. Nothing in the protocol reads it,
# and deleting it changes zero verdicts — that is the test that keeps it safe to publish.
#
# It is NAMING, NOT DECIDING. There are no owl: terms here by construction: no
# equivalentClass, no property chains, no complement, nothing a reasoner could chain
# into a verdict. What you get is the terms we use, what they mean, and — the part that
# matters when we have never met — WHAT OUR SILENCE MEANS on each axis (epr:factClosure
# / epr:verdictClosure below).
#
# Reading our silence: on a layer declared `open`, the absence of an assertion is
# UNKNOWN and never a negative fact. On a layer declared `closed`, the absence of a
# permit is a REFUSAL and never "unknown, therefore possibly allowed".

@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix epr:  <epr:vocab#> .

# --- epr: annotation terms (documentation only; no formal semantics) ---
<epr:vocab#factClosure> a rdfs:Datatype ;
  rdfs:comment "Posture of an axis FACT layer toward absence: open = unknown, never a negative fact." .

<epr:vocab#verdictClosure> a rdfs:Datatype ;
  rdfs:comment "Posture of an axis VERDICT layer toward absence: closed = absence of a permit is a refusal." .

