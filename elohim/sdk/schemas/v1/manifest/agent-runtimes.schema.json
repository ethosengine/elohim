{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentRuntimes",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runtimes"],
  "properties": {
    "version": {
      "const": 1
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "comm", "sessionEnv"],
        "properties": {
          "id": {
            "type": "string"
          },
          "comm": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "sessionEnv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "modelEnv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        }
      }
    }
  }
}
