{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentRuntimes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "runtimes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "comm",
          "sessionEnv"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "comm": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "sessionEnv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "modelEnv": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "modelSource": {
            "description": "Implemented read-only adapter for the current session's model metadata; absence uses mounted model context.",
            "enum": [
              "codex-state-v5"
            ]
          },
          "commitAttribution": {
            "description": "Git presentation conventions for participation claims, never actor authority.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "email",
              "sessionTrailer"
            ],
            "properties": {
              "email": {
                "type": "string",
                "minLength": 1
              },
              "modelSuffix": {
                "type": "string"
              },
              "sessionTrailer": {
                "type": "string",
                "pattern": "^[A-Za-z0-9-]+$"
              }
            }
          },
          "capabilityBindings": {
            "description": "Lab-neutral capability level -> this runtime's model binding (dialogue-stasis spec, Capability vocabulary and bindings). A level absent here is unbound for this runtime.",
            "type": "object",
            "additionalProperties": false,
            "patternProperties": {
              "^C[1-4]$": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "model"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "effort": {
                    "enum": [
                      "low",
                      "medium",
                      "high",
                      "xhigh"
                    ]
                  }
                }
              }
            }
          },
          "harnessCapabilities": {
            "description": "Harness capabilities proven by stasis-probe reports; an id absent here reads unsupported.",
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "evidence"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "yes",
                    "no",
                    "unsupported"
                  ]
                },
                "evidence": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "cliVersion": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          },
          "keeperInvocation": {
            "description": "Headless, read-only, non-prompting keeper shape for the dialogue-stasis coordinator; null when the runtime has none.",
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "argv",
                  "env"
                ],
                "properties": {
                  "status": {
                    "enum": [
                      "probed",
                      "declared"
                    ]
                  },
                  "argv": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "stdin": {
                    "type": "boolean"
                  },
                  "env": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "evidence": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "cliVersion": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
