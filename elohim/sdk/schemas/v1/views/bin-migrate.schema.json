{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epr:schema:view:bin-migrate",
  "title": "BinMigrate",
  "description": "Device-local CLI output; reconstructed from private custody and runtime observations. No network authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "migrated",
    "legacyRetained"
  ],
  "properties": {
    "migrated": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^(bafkr4i|bafyrei)[a-z2-7]{52}$"
      }
    },
    "legacyRetained": {
      "const": true,
      "type": "boolean"
    }
  }
}
