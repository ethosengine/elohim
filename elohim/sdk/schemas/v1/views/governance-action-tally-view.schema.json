{
  "$id": "epr:schema:view:governance-action-tally",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GovernanceActionTallyView",
  "description": "Source of truth: local (operational, Category C per p2p-design-gate). Recomputable from governance_actions JOIN attestations at any time via tally_projector::recompute. This record is NOT notarized on the DHT — only the constituent vote attestations are.",
  "type": "object",
  "required": [
    "parentCid",
    "governanceKind",
    "subjectCid",
    "thresholdM",
    "closesAt",
    "currentApproveCount",
    "currentRejectCount",
    "currentAbstainCount",
    "computedStatus",
    "rebuiltAt"
  ],
  "additionalProperties": false,
  "properties": {
    "parentCid": {
      "type": "string",
      "description": "CID of the parent governance-action"
    },
    "governanceKind": {
      "type": "string",
      "description": "Governance kind discriminator (copied from parent)"
    },
    "subjectCid": {
      "type": "string",
      "description": "CID of the subject being acted upon (copied from parent)"
    },
    "thresholdM": {
      "type": "integer",
      "minimum": 1,
      "description": "Required count for M-of-N quorum (threshold.m)"
    },
    "thresholdN": {
      "type": ["integer", "null"],
      "description": "Optional N for M-of-N quorum (threshold.n)"
    },
    "thresholdPercentage": {
      "type": ["number", "null"],
      "description": "Optional percentage for percentage-threshold ballots"
    },
    "closesAt": {
      "type": "string",
      "description": "ISO 8601 close time (copied from parent)"
    },
    "currentApproveCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Current count of approve votes"
    },
    "currentRejectCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Current count of reject votes"
    },
    "currentAbstainCount": {
      "type": "integer",
      "minimum": 0,
      "description": "Current count of abstain votes"
    },
    "computedStatus": {
      "type": "string",
      "enum": ["pending", "reached-quorum", "rejected", "expired", "tied"],
      "description": "Computed status of the vote"
    },
    "lastChildAt": {
      "type": ["string", "null"],
      "description": "ISO 8601 timestamp of the most recent child vote, if any"
    },
    "rebuiltAt": {
      "type": "string",
      "description": "ISO 8601 timestamp when this tally row was last recomputed"
    }
  }
}
