{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "epr:schema:view:app-release",
  "title": "AppReleaseView",
  "description": "Source of truth: peer runtime operational state (Category C). Portable app lifecycle foundation; private checkpoint references retain existing working-version authority. This shape does not declare a served HTTP endpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "appId",
    "releaseCid",
    "target",
    "artifactCids",
    "requiredCapabilities"
  ],
  "properties": {
    "appId": {
      "type": "string"
    },
    "releaseCid": {
      "type": "string"
    },
    "target": {
      "type": "string"
    },
    "artifactCids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
