{
  "$id": "epr:schema:view:recovery-seed-commitment",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecoverySeedCommitmentView",
  "description": "Projection of imagodei RecoverySeedCommitment DHT entry. Source of truth: DHT (Notarized, Category A).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dhtAnchorHash",
    "humanAgentPubkey",
    "seedPublicHalf",
    "thresholdN",
    "totalM",
    "commitmentNonce",
    "createdAt"
  ],
  "properties": {
    "dhtAnchorHash": { "type": "string", "description": "Hex-encoded ActionHash" },
    "humanAgentPubkey": { "type": "string" },
    "seedPublicHalf": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 255 },
      "minItems": 32,
      "maxItems": 32,
      "description": "Ed25519 public key derived from the recovery seed"
    },
    "thresholdN": { "type": "integer", "minimum": 2, "maximum": 16 },
    "totalM": { "type": "integer", "minimum": 2, "maximum": 16 },
    "commitmentNonce": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 255 },
      "minItems": 16,
      "maxItems": 16
    },
    "supersededBy": { "type": ["string", "null"] },
    "createdAt": { "type": "string", "description": "RFC3339 timestamp" }
  }
}
