{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epr:schema:view:bin-gc",
  "title": "BinGc",
  "description": "Device-local CLI output; reconstructed from private custody and runtime observations. No network authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kept",
    "removed",
    "removedSessions"
  ],
  "properties": {
    "kept": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(bafkr4i|bafyrei)[a-z2-7]{52}$"
      }
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(bafkr4i|bafyrei)[a-z2-7]{52}$"
      }
    },
    "removedSessions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
