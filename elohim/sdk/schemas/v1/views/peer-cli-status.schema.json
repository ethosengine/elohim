{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epr:schema:view:peer-cli-status",
  "title": "PeerCliStatus",
  "description": "Source of truth: device-private bin stores, head table and process table (Private, Category B). Device-local CLI output; reconstructed from private custody and runtime observations per invocation. No network authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cliCid",
    "daemonCids",
    "daemonDiffers",
    "handle",
    "chainRoot",
    "device",
    "nodeId",
    "ownSeq",
    "rules",
    "devices",
    "dropped",
    "channel",
    "refusedConnections",
    "refusedStrangers",
    "withheldCrossings",
    "artifactGate"
  ],
  "$defs": {
    "followRecord": {
      "description": "One `epr bin follow` attempt as the tool store's private follow.json holds it. Device operational state: never notarized or synced, and it never names the installed head (current.json does).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "attempt",
        "startedAt",
        "endedAt",
        "ownerPid",
        "ownerStartTime",
        "source",
        "commit",
        "mode",
        "priorCid",
        "candidateCid",
        "resultCid",
        "outcome",
        "kind",
        "reason"
      ],
      "properties": {
        "version": { "type": "integer", "minimum": 1 },
        "attempt": { "type": "string" },
        "startedAt": { "type": "string" },
        "endedAt": {
          "description": "Null only while the attempt is pending (one provenance).",
          "type": ["string", "null"]
        },
        "ownerPid": { "type": "integer", "minimum": 0 },
        "ownerStartTime": {
          "description": "Owner start time in clock ticks as decimal text (bigint-as-string); null when the process table could not be read at start.",
          "type": ["string", "null"],
          "pattern": "^[0-9]+$"
        },
        "source": {
          "description": "The source checkout followed, as the caller named it; URL userinfo, query and fragment are removed.",
          "type": "string"
        },
        "commit": {
          "description": "The checkout HEAD the attempt observed; null when it stopped before reading one.",
          "type": ["string", "null"]
        },
        "mode": { "enum": ["apply", "canary", "observe"] },
        "priorCid": {
          "description": "Device head when the attempt began; null when the device had none.",
          "type": ["string", "null"],
          "pattern": "^baf[k-y]r(ei|4i)[a-z2-7]+$"
        },
        "candidateCid": {
          "description": "Release the attempt staged or tried to land; null when it stopped before choosing one.",
          "type": ["string", "null"],
          "pattern": "^baf[k-y]r(ei|4i)[a-z2-7]+$"
        },
        "resultCid": {
          "description": "Device head when the attempt ended; null when the device had none.",
          "type": ["string", "null"],
          "pattern": "^baf[k-y]r(ei|4i)[a-z2-7]+$"
        },
        "outcome": {
          "description": "pending is written before any work; the other four are terminal.",
          "enum": ["pending", "landed", "refused", "unchanged", "observed"]
        },
        "kind": {
          "description": "Stable reason category (a refusal kind, or why nothing was done). Null for a clean landing or an observation; a landing whose head committed before a later step failed carries that step's kind.",
          "type": ["string", "null"]
        },
        "reason": {
          "description": "Bounded (240 characters), single-line, sanitised reason: URL credentials and secret-named assignments are removed. Null exactly when there is no reason to give.",
          "type": ["string", "null"],
          "maxLength": 240
        }
      }
    }
  },
  "properties": {
    "cliCid": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^baf[k-y]rei[a-z2-7]+$"
    },
    "daemonCids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^baf[k-y]rei[a-z2-7]+$"
      }
    },
    "daemonDiffers": {
      "type": "boolean"
    },
    "handle": {
      "type": "string"
    },
    "chainRoot": {
      "type": "string"
    },
    "device": {
      "type": "string"
    },
    "nodeId": {
      "type": [
        "string",
        "null"
      ]
    },
    "ownSeq": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "rules": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["digest", "short", "state", "policy", "reason"],
          "properties": {
            "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "short": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
            "state": { "enum": ["loaded", "reloading"] },
            "policy": { "type": "string" },
            "reason": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "device",
          "nodeId",
          "seq",
          "root",
          "ageS",
          "eventsFolded",
          "acked"
        ],
        "properties": {
          "device": {
            "type": "string"
          },
          "nodeId": {
            "type": "string"
          },
          "seq": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "root": {
            "type": [
              "string",
              "null"
            ]
          },
          "ageS": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "heardAgeS": {
            "description": "Seconds on this device's clock since any verified head was heard from the peer, including a replay; null when no verified head has been heard (one provenance).",
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "foldedAgeS": {
            "description": "Seconds on this device's clock since a head from the peer folded new records; null when no head has folded records (one provenance).",
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "probeOk": {
            "description": "Whether the most recent recovery probe reached the peer; null when no recovery probe has been recorded (one provenance).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "probeUnsupported": {
            "description": "Whether the most recent recovery probe found a peer that does not support probing; null when no recovery probe has been recorded (one provenance).",
            "type": [
              "boolean",
              "null"
            ]
          },
          "probeAgeS": {
            "description": "Seconds on this device's clock since the most recent recovery probe; null when no recovery probe has been recorded (one provenance).",
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "resubscriptions": {
            "description": "Number of recovery resubscriptions attempted for this peer since the daemon started.",
            "type": "integer",
            "minimum": 0
          },
          "connectionResets": {
            "description": "Number of recovery connection resets attempted for this peer since the daemon started.",
            "type": "integer",
            "minimum": 0
          },
          "eventsFolded": {
            "type": "integer",
            "minimum": 0
          },
          "acked": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "dropped": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unadmitted",
        "forged",
        "rollback",
        "replayed",
        "malformed"
      ],
      "properties": {
        "unadmitted": {
          "type": "integer",
          "minimum": 0
        },
        "forged": {
          "type": "integer",
          "minimum": 0
        },
        "rollback": {
          "type": "integer",
          "minimum": 0
        },
        "replayed": {
          "type": "integer",
          "minimum": 0
        },
        "malformed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection_failures",
        "fold_failures",
        "oversized_events",
        "over_budget_folds",
        "refused_strangers",
        "last_projection_error",
        "refused_connections"
      ],
      "properties": {
        "projection_failures": {
          "type": "integer",
          "minimum": 0
        },
        "fold_failures": {
          "type": "integer",
          "minimum": 0
        },
        "foldFailuresOurs": {
          "description": "Fold failures caused by this device's transport, timeout, unanswered request, or local I/O. Optional for output from older CLIs.",
          "type": "integer",
          "minimum": 0
        },
        "foldFailuresInvalid": {
          "description": "Fold failures caused by sender content that failed verification. Optional for output from older CLIs.",
          "type": "integer",
          "minimum": 0
        },
        "lastFoldFailure": {
          "description": "The latest fold failure, cleared when that same device later folds successfully. Optional for output from older CLIs.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["device", "seq", "at", "class", "reason"],
              "properties": {
                "device": { "type": "string" },
                "seq": { "type": "integer", "minimum": 0 },
                "at": {
                  "description": "Unix milliseconds on the receiving device when the failure was recorded.",
                  "type": "integer",
                  "minimum": 0
                },
                "class": { "enum": ["ours", "invalid"] },
                "reason": {
                  "description": "Bounded, one-line Display form of the typed fold error.",
                  "type": "string",
                  "maxLength": 320
                }
              }
            }
          ]
        },
        "oversized_events": {
          "type": "integer",
          "minimum": 0
        },
        "over_budget_folds": {
          "type": "integer",
          "minimum": 0
        },
        "refused_strangers": {
          "type": "integer",
          "minimum": 0
        },
        "last_projection_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "refused_connections": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "refusedConnections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nodeId",
          "device",
          "count"
        ],
        "properties": {
          "nodeId": {
            "type": "string"
          },
          "device": {
            "type": [
              "string",
              "null"
            ]
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "refusedStrangers": {
      "type": "integer",
      "minimum": 0
    },
    "withheldCrossings": {
      "description": "This device's own crossing-intent records that the policy file the daemon loaded does not cross. Empty when every one crosses, or when no daemon has recorded its store and rules.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "measure",
          "kind",
          "events"
        ],
        "properties": {
          "measure": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "events": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "artifactGate": {
      "description": "The artifact gate's exit counts over the daemon's recorded flow store for the last 14 days (K12 design section 4): serves by reach, serves by method row, and outputs whose latest own custody record in the window has no reach slot. Null when no daemon has recorded its store, or the store cannot be read.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["since", "reachDraws", "rowDraws", "slotlessDesignated"],
          "properties": {
            "since": { "type": "string" },
            "reachDraws": { "type": "integer", "minimum": 0 },
            "rowDraws": { "type": "integer", "minimum": 0 },
            "slotlessDesignated": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "followOutcomes": {
      "description": "The last `epr bin follow` attempt per registered tool, one row each, read from that tool store's private follow.json. Optional: absent in output from a CLI that predates follow outcomes; every current CLI emits it. `state` makes every absence explicit (views CONVENTIONS rule 11): `never` = the store holds no follow record; `recorded` = a terminal record; `in-progress` = a pending record whose owner process was observed running (not a zombie); `unknown` = a pending record whose owner could not be observed, with `detail` saying why; `interrupted` = a pending record that will never finish (owner exited, is a zombie, its PID was reused, or the outcome could not be written), with `detail` saying which; `corrupt` = the record exists but cannot be read or fails validation; `unavailable` = the tool's store could not be opened, or, with tool `*`, the tool registry itself.",
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "tool"],
            "properties": {
              "state": { "const": "never" },
              "tool": { "type": "string" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "tool", "record"],
            "properties": {
              "state": { "enum": ["recorded", "in-progress"] },
              "tool": { "type": "string" },
              "record": { "$ref": "#/$defs/followRecord" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "tool", "record", "detail"],
            "properties": {
              "state": { "enum": ["unknown", "interrupted"] },
              "tool": { "type": "string" },
              "record": { "$ref": "#/$defs/followRecord" },
              "detail": { "type": "string" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "tool", "detail"],
            "properties": {
              "state": { "enum": ["corrupt", "unavailable"] },
              "tool": { "type": "string" },
              "detail": { "type": "string" }
            }
          }
        ]
      }
    }
  }
}
