{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "epr:schema:view:bin-status",
  "title": "BinStatus",
  "description": "Ephemeral projection of device-private releases and session pins. CIDv1 addresses; paths are native resolution results, never reconstructed by clients.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool",
    "store",
    "session",
    "sessionCid",
    "head",
    "behind",
    "source",
    "resolvedCid",
    "resolved",
    "verifiedCurrent",
    "candidates",
    "headRepairNeeded"
  ],
  "properties": {
    "tool": {
      "type": "string"
    },
    "store": {
      "type": "string"
    },
    "session": {
      "type": [
        "string",
        "null"
      ]
    },
    "sessionCid": {
      "type": [
        "string",
        "null"
      ]
    },
    "head": {
      "type": [
        "string",
        "null"
      ]
    },
    "behind": {
      "type": "boolean"
    },
    "source": {
      "type": "string"
    },
    "resolvedCid": {
      "type": [
        "string",
        "null"
      ]
    },
    "resolved": {
      "type": [
        "string",
        "null"
      ]
    },
    "verifiedCurrent": {
      "type": "boolean"
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Release"
      }
    },
    "headRepairNeeded": {
      "type": "boolean",
      "description": "Derived head links need explicit repair."
    }
  },
  "definitions": {
    "Release": {
      "$ref": "epr:schema:view:bin-release"
    }
  }
}
