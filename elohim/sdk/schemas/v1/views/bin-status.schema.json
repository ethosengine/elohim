{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "epr:schema:view:bin-status",
  "title": "BinStatus",
  "description": "Ephemeral projection of device-private releases and session pins. CIDv1 addresses; paths are native resolution results, never reconstructed by clients.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool",
    "store",
    "session",
    "sessionCid",
    "head",
    "behind",
    "source",
    "resolvedCid",
    "resolved",
    "verifiedCurrent",
    "candidates"
  ],
  "properties": {
    "tool": {
      "type": "string"
    },
    "store": {
      "type": "string"
    },
    "session": {
      "type": ["string", "null"]
    },
    "sessionCid": {
      "type": ["string", "null"]
    },
    "head": {
      "type": ["string", "null"]
    },
    "behind": {
      "type": "boolean"
    },
    "source": {
      "type": "string"
    },
    "resolvedCid": {
      "type": ["string", "null"]
    },
    "resolved": {
      "type": ["string", "null"]
    },
    "verifiedCurrent": {
      "type": "boolean"
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Release"
      }
    }
  },
  "definitions": {
    "Release": {
      "type": "object",
      "properties": {
        "cid": {
          "type": "string",
          "pattern": "^baf[k-y]rei[a-z2-7]+$"
        },
        "rcid": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "bins": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^bafkrei[a-z2-7]+$"
          }
        },
        "version": {
          "type": ["string", "null"]
        },
        "sourceCommit": {
          "type": "string"
        },
        "treeClean": {
          "type": "boolean"
        },
        "gateRun": {
          "type": ["string", "null"]
        },
        "ingestedAt": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sourceCommit": {
                "type": "string"
              },
              "treeClean": {
                "type": "boolean"
              },
              "gateRun": {
                "type": ["string", "null"]
              },
              "ingestedAt": {
                "type": "string"
              }
            },
            "required": ["sourceCommit", "treeClean", "gateRun", "ingestedAt"]
          }
        },
        "ring": {
          "type": "string"
        },
        "attestations": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "cid",
        "rcid",
        "tool",
        "bins",
        "version",
        "sourceCommit",
        "treeClean",
        "gateRun",
        "ingestedAt",
        "sources",
        "ring",
        "attestations"
      ],
      "additionalProperties": true
    }
  }
}
