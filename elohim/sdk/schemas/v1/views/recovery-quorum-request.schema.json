{
  "$id": "epr:schema:view:recovery-quorum-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RecoveryQuorumRequestView",
  "description": "Projection of imagodei RecoveryQuorumRequest DHT entry. Source of truth: DHT (Notarized, Category A).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dhtAnchorHash",
    "humanAgentPubkey",
    "seedCommitmentHash",
    "newAgentPubkey",
    "hostingDoorwayPubkey",
    "recoveryMode",
    "requestNonce",
    "createdAt"
  ],
  "properties": {
    "dhtAnchorHash": { "type": "string" },
    "humanAgentPubkey": { "type": "string" },
    "seedCommitmentHash": { "type": "string" },
    "newAgentPubkey": { "type": "string" },
    "hostingDoorwayPubkey": { "type": "string" },
    "recoveryMode": { "type": "string", "enum": ["normal", "stewarded"] },
    "stewardedGrantHash": { "type": ["string", "null"] },
    "requestNonce": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0, "maximum": 255 },
      "minItems": 16,
      "maxItems": 16
    },
    "createdAt": { "type": "string" }
  }
}
