{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "epr:schema:view:bin-install-launcher",
  "title": "BinInstallLauncher",
  "description": "Device-local CLI output; reconstructed from private custody and runtime observations. No network authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "launcher",
    "head",
    "adopted",
    "persistentAdopted",
    "shadows"
  ],
  "properties": {
    "launcher": {
      "type": "string"
    },
    "head": {
      "type": "string",
      "pattern": "^baf[k-y]rei[a-z2-7]+$"
    },
    "adopted": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "persistentAdopted": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "shadows": {
      "$ref": "epr:schema:view:bin-shadows"
    }
  }
}
