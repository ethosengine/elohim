{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epr:schema:view:bin-shadows",
  "title": "BinShadows",
  "description": "Device-local CLI output; reconstructed from private custody and runtime observations. No network authority.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "name",
      "path",
      "target",
      "superseded"
    ],
    "properties": {
      "name": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "target": {
        "type": [
          "string",
          "null"
        ]
      },
      "superseded": {
        "type": "boolean"
      }
    }
  }
}
