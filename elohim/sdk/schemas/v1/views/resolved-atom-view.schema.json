{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epr:schema:view:resolved-atom-view",
  "title": "ResolvedAtomView",
  "description": "Three-pillar EPR atom view assembled from graph projection. Source of truth: CozoDB graph projection (Operational, Category C). Reconstructed per request from DHT-canonical epr_atoms relational projection.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cid", "slug", "contentCid", "version", "updatedAt", "lamad", "qahal"],
  "properties": {
    "cid": { "type": "string", "description": "Content-addressed identifier for this EPR atom." },
    "slug": { "type": "string", "description": "Human-readable slug (the EPR id field)." },
    "contentCid": { "type": "string", "description": "CID of the associated content blob." },
    "version": { "type": "integer", "minimum": 1 },
    "authorDid": { "type": ["string", "null"], "description": "Author DID, null when not specified." },
    "updatedAt": { "type": "string", "description": "ISO-8601 timestamp of last update." },
    "lamad": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "contentType", "tags"],
      "properties": {
        "title": { "type": "string" },
        "contentType": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "contentFormat": { "type": ["string", "null"] },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "shefa": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "stewards": { "type": "array", "items": { "type": "string" } },
        "allocations": { "type": "array", "items": { "type": "number" } }
      }
    },
    "qahal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attestationRequirements"],
      "properties": {
        "reach": { "type": ["string", "null"] },
        "layer": { "type": ["string", "null"] },
        "attestationRequirements": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
