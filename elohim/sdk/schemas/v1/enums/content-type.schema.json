{
  "$id": "epr:schema:enum:content-type",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ContentType",
  "description": "Content type vocabulary. Core types are DNA-notarized (three-leg coupled: knowledge+value+governance). Storage-only types are cross-domain entity references. Extensible types are community vocabulary.",
  "type": "string",
  "enum": [
    "epic", "concept", "lesson", "scenario", "assessment",
    "reflection", "discussion", "exercise", "article", "path",
    "human", "role", "collective",
    "example", "reference",
    "feature", "practice", "contributor",
    "video", "audio", "book", "book-chapter", "documentary",
    "bible-verse", "activity", "narrative", "course-module",
    "module", "quiz", "podcast", "simulation",
    "node-context", "stewardship-context",
    "work-story", "work-project", "issue-report",
    "application"
  ],
  "_tiers": {
    "core": {
      "values": ["epic", "concept", "lesson", "scenario", "assessment",
                 "reflection", "discussion", "exercise", "article", "path"],
      "rationale": "Three-leg coupled: knowledge + value + governance. DNA-notarized, immutable once signed."
    },
    "storageOnly": {
      "values": ["human", "role", "collective"],
      "rationale": "Cross-domain entity references. Notarized in their own DNAs (imagodei/mishpat). Referenced in content graph but not content primitives."
    },
    "extensible": {
      "values": ["example", "reference", "feature", "practice", "contributor",
                 "video", "audio", "book", "book-chapter", "documentary",
                 "bible-verse", "activity", "narrative", "course-module",
                 "module", "quiz", "podcast", "simulation",
                 "node-context", "stewardship-context",
                 "work-story", "work-project", "issue-report",
                 "application"],
      "rationale": "Community-defined vocabulary. Accepted by storage, not validated by DNA. Communities register new types without protocol changes."
    }
  },
  "_dna": {
    "constant": "CONTENT_TYPES",
    "zome": "content_store_integrity",
    "file": "elohim/holochain/dna/elohim/zomes/content_store_integrity/src/lib.rs",
    "tier": "core"
  }
}
