# Elohim Storage - Content Storage & Session Management
#
# RUSTFLAGS is baked in — just `just build` and go.

set dotenv-load := false

export RUSTFLAGS := '--cfg getrandom_backend="custom"'

# RAM-guard-aware codegen cap. `cargo test` of this crate compiles the lib AND the
# test harness as two ~5.5 GB rustc processes; with the household mesh up (three
# 0.7 conductors) that crosses the workspace RAM guard's 80% shed line and the
# recipe dies with "terminated … by signal 15" (2026-09-04 overnight, 2026-09-05
# integration push #4 and the re-run under line-tables-only debuginfo). When the
# guard exists and reports less than ~14 GB of headroom, serialize codegen with
# -j1 (peak ≈ one rustc). No guard (CI, a plain container) → cargo's default.
# Override explicitly with `just jobs_flag=-j4 gate` or leave it alone.
jobs_flag := `sh "$(git rev-parse --show-toplevel 2>/dev/null)/genesis/agentic/bin/cargo-jobs-flag" 2>/dev/null || true`

# List available recipes
default:
    @just --list

# Build release binary
build:
    cargo build --release

# Build debug binary
build-dev:
    cargo build

# Run tests (jobs_flag: -j1 under RAM-guard pressure, see above)
test:
    cargo test {{jobs_flag}}

# Build with iroh parallel stack enabled (libp2p still default)
# See genesis/docs/superpowers/plans/2026-05-07-iroh-parallel-stack.md
build-iroh:
    cargo build --features "p2p p2p-iroh"

# Test with both stacks compiled in.
# Iroh integration tests (the iroh_* tests in tests/) run serialized via
# --test-threads=1 because multiple in-process QUIC endpoints on loopback
# race for UDP port allocation and the iroh-gossip overlay needs more
# than the default test thread share to converge under contention. Unit
# tests (--lib) are unaffected and can run parallel.
test-iroh:
    cargo test --features "p2p p2p-iroh" --lib
    cargo test --features "p2p p2p-iroh" --test 'iroh_*' -- --test-threads=1

# Head-to-head blob plane perf bench: iroh vs libp2p on loopback.
# Release-mode + ignored-test pattern keeps the bench out of `just test-iroh`
# but makes it explicit-to-invoke.
bench-blob:
    cargo test --release --features "p2p p2p-iroh" --test bench_blob_perf -- --ignored --nocapture

# Head-to-head sync plane perf bench: iroh /elohim/sync/2.0.0 vs libp2p
# /elohim/storage-sync/1.0.0 — request/response with reused connections.
bench-sync:
    cargo test --release --features "p2p p2p-iroh" --test bench_sync_perf -- --ignored --nocapture

# Head-to-head EPR plane perf bench: iroh /elohim/epr/2.0.0 vs libp2p
# /elohim/epr/1.0.0 — Resolve→Head round-trip on MessagePack codec.
bench-epr:
    cargo test --release --features "p2p p2p-iroh" --test bench_epr_perf -- --ignored --nocapture

# Head-to-head EPR-atom plane perf bench: iroh /elohim/epr-atom/2.0.0 vs libp2p
# /elohim/epr-atom/1.0.0 — Fetch→Atom round-trip on CBOR codec.
bench-epr-atom:
    cargo test --release --features "p2p p2p-iroh" --test bench_epr_atom_perf -- --ignored --nocapture

# Head-to-head shard plane perf bench: iroh /elohim/shard/2.0.0 vs libp2p
# /elohim/shard/1.0.0 — Get→Data round-trip; sweeps RS-shard sizes.
bench-shard:
    cargo test --release --features "p2p p2p-iroh" --test bench_shard_perf -- --ignored --nocapture

# Head-to-head view-federation plane perf bench: iroh
# /elohim/view-federation/2.0.0 vs libp2p /elohim/view-federation/1.0.0 —
# ViewFederationRequest/Response with topology-edge payloads (256 KiB cap).
bench-view-fed:
    cargo test --release --features "p2p p2p-iroh" --test bench_view_fed_perf -- --ignored --nocapture

# Head-to-head gossip plane perf bench: iroh-gossip vs libp2p-gossipsub —
# inventory delta publish→receive latency.
bench-gossip:
    cargo test --release --features "p2p p2p-iroh" --test bench_gossip_perf -- --ignored --nocapture

# Head-to-head identity-handshake plane perf bench: iroh /elohim/identity-handshake/2.0.0
# vs libp2p /elohim/identity/handshake/1.0.0 — IdentityHandshakeRequest/Response with
# signature payload size sweep (64 B – 2048 B raw; ~2730 B base64 + binding
# overhead stays under the 4 KiB IDENTITY_HANDSHAKE_REQ_MAX cap).
bench-identity-handshake:
    cargo test --release --features "p2p p2p-iroh" --test bench_identity_handshake_perf -- --ignored --nocapture

# Head-to-head trust plane perf bench: iroh /elohim/trust/2.0.0
# vs libp2p /elohim/trust/1.0.0 — TrustHandshake/Response with attestation CID count sweep
# (1–768 CIDs, under the 64 KiB request cap).
bench-trust:
    cargo test --release --features "p2p p2p-iroh" --test bench_trust_perf -- --ignored --nocapture

# Run every bench in sequence and print a combined summary report.
# Each plane runs independently; the umbrella target streams output as it goes.
bench-all: bench-blob bench-sync bench-epr bench-epr-atom bench-shard bench-view-fed bench-gossip bench-identity-handshake bench-trust
    @echo ""
    @echo "All bench-* recipes completed. See per-plane markdown tables above."

# Export TypeScript type bindings
export-bindings:
    cargo test export_bindings

# Type-check without building
check:
    cargo check

# Lint with clippy (jobs_flag: -j1 under RAM-guard pressure, see above)
clippy:
    cargo clippy {{jobs_flag}} -- -D warnings

# Format code
fmt:
    cargo fmt

# Check formatting without modifying
fmt-check:
    cargo fmt --check

# Remove build artifacts
clean:
    cargo clean

# Guard against the diesel migration timestamp-prefix collision:
# embed_migrations! keys on the YYYY-MM-DD-HHMMSS prefix and SILENTLY keeps
# only ONE of any two dirs sharing it. That hid a never-created
# challenge_outcomes table for ~3 months (cured 2026-07-26). Any duplicate
# prefix here means one of the colliding migrations will never run.
migration-hygiene:
    #!/usr/bin/env bash
    set -euo pipefail
    dupes="$(ls -d migrations/*/ 2>/dev/null | sed 's#.*/\([0-9-]*\)_.*#\1#' | sort | uniq -d)"
    if [ -n "$dupes" ]; then
        echo "✗ duplicate diesel migration timestamp prefix(es) — embed_migrations! will silently drop one:" >&2
        echo "$dupes" >&2
        exit 1
    fi
    echo "✓ no duplicate migration timestamp prefixes"

# Quality gate: migration-hygiene + fmt-check + clippy + test
gate: migration-hygiene fmt-check clippy test
