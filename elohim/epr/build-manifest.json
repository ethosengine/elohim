{
  "manifestVersion": "1.0",
  "pipeline": "elohim-epr",
  "jenkinsPath": "elohim/epr/Jenkinsfile",
  "manualOnly": false,
  "triggersGenesis": false,
  "cascades": false,
  "dependsOn": [],
  "description": "Elohim EPR codec — canonical CBOR + CIDv1 + Ed25519 for the graph substrate (Rust crate + TS SDK)",
  "steps": {
    "rust-build-test": {
      "description": "fmt + clippy + nextest for the elohim-epr and elohim-epr-rea Rust crates",
      "inputs": {
        "sources": [
          "elohim/epr/**",
          "crates/elohim-address/**",
          "elohim/epr-rea/**",
          "elohim/epr-index/**",
          "elohim/Cargo.toml",
          "elohim/Cargo.lock"
        ],
        "buildProcess": ["elohim/epr/Jenkinsfile"]
      },
      "outputs": {
        "artifacts": ["elohim-epr-rlib"],
        "verify": null
      },
      "depends": [],
      "executor": {
        "stage": "Rust — tests",
        "function": null
      }
    },
    "ts-test": {
      "description": "Build and test the epr-ts SDK (TypeScript companion to the Rust codec)",
      "inputs": {
        "sources": [
          "elohim/sdk/epr-ts/**"
        ],
        "buildProcess": ["elohim/epr/Jenkinsfile"]
      },
      "outputs": {
        "artifacts": ["epr-ts-dist"],
        "verify": null
      },
      "depends": ["rust-build-test"],
      "executor": {
        "stage": "TS — tests",
        "function": null
      }
    }
  },
  "gate": {
    "projects": {
      "elohim-epr": {
        "dir": "elohim/epr",
        "steps": ["rust-build-test"],
        "run": {
          "kind": "root-just",
          "recipe": "_gate-elohim-epr",
          "cargo": { "workspace": "elohim", "profile": "dev", "rustflags": "" }
        }
      },
      "elohim-address": {
        "dir": "crates/elohim-address",
        "inputs": {
          "sources": ["crates/elohim-address/**"],
          "buildProcess": []
        },
        "run": {
          "kind": "root-just",
          "recipe": "_gate-elohim-address",
          "cargo": { "workspace": "crates/elohim-address", "profile": "dev", "rustflags": "" }
        }
      },
      "elohim-blob-store": {
        "dir": "crates/elohim-blob-store",
        "inputs": {
          "sources": [
            "crates/elohim-blob-store/**",
            "elohim/epr/**",
            "crates/elohim-address/**",
            "elohim/Cargo.toml",
            "elohim/eprfs/Cargo.toml",
            "elohim/eprfs/eprfs-core/**",
            "elohim/eprfs/eprfs-serve/**",
            "crates/seam-contracts/**",
            "vendor/iroh-quinn-proto-0.13.0/**"
          ],
          "buildProcess": []
        },
        "run": {
          "kind": "root-just",
          "recipe": "_gate-elohim-blob-store",
          "cargo": { "workspace": "crates/elohim-blob-store", "profile": "dev", "rustflags": "" }
        }
      },
      "elohim-storage-client": {
        "dir": "crates/elohim-storage-client",
        "inputs": {
          "sources": ["crates/elohim-storage-client/**", "crates/elohim-address/**", "crates/elohim-views/**"],
          "buildProcess": []
        },
        "run": {
          "kind": "root-just",
          "recipe": "_gate-elohim-storage-client",
          "cargo": { "workspace": "crates/elohim-storage-client", "profile": "dev", "rustflags": "" }
        }
      },
      "epr-ts": {
        "dir": "elohim/sdk/epr-ts",
        "steps": ["ts-test"],
        "inputs": {
          "sources": [
            "elohim/sdk/epr-ts/**",
            "elohim/eprfs/eprfs-ts/src/**",
            "elohim/sdk/storage-client-ts/src/**",
            "app/elohim-app/src/**"
          ],
          "buildProcess": ["elohim/epr/Jenkinsfile"]
        },
        "run": { "kind": "root-just", "recipe": "_gate-epr-ts" }
      },
      "seam-contracts": {
        "dir": "crates/seam-contracts",
        "inputs": {
          "sources": ["crates/seam-contracts/**"],
          "buildProcess": []
        },
        "run": {
          "kind": "root-just",
          "recipe": "_gate-seam-contracts",
          "cargo": { "workspace": "crates/seam-contracts", "profile": "dev", "rustflags": "" }
        }
      },
      "consent-grant": {
        "dir": "crates/consent-grant",
        "inputs": {
          "sources": ["crates/consent-grant/**", "elohim/epr/**", "crates/elohim-address/**", "elohim/Cargo.toml"],
          "buildProcess": []
        },
        "run": {
          "kind": "root-just",
          "recipe": "_gate-consent-grant",
          "cargo": { "workspace": "crates/consent-grant", "profile": "dev", "rustflags": "" }
        }
      }
    }
  },
  "deployment": {}
}
