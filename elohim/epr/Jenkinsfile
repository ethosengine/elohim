pipeline {
  agent { label 'rust-node' }

  options {
    overrideIndexTriggers(false)
    buildDiscarder(logRotator(numToKeepStr: '30'))
    timeout(time: 20, unit: 'MINUTES')
  }

  stages {
    stage('Rust — fmt + clippy') {
      steps {
        dir('elohim') {
          sh 'cargo fmt --check'
          sh 'cargo clippy -p elohim-epr -- -D warnings'
        }
      }
    }
    stage('Rust — tests') {
      steps {
        dir('elohim') {
          sh 'cargo nextest run -p elohim-epr --all-targets'
        }
      }
    }
    stage('TS — tests') {
      steps {
        dir('elohim/sdk/epr-ts') {
          sh 'pnpm install --frozen-lockfile'
          sh 'pnpm test'
        }
      }
    }

    // Publish to the internal Nexus registry on main only (release-grade;
    // crate versions are immutable). Idempotent + 409-safe: a no-op unless
    // the version in Cargo.toml was bumped. Reuses the CI npm token
    // (`ee-nexus-npm-token`) — it authenticates cross-format; the only
    // prerequisite is the CI user holding repository-view add/read on
    // cargo-internal (Nexus role `cargo-deployer`).
    stage('Publish — cargo (elohim registry)') {
      when {
        anyOf { branch 'main'; expression { env.BRANCH_NAME == 'main' } }
      }
      steps {
        withCredentials([string(credentialsId: 'ee-nexus-npm-token', variable: 'NEXUS_NPM_TOKEN')]) {
          sh "bash '${env.WORKSPACE}/scripts/ci/cargo-publish-epr.sh'"
        }
      }
    }
  }

  post {
    always {
      cleanWs()
    }
  }
}
