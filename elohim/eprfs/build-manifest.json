{
  "manifestVersion": "1.0",
  "pipeline": "elohim-eprfs",
  "jenkinsPath": "elohim/eprfs/Jenkinsfile",
  "manualOnly": false,
  "triggersGenesis": false,
  "cascades": false,
  "dependsOn": [],
  "description": "EPRFS — EPR-governed filesystem projection substrate (eprfs-core/host/local/meta/storage library crates + the eprfs-agent adapter). Publishes the library crates to the internal Nexus 'elohim' registry on dev and main.",
  "steps": {
    "rust-build-test": {
      "description": "fmt + clippy + tests for the eprfs workspace (the library crates, eprfs-serve, eprfs-peer and the eprfs-agent adapter)",
      "inputs": {
        "sources": [
          "elohim/eprfs/**",
          "elohim/ark/core/**",
          "elohim/placement/core/**",
          "elohim/elohim-compute/**",
          "elohim/elohim-settings/**",
          "elohim/elohim-cache-core/**",
          "genesis/orchestrator/manifests/runtime/workspace-device.manifest.json",
          "genesis/orchestrator/rust-style/**",
          "elohim/sdk/domains/elohim-agent/adapter/**",
          "elohim/epr/**",
          "elohim/epr-rea/**",
          "elohim/epr-index/**",
          "elohim/Cargo.toml",
          ".cargo/config.toml",
          "bridges/did/Cargo.toml",
          "bridges/did/did-bridge/**",
          "bridges/did/did-types/**",
          "scripts/ci/cargo-publish-eprfs.sh",
          "scripts/ci/publish_eprfs.py",
          "scripts/ci/test_publish_eprfs.py",
          "crates/consent-grant/**",
          "crates/seam-contracts/**",
          "vendor/iroh-quinn-proto-0.13.0/**"
        ],
        "buildProcess": ["elohim/eprfs/Jenkinsfile"]
      },
      "outputs": {
        "artifacts": ["eprfs-crates"],
        "verify": null
      },
      "depends": [],
      "executor": {
        "stage": "Rust — tests",
        "function": null
      }
    }
  },
  "gate": {
    "projects": {
      "eprfs": {
        "dir": "elohim/eprfs",
        "steps": ["rust-build-test"],
        "run": {
          "kind": "root-just",
          "recipe": "_gate-eprfs",
          "cargo": { "targetDir": "/tmp/eprfs-gate-target", "profile": "dev", "rustflags": "" }
        }
      },
      "seam-guidance-contracts": {
        "dir": "elohim/sdk/domains/elohim-agent",
        "inputs": {
          "sources": [
            "elohim/sdk/domains/elohim-agent/scripts/seam-guidance.test.mjs",
            "elohim/sdk/domains/elohim-agent/tests/seam_hook_test.py",
            "elohim/sdk/schemas/v1/seam-guidance.schema.json",
            "elohim/sdk/schemas/v1/seam-guidance-method.schema.json",
            ".epr-meta/elohim/algorithms/seam-guidance.json",
            ".epr-meta/composition.md",
            "elohim/sdk/working-version.seam.json",
            "elohim/sdk/app-lifecycle.seam.json",
            "elohim/elohim-storage/.epr-meta/publication-authority.seam.json",
            "elohim/elohim-storage/.epr-meta/peer-serving.seam.json",
            "elohim/eprfs/epr-cli/developer-composition.seam.json",
            ".claude/hooks/native-seam-guidance.py",
            ".codex/hooks/native-seam-guidance.py",
            ".claude/scripts/_lib/epr_client.py"
          ],
          "buildProcess": ["justfile"]
        },
        "run": { "kind": "root-just", "recipe": "_gate-seam-guidance-contracts" }
      }
    }
  },
  "deployment": {}
}
