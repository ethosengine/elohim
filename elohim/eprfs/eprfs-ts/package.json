{
  "name": "@elohim/eprfs",
  "version": "0.1.0",
  "description": "Pure TypeScript twin of eprfs-core: the canonical tree codec, the view-scoped level walk and the tier chain (interfaces spec §H.1)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prebuild": "pnpm --filter @elohim/epr build",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "eslint -c eslint.config.mjs src"
  },
  "dependencies": {
    "@elohim/epr": "workspace:*",
    "multiformats": "^13.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0"
}
