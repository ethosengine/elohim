{
  "_comment": "The view of a mesh-build method for the eprfs workspace's binaries (epr, bin-launch): what `cargo build --bin` reads, and nothing else. No tests/, benches/ or examples/, and no ignored generated output (a crate's ts-rs bindings/, a package's dist/) lies inside it, so `epr artifact key` has nothing to refuse. Used as `epr artifact describe --sources elohim/eprfs/bin-build-view.json#bin-build`. Not a build-manifest: these sources select no gate and dispatch no pipeline. epr-cli/tests/bin_build_view.rs fails when a build of epr reads a tracked file this list does not cover.",
  "steps": {
    "bin-build": {
      "inputs": {
        "sources": [
          "elohim/eprfs/Cargo.toml",
          "elohim/eprfs/Cargo.lock",
          ".cargo/config.toml",
          "elohim/eprfs/device-runtime/Cargo.toml",
          "elohim/eprfs/device-runtime/src/**",
          "elohim/eprfs/epr-cli/Cargo.toml",
          "elohim/eprfs/epr-cli/src/**",
          "elohim/eprfs/epr-lsp/Cargo.toml",
          "elohim/eprfs/epr-lsp/src/**",
          "elohim/eprfs/eprfs-agent/Cargo.toml",
          "elohim/eprfs/eprfs-agent/src/**",
          "elohim/eprfs/eprfs-cli/Cargo.toml",
          "elohim/eprfs/eprfs-cli/src/**",
