{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.codex/hooks/native-seam-guidance.py\"; [ -f \"$f\" ] && python3 \"$f\" codex || exit 0",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.claude/hooks/rust-style.py\"; [ -f \"$f\" ] && python3 \"$f\" || exit 0",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.codex/hooks/brit-first.py\"; [ -f \"$f\" ] && python3 \"$f\" codex || exit 0",
            "timeout": 2
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.codex/hooks/dialogue-stasis-sense.py\"; [ -f \"$f\" ] && python3 \"$f\" --runtime=codex || exit 0",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.codex/hooks/dialogue-stasis-sense.py\"; [ -f \"$f\" ] && python3 \"$f\" --runtime=codex || exit 0",
            "timeout": 3
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.codex/hooks/dialogue-stasis-sense.py\"; [ -f \"$f\" ] && python3 \"$f\" --runtime=codex || exit 0",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.codex/hooks/dialogue-stasis-sense.py\"; [ -f \"$f\" ] && python3 \"$f\" --runtime=codex || exit 0",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.codex/hooks/dialogue-stasis-sense.py\"; [ -f \"$f\" ] && python3 \"$f\" --runtime=codex || exit 0",
            "timeout": 3
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.codex/hooks/dialogue-stasis-sense.py\"; [ -f \"$f\" ] && python3 \"$f\" --runtime=codex || exit 0",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(git rev-parse --show-toplevel 2>/dev/null)/.codex/hooks/dialogue-stasis-sense.py\"; [ -f \"$f\" ] && python3 \"$f\" --runtime=codex || exit 0",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
