# Angular requires hoisted node_modules structure
shamefully-hoist=true

# Angular peer dependency conflicts (mirrors existing per-project .npmrc settings)
legacy-peer-deps=true
strict-peer-dependencies=false

# Registry split (decided 2026-07-30): Nexus serves FIRST-PARTY components only.
#
# Public packages come straight from npmjs. Our Nexus is Sonatype Community
# Edition; its 100k-requests/day cap is enforced by refusing to add new
# components ("New components can no longer be added"), which takes down
# first-party PUBLISHING — the one thing only Nexus can do. Proxying a free
# public registry spent that budget for nothing: one cold install of this
# workspace is ~2,682 packages ≈ 5.4k requests. Mirrors the same decision made
# for cargo in .cargo/config.toml.
#
# pnpm-lock.yaml records integrity hashes with no registry hosts, so it stays
# portable across this switch — same artifacts, same hashes.
registry=https://registry.npmjs.org/
@elohim:registry=https://nexus.ethosengine.com/repository/npm-hosted/
//nexus.ethosengine.com/repository/npm/:_authToken=${NPM_TOKEN}
//nexus.ethosengine.com/repository/npm-hosted/:_authToken=${NPM_TOKEN}
