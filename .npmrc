# Angular requires hoisted node_modules structure
shamefully-hoist=true

# Angular peer dependency conflicts (mirrors existing per-project .npmrc settings)
legacy-peer-deps=true
strict-peer-dependencies=false

# Private registry (Nexus cache + hosted)
registry=https://nexus.ethosengine.com/repository/npm/
//nexus.ethosengine.com/repository/npm/:_authToken=${NPM_TOKEN}
//nexus.ethosengine.com/repository/npm-hosted/:_authToken=${NPM_TOKEN}
