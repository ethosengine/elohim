            "type": "radio",
            "options": {
              "choices": [
                {
                  "content": "Edge cases are rare",
                  "correct": false,
                  "id": "fct-module-12-fairness-justice-q3-c0"
                },
                {
                  "content": "Engineers cannot test them",
                  "correct": false,
                  "id": "fct-module-12-fairness-justice-q3-c1"
                },
                {
                  "content": "Convenience for the center routinely becomes burden at the margins, and who counts as an edge case is chosen",
                  "correct": true,
