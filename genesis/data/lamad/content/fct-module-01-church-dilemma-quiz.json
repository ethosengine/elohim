                  "content": "The content creators publish",
                  "correct": false,
                  "id": "fct-module-01-church-dilemma-q1-c1"
                },
                {
                  "content": "Human attention, sold to advertisers",
                  "correct": true,
                  "id": "fct-module-01-church-dilemma-q1-c2"
