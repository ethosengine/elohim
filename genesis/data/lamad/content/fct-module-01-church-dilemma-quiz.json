        "images": {},
        "widgets": {
          "radio 1": {
            "type": "radio",
            "options": {
              "choices": [
                {
                  "content": "Because nothing can be done about the crisis",
                  "correct": false,
                  "id": "fct-module-01-church-dilemma-q4-c0"
                },
                {
                  "content": "Because lament is faith refusing to lie: honest complaint that turns toward hope",
                  "correct": true,
                  "id": "fct-module-01-church-dilemma-q4-c1"
                },
                {
                  "content": "Because solutions are the pastor's job, not the class's",
                  "correct": false,
                  "id": "fct-module-01-church-dilemma-q4-c2"
                },
                {
                  "content": "Because the crisis is too complex to understand yet",
