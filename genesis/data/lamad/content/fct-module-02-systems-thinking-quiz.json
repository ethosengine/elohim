      "purpose": "mastery",
      "content": {
        "content": "Josiah's reform ended child sacrifice to Moloch. In systems terms, what did it change?\n\n[[☃ radio 1]]",
        "images": {},
        "widgets": {
          "radio 1": {
            "type": "radio",
            "options": {
              "choices": [
                {
                  "content": "The hearts of each individual parent, one by one",
                  "correct": false,
                  "id": "fct-module-02-systems-thinking-q4-c0"
                },
                {
                  "content": "The payoffs of the game, so no one had to sacrifice to keep up",
                  "correct": true,
                  "id": "fct-module-02-systems-thinking-q4-c1"
                },
                {
                  "content": "The laws about temple worship only",
                  "correct": false,
                  "id": "fct-module-02-systems-thinking-q4-c2"
                },
                {
                  "content": "Nothing structural; it was a personal example",
                  "correct": false,
                  "id": "fct-module-02-systems-thinking-q4-c3"
                }
              ],
              "randomize": true,
