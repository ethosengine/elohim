                },
                {
                  "content": "In the relationships among diverse parts",
                  "correct": true,
                  "id": "fct-module-02-systems-thinking-q3-c1"
                },
                {
                  "content": "In making every part the same",
                  "correct": false,
                  "id": "fct-module-02-systems-thinking-q3-c2"
