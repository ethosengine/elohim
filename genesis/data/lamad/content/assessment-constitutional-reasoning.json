      "id": "cr-q1",
      "purpose": "mastery",
      "content": {
        "content": "A community Elohim makes a decision that a family disagrees with. What is the appropriate first step?\n\n[[☃ radio 1]]",
        "images": {},
        "widgets": {
          "radio 1": {
            "type": "radio",
            "options": {
              "choices": [
                {
                  "content": "Accept the decision without question",
                  "correct": false,
                  "id": "cr-q1-choice-0"
                },
                {
                  "content": "File a challenge at the family level",
                  "correct": true,
                  "id": "cr-q1-choice-1"
                },
                {
                  "content": "Escalate directly to global Elohim",
                  "correct": false,
                  "id": "cr-q1-choice-2"
                },
                {
                  "content": "Leave the community",
                  "correct": false,
                  "id": "cr-q1-choice-3"
