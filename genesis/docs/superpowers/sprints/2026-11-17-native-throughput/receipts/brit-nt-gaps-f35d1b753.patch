+/// A positional argument that names no revision is still refused rather than read
+/// as an empty range, and a literal path after `--` keeps its existing refusal.
+#[test]
+fn log_refuses_unknown_revisions_and_path_limiting() -> Result<()> {
+    let repo = TestRepo::new("log-revision-refusals")?;
+    repo.commit_file("tracked", "content\n")?;
+    for args in [
+        &["log", "no-such-ref"][..],
+        &["log", "tracked"][..],
+        &["log", "--", "tracked"][..],
+    ] {
+        let mut command = Command::new(brit_bin().expect("built Brit"));
+        gix_testtools::configure_git_environment(&mut command, repo.path());
+        let out = command.current_dir(repo.path()).args(args).output()?;
+        assert!(!out.status.success(), "{args:?} must fail");
+        assert!(out.stdout.is_empty(), "{args:?} prints no commits");
+        assert!(
+            String::from_utf8_lossy(&out.stderr).contains("File-based lookup isn't yet implemented"),
+            "{args:?} keeps the path-limiting refusal"
+        );
+    }
+    Ok(())
+}
