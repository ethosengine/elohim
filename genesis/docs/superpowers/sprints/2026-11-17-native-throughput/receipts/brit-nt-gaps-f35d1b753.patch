+}
+
+/// Resolve `revisions` into the commits to start from and the commits whose ancestry is hidden.
+fn tips_and_ends(
+    repo: &gix::Repository,
+    source: &Source<'_>,
+    revisions: &[BString],
+) -> Result<(Vec<gix::ObjectId>, Vec<gix::ObjectId>)> {
+    use gix::revision::plumbing::Spec;
+    let commit = |id| {
+        source
+            .peel(id, Kind::Commit)
+            .or_raise(|| message!("revision {id} does not name a commit").validation())
+    };
+    let parents = |commit_id: gix::ObjectId| -> Result<Vec<gix::ObjectId>> {
+        let mut buffer = Buffer::default();
+        let commit = source
+            .load(&commit_id, &mut buffer)?
+            .try_into_commit_iter()
+            .ok_or_raise(|| message!("Expected commit {commit_id}").validation())?;
+        Ok(commit.parent_ids().collect())
+    };
+    let (mut tips, mut ends) = (Vec::new(), Vec::new());
+    for revision in revisions {
+        // Git would read an unknown name as a path; path-limited logs stay refused here.
+        let spec = repo.rev_parse(revision.as_bstr()).or_raise(|| {
+            message!(
+                "`{revision}` is not a revision, and File-based lookup isn't yet implemented in a way that is competitively fast"
+            )
+        })?;
+        match spec.detach() {
+            Spec::Include(id) => tips.push(commit(id)?),
+            Spec::Exclude(id) => ends.push(commit(id)?),
+            Spec::Range { from, to } => {
+                ends.push(commit(from)?);
+                tips.push(commit(to)?);
+            }
+            Spec::Merge { theirs, ours } => {
+                let (theirs, ours) = (commit(theirs)?, commit(ours)?);
+                ends.extend(repo.merge_bases_many(theirs, &[ours])?.into_iter().map(gix::Id::detach));
+                tips.extend([theirs, ours]);
+            }
+            Spec::IncludeOnlyParents(id) => tips.extend(parents(commit(id)?)?),
+            Spec::ExcludeParents(id) => {
+                let id = commit(id)?;
+                ends.extend(parents(id)?);
+                tips.push(id);
+            }
+        }
     }
+    Ok((tips, ends))
 }
 
