+/// `A^@`, `A^!`); excluded commits hide everything reachable from them.
+pub fn log_revisions(
+    repo: gix::Repository,
+    out: &mut dyn std::io::Write,
+    revisions: &[BString],
+    path: Option<BString>,
+    max_count: Option<usize>,
