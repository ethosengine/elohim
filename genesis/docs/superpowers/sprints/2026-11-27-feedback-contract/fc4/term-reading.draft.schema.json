{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "epr:schema:manifest:term-reading-draft",
  "title": "TermReadingDraft",
  "description": "FC-4 draft; placement awaits steward ruling. Declaration membership requires contextual validation.",
  "$comment": "One claim and first failing emitter on one device (L:401-409); device is evaluation context.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim",
    "emitter",
    "reading"
  ],
  "properties": {
    "claim": {
      "$ref": "#/$defs/claimId"
    },
    "emitter": {
      "$ref": "#/$defs/emitter"
    },
    "reading": {
      "type": "string",
      "enum": [
        "open",
        "stale-emitter",
        "unrecorded",
        "cure-available",
        "on-watch",
        "retired",
        "reopened",
        "review-due",
        "superseded"
      ]
    }
  },
  "$defs": {
    "claimId": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+(?::[a-z0-9.-]+)?$"
    },
    "emitter": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9._:+-]+$"
    },
    "duration": {
      "type": "string",
      "description": "ISO 8601 duration before unanswered validity needs review.",
      "pattern": "^P(?:[0-9]+(?:[.,][0-9]+)?W|(?:[0-9]+(?:[.,][0-9]+)?Y|(?:[0-9]+Y)?[0-9]+(?:[.,][0-9]+)?M|(?:[0-9]+Y)?(?:[0-9]+M)?[0-9]+(?:[.,][0-9]+)?D)|(?:[0-9]+Y)?(?:[0-9]+M)?(?:[0-9]+D)?T(?:[0-9]+(?:[.,][0-9]+)?H|(?:[0-9]+H)?[0-9]+(?:[.,][0-9]+)?M|(?:[0-9]+H)?(?:[0-9]+M)?[0-9]+(?:[.,][0-9]+)?S))$"
    }
  }
}
