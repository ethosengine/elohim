{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "@framework/*": ["./src/framework/*"],
      "@elohim/identity/*": ["../../app/elohim-library/projects/elohim-identity/src/*"]
    }
  },
  "include": ["src/**/*.ts", "steps/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
