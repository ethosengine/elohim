{
  "name": "@elohim/a2o",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Alpha-to-omega validation: E2E tests that verify deployed artifacts match genesis intent",
  "scripts": {
    "test": "cucumber-js --tags '@e2e'",
    "test:practical": "cucumber-js --tags '@e2e'",
    "test:auth": "cucumber-js --tags '@e2e and @auth'",
    "test:content": "cucumber-js --tags '@e2e and @content'",
    "test:basics": "cucumber-js --tags '@e2e and (@auth or @content)'",
    "test:hosted-human": "cucumber-js --tags '@e2e and @hosted-human'",
    "test:federation": "cucumber-js --tags '@e2e and @federation'",
    "test:browser": "E2E_DEVICE_MODE=playwright cucumber-js --tags '@browser'",
    "test:browser:headed": "E2E_DEVICE_MODE=playwright E2E_HEADLESS=false cucumber-js --tags '@browser'",
    "test:browser:trace": "E2E_DEVICE_MODE=playwright E2E_TRACE=true cucumber-js --tags '@browser'",
    "test:browser:auth": "E2E_DEVICE_MODE=playwright cucumber-js --tags '@browser and @auth'",
    "test:browser:e2e": "E2E_DEVICE_MODE=playwright cucumber-js --tags '@e2e'",
    "test:local": "E2E_MODE=local cucumber-js --tags '@e2e'",
    "test:steward": "E2E_MODE=steward cucumber-js --tags '@e2e'",
    "test:testnet": "cucumber-js --profile testnet --tags '@testnet and @e2e and not @wip'",
    "test:genesis:dry": "cucumber-js --dry-run '../docs/content/elohim-protocol/**/*.feature'",
    "test:genesis:epic": "cucumber-js --dry-run --tags '@epic:$npm_config_name' '../docs/content/elohim-protocol/**/*.feature'",
    "test:genesis:layer": "cucumber-js --dry-run --tags '@governance_layer:$npm_config_name' '../docs/content/elohim-protocol/**/*.feature'",
    "generate:skeletons": "tsx scripts/generate-step-skeletons.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check \"**/*.{ts,js,json,mjs}\"",
    "format": "prettier --write \"**/*.{ts,js,json,mjs}\"",
    "scan:coverage": "tsx scripts/scan-coverage.ts",
    "scan:coverage:ci": "tsx scripts/scan-coverage.ts --ci",
    "explore": "tsx scripts/explore-session.ts",
    "publish:results": "tsx scripts/publish-results.ts",
    "local:check": "tsx scripts/local-stack.ts",
    "local:seed": "tsx scripts/local-stack.ts --seed"
  },
  "dependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "playwright": "^1.50.0",
    "undici": "^7.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-sonarjs": "^3.0.5",
    "eslint-plugin-unicorn": "^62.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.50.1"
  }
}
