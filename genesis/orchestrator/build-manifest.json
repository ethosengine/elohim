{
  "manifestVersion": "1.0",
  "pipeline": "elohim-orchestrator",
  "jenkinsPath": "genesis/orchestrator/Jenkinsfile",
  "manualOnly": false,
  "triggersGenesis": false,
  "cascades": false,
  "dependsOn": [],
  "description": "CI orchestrator \u2014 Jenkinsfile linting and validation",
  "steps": {
    "lint-jenkinsfiles": {
      "description": "Lint all Jenkinsfiles with npm-groovy-lint",
      "inputs": {
        "sources": [
          "**/Jenkinsfile*",
          "genesis/orchestrator/**",
          "genesis/agentic/compute/**",
          "elohim/eprfs/**",
          "elohim/sdk/domains/elohim-agent/adapter/**",
          "elohim/ark/core/**",
          "elohim/ark/supervisor/**",
          "elohim/placement/core/**",
          "elohim/elohim-compute/**",
          "elohim/elohim-settings/**",
          "elohim/elohim-cache-core/**",
          "elohim/epr/**",
          "crates/elohim-address/**",
          "crates/elohim-blob-store/**",
          "elohim/epr-rea/**",
          "elohim/epr-index/**",
          "elohim/Cargo.toml",
          "bridges/did/Cargo.toml",
          "bridges/did/did-bridge/**",
          "bridges/did/did-types/**",
          "crates/consent-grant/**",
          "crates/elohim-host-contract/**",
          "crates/seam-contracts/**",
          "vendor/iroh-quinn-proto-0.13.0/**"
        ],
        "buildProcess": []
      },
      "outputs": {
        "artifacts": [],
        "verify": null
      },
      "depends": [],
      "executor": {
        "stage": "Lint Jenkinsfiles",
        "function": null
      }
    },
    "rust-style-checker": {
      "description": "The Rust style checker's own sources: the closure its fmt, lint, self-tests and distribution test read. Every source sits under genesis/orchestrator/**, which lint-jenkinsfiles already watches, so this step adds no CI dispatch; it gives the local rust-style-checker gate project a fingerprint.",
      "inputs": {
        "sources": [
          "genesis/orchestrator/rust-style/**",
          "genesis/orchestrator/rust-style.sh",
          "genesis/orchestrator/rust-style-build-env.sh"
        ],
        "buildProcess": []
      },
      "outputs": {
        "artifacts": [],
        "verify": null
      },
      "depends": [],
      "executor": {
        "stage": "Rust Style Gate",
        "function": null
      }
    }
  },
  "gate": {
    "projects": {
      "dialogue-stasis": {
        "dir": ".",
        "inputs": {
          "sources": [
            "genesis/agentic/stasis*",
            "genesis/agentic/bin/stasis-*",
            "genesis/agentic/agent-runtimes.json",
            ".claude/hooks/dialogue-stasis-sense.py",
            ".codex/hooks/dialogue-stasis-sense.py",
            ".claude/hooks/tests/test_dialogue_stasis_sense.py",
            ".epr-meta/elohim/packages/hooks/dialogue-stasis-sense.json",
            ".epr-meta/elohim/packages/agents/stasis-keeper.json",
            ".epr-meta/elohim/packages/skills/stasis-keeper-brief.json",
            "elohim/sdk/domains/elohim-agent/schemas/*stasis*.json",
            "elohim/sdk/domains/elohim-agent/schemas/session-event.schema.json",
            "elohim/sdk/domains/elohim-agent/schemas/keeper-decision.schema.json"
          ],
          "buildProcess": ["justfile"]
        },
        "run": { "kind": "root-just", "recipe": "_gate-dialogue-stasis" }
      },
      "agentic-shift": {
        "dir": ".",
        "inputs": {
          "sources": [
            "genesis/agentic/shift*.py",
            "genesis/agentic/shift-observer-paths.json",
            "genesis/agentic/seed-target.test.mjs",
            "genesis/agentic/bin/berth",
            "genesis/agentic/berth_test.py",
            "genesis/agentic/bin/pool-lib.sh",
            "genesis/agentic/bin/pool-preflight.sh",
            "genesis/agentic/bin/pool-artifact-hashes.py",
            "genesis/agentic/bin/lsp-attach",
            "genesis/agentic/bin/lsp-flycheck",
            "genesis/agentic/bin/lsp-null.py",
            "genesis/agentic/pool-policy.json",
            "genesis/agentic/pool_preflight_test.py",
            "genesis/agentic/pool_family_test.py",
            ".claude/hooks/cargo-disk-guard.py",
            "genesis/agentic/pool_artifact_hashes_test.py",
            "genesis/agentic/lsp_attach_test.py",
            "genesis/agentic/lsp_flycheck_test.py",
            "genesis/agentic/objective*.mjs",
            "genesis/agentic/readiness*.mjs",
            ".claude/schemas/objective.schema.json",
            "justfile",
            "devfile.base.yaml"
          ],
          "buildProcess": []
        },
        "run": { "kind": "root-just", "recipe": "_gate-agentic-shift" }
      },
      "agentic-tools": {
        "dir": ".",
        "inputs": {
          "sources": [
            ".claude/hooks/tests/test_berth_note_inject.py",
            ".claude/hooks/tests/test_berth_writes_observe.py",
            ".claude/hooks/tests/test_blind_reader_review.py",
            ".claude/hooks/tests/test_brit_first_forms.py",
            ".claude/hooks/tests/test_cargo_disk_guard_pool.py",
            ".claude/hooks/tests/test_cargo_disk_guard_seats.py",
            ".claude/hooks/tests/test_cargo_disk_guard_yield.py",
            ".claude/hooks/tests/test_gate_live_inject.py",
            ".claude/hooks/tests/test_held_tool_ensure.py",
            ".claude/hooks/tests/test_hook_budgets.py",
            ".claude/hooks/tests/test_io_guard.py",
            ".claude/hooks/tests/test_load_project_context.py",
            ".claude/hooks/tests/test_lsp_edit_event.py",
            ".claude/hooks/tests/test_ram_guard.py",
            ".claude/hooks/tests/test_sensitive_file_protection.py",
            ".claude/hooks/tests/test_sensor_scan_budget.py",
            ".claude/hooks/tests/test_sibling_miss_inject.py",
            "genesis/agentic/bin-head-notice_test.py",
            "genesis/agentic/dup_census_test.py",
            "genesis/agentic/held_tool_watch_test.py",
            "genesis/agentic/lsp_null_test.py",
            "genesis/agentic/peer_liveness_test.py",
            "genesis/agentic/ram_guard_session_test.py",
            "genesis/agentic/session_envelope_test.py",
            "genesis/agentic/bin/README.md",
            "genesis/agentic/bin/cargo-jobs-flag",
            "genesis/agentic/bin/cargo-pool",
            "genesis/agentic/bin/device-memory-sync",
            "genesis/agentic/bin/dup-census",
            "genesis/agentic/bin/embed-model-provision",
            "genesis/agentic/bin/held-tool-watch",
            "genesis/agentic/bin/io-guard",
            "genesis/agentic/bin/landing-pick",
            "genesis/agentic/bin/landing-retrailer",
            "genesis/agentic/bin/landing-tagged-tip",
            "genesis/agentic/bin/peer-liveness",
            "genesis/agentic/bin/ram-guard",
            ".claude/hooks/berth-note-inject.py",
            ".claude/hooks/berth-writes-observe.py",
            ".claude/hooks/blind-reader-review.py",
            ".claude/hooks/capability-tier-gate.py",
            ".claude/hooks/cargo-disk-guard.py",
            ".claude/hooks/device-head-notice.py",
            ".claude/hooks/dialogue-stasis-sense.py",
            ".claude/hooks/epr-meta-resolver.py",
            ".claude/hooks/gate-live-inject.py",
            ".claude/hooks/held-tool-ensure.py",
            ".claude/hooks/load-project-context.py",
            ".claude/hooks/lsp-edit-event.py",
            ".claude/hooks/ram-guard.py",
            ".claude/hooks/sensitive-file-protection.py",
            ".claude/hooks/sibling-miss-inject.py",
            ".claude/hooks/_observation.py",
            ".claude/epr-meta/policies.yaml",
            ".claude/settings.json",
            ".claude/scripts/_lib/concern_routes.py",
            ".claude/scripts/_lib/deadline.py",
            ".claude/scripts/_lib/epr_client.py",
            ".claude/scripts/_lib/epr_meta.py",
            ".claude/scripts/_lib/session.py",
            ".claude/scripts/_lib/store.py",
            ".codex/hooks/brit-first.py",
            "genesis/agentic/bin-head-notice.py",
            "genesis/agentic/agent-runtimes.json",
            "genesis/agentic/bin/berth",
            "genesis/agentic/bin/lsp-null.py",
            "genesis/agentic/fixtures/session-cases.json",
            "genesis/agentic/pool-policy.json",
            "genesis/orchestrator/device-epr.mjs"
          ],
          "buildProcess": ["justfile"]
        },
        "run": { "kind": "root-just", "recipe": "_gate-agentic-tools" }
      },
      "orchestrator": {
        "dir": "genesis/orchestrator",
        "steps": ["lint-jenkinsfiles"],
        "inputs": {
          "sources": [
            "**/Cargo.toml",
            "**/Cargo.lock",
            "**/build-manifest.json",
            "scripts/ci/*compute-worker*",
            "genesis/scripts/ci/runner-*",
            "genesis/scripts/ci/package-compute-worker*",
            "genesis/scripts/ci/edge-1672-inputs.json",
            "app/elohim-app/scripts/hc-mesh.sh",
            "app/elohim-app/scripts/__tests__/hc-mesh-storage-port.test.sh",
            "app/elohim-app/scripts/__tests__/hc-mesh-closure-staleness.test.sh",
            "genesis/agentic/bin/berth",
            "genesis/agentic/berth_test.py",
            "genesis/agentic/pool-policy.json"
          ],
          "buildProcess": ["genesis/orchestrator/build-inputs-closure.test.mjs"]
        },
        "run": {
          "kind": "just",
          "recipe": "gate"
        }
      },
      "orchestrator-tree": {
        "dir": "genesis/orchestrator",
        "steps": ["lint-jenkinsfiles"],
        "inputs": {
          "sources": [
            "**/Cargo.toml",
            "**/Cargo.lock",
            "**/build-manifest.json",
            "scripts/ci/*compute-worker*",
            "genesis/scripts/ci/runner-*",
            "genesis/scripts/ci/package-compute-worker*",
            "genesis/scripts/ci/edge-1672-inputs.json",
            "app/elohim-app/scripts/hc-mesh.sh",
            "app/elohim-app/scripts/__tests__/hc-mesh-storage-port.test.sh",
            "app/elohim-app/scripts/__tests__/hc-mesh-closure-staleness.test.sh",
            "genesis/agentic/bin/berth",
            "genesis/agentic/berth_test.py",
            "genesis/agentic/pool-policy.json"
          ],
          "buildProcess": ["genesis/orchestrator/build-inputs-closure.test.mjs"]
        },
        "run": {
          "kind": "just",
          "recipe": "gate-tree",
          "cargo": {
            "workspace": "elohim/eprfs",
            "profile": "dev",
            "rustflags": ""
          }
        }
      },
      "rakia-codegen": {
        "dir": ".",
        "inputs": {
          "sources": [
            "elohim/rakia",
            "elohim/rakia/schemas/**",
            "elohim/rakia/rakia-core/src/generated_types.rs",
            "elohim/rakia/rakia-core/src/manifest.rs"
          ],
          "buildProcess": ["elohim/rakia/schemas/scripts/codegen-rs.mjs"]
        },
        "run": {
          "kind": "root-just",
          "recipe": "_gate-rakia-codegen"
        }
      },
      "rakia-validate": {
        "dir": ".",
        "inputs": {
          "sources": [
            "elohim/rakia",
            "**/build-manifest.json",
            "elohim/rakia/schemas/v1/build-manifest.schema.json"
          ],
          "buildProcess": ["elohim/rakia/schemas/scripts/validate.mjs"]
        },
        "run": {
          "kind": "root-just",
          "recipe": "_gate-rakia-validate"
        }
      },
      "cargo-coverage": {
        "dir": ".",
        "inputs": {
          "sources": ["**/Cargo.toml", "**/build-manifest.json"],
          "buildProcess": ["genesis/orchestrator/cargo-target-coverage.mjs"]
        },
        "run": {
          "kind": "root-just",
          "recipe": "_gate-cargo-coverage"
        }
      },
      "pipeline-list-fresh": {
        "dir": ".",
        "inputs": {
          "sources": ["**/build-manifest.json"],
          "buildProcess": [
            "genesis/orchestrator/pipeline-registry.mjs",
            "genesis/orchestrator/scripts/generate-pipeline-list.mjs"
          ]
        },
        "run": {
          "kind": "root-just",
          "recipe": "_gate-pipeline-list-fresh"
        }
      },
      "rust-style": {
        "dir": "genesis/orchestrator/rust-style",
        "inputs": {
          "sources": [
            "**/*.rs",
            "**/Cargo.toml",
            "**/.epr-meta",
            "**/.epr-meta/manifest.md",
            ".epr-meta/rust-style-policy.json",
            ".epr-meta/rust-style/**",
            "genesis/docs/rust-style-guide.md",
            "genesis/orchestrator/rust-style/**",
            "**/clippy.toml",
            "**/.clippy.toml",
            "**/rustfmt.toml",
            "**/.rustfmt.toml",
            "**/.cargo/config.toml"
          ],
          "buildProcess": [
            "genesis/orchestrator/rust-style/**",
            "genesis/orchestrator/rust-style.sh",
            "genesis/orchestrator/rust-style-build-env.sh",
            ".claude/epr-meta/policies.yaml",
            "genesis/orchestrator/rust-style-ci.sh"
          ]
        },
        "run": {
          "kind": "root-just",
          "recipe": "_gate-rust-style",
          "cargo": {
            "workspace": "genesis__orchestrator__rust-style",
            "profile": "dev",
            "rustflags": "",
            "env": {
              "CARGO_BUILD_JOBS": "1"
            }
          }
        }
      },
      "rust-style-checker": {
        "dir": "genesis/orchestrator/rust-style",
        "steps": ["rust-style-checker"],
        "inputs": {
          "sources": [
            "genesis/orchestrator/rust-style/**",
            "genesis/orchestrator/rust-style.sh",
            "genesis/orchestrator/rust-style-build-env.sh",
            ".cargo/config.toml"
          ],
          "buildProcess": ["justfile"]
        },
        "run": {
          "kind": "root-just",
          "recipe": "_gate-rust-style-checker",
          "cargo": {
            "workspace": "genesis__orchestrator__rust-style",
            "profile": "dev",
            "rustflags": "",
            "env": {
              "CARGO_BUILD_JOBS": "1"
            }
          }
        }
      }
    }
  },
  "deployment": {}
}
