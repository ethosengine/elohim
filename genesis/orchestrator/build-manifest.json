{
  "manifestVersion": "1.0",
  "pipeline": "elohim-orchestrator",
  "jenkinsPath": "genesis/orchestrator/Jenkinsfile",
  "manualOnly": false,
  "triggersGenesis": false,
  "cascades": false,
  "dependsOn": [],
  "description": "CI orchestrator \u2014 Jenkinsfile linting and validation",
  "steps": {
    "lint-jenkinsfiles": {
      "description": "Lint all Jenkinsfiles with npm-groovy-lint",
      "inputs": {
        "sources": [
          "**/Jenkinsfile*",
          "genesis/orchestrator/**",
          "genesis/agentic/compute/**",
          "elohim/eprfs/**",
          "elohim/sdk/domains/elohim-agent/adapter/**",
          "elohim/ark/core/**",
          "elohim/placement/core/**",
          "elohim/elohim-compute/**",
          "elohim/elohim-settings/**",
          "elohim/elohim-cache-core/**",
          "elohim/epr/**",
          "crates/elohim-address/**",
          "crates/elohim-blob-store/**",
          "elohim/epr-rea/**",
          "elohim/epr-index/**",
          "elohim/Cargo.toml",
          "bridges/did/Cargo.toml",
          "bridges/did/did-bridge/**",
          "bridges/did/did-types/**",
          "crates/consent-grant/**",
          "crates/elohim-host-contract/**",
          "crates/seam-contracts/**",
          "vendor/iroh-quinn-proto-0.13.0/**"
        ],
        "buildProcess": []
      },
      "outputs": {
        "artifacts": [],
        "verify": null
      },
      "depends": [],
      "executor": {
        "stage": "Lint Jenkinsfiles",
        "function": null
      }
    }
  },
  "gate": {
    "projects": {
      "dialogue-stasis": {
        "dir": ".",
        "inputs": {
          "sources": [
            "genesis/agentic/stasis*",
            "genesis/agentic/bin/stasis-*",
            "genesis/agentic/agent-runtimes.json",
            ".claude/hooks/dialogue-stasis-sense.py",
            ".codex/hooks/dialogue-stasis-sense.py",
            ".claude/hooks/tests/test_dialogue_stasis_sense.py",
            ".epr-meta/elohim/packages/hooks/dialogue-stasis-sense.json",
            ".epr-meta/elohim/packages/agents/stasis-keeper.json",
            ".epr-meta/elohim/packages/skills/stasis-keeper-brief.json",
            "elohim/sdk/domains/elohim-agent/schemas/*stasis*.json",
            "elohim/sdk/domains/elohim-agent/schemas/session-event.schema.json",
            "elohim/sdk/domains/elohim-agent/schemas/keeper-decision.schema.json"
          ],
          "buildProcess": ["justfile"]
        },
        "run": { "kind": "root-just", "recipe": "_gate-dialogue-stasis" }
      },
      "agentic-shift": {
        "dir": ".",
        "inputs": {
          "sources": [
            "genesis/agentic/shift*.py",
            "genesis/agentic/shift-observer-paths.json",
            "genesis/agentic/seed-target.test.mjs",
            "genesis/agentic/bin/berth",
            "genesis/agentic/berth_test.py",
            "genesis/agentic/objective*.mjs",
            "genesis/agentic/readiness*.mjs",
            ".claude/schemas/objective.schema.json",
            "justfile",
            "devfile.base.yaml"
          ],
          "buildProcess": []
        },
        "run": { "kind": "root-just", "recipe": "_gate-agentic-shift" }
      },
      "orchestrator": {
        "dir": "genesis/orchestrator",
        "steps": ["lint-jenkinsfiles"],
        "inputs": {
          "sources": [
            "**/Cargo.toml",
            "**/Cargo.lock",
            "**/build-manifest.json",
            "scripts/ci/*compute-worker*",
            "genesis/scripts/ci/runner-*",
            "genesis/scripts/ci/package-compute-worker*",
            "genesis/scripts/ci/edge-1672-inputs.json",
            "app/elohim-app/scripts/hc-mesh.sh",
            "app/elohim-app/scripts/__tests__/hc-mesh-storage-port.test.sh",
            "app/elohim-app/scripts/__tests__/hc-mesh-closure-staleness.test.sh",
            "genesis/agentic/bin/berth",
            "genesis/agentic/berth_test.py",
            "genesis/agentic/pool-policy.json"
          ],
          "buildProcess": ["genesis/orchestrator/build-inputs-closure.test.mjs"]
        },
        "run": {
          "kind": "just",
          "recipe": "gate",
          "cargo": {
            "workspace": "elohim/eprfs",
            "profile": "dev",
            "rustflags": ""
          }
        }
      },
      "rakia-codegen": {
        "dir": ".",
        "inputs": {
          "sources": [
            "elohim/rakia",
            "elohim/rakia/schemas/**",
            "elohim/rakia/rakia-core/src/generated_types.rs",
            "elohim/rakia/rakia-core/src/manifest.rs"
          ],
          "buildProcess": ["elohim/rakia/schemas/scripts/codegen-rs.mjs"]
        },
        "run": {
          "kind": "root-just",
          "recipe": "_gate-rakia-codegen"
        }
      },
      "rakia-validate": {
        "dir": ".",
        "inputs": {
          "sources": [
            "elohim/rakia",
            "**/build-manifest.json",
            "elohim/rakia/schemas/v1/build-manifest.schema.json"
          ],
          "buildProcess": ["elohim/rakia/schemas/scripts/validate.mjs"]
        },
        "run": {
          "kind": "root-just",
          "recipe": "_gate-rakia-validate"
        }
      },
      "cargo-coverage": {
        "dir": ".",
        "inputs": {
          "sources": ["**/Cargo.toml", "**/build-manifest.json"],
          "buildProcess": ["genesis/orchestrator/cargo-target-coverage.mjs"]
        },
        "run": {
          "kind": "root-just",
          "recipe": "_gate-cargo-coverage"
        }
      },
      "pipeline-list-fresh": {
        "dir": ".",
        "inputs": {
          "sources": ["**/build-manifest.json"],
          "buildProcess": [
            "genesis/orchestrator/pipeline-registry.mjs",
            "genesis/orchestrator/scripts/generate-pipeline-list.mjs"
          ]
        },
        "run": {
          "kind": "root-just",
          "recipe": "_gate-pipeline-list-fresh"
        }
      },
      "rust-style": {
        "dir": "genesis/orchestrator/rust-style",
        "inputs": {
          "sources": [
            "**/*.rs",
            "**/Cargo.toml",
            "**/.epr-meta",
            "**/.epr-meta/manifest.md",
            ".epr-meta/rust-style-policy.json",
            ".epr-meta/rust-style/**",
            "genesis/docs/rust-style-guide.md",
            "genesis/orchestrator/rust-style/**",
            "**/clippy.toml",
            "**/.clippy.toml",
            "**/rustfmt.toml",
            "**/.rustfmt.toml",
            "**/.cargo/config.toml"
          ],
          "buildProcess": [
            "genesis/orchestrator/rust-style/**",
            "genesis/orchestrator/rust-style.sh",
            ".claude/epr-meta/policies.yaml",
            "genesis/orchestrator/rust-style-ci.sh"
          ]
        },
        "run": {
          "kind": "root-just",
          "recipe": "_gate-rust-style",
          "cargo": {
            "workspace": "genesis__orchestrator__rust-style",
            "profile": "dev",
            "rustflags": "",
            "env": {
              "CARGO_BUILD_JOBS": "1"
            }
          }
        }
      }
    }
  },
  "deployment": {}
}
