/**
 * Elohim Orchestrator Pipeline v2
 *
 * CENTRAL CONTROLLER for all Elohim mono-repo pipelines.
 * This is the ONLY pipeline that receives GitHub webhooks.
 *
 * Key Improvements:
 *   - Explicit deployment tracking with version verification
 *   - Complete changeset analysis (all commits since last build, not just HEAD~1)
 *   - Post-deployment health verification
 *   - Clear decision matrix showing what will be built and why
 *   - Deployment manifest comparing expected vs actual versions
 *   - Commit message tags: [build:edge], [build:dna], [build:app], [build:all], [skip ci], [deploy-only]
 *
 * Dependency Graph:
 *   elohim-holochain (DNA/hApp, WASM) [cascades: true]
 *       ├──► elohim-edge (auto-triggered when DNA changes, ensures new hApp is deployed)
 *       │                                    ├──► elohim-genesis (seed + test)
 *       └──► elohim-steward (manual only)    │
 *   elohim (Angular app) ───────────────────┘
 */

// =============================================================================
// CONFIGURATION
// =============================================================================

import groovy.transform.Field

// longRunning flag: pipelines that take 15min+ to complete. Orchestrator
// dispatches these with `wait: false` (fire-and-forget) so the orchestrator
// itself stays short (~5min). This prevents the abortPrevious cascade
// documented as bug #5 in 2026-05-24 sweettest sprint result — when a new
// orchestrator dispatch arrived (cron or push), the prior orchestrator was
// aborted, which propagated to its in-flight `build(wait:true)` call and
// killed the long downstream mid-run (cost: 55-90min lost per cascade).
// Tradeoff: baseline advances optimistically at dispatch (not at completion);
// if a long pipeline fails silently and no follow-up push lands, baseline
// stays stale. Visible in the downstream pipeline's own Jenkins view.
// Environment-specific endpoints for version checking.
// `doorway-alpha-b` is the federation peer of doorway-alpha on apex hostname
// elohim.host; both back the shared alpha conductor pool — see
// genesis/orchestrator/manifests/doorway/alpha-b.yaml. Prod (doorway-prod /
// app-prod) is paused 2026-05-22 pending dev-branch federation proof; the
// app-prod entry was removed because its apex `elohim.host` is now bound to
// doorway-alpha-b. Restore it when the prod pipeline reopens.
@Field def VERSION_ENDPOINTS = [
    'doorway-alpha': 'https://doorway-alpha.elohim.host/version',
    'doorway-alpha-b': 'https://elohim.host/version',
    'doorway-prod': 'https://doorway.elohim.host/version',
    'app-alpha': 'https://alpha.elohim.host/version.json',
]

// =============================================================================
// HELPER FUNCTIONS
// =============================================================================

/**
 * Look up pipeline metadata from the manifest-derived registry.
 * Available after runBuildGraph() runs (Determine Build Plan stage).
 * For Pre-flight + early stages that need metadata before the registry is
 * populated, falls back to parsing manifests directly via find + readJSON.
 */
def getPipelineMetadata(String name) {
    if (env.PIPELINE_REGISTRY_JSON) {
        def registry = readJSON(text: env.PIPELINE_REGISTRY_JSON)
        def meta = registry[name] ?: [:]
        // readJSON deserializes an absent/null jenkinsPath as net.sf.json.JSONNull —
        // a non-null OBJECT, hence Groovy-TRUTHY — so `!meta.jenkinsPath` dispatch
        // filters let graph-only pipelines (elohim-doorway-app, by design no
        // jenkinsPath) through to dispatch, which soft-skips "No item named …"
        // → permanent UNSTABLE on every doorway-app-touching push. Normalize to
        // real-nonblank-String-or-absent, mirroring pipeline-registry.mjs's guard.
        def jp = meta.jenkinsPath
        if (!(jp instanceof CharSequence) || !jp.toString().trim()) {
            meta.remove('jenkinsPath')
        }
        // Same JSONNull-is-truthy hazard, and here it is worse: a truthy
        // jenkinsBranch routes a pipeline down the CROSS-REPO dispatch path,
        // which would send every pipeline to a wrong job with an empty
        // parameter set. Normalize to real-nonblank-String-or-absent.
        def jb = meta.jenkinsBranch
        if (!(jb instanceof CharSequence) || !jb.toString().trim()) {
            meta.remove('jenkinsBranch')
        }
        return meta
    }
    // Pre-build-graph fallback: parse manifests directly.
    def manifestPath = sh(
        script: "find . -name 'build-manifest.json' -not -path '*/node_modules/*' | xargs grep -l '\"pipeline\": \"${name}\"' | head -1",
        returnStdout: true
    ).trim()
    if (!manifestPath) return [:]
    def m = readJSON(file: manifestPath)
    // Build deploymentCheck from deployment.targets.<env>.healthCheck fields.
    def deploymentCheck = null
    def targets = m.deployment?.targets
    if (targets) {
        deploymentCheck = [:]
        targets.each { envName, target ->
            if (target?.healthCheck) {
                deploymentCheck[envName] = target.healthCheck
            }
        }
        if (deploymentCheck.isEmpty()) {
            deploymentCheck = null
        }
    }
    return [
        jenkinsPath:     m.jenkinsPath,
        // Job name / branch default to "same as the pipeline, same branch as this
        // orchestrator run". A pipeline whose Jenkins job tracks a DIFFERENT repo
        // (elohim-conductor → the elohim-edgenode job on che-devworkspaces) pins
        // both, because this repo's branch name means nothing over there.
        jenkinsJob:      m.jenkinsJob ?: m.pipeline,
        jenkinsBranch:   m.jenkinsBranch,
        manualOnly:      m.manualOnly == true,
        triggersGenesis: m.triggersGenesis == true,
        cascades:        m.cascades == null ? true : (m.cascades == true),
        dependsOn:       m.dependsOn ?: [],
        longRunning:     m.longRunning == true,
        deploymentCheck: deploymentCheck,
    ]
}

// Derive health endpoints from build-manifest.json deployment.targets.*.healthCheck fields.
def getHealthEndpoints() {
    def endpoints = [:]
    // Read deployment health checks from build-manifest.json files.
    def manifestPaths = sh(
        script: "find . -name 'build-manifest.json' -not -path '*/node_modules/*'",
        returnStdout: true
    ).trim().split('\n').findAll { it }
    manifestPaths.each { path ->
        def m = readJSON(file: path)
        def alphaCheck = m.deployment?.targets?.alpha?.healthCheck
        if (m.pipeline && alphaCheck) {
            endpoints[m.pipeline] = alphaCheck
        }
    }
    return endpoints
}

def getGitCommitHash() {
    return sh(script: 'git rev-parse HEAD | cut -c1-8', returnStdout: true).trim()
}

// CI Summary helpers for Claude triage
def categorizeFailure(String p) {
    ['elohim-holochain':'DNA_BUILD', 'elohim-edge':'INFRASTRUCTURE',
     'elohim':'APP_BUILD', 'elohim-genesis':'SEEDING', 'elohim-steward':'DESKTOP_BUILD',
     'elohim-sophia':'SOPHIA_BUILD'][p] ?: 'UNKNOWN'
}
def getRemediationHint(String p) {
    ['elohim-holochain':'Check RUSTFLAGS, cargo build locally',
     'elohim-edge':'Check hApp artifact, Harbor creds',
     'elohim':'Run npm run build locally',
     'elohim-genesis':'Check doorway-alpha.elohim.host/health or doorway-staging.elohim.host/health',
     'elohim-steward':'Check Tauri build, hApp artifact',
     'elohim-sophia':'cd sophia && pnpm lint && pnpm test'][p] ?: 'Check logs'
}
def calculateTriagePriority(int f, int u) { f > 0 && u > 0 ? 'CRITICAL' : f > 0 ? 'HIGH' : u > 0 ? 'MEDIUM' : 'LOW' }

/**
 * Archive per-pipeline baselines for the next orchestrator run's change detection.
 *
 * Called at multiple checkpoints ('plan' → 'execute' → 'post') so that a single
 * interrupted stage cannot wipe the baseline permanently. Each checkpoint is a
 * valid resume point on its own.
 *
 * Two correctness rules (bug #2 of 2026-05-24 sweettest sprint):
 *  1. Preserve per-pipeline baselines from env.PIPELINE_BASELINES (set in
 *     Execute Builds as recordPipelineResult advances them on success).
 *     Without this, every checkpoint wiped the per-pipeline tracking and
 *     forced re-dispatch of all pipelines on every push.
 *  2. Only advance __global__ when the orchestrator's overall state warrants
 *     it. At 'plan' and 'execute' checkpoints (build still in flight),
 *     advance optimistically. At 'post' checkpoint, gate the advance on
 *     currentBuild.result NOT being FAILURE/ABORTED — those mean downstream
 *     never finished its work, so __global__ shouldn't claim "all of HEAD
 *     was successfully built" (which would cause the next orchestrator to
 *     skip the rebuilds the failure actually requires).
 *
 * Pure pipeline steps only (readJSON/writeJSON/archiveArtifacts) — safe to call
 * from inside a container() block or from bare post.always.
 *
 * Fails loudly (error + no allowEmptyArchive) on writeJSON/archive drop-outs.
 * Silent degradation is what caused the original "No previous pipeline baselines
 * found (first run)" stuck state that re-triggered every pipeline on every push.
 */
def archivePipelineBaselines(String checkpoint) {
    // Rule 1: start from prior per-pipeline baselines (preserved across calls).
    def baselines = [:]
    if (env.PIPELINE_BASELINES) {
        try {
            def prior = readJSON(text: env.PIPELINE_BASELINES)
            if (prior instanceof Map) baselines = prior
        } catch (Exception e) {
            echo "[baseline:${checkpoint}] WARNING: env.PIPELINE_BASELINES unparseable (${e.message}); starting fresh"
        }
    }

    // Rule 2: gate __global__ advance on build state at post-checkpoint.
    boolean shouldAdvanceGlobal = true
    if (checkpoint == 'post') {
        // currentBuild.result is null while in-flight, set to FAILURE/UNSTABLE/etc
        // by stage failures or explicit unstable()/error() calls. Stage successes
        // before post.always leave it null = treated as SUCCESS by Jenkins.
        def cbResult = currentBuild.result ?: 'SUCCESS'
        if (cbResult in ['FAILURE', 'ABORTED', 'NOT_BUILT']) {
            shouldAdvanceGlobal = false
            def prior = baselines['__global__']
            echo "[baseline:${checkpoint}] currentBuild.result=${cbResult} — NOT advancing __global__ (preserving prior ${prior?.toString()?.take(8) ?: '(null)'})"
        }
    }
    if (shouldAdvanceGlobal && env.GIT_COMMIT_FULL) {
        baselines['__global__'] = env.GIT_COMMIT_FULL
    }

    env.PIPELINE_BASELINES = writeJSON(returnText: true, json: baselines)
    writeJSON file: 'pipeline-baselines.json', json: baselines, pretty: 2
    if (!fileExists('pipeline-baselines.json')) {
        error "pipeline-baselines.json missing after writeJSON (checkpoint=${checkpoint})"
    }
    archiveArtifacts artifacts: 'pipeline-baselines.json', fingerprint: true
    def perPipelineCount = baselines.keySet().findAll { it != '__global__' }.size()
    echo "[baseline:${checkpoint}] archived — __global__=${baselines['__global__']?.toString()?.take(8) ?: '(null)'}, per-pipeline=${perPipelineCount}"
}

/**
 * Advisory P2P peer validation — checks doorway /health for P2P status.
 * Logs warnings but never fails the build.
 */
def runP2PValidation(String environment, String doorwayUrl) {
    def result = sh(
        script: """
            set +e
            HEALTH=\$(curl -s --max-time 10 ${doorwayUrl}/health 2>/dev/null)
            if [ \$? -ne 0 ]; then
                echo "P2P [${environment}]: Could not reach ${doorwayUrl}/health"
                exit 0
            fi

            PEERS=\$(echo "\$HEALTH" | python3 -c "import sys,json; d=json.load(sys.stdin); p=d.get('p2p'); print(p.get('connectedPeers',0) if p else 'n/a')" 2>/dev/null)
            SYNC_DOCS=\$(echo "\$HEALTH" | python3 -c "import sys,json; d=json.load(sys.stdin); p=d.get('p2p'); print(p.get('syncDocuments',0) if p else 'n/a')" 2>/dev/null)
            PEER_ID=\$(echo "\$HEALTH" | python3 -c "import sys,json; d=json.load(sys.stdin); p=d.get('p2p'); print(p.get('peerId','unknown')[:12] if p else 'n/a')" 2>/dev/null)

            echo "P2P [${environment}]: peers=\${PEERS} sync_docs=\${SYNC_DOCS} peer_id=\${PEER_ID}"

            if [ "\$PEERS" = "n/a" ]; then
                echo "P2P [${environment}]: P2P not enabled on this doorway"
            elif [ "\$PEERS" = "0" ]; then
                echo "P2P [${environment}]: WARNING - no peers connected"
            else
                echo "P2P [${environment}]: OK - \${PEERS} peer(s) connected"
            fi
        """,
        returnStatus: true
    )
    return result == 0
}

def getGitCommitHashFull() {
    return sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
}

/**
 * Analyze the changeset to determine which files changed.
 *
 * Priority order:
 *   1. FORCE_COMMIT parameter (manual override)
 *   2. Stored global baseline (from pipeline-baselines.json of lastCompleted)
 *   3. GIT_PREVIOUS_COMMIT (Jenkins Git plugin - any result, always set after first build)
 *   4. GIT_PREVIOUS_SUCCESSFUL_COMMIT (Jenkins Git plugin - only advances on SUCCESS)
 *   5. HEAD~1 fallback (only diffs the latest push)
 *
 * Priority 3 (GIT_PREVIOUS_COMMIT) prevents the "stuck baseline" cascade where
 * a string of FAILUREs makes GIT_PREVIOUS_SUCCESSFUL_COMMIT lag arbitrarily far
 * behind HEAD. Using the immediately-previous build's HEAD (any result) instead
 * means the diff window is bounded to "since the last orchestrator dispatched",
 * which is what change-detection actually needs.
 */
def analyzeChangeset(storedGlobalBaseline = null) {
    // 1. Manual override via FORCE_COMMIT parameter
    def baseCommit = params.FORCE_COMMIT?.trim() ?: null

    // 2. Stored global baseline from previous completed build
    if (!baseCommit && storedGlobalBaseline) {
        baseCommit = storedGlobalBaseline
        echo "Using stored global baseline: ${baseCommit.take(8)}"
    }

    // 3. Jenkins Git plugin: previous build's commit (any result). Available
    //    after the first build on this branch. Preferred over the
    //    success-gated variant because a streak of FAILUREs must not stretch
    //    the baseline back arbitrarily far.
    if (!baseCommit && env.GIT_PREVIOUS_COMMIT) {
        baseCommit = env.GIT_PREVIOUS_COMMIT
        echo "Using GIT_PREVIOUS_COMMIT (previous build, any result): ${baseCommit.take(8)}"
    }

    // 4. Jenkins Git plugin: last successful build's commit (only advances on
    //    SUCCESS). Last-resort fallback before HEAD~1.
    if (!baseCommit) {
        baseCommit = env.GIT_PREVIOUS_SUCCESSFUL_COMMIT
    }

    if (baseCommit) {
        echo "Comparing HEAD against: ${baseCommit}"

        // Verify commit exists (handles force-push/rebase scenarios)
        def commitExists = sh(
            script: "git cat-file -t ${baseCommit} 2>/dev/null || echo 'missing'",
            returnStdout: true
        ).trim()

        if (commitExists == 'commit') {
            return sh(
                script: "git diff --name-only ${baseCommit}..HEAD",
                returnStdout: true
            ).trim().split('\n').findAll { it }
        }

        echo "WARNING: Commit ${baseCommit} not found in repo"
    }

    // 4. Fallback: diff against previous commit only
    // This is conservative - only looks at what changed in the latest push.
    // Once this build succeeds, GIT_PREVIOUS_SUCCESSFUL_COMMIT will be set
    // and future builds will diff correctly.
    echo 'No baseline commit available - diffing HEAD~1 (latest push only)'
    return sh(
        script: 'git diff --name-only HEAD~1 2>/dev/null || git diff --name-only HEAD',
        returnStdout: true
    ).trim().split('\n').findAll { it }
}

/**
 * Check deployed version against expected commit
 */
def checkDeployedVersion(String endpoint, String expectedCommit) {
    try {
        def response = sh(
            script: "curl -sf '${endpoint}' 2>/dev/null || echo '{}'",
            returnStdout: true
        ).trim()

        if (response.contains(expectedCommit) || response.contains(expectedCommit.take(7))) {
            return [match: true, response: response]
        }
        return [match: false, response: response, expected: expectedCommit]
    } catch (Exception e) {
        return [match: false, error: e.message]
    }
}

/**
 * Get health status of an endpoint
 */
def checkHealth(String name, String url) {
    def status = sh(
        script: "curl -sf -o /dev/null -w '%{http_code}' '${url}' 2>/dev/null || echo '000'",
        returnStdout: true
    ).trim()
    return [name: name, url: url, status: status, healthy: status in ['200', '301', '302']]
}

/**
 * Order pipelines by dependencies using topological sort.
 * Reads dependency metadata from build-manifest.json via getPipelineMetadata().
 */
def orderByDependencies(pipelineList) {
    def ordered = []
    def remaining = pipelineList.collect()

    while (!remaining.isEmpty()) {
        def ready = remaining.find { name ->
            def deps = getPipelineMetadata(name).dependsOn ?: []
            deps.every { dep ->
                !remaining.contains(dep) || ordered.contains(dep)
            }
        }

        if (ready) {
            ordered.add(ready)
            remaining.remove(ready)
        } else {
            ordered.addAll(remaining)
            break
        }
    }

    return ordered
}

/**
 * Group pipelines into dependency levels for parallel execution.
 * Pipelines in the same level have no dependencies on each other.
 * Genesis is excluded (always runs last after all builds succeed).
 * Reads dependency metadata from build-manifest.json via getPipelineMetadata().
 */
def groupByDependencyLevel(pipelineList) {
    def nonGenesis = pipelineList.findAll { it != 'elohim-genesis' }
    def levels = []
    def placed = [] as Set

    while (placed.size() < nonGenesis.size()) {
        def currentLevel = nonGenesis.findAll { name ->
            if (placed.contains(name)) return false
            def deps = getPipelineMetadata(name).dependsOn ?: []
            deps.every { dep -> !nonGenesis.contains(dep) || placed.contains(dep) }
        }
        if (currentLevel.isEmpty()) break
        levels.add(currentLevel)
        placed.addAll(currentLevel)
    }

    return levels
}

/**
 * Load per-pipeline baseline commits from the previous orchestrator build.
 * Each baseline records the commit at which that pipeline last built successfully.
 * This prevents re-triggering pipelines for changes they already built.
 */
def loadPipelineBaselines() {
    def baselines = [:]
    try {
        // Selector: lastCompleted() — every completed orchestrator run advances
        // the baseline, not only SUCCESS/UNSTABLE ones. Required because a
        // string of FAILUREs (genesis flake, downstream brokenness) would
        // otherwise freeze the baseline at the last UNSTABLE run, causing
        // every later build's changeset to balloon to "everything since then"
        // and dispatch the full cascade including hour-long DNA recompiles
        // that re-do uncovered work three runs in a row.
        //
        // Safe to use lastCompleted() because archivePipelineBaselines() always
        // writes at minimum __global__ = current HEAD on every checkpoint
        // (plan / execute / post), so a run that reached even the 'plan'
        // checkpoint produces a valid baseline regardless of subsequent
        // pipeline outcomes. A run hard-killed before 'plan' archives nothing
        // — copyArtifacts(optional: true) handles that silently and the
        // GIT_PREVIOUS_COMMIT fallback in analyzeChangeset takes over.
        copyArtifacts(
            projectName: env.JOB_NAME,
            filter: 'pipeline-baselines.json',
            selector: lastCompleted(),
            optional: true,
            flatten: true
        )
        if (fileExists('pipeline-baselines.json')) {
            baselines = readJSON(file: 'pipeline-baselines.json')
            // Defensive: an empty archive can still slip through (e.g. early
            // post-action archive before Execute Builds populated the file).
            // Treat empty baselines as missing so callers cold-start cleanly
            // rather than silently cascading into rebuild-everything.
            if (baselines.isEmpty()) {
                echo "Loaded pipeline-baselines.json but it is empty — treating as cold start"
                baselines = [:]
            } else {
                echo "Loaded per-pipeline baselines from previous successful build"
                baselines.each { name, commit ->
                    echo "   ${name}: ${commit.take(8)}"
                }
            }
        } else if (env.GIT_PREVIOUS_SUCCESSFUL_COMMIT) {
            // Contradictory state: Jenkins remembers a prior successful build but
            // we can't find its pipeline-baselines.json. This means the previous
            // build's post.always either skipped the archive (container step
            // failed, pod evicted) or copyArtifacts can't resolve JOB_NAME. Both
            // are bugs — loud warning so we see them instead of silently
            // cold-starting into a rebuild-everything cascade.
            echo """
╔══════════════════════════════════════════════════════════════════════════════╗
║  ⚠️  BASELINE CASCADE WARNING                                                ║
╠══════════════════════════════════════════════════════════════════════════════╣
║  copyArtifacts(lastSuccessful) found NO pipeline-baselines.json              ║
║  but GIT_PREVIOUS_SUCCESSFUL_COMMIT = ${env.GIT_PREVIOUS_SUCCESSFUL_COMMIT.take(8)}
║  JOB_NAME = ${env.JOB_NAME}
║                                                                              ║
║  The previous orchestrator build either:                                     ║
║    (a) failed to archive pipeline-baselines.json                             ║
║    (b) archived it but copyArtifacts can't resolve the selector              ║
║                                                                              ║
║  Falling back to GIT_PREVIOUS_SUCCESSFUL_COMMIT. Investigate the previous    ║
║  build's post block for archive failures.                                    ║
╚══════════════════════════════════════════════════════════════════════════════╝
            """
        } else {
            echo "No previous pipeline baselines found (cold start — genuinely first run)"
        }
    } catch (Exception e) {
        echo "WARNING: Could not load pipeline baselines: ${e.message}"
        echo "   Using global baseline (GIT_PREVIOUS_SUCCESSFUL_COMMIT)"
    }
    return baselines
}

/**
 * Record a triggerPipeline result: echo status, update baseline, and
 * mark the build UNSTABLE on a SKIPPED outcome (Jenkins job missing in
 * the multibranch tree even though strategy.mjs declares the pipeline).
 *
 * Extracted from Execute Builds' script {} body to keep it under the
 * 11000-byte HARD limit (each script {} compiles to its own CPS method
 * capped at 64KB JVM bytecode). Behaviour-preserving for the
 * SUCCESS/UNSTABLE/ERROR cases that existed before iteration 1 of the
 * 2026-05-17 rca-orchestrator-963 shift.
 */
def recordPipelineResult(String name, Map result, Map pipelineBaselines) {
    if (result.success) {
        if (result.skipped) {
            echo "⏭️ ${name}: SKIPPED — Jenkins job not provisioned (${result.error})"
            unstable("${name}: registered in strategy.mjs but Jenkins multibranch job missing — create it to restore full delivery")
        } else if (result.dispatched) {
            // Fire-and-forget (longRunning pipeline) — orchestrator did NOT
            // wait for downstream result. Advance baseline optimistically;
            // outcome is visible in the downstream pipeline's own Jenkins
            // view. See build-manifest.json longRunning flag for the
            // cascade-avoidance rationale (bug #5 of 2026-05-24 sweettest sprint).
            def buildRef = result.buildNumber ? "#${result.buildNumber}" : "(queued)"
            echo "🚀 ${name}: DISPATCHED ${buildRef} — fire-and-forget; baseline advanced optimistically"
            pipelineBaselines[name] = env.GIT_COMMIT_FULL
        } else if (result.unstable) {
            echo "⚠️ ${name}: UNSTABLE (${result.duration / 1000}s)"
            pipelineBaselines[name] = env.GIT_COMMIT_FULL
        } else {
            echo "✅ ${name}: SUCCESS (${result.duration / 1000}s)"
            pipelineBaselines[name] = env.GIT_COMMIT_FULL
        }
    } else {
        echo "❌ ${name}: ${result.result}"
        if (result.error) echo "   Error: ${result.error}"
    }
}

/**
 * Extract the lowercased, comma-split tokens from every [build:…] tag in a
 * commit message.
 *
 * `@NonCPS` here is LOAD-BEARING, not decoration. `=~` yields a
 * java.util.regex.Matcher, which is NOT serializable. A Matcher sitting in a CPS
 * local is harmless only until the next CPS step forces a program save — then
 * the build dies with `NotSerializableException: java.util.regex.Matcher` at
 * "End of Pipeline", AFTER every stage has already reported success, so the
 * failure looks like it came from nowhere. Running the regex inside a @NonCPS
 * frame keeps the Matcher out of the serialized program entirely; the returned
 * List<String> is plain serializable data.
 *
 * Lived: orchestrator #1666 — adding an `applyConductorTag()` call (which runs
 * writeFile/sh/readJSON) after the old inline `def tagMatcher = …` block turned
 * a latent scope violation into an every-push failure that dispatched nothing.
 * The `[build:all]` branch's readJSON was the same bug, unfired.
 *
 * @NonCPS also keeps this regex out of the CPS dispatch method, which matters
 * for the Jenkinsfile 64KB CPS size ceiling.
 */
@NonCPS
def parseBuildTagTokens(String commitMsg) {
    def tokens = []
    def matcher = (commitMsg =~ /(?i)\[build:([a-z,-]+)\]/)
    while (matcher.find()) {
        matcher.group(1).split(',').each { token -> tokens.add(token.trim().toLowerCase()) }
    }
    return tokens
}

/**
 * Parse the [conductor:…] commit tag — variant, feature set, canary, fork
 * branches for the custom-conductor image build — and stash it for dispatch.
 *
 * The grammar has ONE home (genesis/orchestrator/commit-tag-parser.mjs); this
 * shells out to it rather than adding a third copy alongside the [build:*]
 * aliases already duplicated in this file. The commit message travels by FILE,
 * never argv — it is untrusted multi-line text.
 *
 * The tag is itself the intent to build, so it force-includes the pipeline; a
 * separate [build:conductor] is not required.
 *
 * @return pipeline names to force-include ([] or ['elohim-conductor'])
 */
def applyConductorTag(String commitMsg) {
    String msgFile = '.orchestrator-commit-msg.txt'
    writeFile file: msgFile, text: commitMsg
    def json = sh(
        script: "node genesis/orchestrator/commit-tag-parser.mjs conductor-opts ${msgFile}",
        returnStdout: true
    ).trim()
    sh "rm -f ${msgFile}"
    def opts = readJSON(text: json)
    if (!opts.present) return []
    env.CONDUCTOR_OPTS_JSON = json
    echo "🔩 [conductor:*] detected — ${json}"
    if (opts.unknown) {
        echo "⚠️  Unrecognized [conductor:*] items ignored: ${opts.unknown.join(', ')}"
    }
    return ['elohim-conductor']
}

/**
 * Normalize a build() call into the result Map the reporting code expects.
 *
 * Fire-and-forget: build() returns the RunWrapper for the queued build but
 * result/duration are not yet known. Mark as dispatched and let the caller
 * advance the baseline optimistically — if the build later fails, the next
 * push touching this pipeline's patterns re-dispatches (failures are visible
 * in the downstream's own Jenkins view). Tradeoff documented at the
 * build-manifest.json longRunning flag.
 */
def dispatchResult(Object result, boolean waited) {
    if (!waited) {
        return [
            success: true,
            dispatched: true,
            result: 'DISPATCHED',
            duration: 0,
            url: result?.absoluteUrl ?: "(queued)",
            buildNumber: result?.number ?: null
        ]
    }
    return [
        success: result.result in ['SUCCESS', 'UNSTABLE'],
        unstable: result.result == 'UNSTABLE',
        result: result.result,
        duration: result.duration,
        url: result.absoluteUrl,
        buildNumber: result.number
    ]
}

/**
 * Parameters for a pipeline whose Jenkins job tracks a different repository.
 *
 * elohim-conductor → the elohim-edgenode job (SCM: che-devworkspaces), which
 * compiles the patched holochain conductor. Two things get forwarded:
 *
 *   HC_REF — the SHA THIS commit's conductor submodule pointer records. That is
 *   what makes the built image correspond to committed source: the job publishes
 *   `elohim-edgenode:conductor-<sha12>`, and the edge pipeline derives the same
 *   tag from the same pointer when it bakes the storage image. No hand-edited
 *   digest, no manual job run.
 *
 *   The [conductor:…] commit-tag options (parsed into CONDUCTOR_OPTS_JSON) —
 *   variant, feature set, canary, fork branches. This is the whole point of the
 *   integration: a conductor variant is buildable from a commit message instead
 *   of a hand-filled Jenkins parameter form.
 */
def crossRepoParams(String name) {
    if (name != 'elohim-conductor') return []
    def opts = env.CONDUCTOR_OPTS_JSON ? readJSON(text: env.CONDUCTOR_OPTS_JSON) : [:]
    def out = []
    out.add(stringParam(name: 'HC_REF', value: submoduleSha('elohim/holochain-conductor')))
    if (opts.hcBranch)  out.add(stringParam(name: 'HC_BRANCH',  value: opts.hcBranch))
    if (opts.features)  out.add(stringParam(name: 'HC_FEATURES', value: opts.features))
    out.add(booleanParam(name: 'BUILD_STORAGE_CANARY', value: opts.canary == true))
    out.add(booleanParam(name: 'SKIP_PUSH', value: opts.skipPush == true))
    return out
}

/**
 * Read a submodule pointer's recorded commit from the current tree.
 *
 * `rev-parse HEAD:<path>` reads the gitlink out of the commit object, so this
 * works for `update = none` submodules that are never cloned in CI — which is
 * exactly what the conductor forks are. Empty on failure: the downstream job
 * falls back to a branch-tip build and publishes no pin tag, which the edge
 * pipeline then reports as a missing conductor rather than silently deploying
 * the wrong one.
 */
def submoduleSha(String path) {
    return sh(
        script: "git rev-parse HEAD:${path} 2>/dev/null || true",
        returnStdout: true
    ).trim()
}

/**
 * Trigger a pipeline. Long-running pipelines (config.longRunning) are
 * dispatched fire-and-forget (wait:false) so the orchestrator stays short
 * and the abortPrevious cascade (bug #5 of 2026-05-24 sweettest sprint)
 * can no longer kill in-flight downstreams. Short pipelines keep wait:true
 * so the orchestrator can summarise their result inline.
 *
 * The wait param remains as a manual override for callers that need it
 * (e.g. genesis dispatched as a barrier). Default is "auto" — derived
 * from config.longRunning.
 */
def triggerPipeline(String name, String branch, Object wait = null, List changedFiles = []) {
    def config = getPipelineMetadata(name)
    if (!config.jenkinsPath) {
        error "Cannot dispatch pipeline '${name}': no jenkinsPath in its build-manifest.json"
    }
    // Auto-derive wait from longRunning flag unless caller forced it.
    boolean shouldWait = (wait == null) ? !(config.longRunning) : (wait as boolean)
    String waitMode = shouldWait ? 'wait-for-result' : 'fire-and-forget (longRunning)'
    // A cross-repo pipeline pins its own job name and branch (see getPipelineMetadata).
    String jobName = config.jenkinsJob ?: name
    String jobBranch = config.jenkinsBranch ?: branch
    echo "▶️ Triggering ${jobName}/${jobBranch} [${waitMode}]..."

    try {
        // Only send FORCE_DEPLOY to pipelines that actually deploy (have a deploymentCheck)
        // Note: local list named `buildParams` to avoid shadowing the pipeline-scope
        // `params` accessor (needed below to forward DEPLOY_ONLY).
        // An isolated edge validation must not arrive carrying the ordinary
        // force-build/deploy flags. The edge Jenkinsfile also reads the commit
        // tag directly, but the explicit parameter makes the dispatch contract
        // visible in Jenkins and keeps the guarantee independent of checkout
        // history depth.
        boolean validateOnlyDownstream = name == 'elohim-edge' && env.EDGE_VALIDATE_ONLY_FROM_TAG == 'true'
        // Cross-repo pipelines share none of the monorepo's parameter vocabulary —
        // sending FORCE_BUILD/DEPLOY_ONLY/CHANGED_PATHS to a job that declares none
        // of them produces undefined-parameter warnings and no behaviour. They get
        // their own dedicated list instead.
        if (config.jenkinsBranch) {
            def result = build(
                job: "${jobName}/${jobBranch}",
                wait: shouldWait,
                propagate: false,
                parameters: crossRepoParams(name)
            )
            return dispatchResult(result, shouldWait)
        }
        def buildParams = [booleanParam(name: 'FORCE_BUILD', value: !validateOnlyDownstream)]
        if (config.deploymentCheck) {
            buildParams.add(booleanParam(name: 'FORCE_DEPLOY', value: !validateOnlyDownstream))
        }
        // Propagate DEPLOY_ONLY so downstream pipelines (edge especially) skip
        // their build stages and go straight to deploy. Safe to send to all
        // declared downstream pipelines — each one accepts the param as a no-op
        // when not deploy-bearing.
        // Two activation paths: operator param OR [deploy-only] commit tag.
        def deployOnlyDownstream = (params.DEPLOY_ONLY ?: false) || env.DEPLOY_ONLY_FROM_TAG == 'true'
        buildParams.add(booleanParam(name: 'DEPLOY_ONLY', value: deployOnlyDownstream))
        if (name == 'elohim-edge') {
            buildParams.add(booleanParam(name: 'VALIDATE_ONLY', value: validateOnlyDownstream))
        }
        // CHANGED_PATHS — newline-delimited list of changed source paths
        // from this orchestrator run's changeset. Downstream pipelines that
        // want per-path / per-DNA selectivity (e.g. elohim-holochain's
        // sweettest stage harvester for nextest binary filter, W3 of the
        // 2026-05-24 stage efficiency design) read this. Empty value →
        // full-suite fallback (manual / [build:X] tag / force builds).
        buildParams.add(stringParam(name: 'CHANGED_PATHS', value: changedFiles.join('\n')))

        // RESET_STORAGE — only elohim-genesis declares + consumes it (wipe content.db +
        // fresh reseed). Two activation paths: operator param OR [reseed] commit tag
        // (webhook-gated above). Scoped to genesis so other pipelines don't get an
        // undefined-param warning.
        if (name == 'elohim-genesis') {
            boolean resetStorage = (params.RESET_STORAGE ?: false) || env.RESET_STORAGE_FROM_TAG == 'true'
            buildParams.add(booleanParam(name: 'RESET_STORAGE', value: resetStorage))
        }

        def result = build(
            job: "${jobName}/${jobBranch}",
            wait: shouldWait,
            propagate: false,
            parameters: buildParams
        )

        return dispatchResult(result, shouldWait)
    } catch (Exception e) {
        // Distinguish "Jenkins job not provisioned" from a real build failure.
        // When a pipeline is registered in build-manifest.json
        // but its multibranch job has not been created in Jenkins yet — a normal
        // interim state during multi-step pipeline landings — the build(job:…) call
        // throws hudson.AbortException with "No item named <X> found". Treat that
        // as a soft skip: the orchestrator marks UNSTABLE-with-clear-warning at
        // the call site (not FAILURE), other downstream pipelines still run, and
        // the missing job is surfaced loudly so the operator provisions it.
        // See .claude/shifts/2026-05-17T15-57-rca-orchestrator-963-graph-failure
        // for the RCA that motivated this branch.
        if (e.message?.contains('No item named')) {
            return [
                success: true,
                skipped: true,
                result: 'NOT_PROVISIONED',
                error: e.message
            ]
        }
        return [
            success: false,
            result: 'ERROR',
            error: e.message
        ]
    }
}

/**
 * Auto-mode analyzer — load baselines, analyze changesets, apply
 * commit-tag overrides, propagate dependencies, auto-include genesis.
 * Extracted from Determine Build Plan to keep its script {} body
 * under the 64KB CPS method size limit.
 *
 * Side effects: sets env.PIPELINE_BASELINES, env.CHANGED_FILES_COUNT,
 * env.ANALYSIS_JSON; logs decision matrix output.
 *
 * @return Map [pipelines, analysis, changedFiles]
 */
def autoModeAnalyze() {
    def pipelineBaselines = [:]
    if (!(params.FORCE_COMMIT?.trim())) {
        pipelineBaselines = loadPipelineBaselines()
    }

    echo "🔍 Analyzing changesets since last build..."
    def changedFiles = analyzeChangeset(pipelineBaselines['__global__'])

    env.PIPELINE_BASELINES = writeJSON(returnText: true, json: pipelineBaselines)
    env.CHANGED_FILES_COUNT = changedFiles.size().toString()

    // Group changed files by top-level area for the decision-matrix log.
    def filesByArea = [:]
    changedFiles.each { file ->
        def area = file.split('/')[0]
        if (!filesByArea[area]) filesByArea[area] = []
        filesByArea[area].add(file)
    }
    echo "📁 Changed Files (${changedFiles.size()} total):"
    filesByArea.each { area, files ->
        echo "   ${area}/ (${files.size()} files)"
        files.take(3).each { echo "      └─ ${it}" }
        if (files.size() > 3) echo "      └─ ... and ${files.size() - 3} more"
    }

    // Build advisory analysis map from manifest-backed metadata.
    // The build graph (runBuildGraph) is authoritative; this map is used
    // only for the decision matrix display and pipeline-name enumeration.
    def allPipelineNames = env.PIPELINE_REGISTRY_JSON
        ? readJSON(text: env.PIPELINE_REGISTRY_JSON).keySet().toList()
        : []
    def analysis = [:]
    allPipelineNames.each { name ->
        def meta = getPipelineMetadata(name)
        analysis[name] = [
            shouldRun: false,
            manualOnly: meta.manualOnly ?: false,
            matchedPatterns: [],
            matchedFileCount: 0,
            sampleFiles: [],
            dependsOn: meta.dependsOn ?: [],
            triggersGenesis: meta.triggersGenesis ?: false,
            baselineUsed: 'global'
        ]
    }
    env.ANALYSIS_JSON = writeJSON(returnText: true, json: analysis)

    // Return empty pipelines list — graph routing (applyBuildGraphRouting)
    // is the sole authority for auto mode pipeline selection.
    return [pipelines: [], analysis: analysis, changedFiles: changedFiles]
}

/**
 * Manual-mode analyzer — emit fixed pipeline lists for explicit operator
 * mode params, plus a synthetic analysis Map for the decision matrix
 * display. Extracted from Determine Build Plan to keep script {} body
 * under the 64KB CPS limit.
 *
 * @return Map [pipelines, analysis]
 */
def manualModeAnalyze(String mode) {
    echo "📋 Using manual build mode: ${mode}"
    def pipelines = []

    switch (mode) {
        case 'rebuild-all':
            pipelines = ['elohim-holochain', 'elohim-edge', 'elohim']
            if (!params.SKIP_GENESIS) pipelines.add('elohim-genesis')
            break
        case 'rebuild-edge':
            pipelines = ['elohim-edge']
            if (!params.SKIP_GENESIS) pipelines.add('elohim-genesis')
            break
        case 'rebuild-app':
            pipelines = ['elohim']
            if (!params.SKIP_GENESIS) pipelines.add('elohim-genesis')
            break
        case 'genesis-only':
            pipelines = ['elohim-genesis']
            break
    }

    // Build the advisory analysis map from manifest-backed metadata.
    // In manual mode the build graph hasn't run yet, so derive the name list
    // from PIPELINE_REGISTRY_JSON (populated by runBuildGraph in auto mode,
    // or empty in manual mode — callers that need the matrix should ensure
    // the registry is populated before this runs).
    def allPipelineNames = env.PIPELINE_REGISTRY_JSON
        ? readJSON(text: env.PIPELINE_REGISTRY_JSON).keySet().toList()
        : []

    def analysis = [:]
    allPipelineNames.each { name ->
        def meta = getPipelineMetadata(name)
        analysis[name] = [
            shouldRun: pipelines.contains(name),
            manualOnly: meta.manualOnly ?: false,
            matchedPatterns: pipelines.contains(name) ? ['manual-mode'] : [],
            matchedFileCount: 0,
            sampleFiles: [],
            dependsOn: meta.dependsOn ?: [],
            triggersGenesis: meta.triggersGenesis ?: false,
            baselineUsed: 'global'
        ]
    }
    env.ANALYSIS_JSON = writeJSON(returnText: true, json: analysis)

    return [pipelines: pipelines, analysis: analysis]
}

/**
 * Apply build-graph routing on top of legacy analysis. For auto/status
 * mode, runs runBuildGraph then applies [build:*] tag overrides + genesis
 * auto-include. For manual mode, passes through the explicit pipeline list.
 * Extracted from Determine Build Plan to keep script {} body under 64KB.
 */
def applyBuildGraphRouting(String mode, changedFiles, analysis, fallbackPipelines) {
    def graphPipelines
    if (mode in ['auto', 'status']) {
        echo '\n=== Build Graph (Primary) ==='
        def graphResult = runBuildGraph(changedFiles)
        graphPipelines = graphResult.pipelineSteps.keySet().toList()

        // Filter to dispatchable pipelines (have jenkinsPath in their manifest).
        graphPipelines.removeAll { name -> !getPipelineMetadata(name).jenkinsPath }

        // Apply [build:*] commit-message overrides — graph-walker (auth
        // since 2026-04) needs to honor manual retrigger workflow.
        if (env.FORCE_BUILD_PIPELINES) {
            env.FORCE_BUILD_PIPELINES.split(',').each { name ->
                def meta = getPipelineMetadata(name)
                if (!graphPipelines.contains(name) && meta.jenkinsPath) {
                    graphPipelines.add(name)
                    echo "🔧 [build:*] force-include applied to graph result: ${name}"
                } else if (!graphPipelines.contains(name)) {
                    echo "⚠️  [build:*] force-include DROPPED: ${name} has no jenkinsPath in the registry — not dispatchable"
                }
            }
        }

        // Genesis auto-include for dev branches
        if (!graphPipelines.contains('elohim-genesis') && !params.SKIP_GENESIS) {
            def isDevBranch = env.BRANCH_NAME == 'dev' || env.BRANCH_NAME ==~ /dev-.+|feat-.+|claude\/.+/
            def triggeringPipeline = graphPipelines.find { getPipelineMetadata(it).triggersGenesis }
            if (triggeringPipeline && isDevBranch) {
                graphPipelines.add('elohim-genesis')
            }
        }
    } else {
        graphPipelines = fallbackPipelines
    }

    // Self-dispatch guard: the orchestrator must NEVER dispatch itself as a downstream.
    // A push touching any **/Jenkinsfile* path matches elohim-orchestrator's
    // lint-jenkinsfiles source glob, which would schedule elohim-orchestrator/<branch>
    // as a downstream of THIS very build. With abortPrevious concurrency, the
    // self-triggered child aborts its still-running parent (and is itself orphaned as
    // BuildTriggerCancelled), so the parent exits NOT_BUILT before Level-1 (genesis) ever
    // dispatches. propagate:false / longRunning fire-and-forget cannot cover this — only
    // self-exclusion can. (Diagnosed 2026-06-03: every Jenkinsfile-touching dev push
    // produced a NOT_BUILT+ABORTED orchestrator pair (#1135–#1140) and dispatched no
    // genesis build since #1076.) findAll (non-mutating) is immutable-list-safe.
    def selfProject = (env.JOB_NAME ?: '').tokenize('/')[0]
    if (selfProject && graphPipelines.contains(selfProject)) {
        graphPipelines = graphPipelines.findAll { name -> name != selfProject }
        echo "🛡️  self-dispatch guard: removed ${selfProject} from the dispatch set (a build never triggers itself)"
    }
    return graphPipelines
}

/**
 * Build the predicted-build-graph artifact map. Extracted from
 * Determine Build Plan to keep the inline CPS-compiled method under
 * the 64KB JVM limit.
 */
def buildPredictedGraph(graphPipelines, analysis, mode, deployOnly, changedFiles, predictedLevels, hasGenesis) {
    return [
        schemaVersion: '1',
        predictedAt: new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC')),
        commitSha: env.GIT_COMMIT_FULL ?: env.GIT_COMMIT ?: '',
        branch: env.BRANCH_NAME ?: '',
        mode: mode,
        buildTrigger: env.BUILD_TRIGGER ?: '',
        buildNumber: env.BUILD_NUMBER ?: '',
        changedFileCount: changedFiles.size(),
        // Cap at 50 — the decision matrix is the authoritative view; this
        // is for forensic spot-checks only.
        changedFilesSample: changedFiles.take(50),
        skipCi: env.SKIP_CI == 'true',
        forceBuildPipelines: (env.FORCE_BUILD_PIPELINES ?: '').split(',').findAll { it },
        deployOnly: deployOnly,
        pipelines: graphPipelines,
        levels: predictedLevels,
        genesisAfterLevels: hasGenesis,
        analysis: analysis,
    ]
}

/**
 * Build the actual-build-graph artifact map. Extracted from Execute
 * Builds to keep the inline CPS-compiled method under the 64KB JVM limit.
 */
def buildActualGraph(pipelines, results, levels) {
    def levelMap = [:]
    levels.eachWithIndex { lvl, idx ->
        lvl.each { name -> levelMap[name] = idx }
    }
    if (pipelines.contains('elohim-genesis')) {
        levelMap['elohim-genesis'] = 'genesis-trailer'
    }

    def abortedBeforeStart = pipelines.findAll { name -> !results.containsKey(name) }

    def enrichedResults = [:]
    results.each { name, info ->
        def enriched = [:] + info
        enriched.level = levelMap.containsKey(name) ? levelMap[name] : null
        enrichedResults[name] = enriched
    }

    return [
        schemaVersion: '1',
        executedAt: new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC')),
        commitSha: env.GIT_COMMIT_FULL ?: env.GIT_COMMIT ?: '',
        branch: env.BRANCH_NAME ?: '',
        buildNumber: env.BUILD_NUMBER ?: '',
        executionOrder: pipelines,
        results: enrichedResults,
        abortedBeforeStart: abortedBeforeStart,
    ]
}

/**
 * Build the machine-readable CI summary map. Extracted from post.always
 * to keep the inline pipeline { } block under the JVM CPS 64KB method
 * size limit. See CLAUDE.md note: "Never add inline logic to stages."
 */
def buildCiSummary(results, preflight, postflight, verification, successCount, unstableCount, failCount, healthyCount, unhealthyCount) {
    return [
        schema_version: '1.0.0',
        timestamp: new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC')),
        orchestration: [
            build_number: env.BUILD_NUMBER,
            build_url: env.BUILD_URL,
            branch: env.BRANCH_NAME,
            commit: env.GIT_COMMIT_SHORT ?: 'unknown',
            mode: params.MODE,
            duration_seconds: (System.currentTimeMillis() - currentBuild.startTimeInMillis) / 1000
        ],
        pipelines: results.collect { name, r ->
            [
                name: name,
                status: r?.unstable ? 'UNSTABLE' : (r?.success ? 'SUCCESS' : (r?.result ?: 'FAILURE')),
                url: r?.url,
                duration_ms: r?.duration,
                category: r?.success ? null : categorizeFailure(name),
                remediation_hint: r?.success ? null : getRemediationHint(name)
            ]
        },
        health: [
            preflight: preflight,
            postflight: postflight,
            degraded_services: postflight.findAll { k, v -> !v?.healthy }.keySet().toList()
        ],
        deployment: [
            verified: verification.every { k, v -> v?.match },
            verification_results: verification,
            mismatches: verification.findAll { k, v -> !v?.match }.keySet().toList()
        ],
        summary: [
            overall_status: failCount > 0 ? 'FAILURE' : (unstableCount > 0 || unhealthyCount > 0 ? 'UNSTABLE' : 'SUCCESS'),
            builds_succeeded: successCount,
            builds_unstable: unstableCount,
            builds_failed: failCount,
            services_healthy: healthyCount,
            services_total: postflight.size(),
            failed_pipelines: results.findAll { k, v -> !v?.success }.keySet().toList(),
            triage_priority: calculateTriagePriority(failCount, unhealthyCount),
            action_required: failCount > 0 ? results.findAll { k, v -> !v?.success }.collect { name, r ->
                "${name}: ${getRemediationHint(name)}"
            } : []
        ]
    ]
}

/**
 * Reconciliation backstop — runs in post.always when the happy-path
 * Reconcile Build Graph stage was skipped (cascade abort). Synthesizes
 * actual-build-graph.json from env.BUILD_RESULTS so external Ralph
 * Wiggum tooling can still reconcile against the predicted artifact.
 *
 * Pure Groovy + Jenkins workflow primitives only — runs inside
 * node('built-in') where sh / node may be unavailable.
 */
def runReconciliationBackstop() {
    def predictedFile = env.PREDICTED_BUILD_GRAPH_FILE ?: 'predicted-build-graph.json'
    def actualFile = env.ACTUAL_BUILD_GRAPH_FILE ?: 'actual-build-graph.json'
    def reconciliationFile = env.BUILD_GRAPH_RECONCILIATION_FILE ?: 'build-graph-reconciliation.json'

    // Post block runs in node('built-in'); Determine Build Plan + Post
    // Predicted Build Graph ran in container('builder') with a different
    // workspace. Recover the archived predictedFile into this workspace
    // before checking — otherwise we'd false-positive "Determine Build
    // Plan did not complete" on every cascade-abort run.
    if (!fileExists(predictedFile)) {
        try {
            copyArtifacts(
                projectName: env.JOB_NAME,
                selector: specific(env.BUILD_NUMBER),
                filter: predictedFile,
                optional: true,
                fingerprintArtifacts: false,
            )
        } catch (Exception e) {
            echo "[backstop] could not copy-back ${predictedFile} from this build: ${e.message}"
        }
    }

    if (!fileExists(predictedFile)) {
        echo "[backstop] No ${predictedFile} after copy-back — Determine Build Plan never archived it (early abort or archive failure); skipping reconciliation backstop"
        return
    }

    if (!fileExists(actualFile)) {
        def predicted = readJSON(file: predictedFile)
        def predictedPipelines = predicted.pipelines ?: []
        def buildResults = readJSON(text: env.BUILD_RESULTS ?: '{}')
        def abortedBeforeStart = predictedPipelines.findAll { name -> !buildResults.containsKey(name) }
        def synthesized = [
            schemaVersion: '1',
            executedAt: new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC')),
            commitSha: env.GIT_COMMIT_FULL ?: env.GIT_COMMIT ?: '',
            branch: env.BRANCH_NAME ?: '',
            buildNumber: env.BUILD_NUMBER ?: '',
            executionOrder: predictedPipelines,
            results: buildResults,
            abortedBeforeStart: abortedBeforeStart,
            synthesizedByBackstop: true
        ]
        writeJSON file: actualFile, json: synthesized, pretty: 2
        archiveArtifacts artifacts: actualFile, allowEmptyArchive: true
        echo "[backstop] Synthesized ${actualFile} from env.BUILD_RESULTS — ${buildResults.size()} pipelines completed, ${abortedBeforeStart.size()} aborted before start"
    }

    if (!fileExists(reconciliationFile)) {
        echo '[backstop] No reconciliation artifact yet — Reconcile Build Graph stage was skipped (cascade abort path).'
        echo '[backstop] Both predicted and actual artifacts are archived. To reconcile externally:'
        echo "[backstop]   curl -O \${BUILD_URL}artifact/${predictedFile}"
        echo "[backstop]   curl -O \${BUILD_URL}artifact/${actualFile}"
        echo "[backstop]   node genesis/orchestrator/reconcile-build-graph.mjs ${predictedFile} ${actualFile} out.json"
    } else {
        echo '[backstop] Reconciliation artifact already exists — happy-path Reconcile Build Graph stage ran.'
    }
}

/**
 * Continuity guard for build-state.json. If this run was interrupted
 * before saveBuildState ran (superseded push, pod eviction, SCM checkout
 * abort), copy-forward the most recent good build-state.json so the next
 * orchestrator build doesn't cold-start every pipeline.
 */
def maintainBuildStateContinuity() {
    if (!fileExists('build-state.json')) {
        try {
            copyArtifacts(
                projectName: env.JOB_NAME,
                selector: lastSuccessful(),
                filter: 'build-state.json',
                optional: true,
                fingerprintArtifacts: false
            )
        } catch (Exception e) {
            echo "[baseline:post] could not copy-forward build-state.json: ${e.message}"
        }
    }
    if (fileExists('build-state.json')) {
        archiveArtifacts artifacts: 'build-state.json', fingerprint: true
        echo "[baseline:post] build-state.json archived (continuity)"
    } else {
        echo "[baseline:post] no prior build-state.json found — genuine first run"
    }
}

/**
 * Hydrate stageAnnotations for a downstream pipeline by copying its
 * structured artifacts into the orchestrator workspace and parsing them.
 *
 * The actual-build-graph.json's results map gets a `stageAnnotations` field
 * per pipeline that ran one of these emit-aware stages. This lets the
 * reconciler surface peer-level / human-level findings as investigation
 * pointers without requiring downstream tooling to fetch each downstream
 * build's artifacts separately.
 *
 * Best-effort by design: a missing artifact (build aborted before emit,
 * old pipeline version, archive expired) yields a smaller annotation map.
 * The reconciler tolerates absent annotations.
 *
 * @param pipelineName  e.g. 'elohim-genesis'
 * @param buildNumber   the downstream build's number (from triggerPipeline result)
 * @param branch        e.g. env.BRANCH_NAME
 * @return              Map of annotation key → parsed JSON
 */
def hydrateStageAnnotations(String pipelineName, def buildNumber, String branch) {
    def annotations = [:]
    if (!buildNumber) return annotations

    // Each pipeline declares which artifacts to slurp. Genesis is the
    // only pipeline today; future pipelines (edge, app) can register here
    // when they emit their own stage-level partial-readiness signals.
    def manifest = readJSON(file: 'genesis/orchestrator/build-artifacts.json')
    def genesisArtifacts = manifest.genesis ?: [:]
    def perPipelineArtifacts = [
        'elohim-genesis': [
            conductorReadiness:                genesisArtifacts.conductorReadiness,
            seedResultsConductorIdentities:    genesisArtifacts.seedResultsConductorIdentities,
            seedResultsAgentBindings:          genesisArtifacts.seedResultsAgentBindings,
        ],
    ]
    def wanted = perPipelineArtifacts[pipelineName]
    if (!wanted) return annotations

    // Copy into a per-build dir so successive trigger calls don't clobber
    // each other's artifacts. The dir is local to the orchestrator workspace
    // and not archived — only the parsed values land in stageAnnotations.
    def downstreamDir = "downstream-artifacts/${pipelineName}-${buildNumber}"
    sh "mkdir -p '${downstreamDir}'"

    // Build an Ant glob that catches all wanted basenames, regardless of
    // where they were archived inside the downstream build. The seeders
    // archive at genesis/seeder/<name>; conductor-readiness archives at root.
    def basenames = wanted.values().findAll { it } as Set
    def filter = basenames.collect { "**/${it}" }.join(',')

    try {
        copyArtifacts(
            projectName: "${pipelineName}/${branch}",
            selector: specific(buildNumber.toString()),
            filter: filter,
            target: downstreamDir,
            optional: true,
            flatten: true,
            fingerprintArtifacts: false,
        )
    } catch (Exception e) {
        echo "[stageAnnotations] copyArtifacts failed for ${pipelineName} #${buildNumber}: ${e.message}"
        return annotations
    }

    wanted.each { String key, String fname ->
        if (!fname) return
        def path = "${downstreamDir}/${fname}"
        if (fileExists(path)) {
            try {
                annotations[key] = readJSON(file: path)
            } catch (Exception e) {
                echo "[stageAnnotations] could not parse ${path}: ${e.message}"
            }
        }
    }

    return annotations
}

/**
 * Print a decision matrix showing what will be built and why
 */
def printDecisionMatrix(analysis, pipelines) {
    echo '''
╔══════════════════════════════════════════════════════════════════════════════╗
║                          DEPLOYMENT DECISION MATRIX                           ║
╠══════════════════════════════════════════════════════════════════════════════╣'''

    def allNames = analysis.keySet().toList().sort()
    allNames.each { name ->
        def info = analysis[name]
        if (!info) return
        def willRun = pipelines.contains(name)
        def icon = willRun ? '🔨' : (info.manualOnly ? '🔒' : '⏭️')
        def status = willRun ? 'BUILD' : (info.manualOnly ? 'MANUAL' : 'SKIP')

        def reason = info.matchedPatterns.join(', ') ?: 'no changes'
        def baselineInfo = info.baselineUsed && info.baselineUsed != 'global' ? " (since ${info.baselineUsed})" : ''
        echo "║ ${icon} ${name.padRight(20)} │ ${status.padRight(8)} │ ${reason}${baselineInfo}"

        if (info.sampleFiles && info.sampleFiles.size() > 0) {
            info.sampleFiles.each { file ->
                echo "║    └─ ${file}"
            }
        }
    }

    echo '''╚══════════════════════════════════════════════════════════════════════════════╝'''
}

/**
 * Print deployment verification results
 */
def printDeploymentVerification(commit, results) {
    echo """
╔══════════════════════════════════════════════════════════════════════════════╗
║                          DEPLOYMENT VERIFICATION                              ║
║  Expected commit: ${commit}
╠══════════════════════════════════════════════════════════════════════════════╣"""

    results.each { name, result ->
        def icon = result.match ? '✅' : '❌'
        def status = result.match ? 'VERIFIED' : 'MISMATCH'
        echo "║ ${icon} ${name.padRight(20)} │ ${status}"
        if (!result.match && result.response) {
            echo "║    └─ Got: ${result.response.take(60)}..."
        }
    }

    echo '''╚══════════════════════════════════════════════════════════════════════════════╝'''
}

/**
 * Run BDD coverage gap scanner — compares conceptual (genesis) vs executable scenarios.
 * Produces an advisory JSON report for quality-architect consumption.
 */
def runBddCoverageGap() {
    sh 'corepack enable'
    dir('genesis/a2o') {
        sh 'pnpm install --frozen-lockfile'
        sh 'pnpm exec tsx scripts/scan-coverage.ts --ci'
    }
}

/**
 * Run manifest-driven build graph — primary change detection algorithm.
 * Returns the graph result (used to determine which pipelines build).
 */
def runBuildGraph(List changedFiles) {
    def buildGraph = load('genesis/orchestrator/build-graph.groovy')
    def result = buildGraph.walkBuildGraph(changedFiles)

    // Per-file routing matrix (always-on visibility, from Task 4)
    echo buildGraph.formatPerFileMatrix(result.graph, result.staleMap, changedFiles)

    // Save build state with buildProcess hashes for next run, but do NOT
    // advance lastSuccessfulCommit yet — that happens only after Execute
    // Builds succeeds. Advancing it here caused the graph to think all
    // changes were already built when the previous run NPE'd before builds ran.
    def previousCommit = result.previousState?.lastSuccessfulCommit ?: null
    buildGraph.saveBuildState(result.graph, result.staleMap, result.buildProcessHashes, previousCommit, result.previousState)

    // Stash registry as JSON env var so all later stages can read pipeline
    // metadata without re-parsing build-manifest.json files.
    if (result.pipelineRegistry) {
        env.PIPELINE_REGISTRY_JSON = writeJSON(returnText: true, json: result.pipelineRegistry)
        // elohim-sophia's build-manifest.json lives INSIDE the sophia
        // submodule, which this orchestrator checkout never initializes — the
        // walker cannot see it, so [build:sophia] force-includes were silently
        // dropped as non-dispatchable (no jenkinsPath). Register it statically:
        // jenkinsPath here is only the dispatchability marker; the elohim-sophia
        // multibranch job loads sophia/Jenkinsfile from its own
        // submodule-initialized checkout.
        def reg = readJSON(text: env.PIPELINE_REGISTRY_JSON)
        def sophiaMeta = reg['elohim-sophia'] ?: [:]
        def sjp = sophiaMeta.jenkinsPath
        if (!(sjp instanceof CharSequence) || !sjp.toString().trim()) {
            sophiaMeta.jenkinsPath = 'sophia/Jenkinsfile'
            reg['elohim-sophia'] = sophiaMeta
            env.PIPELINE_REGISTRY_JSON = writeJSON(returnText: true, json: reg)
            echo "Registry patch: elohim-sophia marked dispatchable (submodule manifest invisible to the walker)"
        }
    }

    return result
}

// =============================================================================
// PIPELINE
// =============================================================================

pipeline {
    agent {
        kubernetes {
            cloud 'kubernetes'
            yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccount: ee-jenkins
  nodeSelector:
    node-type: edge
  containers:
  - name: builder
    image: harbor.ethosengine.com/ethosengine/ci-builder:latest
    # Always: :latest is a moving tag — a cached node can silently serve a stale
    # toolchain (#1218 shape). Freshness > outage-resilience (operator, 2026-06-07;
    # the 2026-06-06 IfNotPresent outage mitigation was deliberately reverted).
    imagePullPolicy: Always
    command: [cat]
    tty: true
    resources:
      requests:
        memory: "512Mi"
        cpu: "200m"
      limits:
        memory: "2Gi"
        cpu: "1"
'''
        }
    }

    environment {
        // For PR builds, CHANGE_BRANCH holds the source branch (e.g. 'staging');
        // use it so downstream jobs are triggered on the real branch, not 'PR-NNN'.
        BRANCH_NAME = "${env.CHANGE_BRANCH ?: env.BRANCH_NAME ?: 'dev'}"
        NPM_TOKEN = credentials('ee-nexus-npm-token')
    }

    parameters {
        choice(
            name: 'MODE',
            choices: ['auto', 'status', 'rebuild-all', 'rebuild-edge', 'rebuild-app', 'genesis-only'],
            description: '''
                auto = Analyze changes and build what's needed (DEFAULT for webhooks)
                status = Report deployment status only (no builds)
                rebuild-all = Force rebuild everything
                rebuild-edge = Force rebuild edge infrastructure (doorway, storage, conductor)
                rebuild-app = Force rebuild Angular app only
                genesis-only = Run seed + test without rebuilding
            '''
        )
        booleanParam(
            name: 'SKIP_GENESIS',
            defaultValue: false,
            description: 'Skip seed+test after builds (useful for infrastructure-only changes)'
        )
        booleanParam(
            name: 'VERIFY_DEPLOYMENT',
            defaultValue: true,
            description: 'Verify deployed versions match built versions after deployment'
        )
        booleanParam(
            name: 'DEPLOY_ONLY',
            defaultValue: false,
            description: 'Skip all build stages and dispatch only elohim-edge (and elohim-genesis if SKIP_GENESIS is false). Use after manifest/RBAC/storageClass-only changes to redeploy from existing Harbor tags. Operator-triggered only; do not combine with auto webhook flow.'
        )
        booleanParam(
            name: 'RESET_STORAGE',
            defaultValue: false,
            description: 'Wipe genesis storage (content.db) and reseed from scratch before tests. Reliably reconciles authored content that skip-on-exists bulk seeding leaves stale (e.g. a manifesto row stuck at reach=community when the source authors commons — the stampProvenance reach-PATCH trips the conductor re-notarize circuit breaker on bulk-seeded rows). Forwarded only to elohim-genesis. Operator-triggered, or via the [reseed] commit tag on a fresh webhook push.'
        )
        string(
            name: 'FORCE_COMMIT',
            defaultValue: '',
            description: 'Force analysis from a specific commit (leave empty for auto-detect)'
        )
    }

    triggers {
        // Gate #6 iroh parity soak: nightly at midnight UTC.
        // The stage itself guards with `when { anyOf { triggeredBy 'TimerTrigger'; changeset ... } }`
        // so on push-triggered runs the nightly stage only fires when transport code changed.
        // The cron trigger here fires the full orchestrator daily regardless of
        // changes, which then runs the iroh parity stage unconditionally
        // (TimerTrigger path). Schedule chosen to dodge late-evening push windows:
        // 9am UTC = 5am EDT / 2am PDT (both Americas night) / 10am CET (start of
        // EU workday, after morning standups). The original 0 0 UTC collided with
        // late-evening EDT/PDT pushes — concretely on 2026-05-23 00:00 the cron
        // abortPrevious'd webhook-triggered #1003 mid-genesis (downstream #1019
        // → ABORTED → orchestrator → NOT_BUILT). AP-TIMER-WEBHOOK-COLLISION.
        cron('0 9 * * *')
    }

    options {
        timeout(time: 240, unit: 'MINUTES')  // upstream parallel builds + genesis (60min) + a2o gap analysis
        disableConcurrentBuilds(abortPrevious: true)  // Abort older builds when new one starts
        buildDiscarder(logRotator(numToKeepStr: '100'))
        // Skip implicit Declarative: Checkout SCM — its 10-min default per-attempt
        // timeout has been exhausting on the 316MB / 65k-object repo (multiple
        // FAILURE builds in the 781-785 run, all dying at ~10:15 elapsed during
        // git fetch). The explicit Checkout stage below replaces it with a
        // shallow clone + 30-min timeout that cleanly handles slow-link windows.
        skipDefaultCheckout(true)
    }

    stages {
        stage('Deduplication Guard') {
            steps {
                script {
                    // Milestone: automatically aborts older builds when a newer one passes this point
                    milestone(ordinal: 1, label: 'Build Started')
                    echo "✅ Deduplication check passed - proceeding with build #${env.BUILD_NUMBER}"
                }
            }
        }

        stage('Checkout') {
            steps {
                container('builder') {
                    script {
                        sh 'git config --global --add safe.directory "*"'

                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: "*/${env.BRANCH_NAME}"]],
                            extensions: [
                                // shallow:true with depth:200 cuts clone size ~10x while
                                // preserving enough history for orchestrator changeset diffs
                                // against last-successful baselines. timeout:30 (per attempt)
                                // replaces the git-plugin 10-min default that was exhausting.
                                // honorRefspec: only fetch the target branch, not +refs/heads/*
                                // (#787 spent 27min on all-heads fetch even with depth:200).
                                [$class: 'CloneOption', shallow: true, noTags: true, depth: 200, timeout: 30, honorRefspec: true],
                                [$class: 'CleanBeforeCheckout']
                            ],
                            userRemoteConfigs: [[
                                url: 'https://github.com/ethosengine/elohim.git',
                                credentialsId: 'ee-bot-pat',
                                refspec: "+refs/heads/${env.BRANCH_NAME}:refs/remotes/origin/${env.BRANCH_NAME}"
                            ]]
                        ])

                        env.GIT_COMMIT_SHORT = getGitCommitHash()
                        env.GIT_COMMIT_FULL = getGitCommitHashFull()

                        // Load canonical artifact filenames from the manifest
                        // and stash in env vars. Downstream `when` blocks +
                        // steps reference env.PREDICTED_BUILD_GRAPH_FILE etc.
                        // so a rename in build-artifacts.json propagates
                        // automatically. Fail loud if the manifest is missing
                        // or malformed — the rest of the orchestrator's
                        // reconciliation surface depends on it.
                        if (!fileExists('genesis/orchestrator/build-artifacts.json')) {
                            error 'genesis/orchestrator/build-artifacts.json missing — cannot bootstrap artifact names'
                        }
                        def artifactNames = readJSON(file: 'genesis/orchestrator/build-artifacts.json')
                        env.PREDICTED_BUILD_GRAPH_FILE = artifactNames.orchestrator.predictedBuildGraph
                        env.ACTUAL_BUILD_GRAPH_FILE = artifactNames.orchestrator.actualBuildGraph
                        env.BUILD_GRAPH_RECONCILIATION_FILE = artifactNames.orchestrator.buildGraphReconciliation

                        // Detect build trigger type. "Push event to branch X" is the
                        // shortDescription Jenkins emits for git-push webhook causes from
                        // some plugin configurations (alongside the GitHub/SCM/webhook
                        // strings other configurations emit). Match all known forms so
                        // commit-msg tags still fire whichever plugin path is in play.
                        def buildCause = currentBuild.getBuildCauses()[0]?.shortDescription ?: 'Unknown'
                        def isWebhook = buildCause.contains('GitHub') ||
                                        buildCause.contains('webhook') ||
                                        buildCause.contains('SCM') ||
                                        buildCause.contains('Push event')
                        env.BUILD_TRIGGER = isWebhook ? 'WEBHOOK' : 'MANUAL'

                        echo """
═══════════════════════════════════════════════════════════════════════════════
                        🎭 ELOHIM ORCHESTRATOR v2
═══════════════════════════════════════════════════════════════════════════════
  Branch:  ${env.BRANCH_NAME}
  Commit:  ${env.GIT_COMMIT_SHORT} (${env.GIT_COMMIT_FULL})
  Mode:    ${params.MODE} ${params.MODE == 'auto' ? '(automatic changeset analysis)' : ''}
  Trigger: ${env.BUILD_TRIGGER} (${buildCause})
  Build:   #${env.BUILD_NUMBER}
═══════════════════════════════════════════════════════════════════════════════
                        """

                        // Read HEAD commit message once. Used for [skip ci], [build:*], and
                        // (webhook-only) [deploy-only] parsing.
                        def commitMsg = sh(script: 'git log -1 --format=%B', returnStdout: true).trim()

                        // [skip ci] — meaningful on every trigger type. Operator who tagged a commit
                        // with [skip ci] means "do not run CI on this HEAD regardless of how this
                        // build was kicked off" (timer, replay, webhook).
                        if (commitMsg =~ /(?i)\[(skip ci|ci skip|no ci)\]/) {
                            echo "⏭️  [skip ci] detected in commit message — skipping all pipelines"
                            env.SKIP_CI = 'true'
                        }

                        // [build:*] tags — meaningful on every trigger type. The tag lives in
                        // git history; the orchestrator MUST honor it whenever it reads HEAD,
                        // not only on the first webhook delivery (which may be NOT_BUILT due
                        // to milestone() supersede — see plan 2026-05-28).
                        def buildTags = []
                        def buildTagAliases = [
                            'edge': 'elohim-edge',
                            'dna': 'elohim-holochain',
                            'app': 'elohim',
                            'genesis': 'elohim-genesis',
                            'sophia': 'elohim-sophia',
                            'steward': 'elohim-steward',
                            'conductor': 'elohim-conductor',
                            // Crate pipelines were untaggable before 2026-08-15;
                            // with no alias, re-running a failed leaf (e.g. a
                            // Level-0 red blocking the whole graph) had no
                            // webhook lever at all once its files were inside
                            // the advanced global baseline.
                            'eprfs': 'elohim-eprfs',
                            'epr': 'elohim-epr'
                        ]
                        // Tokens come back as a plain List<String> — the Matcher stays
                        // inside parseBuildTagTokens' @NonCPS frame. Do NOT inline the
                        // `=~` here: readJSON below and applyConductorTag() are CPS
                        // steps, and a Matcher in scope at either point kills the build
                        // at End of Pipeline (orchestrator #1666).
                        parseBuildTagTokens(commitMsg).each { tag ->
                            if (tag == 'all') {
                                def allNonManual = env.PIPELINE_REGISTRY_JSON
                                    ? readJSON(text: env.PIPELINE_REGISTRY_JSON).findAll { k, v -> !v.manualOnly }.keySet().toList()
                                    : []
                                buildTags.addAll(allNonManual)
                            } else if (buildTagAliases[tag]) {
                                buildTags.add(buildTagAliases[tag])
                            } else {
                                echo "⚠️  Unknown [build:${tag}] — valid: ${buildTagAliases.keySet().join(', ')}, all"
                            }
                        }
                        buildTags.addAll(applyConductorTag(commitMsg))

                        if (buildTags) {
                            env.FORCE_BUILD_PIPELINES = buildTags.unique().join(',')
                            echo "🔧 [build:*] tags detected — force-including: ${env.FORCE_BUILD_PIPELINES}"
                        }

                        // Safe to honor on replay/timer as well as webhook: this
                        // mode is read-only against the deployed cluster. The
                        // build-plan override below guarantees the tag means one
                        // edge validation job, not the ordinary dependency graph.
                        if (commitMsg =~ /(?i)\[edge:validate-only\]/) {
                            env.EDGE_VALIDATE_ONLY_FROM_TAG = 'true'
                            echo "🧪 [edge:validate-only] detected — isolating dispatch to edge Dataplane Validation"
                        }

                        // [deploy-only] — DELIBERATELY webhook-gated. This tag tells the orchestrator
                        // to bypass changeset analysis and redeploy existing Harbor tags. It is only
                        // meaningful for fresh pushes that intend a deployment; timer/replay reusing
                        // the same HEAD must not silently retrigger a deploy.
                        if (env.BUILD_TRIGGER == 'WEBHOOK') {
                            if (commitMsg =~ /(?i)\[deploy[-_ ]only\]/) {
                                echo "🚀 [deploy-only] detected in commit message — DEPLOY_ONLY mode (skip builds, redeploy from env-file tags)"
                                env.DEPLOY_ONLY_FROM_TAG = 'true'
                            }
                            // [reseed] — webhook-gated like [deploy-only]. Tells the genesis pipeline
                            // to wipe content.db and reseed from scratch (RESET_STORAGE), reliably
                            // reconciling authored content that skip-on-exists bulk seeding leaves
                            // stale. Destructive-ish (the SQLite projection only — reconstructable
                            // from the seed source + P2P), so a timer/replay reusing the same HEAD
                            // must NOT silently re-wipe storage; hence webhook-only.
                            if (commitMsg =~ /(?i)\[reseed\]/) {
                                echo "♻️  [reseed] detected in commit message — RESET_STORAGE for genesis (wipe content.db + fresh reseed)"
                                env.RESET_STORAGE_FROM_TAG = 'true'
                            }
                        }

                        // Milestone 2: Abort older builds that reach this point after checkout
                        milestone(ordinal: 2, label: 'Checkout Complete')
                    }
                }
            }
        }

        stage('Pre-flight Health Check') {
            when { expression { env.SKIP_CI != 'true' } }
            steps {
                container('builder') {
                    script {
                        echo '''
┌──────────────────────────────────────────────────────────────────────────────┐
│                           PRE-FLIGHT HEALTH CHECK                             │
└──────────────────────────────────────────────────────────────────────────────┘'''

                        def healthResults = [:]
                        getHealthEndpoints().each { name, url ->
                            def result = checkHealth(name, url)
                            healthResults[name] = result
                            echo "${result.healthy ? '✅' : '❌'} ${name}: HTTP ${result.status} - ${url}"
                        }

                        env.PREFLIGHT_HEALTH = writeJSON(returnText: true, json: healthResults)

                        def unhealthy = healthResults.findAll { k, v -> !v.healthy }
                        if (unhealthy.size() > 0) {
                            echo "⚠️  WARNING: ${unhealthy.size()} service(s) unhealthy before deployment"
                        }
                    }
                }
            }
        }

        stage('Determine Build Plan') {
            when { expression { env.SKIP_CI != 'true' } }
            steps {
                container('builder') {
                    script {
                        // Stage logic extracted to autoModeAnalyze /
                        // manualModeAnalyze / applyBuildGraphRouting /
                        // buildPredictedGraph helpers (above pipeline {}) to
                        // keep this script body under the 64KB CPS method
                        // size limit. Failure mode in build #923 was
                        // ___cps___74 too large from this stage's inline body.
                        def mode = params.MODE ?: 'auto'
                        echo """
┌──────────────────────────────────────────────────────────────────────────────┐
│                              BUILD PLAN ANALYSIS                              │
├──────────────────────────────────────────────────────────────────────────────┤
│  Mode:    ${mode}
│  Trigger: ${env.BUILD_TRIGGER}
└──────────────────────────────────────────────────────────────────────────────┘"""

                        def pipelines, analysis, changedFiles
                        if (mode in ['auto', 'status']) {
                            def r = autoModeAnalyze()
                            pipelines = r.pipelines
                            analysis = r.analysis
                            changedFiles = r.changedFiles
                        } else {
                            def r = manualModeAnalyze(mode)
                            pipelines = r.pipelines
                            analysis = r.analysis
                            changedFiles = []
                        }

                        // Legacy advisory ordering for the comparison matrix.
                        def legacyOrdered = orderByDependencies(pipelines)
                        printDecisionMatrix(analysis, legacyOrdered)

                        def graphPipelines = applyBuildGraphRouting(mode, changedFiles, analysis, pipelines)

                        // DEPLOY_ONLY override (operator param OR [deploy-only]
                        // commit tag): bypass changeset analysis and dispatch
                        // only deploy-bearing pipelines. Edge self-skips its
                        // build stages, runs only Deploy Edge Node - <Env>.
                        def deployOnly = params.DEPLOY_ONLY || env.DEPLOY_ONLY_FROM_TAG == 'true'
                        if (deployOnly) {
                            graphPipelines = ['elohim-edge']
                            if (!params.SKIP_GENESIS) graphPipelines.add('elohim-genesis')
                            def src = params.DEPLOY_ONLY ? 'param' : 'commit tag'
                            echo "🚀 DEPLOY_ONLY=true (via ${src}): bypassing changeset analysis; dispatching ${graphPipelines.join(', ')}"
                        }

                        // Recording runs must not inherit accumulated graph work
                        // or auto-add Genesis: either can perturb the substrate or
                        // load the doorways while the saga is being measured.
                        // This intentionally wins over other [build:*] tags on the
                        // same commit; use a separate push for unrelated builds.
                        if (env.EDGE_VALIDATE_ONLY_FROM_TAG == 'true') {
                            graphPipelines = ['elohim-edge']
                            echo '🧪 EDGE_VALIDATE_ONLY: dispatching elohim-edge only; Genesis and unrelated graph work suppressed'
                        }

                        env.PIPELINES_TO_RUN = graphPipelines.join(',')
                        // Bridge changedFiles across CPS stage boundaries (def-scoped
                        // locals don't survive into the next stage's script{} block).
                        // Execute Builds reads CHANGED_PATHS_PASSTHROUGH and passes
                        // it as the 4th arg to triggerPipeline so downstream pipelines
                        // see CHANGED_PATHS for per-path / per-DNA selectivity.
                        env.CHANGED_PATHS_PASSTHROUGH = changedFiles.join('\n')

                        // Build + write the predicted-build-graph artifact.
                        def predictedLevels = groupByDependencyLevel(graphPipelines)
                        def hasGenesis = graphPipelines.contains('elohim-genesis')
                        def predictedGraph = buildPredictedGraph(graphPipelines, analysis, mode, deployOnly, changedFiles, predictedLevels, hasGenesis)
                        writeJSON(file: env.PREDICTED_BUILD_GRAPH_FILE, json: predictedGraph, pretty: 2)

                        // Set build description
                        if (graphPipelines.isEmpty() && mode == 'auto') {
                            echo 'ℹ️  No pipelines need to run for these changes'
                            currentBuild.description = "No builds needed (${changedFiles.size()} files)"
                        } else if (mode == 'status') {
                            currentBuild.description = "Status check only"
                        } else {
                            currentBuild.description = "${mode}: ${graphPipelines.join(', ')}"
                        }

                        // Checkpoint 1: archive baseline so an interruption
                        // (pod eviction, abort-on-milestone, OOM) still leaves
                        // the next run with a __global__ = HEAD resume point.
                        archivePipelineBaselines('plan')
                    }
                }
            }
        }

        stage('Post Predicted Build Graph') {
            when { expression { env.SKIP_CI != 'true' } }
            steps {
                container('builder') {
                    script {
                        // Standalone deliverable: predicted-build-graph.json was
                        // written by Determine Build Plan. This stage's only job
                        // is to verify it exists, archive it as an artifact, and
                        // print a one-line summary. Failing here is loud: a red
                        // stage in Blue Ocean before Execute Builds runs. External
                        // watchers (the Ralph Wiggum loop) can grab the artifact
                        // immediately after this stage completes — they do NOT
                        // have to wait for any build to finish.
                        if (!fileExists(env.PREDICTED_BUILD_GRAPH_FILE)) {
                            error "${env.PREDICTED_BUILD_GRAPH_FILE} missing — Determine Build Plan should have written it"
                        }
                        def predicted = readJSON(file: env.PREDICTED_BUILD_GRAPH_FILE)
                        archiveArtifacts(artifacts: env.PREDICTED_BUILD_GRAPH_FILE, fingerprint: true)

                        // Coerce JSON-derived containers to Groovy List
                        // before .join() — readJSON returns net.sf.json.JSONArray
                        // and Jenkins Script Security blocks .join() on it.
                        // .collect{it} materializes a plain ArrayList.
                        def levelDesc = (predicted.levels ?: []).collect { lvl ->
                            lvl.size() > 1 ? "[${lvl.collect{it}.join(' + ')}]" : lvl[0]
                        }.join(' → ')
                        if (predicted.genesisAfterLevels) levelDesc += ' → genesis'

                        def pipelinesList = (predicted.pipelines ?: []).collect { it }
                        echo """
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
📤 PREDICTED BUILD GRAPH posted
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  Commit:    ${(predicted.commitSha ?: '').take(8)}
  Mode:      ${predicted.mode}
  Pipelines: ${pipelinesList.size() > 0 ? pipelinesList.join(', ') : '(none)'}
  Plan:      ${levelDesc ?: '(no builds)'}
  Artifact:  ${env.BUILD_URL}artifact/${env.PREDICTED_BUILD_GRAPH_FILE}
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
"""
                    }
                }
            }
        }

        stage('Brit Plan (advisory)') {
            when {
                expression {
                    // Skip on [skip ci], status-only mode, or missing helper (older branches).
                    // Stage 1a: silent skip on missing helper is intentional scaffolding.
                    // Stage 2: replace fileExists check with an error() — helper will be required.
                    env.SKIP_CI != 'true' &&
                        params.MODE != 'status' &&
                        fileExists('genesis/orchestrator/scripts/brit-helper.sh')
                }
            }
            steps {
                container('builder') {
                    script {
                        // brit-helper.sh wraps brit invocations with safe-fallback (logs WARN, exits 0
                        // if brit is not yet on the ci-builder image — Stage 1a behavior). Once Stage 1b
                        // lands brit on ci-builder, this stage produces a real advisory plan.
                        sh '''
                            export REPO_ROOT=$WORKSPACE
                            chmod +x genesis/orchestrator/scripts/brit-helper.sh || true
                            echo "── brit advisory (Stage 1a — warn-only) ──"
                            ./genesis/orchestrator/scripts/brit-helper.sh verify || true
                            # Ensure origin/dev is in local ref store before plan --since (Jenkins
                            # checkout may not fetch all remote refs on shallow / branch-only clones).
                            git fetch origin dev --no-tags --quiet || true
                            ./genesis/orchestrator/scripts/brit-helper.sh plan --since origin/dev || true
                            echo "── end brit advisory ──"
                        '''
                        // Compare to the legacy/graph dispatch decision for log-side observation.
                        echo "ADVISORY: legacy + build-graph dispatched: ${env.PIPELINES_TO_RUN ?: '(none)'}"
                    }
                }
            }
        }

        stage('Execute Builds') {
            when {
                expression {
                    params.MODE != 'status' && (env.PIPELINES_TO_RUN ?: '') != ''
                }
            }
            steps {
                container('builder') {
                    script {
                        def pipelines = (env.PIPELINES_TO_RUN ?: '').split(',').findAll { it }
                        // Recover changedFiles from env-bridge (see Determine Build Plan).
                        // def-scoped locals don't cross CPS stage boundaries.
                        def changedFiles = (env.CHANGED_PATHS_PASSTHROUGH ?: '').split('\n').findAll { it }
                        def results = [:]
                        def pipelineBaselines = readJSON(text: env.PIPELINE_BASELINES ?: '{}')

                        if (pipelines.isEmpty()) {
                            echo 'ℹ️  No pipelines to execute'
                            return
                        }

                        def levels = groupByDependencyLevel(pipelines)
                        def hasGenesis = pipelines.contains('elohim-genesis')
                        def levelDesc = levels.collect { lvl ->
                            lvl.size() > 1 ? "[${lvl.join(' + ')}]" : lvl[0]
                        }.join(' → ')
                        if (hasGenesis) levelDesc += ' → genesis'

                        echo """
┌──────────────────────────────────────────────────────────────────────────────┐
│                          EXECUTING BUILDS (PARALLEL)                          │
├──────────────────────────────────────────────────────────────────────────────┤
│  Plan: ${levelDesc}
└──────────────────────────────────────────────────────────────────────────────┘"""

                        // Execute in dependency-level order (parallel within each level).
                        // Each level is wrapped in a nested stage() so Blue Ocean
                        // surfaces the dependency-graph structure with per-level
                        // and per-pipeline timing — what `groupByDependencyLevel`
                        // computes is what the UI now shows.
                        // Behaviour-preserving: the level-failed guard, baseline
                        // updates, and parallel-wait semantics are unchanged.
                        levels.eachWithIndex { level, idx ->
                            def levelLabel = level.size() > 1
                                ? "Level ${idx}: ${level.join(' + ')}"
                                : "Level ${idx}: ${level[0]}"

                            stage(levelLabel) {
                                echo ''
                                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                                echo "📦 Level ${idx}: ${level.join(' + ')}"
                                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'

                                if (level.size() == 1) {
                                    def name = level[0]
                                    echo "🔨 Building: ${name}"
                                    // wait=null → triggerPipeline auto-derives from
                                    // build-manifest.json longRunning flag (bug #5 fix).
                                    def result = triggerPipeline(name, env.BRANCH_NAME, null, changedFiles)
                                    results[name] = result
                                    recordPipelineResult(name, result, pipelineBaselines)
                                } else {
                                    def parallelBuilds = [:]
                                    level.each { name ->
                                        parallelBuilds[name] = {
                                            stage(name) {
                                                echo "🔨 Building: ${name}"
                                                // wait=null → auto-derive per longRunning
                                                def result = triggerPipeline(name, env.BRANCH_NAME, null, changedFiles)
                                                results[name] = result
                                                recordPipelineResult(name, result, pipelineBaselines)
                                            }
                                        }
                                    }
                                    parallel parallelBuilds
                                }

                                // Fail fast: abort if any pipeline in this level failed.
                                // Inside the level stage so the failure marks THIS level
                                // red in Blue Ocean, not the outer Execute Builds stage.
                                def levelFailed = level.findAll { !results[it]?.success }
                                if (levelFailed) {
                                    error "Build(s) failed: ${levelFailed.join(', ')} - Aborting"
                                }
                            }
                        }

                        env.BUILD_RESULTS = writeJSON(returnText: true, json: results)
                        env.PIPELINE_BASELINES = writeJSON(returnText: true, json: pipelineBaselines)

                        // Run genesis if requested. Wrapped in its own stage so
                        // Blue Ocean shows the trailing genesis dispatch as a
                        // distinct column (it's NOT a level — runs after all
                        // build levels succeed, per the dependency contract).
                        if (pipelines.contains('elohim-genesis')) {
                            stage('elohim-genesis') {
                                echo ''
                                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'
                                echo '🌱 Running Genesis (seed + test)'
                                echo '━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━'

                                def genesisResult = triggerPipeline('elohim-genesis', env.BRANCH_NAME, true, changedFiles)

                                // Hydrate stageAnnotations from genesis's
                                // conductor-readiness + seed-results artifacts.
                                // Best-effort — empty map on copy failure.
                                // Embedded into actual-build-graph.json so the
                                // reconciler can surface peer-level findings
                                // as investigation pointers (Path C).
                                def genesisAnnotations = hydrateStageAnnotations('elohim-genesis', genesisResult.buildNumber, env.BRANCH_NAME)
                                if (genesisAnnotations) {
                                    genesisResult.stageAnnotations = genesisAnnotations
                                    def keys = genesisAnnotations.keySet().toList()
                                    if (keys) {
                                        echo "[stageAnnotations] elohim-genesis hydrated: ${keys.join(', ')}"
                                    }
                                }
                                results['elohim-genesis'] = genesisResult

                                if (genesisResult.success) {
                                    echo '✅ elohim-genesis: SUCCESS'
                                    pipelineBaselines['elohim-genesis'] = env.GIT_COMMIT_FULL
                                } else {
                                    echo "❌ elohim-genesis: ${genesisResult.result}"
                                    unstable('Genesis failed - seeding or tests may have issues')
                                }

                                env.BUILD_RESULTS = writeJSON(returnText: true, json: results)
                                env.PIPELINE_BASELINES = writeJSON(returnText: true, json: pipelineBaselines)
                            }
                        }

                        // Actual Build Graph artifact — what Execute Builds
                        // dispatched and how each downstream pipeline finished.
                        // Construction extracted to buildActualGraph helper to
                        // keep this stage's inline method under 64KB CPS limit.
                        // Cascade-aborted runs (level-failed throw) are picked
                        // up by the post.always backstop instead.
                        def actualGraph = buildActualGraph(pipelines, results, levels)
                        writeJSON(file: env.ACTUAL_BUILD_GRAPH_FILE, json: actualGraph, pretty: 2)
                        // Archive happens in the dedicated Post Actual Build Graph
                        // stage below — keeps Execute Builds focused on dispatch.

                        // Now that builds succeeded, advance the build graph's
                        // lastSuccessfulCommit. During planning we deliberately
                        // kept the previous commit to avoid baseline leapfrog
                        // when builds fail before reaching this point.
                        if (fileExists('build-state.json')) {
                            def bState = readJSON(file: 'build-state.json')
                            bState.lastSuccessfulCommit = env.GIT_COMMIT_FULL
                            writeJSON(file: 'build-state.json', json: bState, pretty: 2)
                            archiveArtifacts(artifacts: 'build-state.json', fingerprint: true)
                        }

                        // Checkpoint 2: archive per-pipeline baselines captured
                        // during this Execute Builds run.
                        archivePipelineBaselines('execute')
                    }
                }
            }
        }

        stage('Post Actual Build Graph') {
            when {
                expression {
                    // Skip when nothing dispatched (Execute Builds didn't run, no
                    // file exists). The post.always backstop handles cascade-aborted
                    // runs where Execute Builds threw before its writeJSON call.
                    fileExists(env.ACTUAL_BUILD_GRAPH_FILE ?: 'actual-build-graph.json')
                }
            }
            steps {
                container('builder') {
                    // Observational/reporting stage — runs AFTER every dispatched
                    // build has completed. By this point the world is what it is;
                    // a parse/archive hiccup here must not blank-out the downstream
                    // truth. Mirror the 'P2P Validation (Advisory)' pattern: mark
                    // UNSTABLE on any exception so the pipeline still rolls into
                    // Reconcile Build Graph (the real signal-bearer) instead of
                    // hard-failing the whole orchestrator. Compare 'Post Predicted
                    // Build Graph' which is INTENTIONALLY hard-fail because it
                    // runs BEFORE dispatch and a failure means the setup is broken.
                    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                        script {
                            // Standalone deliverable: actual-build-graph.json was
                            // written by Execute Builds. This stage's only job is
                            // to verify it, archive it, and print a summary that
                            // mirrors Post Predicted Build Graph. Symmetric stages
                            // give external watchers two clean artifacts to diff.
                            def actual = readJSON(file: env.ACTUAL_BUILD_GRAPH_FILE)
                            archiveArtifacts(artifacts: env.ACTUAL_BUILD_GRAPH_FILE, fingerprint: true)

                            // Defensive null-safety: actual.results may be null if
                            // Execute Builds wrote the file before populating any
                            // entries (e.g. all dispatches aborted-pre-start). The
                            // prior version accessed `actual.results[name]` raw and
                            // NPE'd in exactly that case — observed in build #970.
                            def resultsMap = actual.results ?: [:]
                            def resultLine = (actual.executionOrder ?: []).collect { name ->
                                def r = resultsMap[name]
                                "${name}=${r?.result ?: 'NOT_RUN'}"
                            }.join(', ')

                            echo """
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
📥 ACTUAL BUILD GRAPH posted
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
  Commit:           ${(actual.commitSha ?: '').take(8)}
  Results:          ${resultLine ?: '(no builds dispatched)'}
  Aborted-pre-start: ${(actual.abortedBeforeStart ?: []).collect { it }.join(', ') ?: '(none)'}
  Artifact:         ${env.BUILD_URL}artifact/${env.ACTUAL_BUILD_GRAPH_FILE}
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
"""
                        }
                    }
                }
            }
        }

        stage('Reconcile Build Graph') {
            when {
                expression {
                    // Run when both artifacts exist (happy path). Cascade-aborted
                    // runs that never reached Post Actual Build Graph are picked
                    // up by the post.always backstop, which synthesizes the actual
                    // artifact from env.BUILD_RESULTS and runs the reconciler then.
                    fileExists(env.PREDICTED_BUILD_GRAPH_FILE ?: 'predicted-build-graph.json') && fileExists(env.ACTUAL_BUILD_GRAPH_FILE ?: 'actual-build-graph.json')
                }
            }
            steps {
                container('builder') {
                    script {
                        // Compare what the orchestrator PROMISED with what
                        // actually happened. Drift between predicted and actual
                        // is the highest-value pipeline-quality signal — every
                        // disconnect is a candidate for investigation.
                        //
                        // The reconcile-build-graph.mjs script is pure JS and
                        // unit-tested at genesis/orchestrator/reconcile-build-graph.test.mjs.
                        // It exits 0 on match, 1 on drift; we use that to mark
                        // the orchestrator UNSTABLE on any disconnect without
                        // aborting the rest of the pipeline.
                        def reconcileExit = sh(
                            script: "node genesis/orchestrator/reconcile-build-graph.mjs ${env.PREDICTED_BUILD_GRAPH_FILE} ${env.ACTUAL_BUILD_GRAPH_FILE} ${env.BUILD_GRAPH_RECONCILIATION_FILE}",
                            returnStatus: true,
                        )
                        archiveArtifacts(artifacts: env.BUILD_GRAPH_RECONCILIATION_FILE, fingerprint: true)

                        if (reconcileExit != 0) {
                            unstable("Build graph drift detected — see ${env.BUILD_GRAPH_RECONCILIATION_FILE}")
                        } else {
                            echo '✅ Build graph reconciled cleanly (predicted == actual)'
                        }
                    }
                }
            }
        }

        stage('Verify Deployment') {
            when {
                expression {
                    params.VERIFY_DEPLOYMENT && params.MODE != 'status' && (env.PIPELINES_TO_RUN ?: '') != ''
                }
            }
            steps {
                container('builder') {
                    // Observational deployment-version cross-check. checkDeployedVersion
                    // is HTTP-bound; a deployment 502 or DNS hiccup during the call
                    // must not hard-fail the orchestrator. Mark UNSTABLE on any
                    // exception so subsequent post-flight stages still run.
                    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                        script {
                            echo '''
┌──────────────────────────────────────────────────────────────────────────────┐
│                          POST-DEPLOYMENT VERIFICATION                         │
└──────────────────────────────────────────────────────────────────────────────┘'''

                            // Wait for deployments to stabilize
                            echo '⏳ Waiting 30s for deployments to stabilize...'
                            sleep(30)

                            def verificationResults = [:]

                            VERSION_ENDPOINTS.each { name, url ->
                                def result = checkDeployedVersion(url, env.GIT_COMMIT_SHORT)
                                verificationResults[name] = result
                            }

                            printDeploymentVerification(env.GIT_COMMIT_SHORT, verificationResults)

                            env.VERIFICATION_RESULTS = writeJSON(returnText: true, json: verificationResults)

                            def mismatches = verificationResults.findAll { k, v -> !v.match }
                            if (mismatches.size() > 0) {
                                echo "⚠️  WARNING: ${mismatches.size()} deployment(s) may not have the expected version"
                                echo '   This could mean:'
                                echo '   - Deployment is still rolling out'
                                echo '   - Version endpoint not implemented'
                                echo '   - Deployment failed silently'
                            }
                        }
                    }
                }
            }
        }

        stage('Post-flight Health Check') {
            steps {
                container('builder') {
                    // Observational health probe. The inner unstable() call already
                    // handles the policy decision (any unhealthy → UNSTABLE). The
                    // catchError wraps the surrounding exception surface: checkHealth
                    // HTTP errors, DNS hiccups, or writeJSON of an unserializable
                    // map must not hard-fail the orchestrator.
                    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                        script {
                            echo '''
┌──────────────────────────────────────────────────────────────────────────────┐
│                          POST-FLIGHT HEALTH CHECK                             │
└──────────────────────────────────────────────────────────────────────────────┘'''

                            def healthResults = [:]
                            getHealthEndpoints().each { name, url ->
                                def result = checkHealth(name, url)
                                healthResults[name] = result
                                echo "${result.healthy ? '✅' : '❌'} ${name}: HTTP ${result.status}"
                            }

                            env.POSTFLIGHT_HEALTH = writeJSON(returnText: true, json: healthResults)

                            def unhealthy = healthResults.findAll { k, v -> !v.healthy }
                            if (unhealthy.size() > 0) {
                                unstable("${unhealthy.size()} service(s) unhealthy after deployment")
                            }
                        }
                    }
                }
            }
        }

        stage('P2P Validation (Advisory)') {
            steps {
                container('builder') {
                    catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                        script {
                            echo '''
┌──────────────────────────────────────────────────────────────────────────────┐
│                          P2P PEER VALIDATION (ADVISORY)                       │
└──────────────────────────────────────────────────────────────────────────────┘'''
                            def p2pResults = [:]
                            def doorwayEndpoints = [
                                alpha: 'https://doorway-alpha.elohim.host',
                            ]
                            doorwayEndpoints.each { env, url ->
                                p2pResults[env] = runP2PValidation(env, url)
                            }
                            currentBuild.description = (currentBuild.description ?: '') +
                                " | P2P: ${p2pResults.collect { k, v -> "${k}=${v ? 'ok' : 'warn'}" }.join(', ')}"
                        }
                    }
                }
            }
        }

        stage('E2E Federation Smoke (Advisory)') {
            when { expression { readJSON(text: env.BUILD_RESULTS ?: '{}').any { it.value?.success } } }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    container('builder') {
                        script {
                            echo '''
┌──────────────────────────────────────────────────────────────────────────────┐
│                     E2E FEDERATION SMOKE TEST (ADVISORY)                      │
└──────────────────────────────────────────────────────────────────────────────┘'''
                        }
                        sh 'corepack enable'
                        dir('genesis/a2o') {
                            sh 'pnpm install --frozen-lockfile'
                            sh '''
                                E2E_DOORWAY_ALPHA=https://doorway-alpha.elohim.host \
                                pnpm exec cucumber-js --tags "@e2e and @federation"
                            '''
                        }
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'genesis/a2o/reports/**', allowEmptyArchive: true
                }
            }
        }

        stage('BDD Coverage Gap (Advisory)') {
            when { expression { readJSON(text: env.BUILD_RESULTS ?: '{}').any { it.value?.success } } }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    container('builder') {
                        script { runBddCoverageGap() }
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'genesis/a2o/reports/coverage-gap-report.json',
                                     allowEmptyArchive: true
                }
            }
        }

        // ── Gate #6: iroh parity nightly soak ─────────────────────────────────
        // Runs every night at midnight UTC and on any push that touches the iroh
        // or libp2p transport code paths. Advisory: marks UNSTABLE, never FAILURE,
        // so it cannot block a legitimate elohim-edge build.
        //
        // Soak window opened: 2026-05-10. Closure criterion: 7 consecutive nightly
        // runs with zero iroh_* test divergences. See RUNBOOK below.
        stage('Iroh Parity Nightly (Gate #6 Soak)') {
            when {
                anyOf {
                    // Nightly cron trigger
                    triggeredBy 'TimerTrigger'
                    // On any push that touches iroh or libp2p transport code
                    changeset pattern: 'elohim/elohim-storage/src/p2p/**', comparator: 'ANT'
                    changeset pattern: 'elohim/elohim-storage/src/p2p_iroh/**', comparator: 'ANT'
                }
            }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                    container('builder') {
                        script {
                            echo '''
+-------------------------------------------------------------------+
| IROH PARITY NIGHTLY SOAK — Gate #6                                |
| Divergence = iroh_*_real_backend or iroh_*_parity fails where     |
| the matching libp2p path is green. 2 hits in 7 days = escalate.  |
+-------------------------------------------------------------------+'''
                        }
                        dir('elohim/elohim-storage') {
                            sh '''
                                export CARGO_TARGET_DIR=/projects/.cargo-target-pool/family/iroh/elohim__elohim-storage/dev
                                RUSTFLAGS=\'--cfg getrandom_backend="custom"\' \
                                cargo nextest run \
                                    --release \
                                    --features "p2p p2p-iroh" \
                                    --test \'iroh_*\' \
                                    --test-threads=1 \
                                    2>&1 | tee iroh-parity-nightly.log
                            '''
                        }
                        archiveArtifacts artifacts: 'elohim/elohim-storage/iroh-parity-nightly.log',
                                         allowEmptyArchive: true
                    }
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'elohim/elohim-storage/iroh-parity-nightly.log',
                                     allowEmptyArchive: true
                }
            }
        }
    }

    post {
        always {
            // Wrap in node{} so writeJSON/archiveArtifacts have a workspace
            // even when the Kubernetes pod was killed (abort/eviction).
            // Previous approach: bare post.always without node — failed with
            // MissingContextVariableException (hudson.FilePath) when the pod
            // was gone, which prevented pipeline-baselines.json from archiving
            // and caused the orchestrator to re-trigger every pipeline.
            // Using node('built-in') instead of container('builder') because
            // container() skips entirely when the pod is dead.
            node('built-in') {
            script {
                def results = readJSON(text: env.BUILD_RESULTS ?: '{}')
                def preflight = readJSON(text: env.PREFLIGHT_HEALTH ?: '{}')
                def postflight = readJSON(text: env.POSTFLIGHT_HEALTH ?: '{}')
                def verification = readJSON(text: env.VERIFICATION_RESULTS ?: '{}')

                def successCount = results.count { k, v -> v?.success && !v?.unstable }
                def unstableCount = results.count { k, v -> v?.unstable }
                def failCount = results.count { k, v -> !v?.success }
                def healthyCount = postflight.count { k, v -> v?.healthy }
                def verifiedCount = verification.count { k, v -> v?.match }

                echo """
═══════════════════════════════════════════════════════════════════════════════
                              📊 ORCHESTRATOR SUMMARY
═══════════════════════════════════════════════════════════════════════════════

  Commit:       ${env.GIT_COMMIT_SHORT}
  Branch:       ${env.BRANCH_NAME}
  Mode:         ${params.MODE}

  BUILDS:       ✅ ${successCount} succeeded │ ⚠️ ${unstableCount} unstable │ ❌ ${failCount} failed
  SERVICES:     ${healthyCount}/${postflight.size()} healthy
  VERIFIED:     ${verifiedCount}/${verification.size()} deployments match commit

${failCount > 0 ? '  ❌ ATTENTION: Build failures detected!' : unstableCount > 0 ? '  ⚠️  Some builds unstable (quality gate warnings)' : '  ✅ All builds completed successfully'}
${healthyCount < postflight.size() ? '  ⚠️  ATTENTION: Some services unhealthy!' : ''}

═══════════════════════════════════════════════════════════════════════════════
                """

                if (failCount > 0) {
                    echo 'Failed pipelines:'
                    results.findAll { k, v -> !v?.success }.each { name, result ->
                        echo "  ❌ ${name}: ${result?.result ?: 'UNKNOWN'}"
                        if (result?.url) echo "     ${result.url}"
                    }
                }

                if (unstableCount > 0) {
                    echo 'Unstable pipelines:'
                    results.findAll { k, v -> v?.unstable }.each { name, result ->
                        echo "  ⚠️ ${name}: UNSTABLE"
                        if (result?.url) echo "     ${result.url}"
                    }
                }

                // Propagate unstable status to orchestrator build
                if (failCount == 0 && unstableCount > 0) {
                    currentBuild.result = 'UNSTABLE'
                }

                // CI summary + reconciliation backstop + build-state continuity
                // are extracted to def helpers above the pipeline block to keep
                // the inline CPS-compiled method under the 64KB JVM limit.
                // See CLAUDE.md: "Never add inline logic to stages."
                def unhealthyCount = postflight.count { k, v -> !v?.healthy }
                def ciSummary = buildCiSummary(results, preflight, postflight, verification, successCount, unstableCount, failCount, healthyCount, unhealthyCount)
                writeJSON file: 'ci-summary.json', json: ciSummary, pretty: 2
                archiveArtifacts artifacts: 'ci-summary.json', allowEmptyArchive: true
                echo "📋 CI Summary archived: ${env.BUILD_URL}artifact/ci-summary.json"

                runReconciliationBackstop()

                archivePipelineBaselines('post')

                maintainBuildStateContinuity()
            }
            } // node('built-in')
        }
    }
}
