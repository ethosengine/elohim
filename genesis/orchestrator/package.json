{
  "name": "elohim-orchestrator",
  "license": "Apache-2.0",
  "private": true,
  "description": "CI/CD orchestrator - Jenkinsfile linting and pipeline management",
  "scripts": {
    "test": "node suite-run.mjs all",
    "test:integration": "node --test orchestrator-integration.test.mjs",
    "test:graph": "node --test graph-walker.test.mjs",
    "test:cargo-coverage": "node --test cargo-target-coverage.test.mjs",
    "check:cargo-coverage": "node cargo-target-coverage.mjs",
    "lint:jenkinsfiles": "npm-groovy-lint --path '..' --files '**/*Jenkinsfile*' --failon error",
    "lint:jenkinsfiles:fix": "npm-groovy-lint --path '..' --files '**/*Jenkinsfile*' --fix"
  },
  "devDependencies": {
    "npm-groovy-lint": "^16.1.1"
  },
  "dependencies": {
    "yaml": "2.8.3"
  }
}
