# Orchestrator - CI/CD Pipeline Management
#
# Central orchestrator that receives GitHub webhooks, analyzes changesets,
# and triggers downstream pipelines.

set dotenv-load := false

# List available recipes
default:
    @just --list

# Install dependencies
install:
    pnpm install

# Lint all Jenkinsfiles via Jenkins's pipeline-model-converter (fast, ~5s).
lint:
    bash scripts/lint-jenkinsfiles-fast.sh

# CodeNarc style/best-practice pass (slow, advisory). Use when you want the style report.
lint-style:
    pnpm exec npm-groovy-lint --path '../..' --files '**/*Jenkinsfile*' --ignorepattern '**/node_modules/**'

# CodeNarc with auto-fix.
lint-fix:
    pnpm exec npm-groovy-lint --path '../..' --files '**/*Jenkinsfile*' --ignorepattern '**/node_modules/**' --fix

# Quality gate: validate Jenkinsfiles against Jenkins itself.
gate: lint
