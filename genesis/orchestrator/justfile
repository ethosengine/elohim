# Orchestrator - CI/CD Pipeline Management
#
# Central orchestrator that receives GitHub webhooks, analyzes changesets,
# and triggers downstream pipelines.

set dotenv-load := false

# List available recipes
default:
    @just --list

# Install dependencies
install:
    pnpm install

# Lint all Jenkinsfiles via Jenkins's pipeline-model-converter (fast, ~5s).
lint:
    bash scripts/lint-jenkinsfiles-fast.sh

# CodeNarc style/best-practice pass (slow, advisory). Use when you want the style report.
lint-style:
    pnpm exec npm-groovy-lint --path '../..' --files '**/*Jenkinsfile*' --ignorepattern '**/node_modules/**'

# CodeNarc with auto-fix.
lint-fix:
    pnpm exec npm-groovy-lint --path '../..' --files '**/*Jenkinsfile*' --ignorepattern '**/node_modules/**' --fix

# Static Jenkinsfile lints that catch runtime-only failure classes
# (env-bridge anti-pattern → orchestrator/dev #1024 MissingPropertyException).
# Fast — no Jenkins required. SCOPED to jenkinsfile-cps-scope.test.mjs only
# because the broader orchestrator-strategy.test.mjs has a pre-existing drift
# failure (tsconfig.storybook.json glob coverage) that's out of scope here.
# Expand to `*.test.mjs` when that gets fixed.
test-jenkinsfile-lints:
    node --test jenkinsfile-cps-scope.test.mjs

# Quality gate: validate Jenkinsfiles against Jenkins itself + run the
# Jenkinsfile static lints. Pre-push hook calls `just gate` on any
# orchestrator change.
gate: lint test-jenkinsfile-lints

# Regenerate pipeline-list.json from orchestrator-strategy.mjs.
# Run after editing PIPELINES.
ci-pipeline-list:
  @node scripts/generate-pipeline-list.mjs
