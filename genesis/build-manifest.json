{
  "manifestVersion": "1.0",
  "pipeline": "elohim-genesis",
  "jenkinsPath": "genesis/Jenkinsfile",
  "manualOnly": false,
  "triggersGenesis": false,
  "dependsOn": ["elohim-edge", "elohim"],
  "description": "Content seeding and validation",
  "steps": {
    "validate-seeds": {
      "description": "Generate schema types and validate seed constants against protocol schemas",
      "inputs": {
        "sources": [
          "genesis/seeds/**",
          "elohim/sdk/schemas/**",
          "elohim/sdk/domains/**"
        ],
        "buildProcess": ["genesis/Jenkinsfile"]
      },
      "outputs": {
        "artifacts": ["validated-seeds"],
        "verify": null
      },
      "depends": [],
      "executor": {
        "stage": "Validate Constants",
        "function": null
      }
    },
    "seed-content": {
      "description": "Seed validated content to target environment",
      "inputs": {
        "sources": ["genesis/manifests/cluster-state.yaml"],
        "buildProcess": ["genesis/Jenkinsfile"]
      },
      "outputs": {
        "artifacts": ["seeded-content"],
        "verify": null
      },
      "depends": [
        "validate-seeds",
        "elohim:build-site-image",
        "elohim-edge:build-edge-image",
        "elohim-edge:cargo-build-storage"
      ],
      "executor": {
        "stage": "Seed Database",
        "function": null
      }
    },
    "schema-validate": {
      "description": "Validate seed data against protocol schemas",
      "inputs": {
        "sources": ["genesis/seeds/**", "elohim/sdk/schemas/**"],
        "buildProcess": []
      },
      "outputs": { "artifacts": [], "verify": null },
      "depends": [],
      "executor": { "stage": "Schema Validate", "function": null }
    },
    "schema-codegen": {
      "description": "Verify schema codegen is fresh",
      "inputs": {
        "sources": [
          "elohim/sdk/schemas/**",
          "elohim/sdk/domains/*/manifest.json",
          "app/lamad/src/app/generated/route-claims.ts",
          "app/elohim-app/src/app/generated/route-claims.ts",
          "genesis/seeder/src/generated/route-claims.ts"
        ],
        "buildProcess": []
      },
      "outputs": { "artifacts": [], "verify": null },
      "depends": [],
      "executor": { "stage": "Schema Codegen", "function": null }
    },
    "constants-sync": {
      "description": "Verify constants sync between schema enums, generated code, and seed data",
      "inputs": {
        "sources": [
          "genesis/data/**",
          "elohim/sdk/schemas/**/*enum*",
          "**/generated/schema-enums*"
        ],
        "buildProcess": []
      },
      "outputs": { "artifacts": [], "verify": null },
      "depends": [],
      "executor": { "stage": "Constants Sync", "function": null }
    },
    "lint-a2o": {
      "description": "Lint and typecheck a2o E2E framework",
      "inputs": {
        "sources": ["genesis/a2o/**"],
        "buildProcess": []
      },
      "outputs": { "artifacts": [], "verify": null },
      "depends": [],
      "executor": { "stage": "Lint A2O", "function": null }
    },
    "gherkin-prepush-lint": {
      "description": "Parse every A2O Gherkin feature before E2E execution",
      "inputs": {
        "sources": [
          "genesis/a2o/features/**/*.feature",
          "genesis/a2o/held/features/**/*.feature",
          "genesis/a2o/scripts/gherkin-prepush-lint.mjs"
        ],
        "buildProcess": []
      },
      "outputs": { "artifacts": [], "verify": null },
      "depends": [],
      "executor": { "stage": "Lint Gherkin", "function": null }
    },
    "gate-genesis": {
      "description": "Catch-all trigger for genesis directory quality gate (excludes orchestrator CI glue)",
      "inputs": {
        "sources": [
          "genesis/seeds/**",
          "genesis/data/**",
          "genesis/a2o/**",
          "genesis/seeder/**",
          "genesis/scripts/**",
          "genesis/Jenkinsfile"
        ],
        "buildProcess": []
      },
      "outputs": { "artifacts": [], "verify": null },
      "depends": [],
      "executor": { "stage": "Gate Genesis", "function": null }
    }
  },
  "gate": {
    "projects": {
      "genesis": {
        "dir": "genesis/seeder",
        "steps": ["validate-seeds", "seed-content", "gate-genesis"],
        "run": { "kind": "just", "recipe": "gate" }
      },
      "schema-validate": {
        "dir": ".",
        "steps": ["schema-validate"],
        "run": { "kind": "root-just", "recipe": "_gate-schema-validate" }
      },
      "schema-codegen": {
        "dir": ".",
        "steps": ["schema-codegen"],
        "run": { "kind": "root-just", "recipe": "_gate-schema-codegen" }
      },
      "constants-sync": {
        "dir": ".",
        "steps": ["constants-sync"],
        "run": { "kind": "root-just", "recipe": "_gate-constants-sync" }
      },
      "genesis-a2o": {
        "dir": "genesis/a2o",
        "steps": ["lint-a2o"],
        "run": { "kind": "root-just", "recipe": "_gate-genesis-a2o" }
      },
      "gherkin-prepush-lint": {
        "dir": "genesis/a2o",
        "steps": ["gherkin-prepush-lint"],
        "run": { "kind": "root-just", "recipe": "_gate-gherkin-prepush-lint" }
      },
      "reach-drift": {
        "dir": ".",
        "inputs": {
          "sources": [
            "genesis/data/lamad/content/**",
            "genesis/data/lamad/paths/**",
            "elohim/sdk/schemas/v1/enums/reach.schema.json"
          ],
          "buildProcess": ["genesis/seeder/scripts/check-reach-drift.mjs"]
        },
        "run": { "kind": "root-just", "recipe": "_gate-reach-drift" }
      },
      "domain-types": {
        "dir": ".",
        "inputs": {
          "sources": ["elohim/sdk/**"],
          "buildProcess": []
        },
        "run": {
          "kind": "root-just",
          "recipe": "_gate-domain-types",
          "cargo": { "workspace": "elohim", "profile": "dev", "rustflags": "" }
        }
      }
    }
  },
  "deployment": {}
}
