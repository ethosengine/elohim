/**
 * Genesis Pipeline (elohim-genesis)
 *
 * Seeds content from genesis/data/lamad to Holochain via doorway.
 * Triggered by orchestrator after successful holochain/edge/app builds.
 *
 * Pipeline: checkout → resolve hosts → verify health → seed
 *
 * Auto-detects target environment from branch:
 *   - dev, feat-*, claude-* → alpha.elohim.host (doorway-alpha)
 *   - staging*              → staging.elohim.host (doorway-staging)
 *   - main                  → elohim.host (doorway)
 *
 * Parameters:
 *   - TARGET_HOST: Override auto-detected host (optional)
 *   - SEED_DATA: Enable/disable seeding (default: true)
 *   - SEED_IDS: Comma-separated list of specific IDs to seed (optional)
 *   - RESET_STORAGE: Reset storage databases before seeding (default: false)
 */

def resolveDoorwayHost(String targetHost, String explicitDoorway) {
    if (explicitDoorway) {
        return explicitDoorway
    }
    // Map target app URLs to environment-specific doorway URLs
    if (targetHost.contains('alpha.elohim.host')) {
        return 'https://doorway-alpha.elohim.host'
    } else if (targetHost.contains('staging.elohim.host')) {
        return 'https://doorway-staging.elohim.host'
    } else if (targetHost.contains('elohim.host') && !targetHost.contains('doorway')) {
        return 'https://doorway.elohim.host'
    }
    return targetHost.replaceFirst('://', '://doorway.')
}

def resolveInternalDoorwayUrl(String doorwayHost) {
    // Map external DNS to internal Kubernetes service DNS
    if (doorwayHost.contains('doorway-alpha.elohim.host')) {
        return 'elohim-doorway-alpha.elohim-alpha.svc.cluster.local:8080'
    } else if (doorwayHost.contains('doorway-staging.elohim.host')) {
        return 'elohim-doorway-staging.elohim-staging.svc.cluster.local:8080'
    } else if (doorwayHost.contains('doorway.elohim.host') && !doorwayHost.contains('doorway-')) {
        return 'elohim-doorway-prod.elohim-prod.svc.cluster.local:8080'
    }
    // Fallback for custom hosts
    return doorwayHost.replace('https://', '').replace('http://', '')
}

def resolveInternalStorageUrl(String doorwayHost) {
    // Points to a genesis peer's per-human storage for preflight checks.
    // The genesis peer set is declared in genesis/orchestrator/data/deployments.json
    // (genesisPeer:true) — but this resolver fires before topology.json is read,
    // so the per-env mapping is hardcoded. Keep these in sync with the active
    // genesis peer for each env.
    //   alpha:   matthew (adam is suspended pending shem replacement)
    //   staging: pete-staging was the genesis peer; suspended along with pete
    //            at the human level — point at matthew-staging when staging is
    //            re-enabled, otherwise this URL is dormant.
    //   prod:    frank-prod, same suspension story; revisit before prod runs.
    if (doorwayHost.contains('alpha.elohim.host')) {
        return 'elohim-matthew-alpha.elohim-alpha.svc.cluster.local:8090'
    } else if (doorwayHost.contains('staging.elohim.host')) {
        return 'elohim-pete-staging.elohim-staging.svc.cluster.local:8090'
    } else if (doorwayHost.contains('elohim.host') && !doorwayHost.contains('alpha') && !doorwayHost.contains('staging')) {
        return 'elohim-frank-prod.elohim-prod.svc.cluster.local:8090'
    }
    // Fallback: swap doorway→edgenode and port
    return doorwayHost.replace('https://', '').replace('http://', '').replace('doorway', 'edgenode').replaceAll(':\\d+', ':8090')
}

/**
 * Per-human storage endpoints across environments.
 * Each human has a dedicated StatefulSet in their assigned environment.
 *
 * Reads topology from genesis/orchestrator/environments/topology.json when available.
 * Falls back to alpha-concentration default (all 5 agents in alpha) if the file
 * is missing or unparseable.
 */
def getHumanStorageUrls(String ignored) {
    def topoPath = "genesis/orchestrator/environments/topology.json"
    if (fileExists(topoPath)) {
        try {
            def topo = new groovy.json.JsonSlurper().parseText(readFile(topoPath))
            return topo.humans.collect { h ->
                [
                    humanId:     h.humanId,
                    service:     h.resourcePrefix,
                    namespace:   h.namespace,
                    storageUrl:  h.storageUrl.replaceFirst('^https?://', ''),
                    genesisPeer: (h.genesisPeer == true),
                ]
            }
        } catch (Exception e) {
            echo "WARN: Failed to parse topology.json, using alpha-concentration fallback: ${e.message}"
        }
    }

    // Fallback: alpha-concentration when topology.json is missing/unparseable.
    // Genesis peers (genesisPeer:true) ingest content directly during seeding;
    // everyone else replicates via P2P. Mirrors the active alpha entries in
    // genesis/orchestrator/data/deployments.json: matthew + adam are the
    // genesis pair (matthew on-prem, adam on shem), jessica is the on-prem
    // non-genesis device that exercises P2P replication.
    def humans = [
        [humanId: 'human-matthew-manager',  service: 'elohim-matthew-alpha',   namespace: 'elohim-alpha', genesisPeer: true],
        [humanId: 'human-adam-firstman',    service: 'elohim-adam-alpha',      namespace: 'elohim-alpha', genesisPeer: true],
        [humanId: 'human-jessica-spouse',   service: 'elohim-jessica-alpha',   namespace: 'elohim-alpha', genesisPeer: false],
    ]
    return humans.collect { h ->
        h + [storageUrl: "${h.service}.${h.namespace}.svc.cluster.local:8090"]
    }
}

/**
 * Comma-separated name=host:port pairs for substrate-verify.sh — derived from
 * getHumanStorageUrls() so topology.json (when present) and the
 * alpha-concentration fallback stay the single source of truth. Short name =
 * first segment after the human- prefix (human-matthew-manager → matthew),
 * matching the seeder's storageUrlForHuman() convention in peer-id.ts.
 */
def peerStorageUrlsCsv() {
    return getHumanStorageUrls('').collect { h ->
        def shortName = (h.humanId ?: '').replaceFirst(/^human-/, '').split('-')[0]
        "${shortName}=${h.storageUrl}"
    }.join(',')
}

/**
 * Build comma-separated CONDUCTOR_URLS for every non-suspended human declared
 * in genesis/orchestrator/data/deployments.json — the authoritative record of
 * who actually has a deployed conductor pod on alpha (every entry there runs
 * the consolidated elohim-node pattern: conductor + storage + doorway in one
 * container). Each URL points at the conductor's app WebSocket port; the
 * seeder derives admin port (= app port - 1) per the existing socat
 * convention in K8s.
 *
 * Historical note: this used to read genesis/orchestrator/environments/
 * topology.json (a file that has never existed) filtered by an `agencyPhase`
 * field deployments.json doesn't carry — the fallback-to-3-humans path silently
 * became the only path, which is why household members outside the
 * matthew/adam/jessica fallback (e.g. james) never got a conductor session to
 * bind (genesis household-formation FATAL: no conductor found for the founder).
 * deployments.json's `suspended` flag remains the single is-this-human-
 * exercise-able source of truth (feedback_deterministic_flag_agent_canon_stasis_pattern).
 *
 * NETPOL DEPENDENCY: reaching these conductor admin/app WS sockets from a
 * jenkins agent requires the elohim-alpha NetworkPolicy default-deny-cross-env
 * to admit the jenkins ns on pod ports 8444 (admin, Svc 4444) / 8445 (app, Svc
 * 4445). Applied 2026-06-10 (genesis/orchestrator/manifests/network-policies.yaml).
 * Cross-node agents are admitted by the sibling ipBlock rule (the 7 Calico
 * VXLAN tunnel /32s); the namespaceSelector match only fires same-node, because
 * the VXLAN source IP is rewritten across nodes. That ipBlock rule lives ONLY
 * in the live cluster, NOT in the manifest -- do NOT `kubectl apply -f` the
 * manifest blindly or it strips the cross-node fix.
 *
 * TODO (scoped bootstrap debt): this admits CI compute to Holochain's admin WS
 * (root-on-conductor) by network position alone -- no identity, standing, or
 * revocation. Retire by routing seeding through a commitment-gated doorway
 * deputy under Mishpat::Commitment `delegates-compute` -- the same primitive
 * that lets a matthew-authorized conductor back Eclipse Che dev against the
 * real P2P network. Tracked:
 * genesis/data/timeline/backlog/security-ci-substrate-authorization-grant-coherence.md
 */
def getConductorAppUrls() {
    def path = "genesis/orchestrator/data/deployments.json"
    def humans = []
    if (fileExists(path)) {
        try {
            // readJSON (not JsonSlurper) — JsonSlurper's LazyMap is CPS-non-serializable
            // across Jenkins pipeline step boundaries (see remoteOnlyHumanRecords() above);
            // readJSON is the proven-safe pattern for reading deployments.json here.
            def data = readJSON(file: path)
            humans = (data.humans ?: []).findAll { !it.suspended && it.name }
        } catch (Exception e) {
            echo "WARN: getConductorAppUrls() deployments.json parse failed: ${e.message}"
        }
    }
    if (humans.isEmpty()) {
        // Fallback: alpha-concentration default (mirrors getHumanStorageUrls) —
        // only reached if deployments.json is missing/unparseable/empty.
        humans = [
            [name: 'matthew'],
            [name: 'adam'],
            [name: 'jessica'],
        ]
    }
    // `-conductor` since rung 2 (2026-08-31): the conductor moved to its own
    // StatefulSet + Service so storage/doorway rolls stop restarting it. A
    // Service selects ONE pod set, so the admin/app WS ports (4444/4445 →
    // container 8444/8445) moved off `elohim-<name>-alpha` — which must keep
    // selecting the storage pod for :8090 — onto `elohim-<name>-alpha-conductor`.
    // The app→admin derivation below (adminPort = appPort - 1) is unchanged.
    // See genesis/orchestrator/manifests/humans/_edgenode-conductor.template.yaml.
    def urls = humans.collect { "ws://elohim-${it.name}-alpha-conductor.elohim-alpha.svc.cluster.local:4445" }
    return urls.join(',')
}

/**
 * Derive shem availability from the durable home (genesis/manifests/cluster-state.yaml) — the CI
 * twin of humans.ts deriveRemoteComputeFromClusterState() / substrate-scope.ts. Returns
 * 'available'/'unavailable', or null when the file is unreadable (caller keeps the legacy
 * fail-open). Line-based parse (no YAML dep on the agent): walk `  <name>:` → `    available: <v>`;
 * shem available iff exactly `true`. shem block absent / no available: line → 'unavailable'
 * (the conservative read for a cross-node canvas).
 */
def deriveRemoteComputeFromClusterState() {
    def path = 'genesis/manifests/cluster-state.yaml'
    if (!fileExists(path)) { return null }
    boolean inShem = false
    for (String ln : readFile(path).split('\n')) {
        // A resource key: exactly 2-space indent then `<name>:` to EOL. `==~` returns a boolean, so
        // no non-serializable Matcher is retained across the loop — CPS-safe (the file's idiom).
        if (ln ==~ /^ {2}[A-Za-z0-9_-]+:\s*$/) {
            inShem = (ln.trim() == 'shem:')
            continue
        }
        if (!inShem) { continue }
        def t = ln.trim()
        if (t.startsWith('available:')) {
            def val = t.substring('available:'.length()).trim().split(/\s+/)[0]
            return (val == 'true') ? 'available' : 'unavailable'
        }
    }
    return 'unavailable'
}

/**
 * Probe the "remote" k8s node pool (shem) and return the substrate signal the whole pipeline
 * reconciles to: 'available' | 'unavailable'. (Never 'unknown' — a blind probe RECONCILES.)
 *
 * This is the single toggle the deployment-wait, seeder, and a2o test bench all key off (via
 * env.ELOHIM_REMOTE_COMPUTE_STATUS). The P2P substrate itself stays k8s-blind — this CI-layer probe
 * only exists so the planning/test scope reconciles to the available compute as the hardware shifts.
 *
 * Semantics:
 *   - shem Ready=True                                → 'available'
 *   - shem Ready=Unknown/False, or node absent       → 'unavailable'
 *   - cluster unreachable (kubectl blind from this agent) → RECONCILE to cluster-state.yaml (the
 *     durable home) instead of failing OPEN. A blind probe must NOT silently treat shem as up —
 *     that runs shem scenarios against down pods and masks the real test-layer signal. The two
 *     signal homes (cluster-state.yaml + ELOHIM_REMOTE_COMPUTE_STATUS) cannot disagree
 *     (project_ci_reconciles_to_substrate_signal). Only if cluster-state.yaml is itself unreadable
 *     do we keep the legacy fail-open ('available').
 *
 * The doc contract lives in genesis/a2o/src/framework/fixtures/humans.ts + substrate-scope.ts
 * (ELOHIM_REMOTE_COMPUTE_STATUS / isRemoteComputeAvailable / isHumanDeployed / @requires:<cap>).
 */
def probeRemotePoolStatus() {
    def status = sh(returnStdout: true, script: '''#!/bin/bash
        set -uo pipefail
        # Blind probe: if we can't even list nodes, say so — the caller reconciles to cluster-state.
        if ! kubectl get nodes >/dev/null 2>&1; then
            echo "unknown"; exit 0
        fi
        READY=$(kubectl get node shem \
            -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || echo "")
        if [ "$READY" = "True" ]; then
            echo "available"
        else
            echo "unavailable"
        fi
    ''').trim()
    if (!(status in ['available', 'unavailable', 'unknown'])) { status = 'unknown' }
    if (status == 'unknown') {
        def derived = deriveRemoteComputeFromClusterState()
        if (derived != null) {
            echo "ℹ️  Probe blind (kubectl unreachable) — reconciling to cluster-state.yaml: shem=${derived}"
            return derived
        }
        echo "⚠️  Probe blind AND cluster-state.yaml unreadable — keeping legacy fail-open (available)."
        return 'available'
    }
    return status
}

/**
 * Personas that auto-skip when the remote pool (shem) is down: those whose
 * nodeTypes are ALL "remote" (no on-prem fallback) and are not hard-suspended.
 * Mirrors isAnyNodePoolAvailable() in humans.ts so the pipeline banner names
 * exactly the set the a2o runner will gate. Reads deployments.json (the same
 * source of truth the test bench reads). Returns [] on any parse failure
 * (fail-open: a banner is informational, never a gate).
 */
def remoteOnlyHumanRecords() {
    def path = 'genesis/orchestrator/data/deployments.json'
    if (!fileExists(path)) { return [] }
    try {
        // readJSON (not JsonSlurper) — JsonSlurper's LazyMap is CPS-non-serializable across
        // Jenkins pipeline step boundaries, so it threw + returned [] every build (the silent
        // "remoteOnlyHumanRecords() parse failed" warning). readJSON is the in-file CPS-safe pattern.
        def data = readJSON(file: path)
        return (data.humans ?: []).findAll { h ->
            def nt = h.nodeTypes ?: []
            !h.suspended && nt && nt.every { it == 'remote' }
        }
    } catch (Exception e) {
        echo "WARN: remoteOnlyHumanRecords() parse failed: ${e.message}"
        return []
    }
}

/**
 * Live household-mesh fixture wiring for the a2o E2E stage.
 *
 * genesis/a2o/src/framework/fixtures/household-mesh.ts is the single authority
 * for the multi-doorway / multi-peer legs of the federation + resilience
 * features, and nothing ever fed it: every scenario naming a second doorway or
 * a named storage peer died reporting an environment-variable NAME. Topology
 * knowledge lives here (as it does for RESOLVED_DOORWAY_HOST /
 * INTERNAL_STORAGE_URL), so this resolves it and hands it to the E2E stage via
 * withEnv. The negative half (this harness has no process control over remote
 * pods; this fleet has no third doorway) is declared in
 * genesis/scripts/ci/e2e-verify-*.sh.
 *
 * Doorways: the alpha namespace deploys TWO from one pipeline —
 * manifests/doorway/alpha.yaml (DOORWAY_ID alpha-elohim-host, at
 * doorway-alpha.elohim.host, matthew-backed) and manifests/doorway/alpha-b.yaml
 * (DOORWAY_ID apex-elohim-host, at elohim.host, adam-backed, its own MongoDB
 * projection DB). a2o calls the front door "apex" and the generic second
 * doorway "beta"; on this fleet both names resolve to doorway-B — which is a
 * real federation peer of doorway-A (different pod, different backing storage,
 * different projection DB), but is ONE doorway wearing two a2o names, so apex
 * and beta are never a peer PAIR. Other envs deploy a single doorway, so
 * nothing is declared for them and the fixture says so in its own words.
 *
 * Storage: mirrors resolveHumanAssignments() + computeStorageUrls() in
 * elohim/holochain/Jenkinsfile via humansDeployedTo() below — `suspended` is not
 * the whole filter there, the resolved `env` is the other half. Returns []
 * entries only for values that exist; an empty withEnv value would read as
 * "declared, but blank" to the fixture.
 */
/**
 * The humans a namespace ACTUALLY runs — the mirror of the authoritative filter
 * in elohim/holochain/Jenkinsfile: resolveHumanAssignments() drops `suspended`
 * humans AND assigns each survivor an `env`, then computeStorageUrls() keeps
 * only `it.env == targetEnv`. This helper once filtered on `!suspended` alone,
 * which agreed with that only by luck.
 *
 * Genesis cannot observe the edge pipeline's DEPLOY_STRATEGY, so it applies the
 * only sound approximation: hold back every human that ANY shipped strategy can
 * place outside `targetEnv`. Under 'distributed' that is pete -> staging and
 * frank -> prod (elohim/holochain/Jenkinsfile `fullDistribution`); under
 * 'alpha-concentration' (the default) nothing moves. Holding them back can only
 * under-report the pool; including them could fabricate a URL — an
 * `elohim-pete-alpha` that no StatefulSet backs — and a fabricated peer is
 * measured by the pool-degrade scenarios as fleet fact.
 *
 * Fails LOUDLY rather than falling back to a guess. The three-name fallback this
 * replaced ran while the registry held seven non-suspended humans: a readJSON
 * throw silently halved the doorway's storage pool, and every scenario counting
 * peers would have reported the halving as the topology.
 */
def humansDeployedTo(String targetEnv) {
    def path = 'genesis/orchestrator/data/deployments.json'
    if (!fileExists(path)) {
        error("householdMeshEnv: ${path} not found — cannot resolve the '${targetEnv}' storage pool. " +
              'Refusing to guess: a fabricated pool is reported by the fixture as measured topology.')
    }
    def humans
    try {
        humans = (readJSON(file: path).humans ?: []).findAll { !it.suspended && it.name }
    } catch (Exception e) {
        error("householdMeshEnv: ${path} parse failed (${e.message}) — cannot resolve the " +
              "'${targetEnv}' storage pool. Refusing to guess.")
    }

    // Mirrors `fullDistribution` in elohim/holochain/Jenkinsfile
    // resolveHumanAssignments(): the only humans any shipped strategy places
    // outside alpha.
    def neverIn = ['alpha': ['pete', 'frank']]
    def held = (neverIn[targetEnv] ?: []).findAll { name -> humans.any { it.name == name } }
    if (held) {
        echo "householdMeshEnv: holding ${held.join(', ')} out of the '${targetEnv}' pool — " +
             'the edge pipeline places them elsewhere under DEPLOY_STRATEGY=distributed, ' +
             'and genesis cannot observe which strategy deployed this fleet.'
    }
    def names = humans.collect { it.name }.findAll { !held.contains(it) }
    if (names.isEmpty()) {
        error("householdMeshEnv: no non-suspended human resolves to env '${targetEnv}' in ${path} — " +
              'the fixture would otherwise declare an empty storage pool as this fleet\'s topology.')
    }
    return names
}

def householdMeshEnv(String doorwayHost) {
    // Only the alpha namespace deploys a second doorway and the named peers.
    // Declaring nothing elsewhere is deliberate: the fixture then reports the
    // absent topology in its own words instead of inventing a URL.
    if (!doorwayHost?.contains('alpha.elohim.host')) {
        echo "householdMeshEnv: no second-doorway/household topology for '${doorwayHost}' — household-mesh scenarios will say so"
        return []
    }

    // ONE second doorway exists on this fleet, and a2o has two names for it.
    // doorway-B is manifests/doorway/alpha-b.yaml — DOORWAY_ID apex-elohim-host,
    // at elohim.host, adam-backed, its own MongoDB projection DB. a2o calls the
    // front door "apex" and the generic second doorway "beta"; on THIS fleet
    // both resolve to doorway-B. That is declared here as one value used twice,
    // not two independently-chosen URLs that happen to match, so nobody reads
    // apex-vs-beta as a peer pair. Any scenario needing two DISTINCT second
    // doorways must not use this pair — a cross-doorway assertion between apex
    // and beta is a tautology on this fleet, and the URL-equality check in
    // genesis/a2o/steps/federation-epr.steps.ts (distinctPeers) refuses it for
    // exactly that reason. A third doorway is declared ABSENT, with the reason,
    // in genesis/scripts/ci/e2e-verify-*.sh.
    def doorwayB = 'https://elohim.host'
    echo "householdMeshEnv: apex and beta both resolve to doorway-B (${doorwayB}) — " +
         'this fleet deploys exactly two doorways, so they are one peer under two names.'

    def entries = [
        "E2E_DOORWAY_APEX=${doorwayB}",
        "E2E_DOORWAY_BETA=${doorwayB}",
        'E2E_APEX_PRIMARY_STORAGE_URL=http://elohim-adam-alpha.elohim-alpha.svc.cluster.local:8090',
    ]

    def names = humansDeployedTo('alpha')
    for (String peer : ['matthew', 'jessica', 'james']) {
        if (names.contains(peer)) {
            entries << "E2E_STORAGE_${peer.toUpperCase()}=http://elohim-${peer}-alpha.elohim-alpha.svc.cluster.local:8090"
        }
    }
    def pool = names.collect { "http://elohim-${it}-alpha.elohim-alpha.svc.cluster.local:8090" }
    entries << "E2E_DOORWAY_POOL_STORAGE_URLS=${pool.join(',')}"
    return entries
}

/** humanIds marked `suspended` in deployments.json — the AUTHORITATIVE
 * is-this-human-exercise-able flag (e.g. suspendedBy:scope-reconcile:shem). A
 * suspended human is never a seed/verify target: holding it from the peer set
 * stops the 120s storage-wait + the partial-cluster UNSTABLE that fires for a
 * known-suspended peer (e.g. adam while shem is down). readJSON (CPS-safe). */
def suspendedHumanIds() {
    def path = 'genesis/orchestrator/data/deployments.json'
    if (!fileExists(path)) { return [] }
    try {
        def data = readJSON(file: path)
        return (data.humans ?: []).findAll { it.suspended }.collect { it.humanId }.findAll { it }.sort()
    } catch (Exception e) {
        echo "WARN: suspendedHumanIds() parse failed: ${e.message}"
        return []
    }
}

def remoteOnlyPersonas() {
    return remoteOnlyHumanRecords().collect { it.name }.findAll { it }.sort()
}

/** humanIds (e.g. 'human-adam-firstman') of remote-only personas — the seeder keys genesis-peer
 * holding off these, since the seeder topology carries humanId, not the short name. */
def remoteOnlyHumanIds() {
    return remoteOnlyHumanRecords().collect { it.humanId }.findAll { it }.sort()
}

/**
 * Bounded readiness probe for a single peer's storage /health. Returns true
 * if it answered within maxAttempts (×2s), false otherwise. The basis of the
 * "seed whoever is ready" discipline: a slow cold-starting peer still gets its
 * full wait, but a peer whose hardware is gone is skipped rather than
 * cascade-failing the stage. Never throws — callers branch on the boolean.
 */
def waitForStorageReady(String storageUrl, String label, int maxAttempts = 60) {
    return sh(returnStatus: true, script: """#!/bin/bash
        set -uo pipefail
        for i in \$(seq 1 ${maxAttempts}); do
            if curl -sf --max-time 5 "http://${storageUrl}/health" >/dev/null 2>&1; then
                echo "✅ ${label} storage is ready (\$i/${maxAttempts})"
                exit 0
            fi
            echo "   Waiting for ${label} storage... (\$i/${maxAttempts})"
            sleep 2
        done
        echo "⏭️  ${label} storage not ready after ${maxAttempts} attempts"
        exit 1
    """) == 0
}

/**
 * Probe Substrate stage body (extracted to keep the pipeline {} CPS method
 * under the 64KB JVM limit — see .claude/hooks/jenkinsfile-method-size.py).
 * Sets env.ELOHIM_REMOTE_COMPUTE_STATUS (the single signal the run reconciles to),
 * emits a loud reduced-scope banner, archives substrate-status.json, and
 * marks the build UNSTABLE (not FAILED) when the remote pool is down.
 */
def probeSubstrateScope() {
    def remoteComputeStatus = probeRemotePoolStatus()
    env.ELOHIM_REMOTE_COMPUTE_STATUS = remoteComputeStatus

    def skipped = (remoteComputeStatus == 'unavailable') ? remoteOnlyPersonas() : []

    echo """
═══════════════════════════════════════════════════════════
🛰️  SUBSTRATE PROBE — remote pool (shem): ${remoteComputeStatus.toUpperCase()}
═══════════════════════════════════════════════════════════"""
    if (remoteComputeStatus == 'unavailable') {
        echo """⚠️  REDUCED SCOPE — operating on available compute only.
   On-prem household (matthew, jessica, james) carries this run.
   Auto-skipped remote-only personas (${skipped.size()}): ${skipped.join(', ') ?: '(none declared)'}
   Seeder will seed whoever is ready; a2o will gate remote-only scenarios.
   This run is intentionally UNSTABLE (loud signal), not FAILED — re-run
   when shem returns to restabilize to full topology."""
    } else {
        // probeRemotePoolStatus() reconciles a blind probe to cluster-state.yaml, so the status is
        // always 'available' or 'unavailable' here — never a fail-open 'unknown'.
        echo "✅ Full topology available — no reduced-scope gating this run."
    }

    writeJSON(file: 'substrate-status.json', pretty: 2, json: [
        schemaVersion: '1',
        probedAt: new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC')),
        commitSha: env.GIT_COMMIT_FULL ?: env.GIT_COMMIT ?: '',
        remotePool: 'shem',
        remoteComputeStatus: remoteComputeStatus,
        reducedScope: (remoteComputeStatus == 'unavailable'),
        autoSkippedPersonas: skipped,
    ])
    archiveArtifacts(artifacts: 'substrate-status.json', allowEmptyArchive: true, fingerprint: true)

    // Reduced-scope is no longer a build-result UNSTABLE (EPR-shift 2026-06-08, operator-blessed
    // proposal): the cybernetic scope reconciler already moves shem-only personas to HELD
    // (deployments.json `suspended` = scope-reconcile:shem), so a run that is green on the in-scope
    // (household) plate is a legitimate SUCCESS — not a per-run failure. The reduced-scope fact stays
    // fully visible via the loud banner above + the archived substrate-status.json (reducedScope:true)
    // + the build description below; the build RESULT now reflects the in-scope work (the downstream
    // seed/verify/a2o stages still mark UNSTABLE on their own real failures). This un-pins genesis from
    // permanent-UNSTABLE-while-shem-is-down, which had masked real signal (shem-down vs a2o-broke).
    if (remoteComputeStatus == 'unavailable') {
        currentBuild.description = ((currentBuild.description ?: '') +
            " · reduced-scope (shem down; ${skipped.size()} remote-only held)").trim()
        echo "ℹ️  Reduced scope (shem down) is NOT a build UNSTABLE — the scope reconciler holds the shem plate; the build result reflects the in-scope household work. (See substrate-status.json.)"
    }
}

/**
 * Seed Database stage body (extracted for the 64KB CPS limit). Implements the
 * "seed whoever is ready" discipline so the content-seed stage reconciles to
 * the available compute instead of cascade-failing when a peer's hardware is
 * gone:
 *   - Genesis peers: seed each that becomes ready; SKIP (not fatal) any that
 *     don't. Fatal ONLY if zero genesis peers seeded (nothing to ingest from).
 *     Honors deployments.json's documented "pipeline tolerates 1..N genesis
 *     peers" contract.
 *   - Replica peers: wait for P2P catch-up; a down/lagging replica is SKIPPED
 *     (never fatal) — it reconverges via identity-driven replication when it
 *     returns.
 * Any skip marks the build UNSTABLE (loud signal), never silently green.
 */
def runContentSeedStage() {
    // Full-roster storage URLs for the seeder's network-stakes fan-out: the
    // corpus trustBootstrap grant is a per-peer local manifest, and the
    // ADOPTING peers (not just the genesis seed targets) are where declared-
    // stakes ceremony pricing pays. Down/suspended peers fail soft in the
    // seeder (they stay fail-closed Bootstrap until a later seed run).
    env.PEER_STORAGE_URLS = peerStorageUrlsCsv()
    def humans = getHumanStorageUrls('alpha')
    // Authoritative suspension gate: deployments.json `suspended` is the single source of truth for
    // is-this-human-exercise-able. Drop suspended humans (e.g. adam, suspendedBy:scope-reconcile:shem)
    // from the seed set entirely — the seeder must never wait 120s on / mark UNSTABLE for a known-
    // suspended peer's dead storage. (Independent of the remote-only-shem banner reconciliation below,
    // which intentionally names only the not-yet-suspended set — see remoteOnlyHumanRecords.)
    def suspendedIds = suspendedHumanIds()
    def heldSuspended = humans.findAll { suspendedIds.contains(it.humanId) }.collect { it.humanId }
    if (!heldSuspended.isEmpty()) {
        echo "⏸️  Holding suspended peer(s) from the seed set: ${heldSuspended.join(', ')} (deployments.json suspended — not exercise-able)."
        humans = humans.findAll { !suspendedIds.contains(it.humanId) }
    }
    def genesisPeers = humans.findAll { it.genesisPeer == true }

    // Substrate-aware genesis set: a remote-only genesis peer (e.g. adam, hard-pinned to shem) cannot
    // ingest while the remote pool is down — drop it so the seeder doesn't wait 120s on a known-down
    // peer and so no e2e expects content from it. The household genesis peer (matthew) carries the
    // run. This reconciles to the substrate signal (env override wins, else cluster-state) instead of
    // a static genesisPeer flag that drifts as shem comes and goes (feedback_shem_down_peers_are_held;
    // adam's genesisPeer:true stays correct-when-shem-is-up — the GATE is at consumption, here).
    def remoteStatus = env.ELOHIM_REMOTE_COMPUTE_STATUS
    if (!(remoteStatus in ['available', 'unavailable'])) {
        remoteStatus = deriveRemoteComputeFromClusterState() ?: 'available'
    }
    if (remoteStatus == 'unavailable') {
        def remoteIds = remoteOnlyHumanIds()
        def heldGenesis = genesisPeers.findAll { remoteIds.contains(it.humanId) }
        if (!heldGenesis.isEmpty()) {
            echo "🛰️  Holding remote-only genesis peer(s) while shem is down: ${heldGenesis.collect { it.humanId }.join(', ')} — household genesis (matthew) carries ingest."
        }
        genesisPeers = genesisPeers.findAll { !remoteIds.contains(it.humanId) }
    }

    if (genesisPeers.isEmpty()) {
        error("No genesis peer found in topology — at least one non-remote human in deployments.json must have genesisPeer:true (and must not be suspended), OR the remote pool must be available. See genesis/orchestrator/data/deployments.json + genesis/manifests/cluster-state.yaml.")
    }
    def replicaPeers = humans.findAll { it.genesisPeer != true }

    echo "Substrate signal: ELOHIM_REMOTE_COMPUTE_STATUS=${env.ELOHIM_REMOTE_COMPUTE_STATUS ?: 'unknown'} — seeding whoever is ready"
    echo "Genesis peers (direct ingest): ${genesisPeers.collect { it.humanId }.join(', ')}"
    echo "Replica peers (P2P replication): ${replicaPeers.collect { it.humanId }.join(', ')}"

    // ── Genesis peers: seed whoever is ready (fatal only if zero seeded) ──
    def seededGenesis = []
    def skippedGenesis = []
    for (gp in genesisPeers) {
        if (!waitForStorageReady(gp.storageUrl, gp.service, 60)) {
            echo "⏭️  Skipping genesis peer ${gp.humanId} — storage unreachable (seed-whoever-is-ready)"
            skippedGenesis << gp.humanId
            continue
        }
        dir('genesis/seeder') {
            sh "bash '${env.WORKSPACE}/genesis/scripts/ci/seed-genesis-peer.sh' '${gp.humanId}' '${gp.storageUrl}'"
        }
        seededGenesis << gp.humanId
    }
    if (seededGenesis.isEmpty()) {
        error("No genesis peer became ready — nothing seeded. At least one genesis peer's storage must answer (skipped: ${skippedGenesis.join(', ')}). If the remote pool is down, an on-prem genesis peer such as matthew must be healthy.")
    }
    if (!skippedGenesis.isEmpty()) {
        unstable("Seeded genesis peers: ${seededGenesis.join(', ')}; skipped unreachable: ${skippedGenesis.join(', ')} — partial-cluster steady state (seed whoever is ready)")
    }

    // ── Replica peers: wait for P2P catch-up; never fatal ──
    def laggingReplicas = []
    for (peer in replicaPeers) {
        if (!waitForStorageReady(peer.storageUrl, peer.service, 30)) {
            echo "⏭️  Replica ${peer.humanId} storage unreachable — will reconverge when it returns"
            laggingReplicas << peer.humanId
            continue
        }
        def rc = sh(returnStatus: true, script: "bash '${env.WORKSPACE}/genesis/scripts/ci/wait-for-replication.sh' '${peer.humanId}' '${peer.storageUrl}'")
        if (rc != 0) {
            laggingReplicas << peer.humanId
        }
    }
    if (!laggingReplicas.isEmpty()) {
        unstable("Replica peers not yet caught up (reconverge when reachable): ${laggingReplicas.join(', ')}")
    }

    // ── Summary (graceful — curl failures fall through to 0) ──
    echo "═══════════════════════════════════════════════════════════"
    echo "📊 SEEDING SUMMARY (seeded: ${seededGenesis.join(', ')})"
    echo "═══════════════════════════════════════════════════════════"
    for (human in humans) {
        sh """#!/bin/bash
            STATS=\$(curl -sf "http://${human.storageUrl}/db/stats" 2>/dev/null || echo '{}')
            COUNT=\$(echo "\$STATS" | jq -r '.contentCount // 0')
            echo "   ${human.humanId}: \$COUNT content nodes"
        """
    }
}

/**
 * Verify Seeding stage body (extracted for the 64KB CPS limit). Reconciles to
 * available compute: verifies REACHABLE peers, tolerates unreachable ones
 * (UNSTABLE, not FAILED). Fatal only on a real seed defect — a reachable peer
 * that is empty, or zero reachable peers with content. The assessment
 * spot-check runs on the first REACHABLE genesis peer, never a skipped one.
 */
def runVerifySeedingStage() {
    def humans = getHumanStorageUrls('alpha')
    // Authoritative suspension gate (mirror of runContentSeedStage): a suspended human is never a
    // verify target — drop it so verification doesn't mark UNSTABLE for a known-suspended peer's
    // unreachable storage (deployments.json `suspended` is the source of truth).
    def suspendedIds = suspendedHumanIds()
    humans = humans.findAll { !suspendedIds.contains(it.humanId) }
    def genesisPeers = humans.findAll { it.genesisPeer == true }
    if (genesisPeers.isEmpty()) {
        error("No genesis peer found in topology — at least one human in deployments.json must have genesisPeer:true (and must not be suspended).")
    }

    echo "═══════════════════════════════════════════════════════════"
    echo "🔍 VERIFYING SEEDING (reachable peers only — reconcile to available compute)"
    echo "═══════════════════════════════════════════════════════════"

    def verified = []
    def unreachable = []
    def empty = []
    for (human in humans) {
        def count = sh(returnStdout: true, script: """#!/bin/bash
            set -uo pipefail
            STATS=\$(curl -sf --max-time 5 "http://${human.storageUrl}/db/stats" 2>/dev/null || echo '')
            if [ -z "\$STATS" ]; then echo "-1"; exit 0; fi
            echo "\$STATS" | jq -r '.contentCount // 0'
        """).trim()
        if (count == '-1' || count == '') {
            echo "   ⏭️  ${human.humanId}: storage unreachable — skipped (reconciled out this run)"
            unreachable << human.humanId
        } else if (count == '0') {
            echo "   ❌ ${human.humanId}: 0 content (reachable but empty — real failure)"
            empty << human.humanId
        } else {
            echo "   ✅ ${human.humanId}: ${count} content"
            verified << human.humanId
        }
    }

    if (!empty.isEmpty()) {
        error("Reachable peer(s) seeded empty (seed defect, not a substrate skip): ${empty.join(', ')}")
    }
    if (verified.isEmpty()) {
        error("No reachable peer has content — seeding cannot be verified. Unreachable: ${unreachable.join(', ')}")
    }
    if (!unreachable.isEmpty()) {
        unstable("Verified ${verified.join(', ')}; skipped unreachable peers: ${unreachable.join(', ')} (partial-cluster steady state)")
    }

    // Assessment spot-check on the first REACHABLE genesis peer (idempotent
    // direct seeding means every genesis peer holds the same content).
    def checkPeer = genesisPeers.find { verified.contains(it.humanId) }
    if (!checkPeer) {
        echo "⚠️  No reachable genesis peer for the assessment spot-check — skipping (replicas verified above)"
        return
    }
    def genesisUrl = checkPeer.storageUrl
    sh "bash '${env.WORKSPACE}/genesis/scripts/ci/verify-assessment-content.sh' '${genesisUrl}' '${checkPeer.humanId}'"
}

/**
 * Probe each conductor's admin WebSocket port for reachability before
 * invoking the seeder. Returns [ready: [...urls], unready: [...urls]]
 * and writes a structured conductor-readiness.json artifact.
 *
 * Aligns with the "seed whoever is ready" principle: partial-cluster
 * operation is the steady state, not an exception. If a peer's admin
 * WS is down, we want to seed the rest and report it as unready — not
 * waste 150s of WebSocket-timeout-loop trying to seed against a dead
 * conductor.
 *
 * The probe is a 2-second TCP connect to the admin port (= app port - 1
 * per the socat convention; see seed-conductor-identities.ts:106-115).
 * TCP success is necessary but not sufficient for WS handshake; if the
 * conductor TCP-accepts but rejects the WS upgrade, the seeder will
 * still surface that as a per-peer failure. The probe just eliminates
 * the obvious "pod is dead" case fast.
 *
 * @param urlsString  comma-separated app URLs from getConductorAppUrls()
 * @param stageLabel  human-readable stage name (for the artifact)
 * @return            [ready: [...urls], unready: [...urls],
 *                     readyDetails: [...{url, host, adminPort}],
 *                     unreadyDetails: [...{url, host, adminPort, reason}]]
 */
def probeConductorReadiness(String urlsString, String stageLabel) {
    def readyDetails = []
    def unreadyDetails = []

    def urls = (urlsString ?: '').split(',').collect { it.trim() }.findAll { it }
    urls.each { String appUrl ->
        // Strip ws:// then split host:port. Defensive against malformed
        // entries from topology.json — we don't want a typo to throw and
        // cascade-fail the whole seed stage.
        def stripped = appUrl.replaceFirst(/^wss?:\/\//, '')
        def parts = stripped.split(':')
        if (parts.size() < 2 || !parts[1].isInteger()) {
            echo "[probe] ⚠️  Malformed URL — skipping: ${appUrl}"
            unreadyDetails.add([url: appUrl, reason: 'malformed-url'])
            return
        }
        def host = parts[0]
        def appPort = parts[1].toInteger()
        def adminPort = appPort - 1

        // Sanity check on host shape — K8s DNS uses [a-z0-9.-]+ only.
        // Anything else likely came from a broken topology entry; treat
        // as unready rather than risk shell interpolation surprises.
        if (!(host ==~ /[a-z0-9.\-]+/)) {
            echo "[probe] ⚠️  Suspicious host shape — skipping: ${host}"
            unreadyDetails.add([url: appUrl, host: host, reason: 'suspicious-host'])
            return
        }

        // 2-second TCP probe via /dev/tcp (no nc dependency required).
        // returnStatus: 0 on connect, non-zero on timeout / refused / DNS fail.
        def probeExit = sh(
            script: "timeout 2 bash -c 'echo > /dev/tcp/${host}/${adminPort}' 2>/dev/null",
            returnStatus: true
        )

        if (probeExit == 0) {
            readyDetails.add([url: appUrl, host: host, adminPort: adminPort])
            echo "[probe] ✅ ${host}:${adminPort} reachable"
        } else {
            unreadyDetails.add([url: appUrl, host: host, adminPort: adminPort, reason: 'tcp-timeout-or-refused'])
            echo "[probe] ❌ ${host}:${adminPort} unreachable (admin WS not accepting TCP) — if ALL peers fail, check the jenkins→elohim-alpha NetworkPolicy admits pod ports 8444/8445 AND (for cross-node agents) the ipBlock VXLAN-tunnel rule (genesis/orchestrator/manifests/network-policies.yaml; applied 2026-06-10; see backlog ci-genesis-conductor-adminws-unreachable)"
        }
    }

    // Emit structured artifact. Schema is intentionally compatible with
    // future stageAnnotations work that would feed conductor-readiness
    // into actual-build-graph.json's per-pipeline result map.
    def report = [
        schemaVersion: '1',
        probedAt: new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC')),
        stage: stageLabel,
        commitSha: env.GIT_COMMIT_FULL ?: env.GIT_COMMIT ?: '',
        readyCount: readyDetails.size(),
        unreadyCount: unreadyDetails.size(),
        partial: readyDetails.size() > 0 && unreadyDetails.size() > 0,
        allReady: unreadyDetails.isEmpty(),
        allUnready: readyDetails.isEmpty(),
        ready: readyDetails,
        unready: unreadyDetails,
    ]
    // Filename comes from build-artifacts.json via env var set in Checkout.
    // Elvis fallback handles edge cases where Checkout's bootstrap was skipped
    // (e.g. helper invoked from a probe-only mode). Drift detection lives in
    // genesis/orchestrator/build-artifacts.test.mjs.
    def conductorReadinessFile = env.CONDUCTOR_READINESS_FILE ?: 'conductor-readiness.json'
    writeJSON(file: conductorReadinessFile, json: report, pretty: 2)
    archiveArtifacts(artifacts: conductorReadinessFile, allowEmptyArchive: true, fingerprint: true)

    return [
        ready: readyDetails.collect { it.url },
        unready: unreadyDetails.collect { it.url },
        readyDetails: readyDetails,
        unreadyDetails: unreadyDetails,
    ]
}

/**
 * Run a probe-then-seed stage: TCP-probe each conductor's admin WS,
 * pass only ready URLs to the named seeder script, parse the structured
 * seed-results-*.json artifact, archive it. Returns a Map describing
 * the run so the caller can format stage-specific UNSTABLE messages.
 *
 * Extracted from the two seed stages (Seed Conductor Identities + Seed
 * Agent Peer Bindings) which had ~80 lines of near-identical inline
 * logic. Keeps the pipeline { } CPS method under the 64KB JVM limit.
 *
 * @param stageLabel       human-readable stage name (for probe + console)
 * @param scriptName       seeder script under genesis/seeder/src/
 * @param seedResultsName  basename of the seed-results-*.json artifact
 * @return Map [skipped, exitCode, seedReport, seedResultsName]
 */
def runProbedSeeder(String stageLabel, String scriptName, String seedResultsName) {
    def conductorUrls = getConductorAppUrls()
    if (!conductorUrls) {
        echo "WARN: no conductor URLs resolved — skipping ${stageLabel}"
        return [skipped: true]
    }

    def probe = probeConductorReadiness(conductorUrls, stageLabel)

    if (probe.ready.isEmpty()) {
        // All conductors unreachable — partial-cluster principle:
        // mark UNSTABLE not FAILED, household is recoverable.
        unstable("All ${probe.unready.size()} conductors unreachable — skipping seed (see conductor-readiness.json)")
        return [skipped: true, allUnready: true]
    }

    if (!probe.unready.isEmpty()) {
        unstable("${probe.unready.size()} of ${probe.ready.size() + probe.unready.size()} conductors unready — seeding ${probe.ready.size()} reachable peers (see conductor-readiness.json)")
    }

    def readyUrls = probe.ready.join(',')

    // Run the seeder; capture exit code so we can interpret the
    // partial-vs-total split (0=clean, 2=partial, 1=total).
    def seedExit = -1
    dir('genesis/seeder') {
        seedExit = sh(
            script: """#!/bin/bash
                set -uo pipefail
                echo "═══════════════════════════════════════════════════════════"
                echo "${stageLabel.toUpperCase()}"
                echo "═══════════════════════════════════════════════════════════"
                echo "Conductors (ready): ${readyUrls}"
                echo ""
                CONDUCTOR_URLS="${readyUrls}" \\
                  npx tsx src/${scriptName}
            """,
            returnStatus: true,
        )
    }

    def seedResultsPath = "genesis/seeder/${seedResultsName}"
    def seedReport = null
    if (fileExists(seedResultsPath)) {
        archiveArtifacts(
            artifacts: seedResultsPath,
            fingerprint: true,
            allowEmptyArchive: true,
        )
        seedReport = readJSON(file: seedResultsPath)
    }

    return [
        skipped: false,
        exitCode: seedExit,
        seedReport: seedReport,
        seedResultsName: seedResultsName,
    ]
}

def shouldRunStep(String stepName) {
    def steps = (params.STEPS ?: 'all').split(',').collect { it.trim() }
    return steps.contains('all') || steps.contains(stepName)
}

/**
 * The e2e bench presents the SAME dev admin key the doorway pod validates as its
 * bootstrap key (operator directive 2026-06-03: consistency over rotation in the
 * dev/simulated environment). The doorway pod's API_KEY_ADMIN ← Secret api-key-admin;
 * the canonical Jenkins credential that mirrors it is `doorway-admin-bootstrap-key`
 * — the SAME credential Seed Humans already binds to API_KEY_ADMIN (NOT
 * storage-api-key-admin, which is the storage X-API-Key / DOORWAY_API_KEY write key,
 * a different value). Returns '' when not visible — the bootstrap-key scenario then
 * uses its fallback and the doorway 403s loudly (ADMIN_KEY_REJECTED) instead of
 * silently issuing an Authenticated token. Extracted for the CPS method-size limit.
 */
def resolveE2eAdminKey() {
    def key = ''
    try {
        withCredentials([string(credentialsId: 'doorway-admin-bootstrap-key', variable: 'ADMIN_KEY')]) {
            key = env.ADMIN_KEY
        }
    } catch (e) {
        echo "doorway-admin-bootstrap-key credential not visible — bootstrap-key scenario will use its fallback"
    }
    return key
}

/**
 * Seed Stewardship Allocations — affinity-based content→steward allocations
 * (genesis/seeder/src/seed-stewardship.ts; manifesto Part IV-C: content is
 * stewarded by whoever has the most relational connection to it).
 *
 * The seeder script existed but was wired into NO pipeline stage, so the six
 * a2o stewardship-allocation scenarios failed every run with "No stewardship
 * allocations found — has the seeder been run?" (diagnosed genesis #1079).
 * Idempotent: the script reads existing allocations first and only bulk-inserts
 * the missing content ids.
 *
 * Body extracted to a helper above pipeline {} for the 64KB CPS method-size limit.
 */
def seedStewardshipStage() {
    def doorwayHost = env.RESOLVED_DOORWAY_HOST
    def apiKey = ''
    try {
        withCredentials([string(credentialsId: 'storage-api-key-admin', variable: 'ADMIN_KEY')]) {
            apiKey = env.ADMIN_KEY
        }
    } catch (e) {
        echo "storage-api-key-admin credential not visible — seeding without admin auth (may 401)"
    }
    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
        dir('genesis/seeder') {
            withEnv(["DOORWAY_API_KEY=${apiKey}"]) {
                sh "bash '${env.WORKSPACE}/genesis/scripts/ci/seed-stewardship.sh' '${doorwayHost}'"
            }
        }
    }
}

/**
 * Seed EPR Atoms — the `elohim-host-landing` atom family
 * (genesis/seeder/src/seed-epr-atom.ts).
 *
 * Mints five content-addressed atoms in dependency order: the family schema
 * manifest, the governance-state manifest (payload = the verbatim
 * genesis/data/lamad/governance/state-content-elohim-host-landing.json), a
 * stewardship Claim, a custody Claim, and the landing atom itself — whose
 * governance coupling leg points at the governance atom's real CID and whose
 * claims array holds the two claim CIDs. Before this stage existed the landing
 * atom shipped `claims: []` and a governance leg that was
 * sha256("elohim-host-governance-v1"), a hash of a literal with nothing behind
 * it — and the seeder was reachable from no pipeline stage at all.
 *
 * Runs BEFORE Seed Projections: the projection commitments declare "doorway D
 * projects EPR elohim-host-landing at /", and the nav-context handler resolves
 * that slug against epr_atoms.
 *
 * Idempotent: atom CIDs are derived from canonical bytes, so a re-run re-PUTs
 * the same CIDs and the storage layer short-circuits on identical bytes.
 *
 * Targets STORAGE_URL (the in-cluster storage pod — PUT /api/v1/epr/{cid} is a
 * storage route), falling back to the doorway host.
 *
 * Body extracted to a helper above pipeline {} for the 64KB CPS method-size limit.
 */
def seedEprAtomsStage() {
    def targetUrl = env.STORAGE_URL ?: env.RESOLVED_DOORWAY_HOST
    def apiKey = ''
    try {
        withCredentials([string(credentialsId: 'storage-api-key-admin', variable: 'ADMIN_KEY')]) {
            apiKey = env.ADMIN_KEY
        }
    } catch (e) {
        echo "storage-api-key-admin credential not visible — seeding without admin auth (may 401)"
    }
    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
        dir('genesis/seeder') {
            withEnv(["DOORWAY_API_KEY=${apiKey}"]) {
                sh "bash '${env.WORKSPACE}/genesis/scripts/ci/seed-epr-atoms.sh' '${targetUrl}'"
            }
        }
    }
}

/**
 * Seeds the EPR-projection REA commitments — one per (doorway, EPR, urlPath)
 * tuple — that the doorway's EprRouter polls from
 * /api/v1/commitments?action=project-epr and uses to dispatch path-prefix
 * routes (/, /lamad, /auth/portal) back through /apps/{slug}/* serving.
 *
 * Without these commitments alpha returns 404 for /lamad and serves the
 * landing bundle only via /apps/... (relative chunks 404 because
 * <base href="/"> resolves them to the root projection which doesn't exist).
 *
 * References:
 *   - genesis/seeder/src/seed-projections.ts (default set: 6 commitments —
 *     landing/lamad/imagodei across alpha-elohim-host + elohim-host)
 *   - doorway/doorway-service/src/main.rs:554-595 (EprRouter refresh loop)
 *   - doorway/doorway-service/src/server/http.rs:1354-1378 (dispatch site)
 *   - .claude/shifts/2026-05-26T08-30-deliver-epr-app-iter0.sprint-result.md
 *     (Gap A diagnosis — this stage closes it)
 *   - genesis/docs/superpowers/plans/2026-05-23-spa-blob-deploy-drift.md
 *     (related substrate work — dev response §682-695 confirms
 *     `storage-api-key-admin` is the canonical credential)
 *
 * Idempotent: a re-run whose projection-relevant metadata is unchanged
 * collapses to a quiet 409 (id content-addressed over steward_peer_id + action
 * + scope). When the metadata DRIFTED (e.g. routeClaims newly granted), the
 * seeder re-grants via supersession — it POSTs a fingerprint-suffixed successor
 * (`{baseId}-r{sha256(metadata)[:8]}`) carrying `supersedes:{baseId}`, which the
 * storage layer applies transactionally (mark predecessor `superseded`, insert
 * successor); only the current grant then serves and the chain stays walkable
 * via GET /api/v1/commitments/{id}. Drift fields compared:
 * urlPath, mode, reach, baseHref, entryFile, spaFallback, redirectsFrom,
 * redirectTemplates, routeClaims, previewEprRef, gateHints, deadEnd,
 * stewardDirectEndpoint (null-vs-missing normalized to storage defaults).
 *
 * Body extracted to a helper above pipeline {} so the giant pipeline block
 * stays under the 64KB CPS method-size limit (see .claude/hooks/jenkinsfile-
 * method-size.py for the gate).
 */
def seedProjectionsStage() {
    def doorwayHost = env.RESOLVED_DOORWAY_HOST
    def apiKey = ''
    try {
        withCredentials([string(credentialsId: 'storage-api-key-admin', variable: 'ADMIN_KEY')]) {
            apiKey = env.ADMIN_KEY
        }
    } catch (e) {
        echo "storage-api-key-admin credential not visible — seeding without admin auth (may 401)"
    }
    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
        dir('genesis/seeder') {
            withEnv(["DOORWAY_API_KEY=${apiKey}"]) {
                sh "bash '${env.WORKSPACE}/genesis/scripts/ci/seed-projections.sh' '${doorwayHost}'"
            }
        }
    }

    // Force a doorway pod restart so the EprRouter's boot-time fetch
    // picks up the freshly seeded project-epr commitments.
    //
    // CORRECTION 2026-08-28 (ci-failure-triage): the claim that used to stand
    // here — "the router only refreshes at boot OR via SSE
    // 'projection.registered' events, so a pod-delete is the deterministic
    // refresh" — was ALREADY STALE when it was written. `main.rs` runs a
    // periodic EPR-router self-heal refresh every DOORWAY_EPR_REFRESH_SECS
    // (default 30) whose sequence is byte-for-byte the boot fetch
    // (resolve_epr_storage_pool -> fetch_projections_with_fallback ->
    // apply_epr_fallback_outcome -> prewarm_projected_shells). It landed in
    // 379668123 on 2026-05-30; this comment was written on 2026-06-10.
    // The script below therefore waits out two refresh ticks and VERIFIES
    // (x-epr-router: dispatched at the public boundary) FIRST, and only
    // pod-deletes as a fallback: deleting the pod resets the doorway's p2p
    // snapshot cache and upstream breakers, and the E2E stage a few minutes
    // later then measures a recovering pod (genesis #1512/#1513/#1514 —
    // backlog/ci-genesis-doorway-503-seed-phase-wedge.md).
    //
    // RBAC note: `ee-jenkins` service account cannot `get deployments`
    // in elohim-alpha (RBAC-forbidden error observed in build #1041 when
    // we tried `kubectl rollout restart deployment/...`). But it CAN
    // manage pods directly — the Reset Storage stage at line ~538 uses
    // `kubectl delete pod` against storage pods successfully. So we use
    // the pods API here too. Hedge across two label conventions then
    // fall back to grep, so cluster label drift doesn't silently miss.
    //
    // Empirically observed in build #1039 that Seed Projections created
    // 6 commitments but doorway-alpha's running pod (commit b45ad43,
    // pre-seed) never picked them up. That observation dates from an image
    // WITHOUT the periodic refresh — it establishes that a handoff is
    // needed, not that a pod-delete is the only one available. Wrapped in
    // catchError so an RBAC issue doesn't mask the seed itself succeeding.
    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
        def deployment = ''
        def namespace = ''
        if (doorwayHost.contains('doorway-alpha.elohim.host')) {
            deployment = 'elohim-doorway-alpha'
            namespace = 'elohim-alpha'
        } else if (doorwayHost.contains('doorway-staging.elohim.host')) {
            deployment = 'elohim-doorway-staging'
            namespace = 'elohim-staging'
        } else if (doorwayHost.contains('doorway.elohim.host') && !doorwayHost.contains('doorway-')) {
            deployment = 'elohim-doorway-prod'
            namespace = 'elohim-prod'
        }

        if (deployment && namespace) {
            // Bash body lives in genesis/scripts/ci/restart-doorway-epr.sh
            // (extracted 2026-06-10: CPS method-size hard limit — the pod-delete
            // + public-boundary rollout-wait heredoc was ~6KB of this method).
            // Bounded on ACTIVITY, not wall clock: the script itself caps its
            // rollout wait at 6 min (72 x 5 s polls) and prints a line per poll,
            // so a silent gap here is never the script — it is the controller
            // losing the agent (genesis #1511, 2026-08-28: a Jenkins controller
            // restart during this wait left the step idle for 41 min and the
            // outer 90-min pipeline timeout consumed the whole run). Fail THIS
            // step in minutes, UNSTABLE via the enclosing catchError, so the
            // E2E verification that follows still runs.
            timeout(time: 8, unit: 'MINUTES', activity: true) {
                sh "bash '${env.WORKSPACE}/genesis/scripts/ci/restart-doorway-epr.sh' '${namespace}' '${deployment}' '${doorwayHost}'"
            }
        } else {
            echo "Skipping doorway pod restart — unrecognized doorwayHost: ${doorwayHost}"
        }
    }
}

/**
 * One substrate-validation step: run a substrate-verify.sh subcommand
 * (UNSTABLE on assertion failure) and archive its JSON report. Top-level
 * def = its own CPS method (64KB pipeline-block relief).
 */
def substrateVerifyStage(String sub) {
    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
        // Facade runner (2026-08-15): substrate-verify migrated from bash+curl+jq
        // to the typed .dataplane() facade (@elohim/storage-client) — the
        // dataplane-sdk habit's probe. Report shape/exit codes are parity with
        // the bash predecessor plus an additive runner:"facade" field.
        // REPORT_DIR is absolute because the runner's cwd is genesis/a2o, while
        // archiveArtifacts patterns below stay workspace-relative.
        dir('genesis/a2o') {
            sh "REPORT_DIR='${env.WORKSPACE}' CONTENT_PATH='${env.WORKSPACE}/genesis/docs/content/elohim-protocol/manifesto.md' pnpm exec tsx scripts/substrate-verify.ts '${sub}'"
        }
    }
    archiveArtifacts(artifacts: "substrate-verify-${sub}.json", allowEmptyArchive: true, fingerprint: true)
}

/**
 * Upload Blob-Backed Content body: stage the content blob + the
 * build-unique propagation probe blob via doorway, then export the hashes
 * for the custody/propagation/delivery stages downstream.
 */
/**
 * Mint a doorway bearer JWT for the jenkins-ci seed actor (jenkins-seed-bearer-gate
 * plan, Task 3). The substrate upload stage PUTs to /admin/seed/blob, which the
 * non-dev doorway bearer-gates (Task 1).
 *
 * Self-provisioning, NO new Jenkins credential: doorway-seed-ensure.sh reuses the
 * EXISTING `doorway-admin-bootstrap-key` (= doorway API_KEY_ADMIN, the same credential
 * the seed-admin stages already bind) to register-on-first-run + log in the seed actor,
 * deriving its password from the admin key (no second stored secret). ADMIN_KEY reaches
 * the script via withEnv — never argv (Jenkinsfile heredoc/secret discipline). Returns ''
 * when the credential is not visible (dev/unconfigured) so the upload runs unauthenticated;
 * a non-dev doorway then 401s loudly downstream.
 */
def resolveSeedDoorwayToken() {
    def token = ''
    def loginUrl = "http://${env.INTERNAL_DOORWAY_URL}"
    try {
        withCredentials([string(credentialsId: 'doorway-admin-bootstrap-key', variable: 'ADMIN_KEY')]) {
            withEnv(["DOORWAY_URL=${loginUrl}"]) {
                def status = sh(script: "bash '${env.WORKSPACE}/genesis/scripts/ci/doorway-seed-ensure.sh' > /tmp/seed-token.out", returnStatus: true)
                if (status == 0) {
                    // `sh` above ran INSIDE the build container, so /tmp/seed-token.out
                    // lives in that container's filesystem; `readFile` runs in the jnlp
                    // agent container and threw NoSuchFile — which the catch below then
                    // reported as "credential not visible" (genesis #1502/#1503: the
                    // upload ran unauthenticated every build and only passed while the
                    // doorway's dev_mode seed gate accepted anonymous callers). Read it
                    // back through `sh` like the blob-hash exports below do.
                    token = sh(script: 'cat /tmp/seed-token.out', returnStdout: true).trim()
                } else {
                    echo "doorway-seed-ensure failed (admin key present but register/login rejected or doorway unreachable — see stderr) — upload runs unauthenticated (dev-mode accepts; non-dev alpha 401s)"
                }
            }
        }
    } catch (e) {
        // Name the exception: a missing credential and a failed token read-back
        // must not share one message (that is how the readFile bug hid).
        echo "doorway-admin-bootstrap-key credential not visible or token read-back failed (${e}) — substrate upload runs unauthenticated (non-dev / loopback-gated doorway will 401/403)"
    }
    return token
}

def uploadBlobContentStage() {
    def seedToken = resolveSeedDoorwayToken()
    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
        withEnv(["SEED_DOORWAY_TOKEN=${seedToken}"]) {
            dir('genesis/a2o') {
                sh "REPORT_DIR='${env.WORKSPACE}' CONTENT_PATH='${env.WORKSPACE}/genesis/docs/content/elohim-protocol/manifesto.md' pnpm exec tsx scripts/substrate-verify.ts upload"
            }
        }
        env.CONTENT_BLOB_HASH = sh(script: 'cat /tmp/substrate-verify/content_blob_hash', returnStdout: true).trim()
        env.CONTENT_BLOB_SIZE_BYTES = sh(script: 'cat /tmp/substrate-verify/content_blob_size', returnStdout: true).trim()
        env.PROBE_BLOB_HASH = sh(script: 'cat /tmp/substrate-verify/probe_blob_hash', returnStdout: true).trim()
        env.SUBSTRATE_BUILD_START_ISO = sh(script: 'cat /tmp/substrate-verify/build_start_iso', returnStdout: true).trim()
        echo "Exported: CONTENT_BLOB_HASH=${env.CONTENT_BLOB_HASH} (${env.CONTENT_BLOB_SIZE_BYTES} bytes), PROBE_BLOB_HASH=${env.PROBE_BLOB_HASH}"
    }
    archiveArtifacts(artifacts: 'substrate-verify-upload.json', allowEmptyArchive: true, fingerprint: true)
}

pipeline {
    agent {
        kubernetes {
            cloud 'kubernetes'
            yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccount: ee-jenkins
  nodeSelector:
    node-type: edge
  containers:
  - name: builder
    image: harbor.ethosengine.com/ethosengine/ci-builder:latest
    # Always: :latest is a moving tag — a cached node can silently serve a stale
    # toolchain (#1218 shape). Freshness > outage-resilience (operator, 2026-06-07).
    imagePullPolicy: Always
    command:
    - cat
    tty: true
    resources:
      requests:
        ephemeral-storage: "2Gi"
        memory: "2Gi"
      limits:
        ephemeral-storage: "5Gi"
        memory: "4Gi"
  - name: playwright
    image: harbor.ethosengine.com/ethosengine/ci-playwright:latest
    imagePullPolicy: Always
    command:
    - cat
    tty: true
    resources:
      requests:
        ephemeral-storage: "2Gi"
        memory: "2Gi"
      limits:
        ephemeral-storage: "5Gi"
        memory: "4Gi"
'''
        }
    }

    parameters {
        string(
            name: 'TARGET_HOST',
            defaultValue: '',
            description: 'Target host URL (auto-detected from branch if empty)'
        )
        booleanParam(
            name: 'SEED_DATA',
            defaultValue: true,
            description: 'Seed the database with content from genesis/data/lamad'
        )
        string(
            name: 'SEED_IDS',
            defaultValue: '',
            description: 'Specific content IDs to seed (comma-separated). Empty = all content'
        )
        booleanParam(
            name: 'RESET_STORAGE',
            defaultValue: false,
            description: 'Reset storage databases before seeding (deletes content.db and restarts pods to run fresh migrations)'
        )
        string(name: 'STEPS', defaultValue: 'all', description: 'Comma-separated build steps to run. "all" runs everything.')
        booleanParam(
            name: 'DEPLOY_ONLY',
            defaultValue: false,
            description: 'No-op for this pipeline (genesis runs as a normal seed when triggered). Accepted so the orchestrator can propagate the flag uniformly. Operator can set SKIP_GENESIS on the orchestrator to skip seeding entirely on a deploy-only run.'
        )
    }

    environment {
        NO_COLOR = '1'
        NPM_TOKEN = credentials('ee-nexus-npm-token')
    }

    options {
        skipDefaultCheckout(true)
        timeout(time: 90, unit: 'MINUTES')  // topology seeds + substrate-validation suite + E2E (~25-35 min on settled pods); 90 absorbs a deploy-fronted wave — when edge deploys immediately before genesis (orchestrator Level 1→2), the alpha rollout + readiness waits ate ~half the old 60-min budget and #1121 ABORTED mid-Seed-Database
        buildDiscarder(logRotator(numToKeepStr: '20'))
        overrideIndexTriggers(false)  // Only orchestrator or manual triggers - no webhook/branch indexing
    }

    // No triggers - orchestrator handles triggering genesis after all builds complete
    // triggers { }

    stages {
        stage('Check Trigger') {
            steps {
                script {
                    def validTrigger = currentBuild.getBuildCauses().any { cause ->
                        cause._class.contains('UpstreamCause') || cause._class.contains('UserIdCause')
                    }
                    if (!validTrigger) {
                        echo "⏭️ PIPELINE SKIPPED - Use orchestrator or manual trigger"
                        currentBuild.result = 'NOT_BUILT'
                        currentBuild.displayName = "#${env.BUILD_NUMBER} SKIPPED"
                        env.PIPELINE_SKIPPED = 'true'
                    } else {
                        echo "✅ Valid trigger: ${currentBuild.getBuildCauses()*.shortDescription.join(', ')}"
                    }
                }
            }
        }

        stage('Checkout') {
            when { expression { env.PIPELINE_SKIPPED != 'true' } }
            steps {
                container('builder') {
                    script {
                        sh 'git config --global --add safe.directory "*"'

                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: "*/${env.BRANCH_NAME ?: 'dev'}"]],
                            extensions: [
                                [$class: 'CloneOption', shallow: true, noTags: true, depth: 1],
                                [$class: 'CleanBeforeCheckout']
                            ],
                            userRemoteConfigs: [[
                                url: 'https://github.com/ethosengine/elohim.git',
                                credentialsId: 'ee-bot-pat'
                            ]]
                        ])

                        // Enable pnpm via corepack (uses packageManager field in root package.json)
                        sh 'corepack enable'
                        sh 'pnpm --version'

                        echo """
═══════════════════════════════════════════════════════════
🌱 GENESIS PIPELINE
═══════════════════════════════════════════════════════════
Branch: ${env.BRANCH_NAME ?: 'dev'}
Seed Data: ${params.SEED_DATA}
Seed IDs: ${params.SEED_IDS ?: '(all)'}
═══════════════════════════════════════════════════════════
                        """

                        // Bootstrap canonical artifact filenames from the
                        // shared manifest (single source of truth across
                        // Groovy + TypeScript + JS). Downstream stages and
                        // the seeder TS scripts both read from the same
                        // build-artifacts.json so a rename propagates to
                        // every consumer automatically.
                        if (!fileExists('genesis/orchestrator/build-artifacts.json')) {
                            error 'genesis/orchestrator/build-artifacts.json missing — cannot bootstrap artifact names'
                        }
                        def artifactNames = readJSON(file: 'genesis/orchestrator/build-artifacts.json')
                        env.CONDUCTOR_READINESS_FILE = artifactNames.genesis.conductorReadiness
                        env.SEED_RESULTS_CONDUCTOR_IDENTITIES_FILE = artifactNames.genesis.seedResultsConductorIdentities
                        env.SEED_RESULTS_AGENT_BINDINGS_FILE = artifactNames.genesis.seedResultsAgentBindings
                        env.SEED_RESULTS_HOUSEHOLD_FORMATION_FILE = artifactNames.genesis.seedResultsHouseholdFormation
                    }
                }
            }
        }

        stage('Resolve Hosts') {
            when { expression { env.PIPELINE_SKIPPED != 'true' } }
            steps {
                container('builder') {
                    script {
                        // Auto-detect target host based on branch if not specified
                        def targetHost = params.TARGET_HOST
                        if (!targetHost) {
                            if (env.BRANCH_NAME == 'main') {
                                targetHost = 'https://elohim.host'
                            } else if (env.BRANCH_NAME == 'staging' || env.BRANCH_NAME ==~ /staging-.+/) {
                                targetHost = 'https://staging.elohim.host'
                            } else {
                                // dev, feat-*, claude/* branches → alpha
                                targetHost = 'https://alpha.elohim.host'
                            }
                            echo "Auto-detected target host from branch '${env.BRANCH_NAME}': ${targetHost}"
                        }

                        env.TARGET_HOST = targetHost
                        def doorwayHost = resolveDoorwayHost(targetHost, '')
                        def internalDoorway = resolveInternalDoorwayUrl(doorwayHost)

                        env.RESOLVED_DOORWAY_HOST = doorwayHost
                        env.INTERNAL_DOORWAY_URL = internalDoorway
                        env.INTERNAL_STORAGE_URL = resolveInternalStorageUrl(doorwayHost)

                        echo "✅ Target host: ${targetHost}"
                        echo "✅ Doorway API (external): ${doorwayHost}"
                        echo "✅ Doorway API (internal): ${internalDoorway}"
                        echo "✅ Storage API (internal): ${env.INTERNAL_STORAGE_URL}"
                    }
                }
            }
        }

        stage('Probe Substrate') {
            // Single substrate probe → env.ELOHIM_REMOTE_COMPUTE_STATUS. Every downstream
            // stage (Reset Storage, Seed Database, Verify Seeding, E2E) and the
            // a2o test bench reconcile their scope to this one signal. Re-running
            // the pipeline re-probes and restabilizes to the confirmed available
            // compute — the CI-layer expression of the protocol's reconciliation
            // principle. The remote pool flapping on/off is a steady state, not a
            // failure: when it's down we run TOLERANT (seed/test whoever is ready)
            // but LOUD (UNSTABLE + an explicit reduced-scope banner), honoring the
            // "Pending if shem is down is intentional fail-loud" directive in
            // genesis/orchestrator/data/deployments.json.
            when { expression { env.PIPELINE_SKIPPED != 'true' } }
            steps {
                container('builder') {
                    script { probeSubstrateScope() }
                }
            }
        }

        stage('Reset Storage') {
            // When to use RESET_STORAGE=true:
            //   "database is locked" errors in the Seed Database stage almost always
            //   indicate schema drift between a persisted DB and the current code's
            //   expectations — NOT SQLite concurrency. Signals: errors clustered in
            //   a single content namespace that SHIFTS between builds (e.g. all 100
            //   errors in preteen-* on build N, caregiver-* on build N+1), high
            //   "skipped" count (prior-run residue), or one batch reporting 0 inserted
            //   while neighbors succeed. SQLite pragmas already include journal_mode=WAL
            //   + busy_timeout=30000 (elohim/elohim-storage/src/db/mod.rs), so adding
            //   more pragma/retry logic is the wrong path. Set RESET_STORAGE=true to
            //   clear content.db and re-run migrations cleanly. Investigate real
            //   concurrency (uniform/random errors, not namespace-clustered) only after
            //   a clean run still reproduces.
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.RESET_STORAGE }
            }}
            steps {
                container('builder') {
                    script {
                        def humans = getHumanStorageUrls('alpha')

                        echo """
═══════════════════════════════════════════════════════════
🗑️  RESETTING STORAGE DATABASES
═══════════════════════════════════════════════════════════
"""
                        for (human in humans) {
                            sh "bash '${env.WORKSPACE}/genesis/scripts/ci/reset-storage-pod.sh' '${human.service}' '${human.namespace}' '${human.humanId}'"
                        }

                        // Wait for pods to begin restarting
                        sh '''#!/bin/bash
                            echo ""
                            echo "Waiting for pods to restart..."
                            sleep 30
                        '''

                        // Wait for each pod to come back Ready, but tolerate a
                        // peer whose hardware is gone (reconcile to available
                        // compute) — a down pod restarts when it returns; don't
                        // hang 600s then cascade-fail the whole reset.
                        def resetUnreachable = []
                        for (human in humans) {
                            def rc = sh(returnStatus: true, script: """#!/bin/bash
                                set -uo pipefail
                                echo "Waiting for ${human.service}..."
                                if kubectl wait --for=condition=Ready pod/${human.service}-0 -n ${human.namespace} --timeout=600s 2>/dev/null; then
                                    echo "   ✅ ${human.service} ready (600s: embedded-HC cold start, see #1055)"
                                    exit 0
                                fi
                                echo "   ⏭️  ${human.service} not Ready within 600s — skipping (reconcile to available compute)"
                                exit 1
                            """)
                            if (rc != 0) { resetUnreachable << human.humanId }
                        }
                        if (!resetUnreachable.isEmpty()) {
                            unstable("Reset Storage: pods not Ready (restart when reachable): ${resetUnreachable.join(', ')}")
                        }

                        echo """
═══════════════════════════════════════════════════════════
✅ STORAGE DATABASES RESET (reachable peers)
═══════════════════════════════════════════════════════════
"""
                    }
                }
            }
        }

        stage('Install Seeder') {
            when { allOf { expression { env.PIPELINE_SKIPPED != 'true' }; expression { params.SEED_DATA } } }
            steps {
                container('builder') {
                    dir('genesis/seeder') {
                        sh '''
                            echo "Installing seeder dependencies..."
                            pnpm install --frozen-lockfile
                            echo "✅ Seeder ready"
                        '''
                    }
                }
            }
        }

        stage('Generate Schema Types') {
            when { allOf { expression { env.PIPELINE_SKIPPED != 'true' }; expression { params.SEED_DATA } } }
            steps {
                container('builder') {
                    sh "bash '${env.WORKSPACE}/genesis/scripts/ci/generate-schema-types.sh'"
                }
            }
        }

        stage('Validate Constants') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
                expression { shouldRunStep('validate-seeds') }
            }}
            steps {
                container('builder') {
                    sh '''#!/bin/bash
                        set -euo pipefail

                        echo "Validating humanId references against humans.json..."
                        python3 genesis/scripts/validate-human-ids.py

                        echo "✅ HumanId validation passed"
                    '''
                    // TODO: Enable manifest codegen verification once app manifest is stable
                    // sh '''#!/bin/bash
                    //     set -euo pipefail
                    //     echo "Verifying manifest codegen is up to date..."
                    //     pnpm -w run manifest:codegen:verify
                    //     echo "✅ Manifest codegen verified"
                    // '''
                    dir('genesis/seeder') {
                        sh "bash '${env.WORKSPACE}/genesis/scripts/ci/typecheck-seeder.sh'"
                    }
                }
            }
        }

        stage('Verify Target Health') {
            when { expression { env.PIPELINE_SKIPPED != 'true' } }
            steps {
                container('builder') {
                    script {
                        // Ensure jq is available for JSON parsing
                        sh '''
                            command -v jq >/dev/null 2>&1 || {
                                echo "Installing jq..."
                                apt-get update -qq && apt-get install -y -qq jq 2>/dev/null || apk add --no-cache jq
                            }
                        '''

                        // Gate on the DOORWAY's liveness (/health), not on the site root: on a
                        // freshly genesised fleet `/` is 503 until the landing content this very
                        // pipeline seeds exists (genesis #1551, 2026-09-04, after the 0.7 wipe —
                        // "Waiting for target site..." ×24, seed stages skipped). The root check
                        // was a chicken-and-egg gate; the doorway answering /health 200 is the
                        // precondition seeding actually needs.
                        def targetHost = env.TARGET_HOST
                        def doorwayHost = env.RESOLVED_DOORWAY_HOST
                        def internalDoorway = env.INTERNAL_DOORWAY_URL

                        echo "Verifying target site: ${targetHost}"
                        sh """
                            timeout 120s bash -c 'until curl -sf -o /dev/null "${targetHost}/health"; do
                                echo "Waiting for target site..."
                                sleep 5
                            done'
                            echo "✅ Target site responding: ${targetHost}"
                        """

                        // Use /status endpoint for comprehensive preflight checks
                        // This includes: conductor connectivity, storage health, cell discovery
                        echo "Verifying Doorway readiness (internal): ${internalDoorway}"
                        sh "bash '${env.WORKSPACE}/genesis/scripts/ci/verify-doorway-readiness.sh' '${internalDoorway}' '${doorwayHost}' '${env.INTERNAL_STORAGE_URL}'"
                    }
                }
            }
        }

        stage('Seed Database') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
                expression { shouldRunStep('seed-content') }
            }}
            steps {
                container('builder') {
                    script { runContentSeedStage() }
                }
            }
        }

        stage('Verify Seeding') {
            when { allOf { expression { env.PIPELINE_SKIPPED != 'true' }; expression { params.SEED_DATA } } }
            steps {
                container('builder') {
                    script { runVerifySeedingStage() }
                }
            }
        }

        // Seed Substrate — merged from the adjacent same-when{} (none) "Seed *"
        // stages Humans · Presences · Collectives · Accounts · Conductor
        // Identities (incl. folded Content Provide Rows) · Agent Peer Bindings ·
        // Household Formation, folded into one declarative stage to keep the
        // stage-model CPS method under the 64KB JVM limit (31→23 stages). Each
        // original stage's container('builder'){ script{ } } body is preserved
        // VERBATIM as a sequential step, same order, same scope. Behavior is
        // identical — only the stage-boundary count drops. (Seed dependency
        // order: humans→presences→collectives→accounts→conductor identities→
        // agent bindings→household formation — NEVER reorder.)
        stage('Seed Substrate') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
            }}
            steps {
                container('builder') {
                    script {
                        def doorwayHost = env.RESOLVED_DOORWAY_HOST
                        def adminKey = ''
                        try {
                            withCredentials([string(credentialsId: 'doorway-admin-bootstrap-key', variable: 'ADMIN_KEY')]) {
                                adminKey = env.ADMIN_KEY
                            }
                        } catch (e) {
                            echo "doorway-admin-bootstrap-key credential not found — seeding without admin promotion"
                        }
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            dir('genesis/seeder') {
                                withEnv(["API_KEY_ADMIN=${adminKey}"]) {
                                    sh "bash '${env.WORKSPACE}/genesis/scripts/ci/seed-humans.sh' '${doorwayHost}'"
                                }
                            }
                        }
                    }
                }
                container('builder') {
                    script {
                        def doorwayHost = env.RESOLVED_DOORWAY_HOST
                        def adminKey = ''
                        try {
                            withCredentials([string(credentialsId: 'doorway-admin-bootstrap-key', variable: 'ADMIN_KEY')]) {
                                adminKey = env.ADMIN_KEY
                            }
                        } catch (e) {
                            echo "doorway-admin-bootstrap-key credential not found — seeding without admin promotion"
                        }
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            dir('genesis/seeder') {
                                withEnv(["API_KEY_ADMIN=${adminKey}"]) {
                                    sh "bash '${env.WORKSPACE}/genesis/scripts/ci/seed-presences.sh' '${doorwayHost}'"
                                }
                            }
                        }
                    }
                }
                container('builder') {
                    script {
                        def doorwayHost = env.RESOLVED_DOORWAY_HOST
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            dir('genesis/seeder') {
                                sh "bash '${env.WORKSPACE}/genesis/scripts/ci/seed-collectives.sh' '${doorwayHost}'"
                            }
                        }
                    }
                }
                container('builder') {
                    script {
                        def doorwayHost = env.RESOLVED_DOORWAY_HOST
                        // SEEDER_TARGET_PEERS: comma-separated storage URLs for active
                        // compute peers (storage that is online and can receive imports).
                        //
                        // The package set being imported is the PRESENCE set — every human
                        // in deployments.json regardless of suspended flag, so suspended
                        // contributors retain their ContributorPresence on the network.
                        // The TARGET set is the COMPUTE set — only non-suspended humans'
                        // storage URLs, derived from topology.json (already filtered by the
                        // edge pipeline's `findAll { !it.suspended }`).
                        //
                        // Suspended humans (e.g. adam/pete/frank during shem outage) appear
                        // as authored sources in imported packages — never as POST targets.
                        // Contract: docs/superpowers/specs/2026-05-04-compute-commitment-substrate-floor-design.md.
                        //
                        // Override via env.SEEDER_TARGET_PEERS to force a specific target list
                        // (e.g. for staged rollouts or a single-peer dev seed).
                        def targetPeers
                        if ((env.SEEDER_TARGET_PEERS ?: '').trim()) {
                            targetPeers = env.SEEDER_TARGET_PEERS.trim()
                        } else {
                            def humans = getHumanStorageUrls('alpha')
                            // getHumanStorageUrls reads topology.json which is already filtered
                            // to non-suspended humans by the edge pipeline. Each storage URL is
                            // an active compute peer that can receive /account/import POSTs.
                            def computeUrls = humans.collect { "http://${it.storageUrl}" }
                            targetPeers = computeUrls.join(',')
                        }
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            dir('genesis/seeder') {
                                sh "bash '${env.WORKSPACE}/genesis/scripts/ci/seed-accounts.sh' '${doorwayHost}' '${targetPeers}'"
                            }
                        }
                    }
                }
                container('builder') {
                    script {
                        def res = runProbedSeeder(
                            'Seed Conductor Identities',
                            'seed-conductor-identities.ts',
                            env.SEED_RESULTS_CONDUCTOR_IDENTITIES_FILE ?: 'seed-results-conductor-identities.json',
                        )
                        // Gates Verify Resilience Signals: peer-status projections
                        // only fill once conductor seeding actually runs. The
                        // jenkins→conductor netpol (pod ports 8444/8445) was
                        // applied 2026-06-10, so 'false' now means the conductor
                        // seeder genuinely skipped/failed -- not a blocked socket.
                        // (backlog ci-genesis-conductor-adminws-unreachable;
                        // retirement TODO: see getConductorAppUrls() +
                        // backlog security-ci-substrate-authorization-grant-coherence).
                        env.CONDUCTOR_SEEDING_READY = res.skipped ? 'false' : 'true'
                        if (res.skipped) return
                        def c = res.seedReport?.counts ?: [:]
                        if (res.exitCode == 2) {
                            unstable("Seed Conductor Identities partial: ${c.succeeded ?: 0} succeeded (${c.created ?: 0} created + ${c.exists ?: 0} exists), ${c.failed ?: 0} failed (see ${res.seedResultsName})")
                        } else if (res.exitCode == 1) {
                            unstable("Seed Conductor Identities total failure: 0 of ${c.total ?: 0} humans seeded (see ${res.seedResultsName})")
                        } else if (res.exitCode != 0) {
                            unstable("Seed Conductor Identities exited ${res.exitCode} (unexpected — see console)")
                        }
                        // Seed Content Provide Rows — folded in from its own stage to
                        // keep the declarative model under the 64KB CPS method limit
                        // (32→31 stages). Reached only when conductor seeding did NOT
                        // skip (res.skipped returns early above) — i.e. exactly the
                        // CONDUCTOR_SEEDING_READY=='true' gate the old stage carried.
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            sh "bash '${env.WORKSPACE}/genesis/scripts/ci/seed-provide-rows.sh'"
                        }
                    }
                }
                container('builder') {
                    script {
                        def res = runProbedSeeder(
                            'Seed Agent Peer Bindings',
                            'seed-agent-bindings.ts',
                            env.SEED_RESULTS_AGENT_BINDINGS_FILE ?: 'seed-results-agent-bindings.json',
                        )
                        if (res.skipped) return
                        def c = res.seedReport?.counts ?: [:]
                        if (res.exitCode == 2) {
                            unstable("Seed Agent Peer Bindings partial: ${c.succeeded ?: 0} humans succeeded (${c.totalCreated ?: 0} bindings written), ${c.failed ?: 0} failed (see ${res.seedResultsName})")
                        } else if (res.exitCode == 1) {
                            unstable("Seed Agent Peer Bindings total failure: 0 of ${c.total ?: 0} humans seeded (see ${res.seedResultsName})")
                        } else if (res.exitCode != 0) {
                            unstable("Seed Agent Peer Bindings exited ${res.exitCode} (unexpected — see console)")
                        }
                    }
                }
                container('builder') {
                    script {
                        // Ceremony driver (rung 3): collective + affirmations + stewardship
                        // grant run BEFORE the blob upload; the custody layer inside the
                        // script self-skips when CONTENT_BLOB_HASH is absent, and the
                        // Seed Custody Commitments stage remains the custody anti-drift flag.
                        // The script probes the storage projection to REUSE the existing
                        // collective cid, so re-runs converge (no new collective per run).
                        // STORAGE_URL exported here (not in runProbedSeeder) so the
                        // probe-convergence path in seed-household-formation.ts can reach
                        // /db/collectives/family-dowell on the in-cluster storage node.
                        // INTERNAL_STORAGE_URL is scheme-less (host:port); prefix http://.
                        // RESOLVED_DOORWAY_HOST already carries https:// — assign verbatim
                        // as DOORWAY_URL fallback so the seeder never sees http://https://…
                        if (env.INTERNAL_STORAGE_URL) {
                            env.STORAGE_URL = "http://${env.INTERNAL_STORAGE_URL}"
                        } else if (env.RESOLVED_DOORWAY_HOST) {
                            env.DOORWAY_URL = env.RESOLVED_DOORWAY_HOST
                        }
                        def res = runProbedSeeder('Seed Household Formation', 'seed-household-formation.ts',
                            env.SEED_RESULTS_HOUSEHOLD_FORMATION_FILE ?: 'seed-results-household-formation.json')
                        if (res.skipped) return
                        if (res.exitCode == 2) { unstable("Household formation partial: affirmed=${res.seedReport?.affirmed}") }
                        else if (res.exitCode != 0) { unstable("Household formation exited ${res.exitCode}") }
                    }
                }
            }
        }

        stage('Verify Peer Mesh') {
            // Substrate-validation suite (formerly the "M1" stages — every
            // assertion lives in genesis/scripts/ci/substrate-verify.sh).
            // The mesh is the precondition for everything downstream:
            // per-pod libp2p peer counts, source↔target adjacency (the
            // cross-pod fetch races CONNECTED peers), binary-version parity
            // (partial-rollout = DHT-partition risk class).
            steps {
                container('builder') {
                    script {
                        // Downstream coupling: propagation/delivery/projection/
                        // resilience subcommands also read PEER_STORAGE_URLS —
                        // safe because they share this stage's when{} gates
                        // (PIPELINE_SKIPPED + SEED_DATA); revisit if those ever
                        // diverge.
                        env.PEER_STORAGE_URLS = peerStorageUrlsCsv()
                        // Runner deps + storage-client build — outside the
                        // catchError in substrateVerifyStage on purpose: an
                        // install failure is a pipeline red, not an UNSTABLE
                        // substrate verdict.
                        sh "bash '${env.WORKSPACE}/genesis/scripts/ci/install-substrate-runner.sh'"
                        substrateVerifyStage('mesh')
                    }
                }
            }
        }

        stage('Upload Blob-Backed Content') {
            // Stages the manifesto blob AND a build-unique propagation probe
            // blob onto the genesis peer via doorway /admin/seed/blob. The
            // probe blob's hash never existed before this build, so Verify
            // Substrate Propagation can only pass via live cross-pod
            // replication (genesis #1100/#1110 "passed" on a fossil replica
            // of the previous manifesto hash — never again).
            steps {
                container('builder') {
                    script { uploadBlobContentStage() }
                }
            }
        }

        stage('Seed Custody Commitments') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
                expression { env.CONTENT_BLOB_HASH != null && env.CONTENT_BLOB_HASH != '' }
            }}
            steps {
                container('builder') {
                    script {
                        def doorwayHost = env.RESOLVED_DOORWAY_HOST
                        def blobHash = env.CONTENT_BLOB_HASH
                        def blobSize = env.CONTENT_BLOB_SIZE_BYTES ?: '0'
                        // Gate custody seeding on the projector being caught up (not
                        // just healthy): the Upload-Blob + earlier seed waves backlog
                        // the projector, so custody PATCH state=active was hitting
                        // 503 catching-up BEFORE the existing REA-stage gate below
                        // (genesis #1191 Cluster B). SOFT — warns and proceeds.
                        sh "bash '${env.WORKSPACE}/genesis/scripts/ci/wait-storage-ready.sh' '${doorwayHost}'"
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            dir('genesis/seeder') {
                                sh "bash '${env.WORKSPACE}/genesis/scripts/ci/seed-custody-commitments.sh' '${doorwayHost}' '${blobHash}' '${blobSize}'"
                            }
                        }
                    }
                }
            }
        }

        // Seed REA Commitments — merged from the adjacent same-when{} (none)
        // "Seed *" stages Operator Bindings · Stewardship Allocations ·
        // Projections, folded into one declarative stage (CPS method-size
        // relief, 31→23). Each body preserved VERBATIM as a sequential step,
        // same order. Behavior is identical — only the stage boundary drops.
        stage('Seed REA Commitments') {
            // Registers Matthew as primary operator of both alpha-cluster
            // doorways via REA operate-doorway commitments. Same human, two
            // doorway IDs (alpha-elohim-host + apex-elohim-host) — the
            // doorways differ in surface URL but share an operator.
            //
            // Per genesis/docs/plans/2026-05-19-doorway-stewardship-chain-design.md
            // and elohim/sdk/schemas/v1/objects/operator-classification.schema.json.
            // Schema v1 (omits custody/steward refs); v2 requires the full
            // attestation chain — graduate when bootstrap attestations land.
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
            }}
            steps {
                container('builder') {
                    script {
                        def doorwayHost = env.RESOLVED_DOORWAY_HOST
                        // Pre-seed readiness RE-gate (genesis #1182 Cluster A): the target
                        // re-enters `catching-up` after the blob-upload/custody projector
                        // backlog, so these LATE seeds 503 past the client retry budget.
                        // Wait for caughtUp + projection.writer first. Soft (never aborts);
                        // bash in scripts/ci to stay under the Jenkinsfile CPS method limit.
                        sh "bash '${env.WORKSPACE}/genesis/scripts/ci/wait-storage-ready.sh' '${doorwayHost}'"
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            dir('genesis/seeder') {
                                sh "bash '${env.WORKSPACE}/genesis/scripts/ci/seed-operator-bindings.sh' '${doorwayHost}'"
                            }
                        }
                    }
                }
                // Affinity-based content→steward allocations. Body in
                // seedStewardshipStage() helper (64KB CPS limit). The seeder
                // existed but was never wired — six a2o stewardship scenarios
                // asserted on data no stage produced (genesis #1079).
                container('builder') {
                    script { seedStewardshipStage() }
                }
                // Mints the elohim-host-landing EPR atom family (schema ·
                // governance state · stewardship claim · custody claim ·
                // landing) so the landing atom's governance leg and claims
                // resolve to atoms that actually exist. Must precede Seed
                // Projections — the projection commitments address this EPR by
                // slug. Body in seedEprAtomsStage() (64KB CPS limit).
                container('builder') {
                    script { seedEprAtomsStage() }
                }
                // Seeds the EPR-projection REA commitments. Body extracted
                // to seedProjectionsStage() helper above pipeline {} to stay
                // under the 64KB CPS method-size limit. See helper for the
                // full rationale.
                container('builder') {
                    script { seedProjectionsStage() }
                }
            }
        }

        stage('Verify Substrate Propagation') {
            // Formerly "Trigger M1 Cross-Pod Fetch". Proves the p2p data
            // plane moved bytes THIS build: custody manifest present on the
            // source (matthew), build-unique probe blob served by the target
            // (jessica, non-genesis on-prem device — never ingests during
            // seeding), polled because heal-on-read + the 120s custody-sweep
            // tick need real time, and bytes persisted on disk
            // (inventory-parity filesystem delta). GET, never HEAD
            // (memory feedback_head_vs_get_blob_asymmetry).
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
                expression { env.CONTENT_BLOB_HASH != null && env.CONTENT_BLOB_HASH != '' }
            }}
            steps {
                container('builder') {
                    script { substrateVerifyStage('propagation') }
                }
            }
        }

        stage('Verify Delivery Events') {
            // serve-blob REA EconomicEvents are written in the SAME
            // transaction as a successful peer blob fetch (blob_fetch's
            // atomic pair) — zero events for this build means either no
            // transfer happened (see propagation) or the delivery-event
            // leg regressed.
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
                expression { env.PROBE_BLOB_HASH != null && env.PROBE_BLOB_HASH != '' }
            }}
            steps {
                container('builder') {
                    script { substrateVerifyStage('delivery') }
                }
            }
        }

        stage('Warm Projection Cache') {
            steps {
                container('builder') {
                    script {
                        def doorwayHost = env.RESOLVED_DOORWAY_HOST
                        sh "bash '${env.WORKSPACE}/genesis/scripts/ci/warm-projection-cache.sh' '${doorwayHost}'"
                    }
                }
            }
        }

        stage('Verify Projection Sync') {
            // Projector cursor lag per pod + replication/pull/
            // projection-reconcile stream caught-up flags from /p2p/status.
            // null streams are "not computable" — warned, never treated as
            // caught up (spec §4.3 in P2PStatusInfo docs).
            steps {
                container('builder') {
                    script { substrateVerifyStage('projection') }
                }
            }
        }

        stage('Verify Federation Layer') {
            // Doorway federation membership + the p2p bootstrap surface.
            // Cross-doorway breadth is shem-dependent and reported, not
            // asserted (a2o @requires:shem vocabulary).
            steps {
                container('builder') {
                    script { substrateVerifyStage('federation') }
                }
            }
        }

        stage('Verify Resilience Signals') {
            // peer-statuses + network posture are written ONLY by
            // conductor-originated PeerStatusRecorded signals — before
            // conductor seeding runs they are empty BY DESIGN, so this stage
            // gates on CONDUCTOR_SEEDING_READY (set by Seed Conductor
            // Identities) instead of false-failing. The jenkins→conductor
            // netpol (pod ports 8444/8445) was applied 2026-06-10, so this
            // canary should now light up; if it stays dark, re-check the
            // elohim-alpha default-deny-cross-env netpol AND its ipBlock VXLAN-
            // tunnel rule (backlog ci-genesis-conductor-adminws-unreachable).
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
                expression { env.CONDUCTOR_SEEDING_READY == 'true' }
            }}
            steps {
                container('builder') {
                    script { substrateVerifyStage('resilience') }
                }
            }
        }

        stage('E2E Verification') {
            when { expression { env.PIPELINE_SKIPPED != 'true' } }
            steps {
                container('builder') {
                    script {
                        def doorwayHost = env.RESOLVED_DOORWAY_HOST

                        // Same dev admin key as the doorway pod's Secret (see helper).
                        def e2eAdminKey = resolveE2eAdminKey()

                        // Live household-mesh fixture legs (second doorway,
                        // named storage peers, the doorway's storage pool).
                        def meshEnv = householdMeshEnv(doorwayHost)

                        // Install E2E driver dependencies
                        dir('genesis/a2o') {
                            sh 'pnpm install --frozen-lockfile 2>/dev/null || pnpm install'
                        }

                        // Always run API-level tests (@e2e tag, fast, no browser)
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            dir('genesis/a2o') {
                                withEnv(["E2E_ADMIN_BOOTSTRAP_KEY=${e2eAdminKey}"] + meshEnv) {
                                sh "bash '${env.WORKSPACE}/genesis/scripts/ci/e2e-verify-api.sh' '${doorwayHost}' '${env.INTERNAL_STORAGE_URL}' '${env.ELOHIM_REMOTE_COMPUTE_STATUS ?: 'unknown'}'"
                                }
                            }
                        }

                        // Browser-mode tests (Playwright). Runs in the dedicated
                        // ci-playwright sidecar, which bundles chromium and the
                        // Playwright runtime. node_modules from the builder's
                        // pnpm install above are visible via the shared workspace.
                        env.PLAYWRIGHT_AVAILABLE = 'true'
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            container('playwright') {
                                dir('genesis/a2o') {
                                    withEnv(meshEnv) {
                                    sh "bash '${env.WORKSPACE}/genesis/scripts/ci/e2e-verify-browser.sh' '${doorwayHost}' '${env.INTERNAL_STORAGE_URL}' '${env.ELOHIM_REMOTE_COMPUTE_STATUS ?: 'unknown'}'"
                                    }
                                }
                            }
                        }

                        // Run BDD coverage gap scan (advisory)
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            dir('genesis/a2o') {
                                sh """#!/bin/bash
                                    set -euo pipefail

                                    echo ""
                                    echo "📊 BDD Coverage Gap Scan"
                                    npx tsx scripts/scan-coverage.ts --ci --suggest 5
                                """
                            }
                        }

                        // --- Sprint-report aggregator (API run) ---
                        // Always runs (pass or fail). Non-blocking: report is informational, not a gate.
                        // NOTE: invoke tsx directly — `pnpm run X -- args` forwards a LITERAL `--`
                        // (pnpm, unlike npm, does not consume the separator), which broke the
                        // script's flag parsing so BOTH aggregators silently ran with all-default
                        // flags (default cucumber path, default out paths, default profile).
                        // Reads the cucumber-report-api.json snapshot (see API stage) so the API
                        // report reflects the API run, not the browser run's clobbered JSON.
                        sh "bash '${env.WORKSPACE}/genesis/scripts/ci/sprint-report-api.sh' '${env.BUILD_TAG}'"

                        // --- Sprint-report aggregator (Browser run) ---
                        // Only emits when the browser stage actually ran. Profile=browser
                        // unlocks the Visual Validation 2x2 buckets and visual-regression
                        // findings in the markdown.
                        if (env.PLAYWRIGHT_AVAILABLE == 'true') {
                            sh "bash '${env.WORKSPACE}/genesis/scripts/ci/sprint-report-browser.sh' '${env.BUILD_TAG}'"
                        }

                        // Archive reports — includes per-feature screenshot subdirs
                        // when the browser stage produced any.
                        archiveArtifacts(
                            artifacts: 'genesis/a2o/reports/**',
                            allowEmptyArchive: true
                        )

                        // Publish cucumber reports through the Jenkins plugin so the
                        // build sidebar gets the "Cucumber Reports" link.
                        //
                        // The glob consumes EXACTLY the two per-stage snapshots and
                        // never the generic reports/cucumber-report.json. cucumber.mjs's
                        // base config writes that generic file on EVERY run, so after the
                        // browser stage it is a SECOND copy of a stage's report — and the
                        // old 'cucumber-report*.json' glob matched all three files, so the
                        // plugin counted one stage twice and reported a failed-step total
                        // that no stage produced (genesis #1489: 45 + 36 + 36 published as
                        // 119). 'cucumber-report-*.json' requires the hyphen, so it matches
                        // cucumber-report-api.json + cucumber-report-browser.json and
                        // excludes cucumber-report.json by construction.
                        // Snapshots: e2e-verify-api.sh (api) and e2e-verify-browser.sh
                        // (browser, which also clears the generic leftover).
                        if (fileExists('genesis/a2o/reports/cucumber-report-api.json') ||
                            fileExists('genesis/a2o/reports/cucumber-report-browser.json')) {
                            cucumber([
                                reportTitle: 'A2O E2E Reports',
                                fileIncludePattern: 'cucumber-report-*.json',
                                jsonReportDirectory: 'genesis/a2o/reports',
                                buildStatus: 'UNSTABLE',
                                sortingMethod: 'ALPHABETICAL',
                                trendsLimit: 10
                            ])
                        }
                    }
                }
            }
        }

    }

    post {
        success {
            script {
                echo """
═══════════════════════════════════════════════════════════
✅ GENESIS PIPELINE COMPLETE
═══════════════════════════════════════════════════════════
Target: ${env.TARGET_HOST}
Seeded: ${params.SEED_DATA}
IDs: ${params.SEED_IDS ?: '(all)'}
═══════════════════════════════════════════════════════════
                """
            }
        }
        failure {
            script {
                echo """
═══════════════════════════════════════════════════════════
❌ GENESIS PIPELINE FAILED
═══════════════════════════════════════════════════════════
Target: ${env.TARGET_HOST}
Seeded: ${params.SEED_DATA}
IDs: ${params.SEED_IDS ?: '(all)'}

Check the logs for details.
═══════════════════════════════════════════════════════════
                """
            }
        }
    }
}
