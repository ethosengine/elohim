                            'Seed Conductor Identities',
                            'seed-conductor-identities.ts',
                            env.SEED_RESULTS_CONDUCTOR_IDENTITIES_FILE ?: 'seed-results-conductor-identities.json',
                        )
                        if (res.skipped) return
                        def c = res.seedReport?.counts ?: [:]
                        if (res.exitCode == 2) {
                            unstable("Seed Conductor Identities partial: ${c.succeeded ?: 0} succeeded (${c.created ?: 0} created + ${c.exists ?: 0} exists), ${c.failed ?: 0} failed (see ${res.seedResultsName})")
                        } else if (res.exitCode == 1) {
                            unstable("Seed Conductor Identities total failure: 0 of ${c.total ?: 0} humans seeded (see ${res.seedResultsName})")
                        } else if (res.exitCode != 0) {
                            unstable("Seed Conductor Identities exited ${res.exitCode} (unexpected — see console)")
                        }
                    }
                }
            }
        }

