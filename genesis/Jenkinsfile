/**
 * Genesis Pipeline (elohim-genesis)
 *
 * Seeds content from genesis/data/lamad to Holochain via doorway.
 * Triggered by orchestrator after successful holochain/edge/app builds.
 *
 * Pipeline: checkout → resolve hosts → verify health → seed
 *
 * Auto-detects target environment from branch:
 *   - dev, feat-*, claude-* → alpha.elohim.host (doorway-alpha)
 *   - staging*              → staging.elohim.host (doorway-staging)
 *   - main                  → elohim.host (doorway)
 *
 * Parameters:
 *   - TARGET_HOST: Override auto-detected host (optional)
 *   - SEED_DATA: Enable/disable seeding (default: true)
 *   - SEED_IDS: Comma-separated list of specific IDs to seed (optional)
 *   - RESET_STORAGE: Reset storage databases before seeding (default: false)
 */

def resolveDoorwayHost(String targetHost, String explicitDoorway) {
    if (explicitDoorway) {
        return explicitDoorway
    }
    // Map target app URLs to environment-specific doorway URLs
    if (targetHost.contains('alpha.elohim.host')) {
        return 'https://doorway-alpha.elohim.host'
    } else if (targetHost.contains('staging.elohim.host')) {
        return 'https://doorway-staging.elohim.host'
    } else if (targetHost.contains('elohim.host') && !targetHost.contains('doorway')) {
        return 'https://doorway.elohim.host'
    }
    return targetHost.replaceFirst('://', '://doorway.')
}

def resolveInternalDoorwayUrl(String doorwayHost) {
    // Map external DNS to internal Kubernetes service DNS
    if (doorwayHost.contains('doorway-alpha.elohim.host')) {
        return 'elohim-doorway-alpha.elohim-alpha.svc.cluster.local:8080'
    } else if (doorwayHost.contains('doorway-staging.elohim.host')) {
        return 'elohim-doorway-staging.elohim-staging.svc.cluster.local:8080'
    } else if (doorwayHost.contains('doorway.elohim.host') && !doorwayHost.contains('doorway-')) {
        return 'elohim-doorway-prod.elohim-prod.svc.cluster.local:8080'
    }
    // Fallback for custom hosts
    return doorwayHost.replace('https://', '').replace('http://', '')
}

def resolveInternalStorageUrl(String doorwayHost) {
    // Points to a genesis peer's per-human storage for preflight checks.
    // The genesis peer set is declared in genesis/orchestrator/data/deployments.json
    // (genesisPeer:true) — but this resolver fires before topology.json is read,
    // so the per-env mapping is hardcoded. Keep these in sync with the active
    // genesis peer for each env.
    //   alpha:   matthew (adam is suspended pending shem replacement)
    //   staging: pete-staging was the genesis peer; suspended along with pete
    //            at the human level — point at matthew-staging when staging is
    //            re-enabled, otherwise this URL is dormant.
    //   prod:    frank-prod, same suspension story; revisit before prod runs.
    if (doorwayHost.contains('alpha.elohim.host')) {
        return 'elohim-matthew-alpha.elohim-alpha.svc.cluster.local:8090'
    } else if (doorwayHost.contains('staging.elohim.host')) {
        return 'elohim-pete-staging.elohim-staging.svc.cluster.local:8090'
    } else if (doorwayHost.contains('elohim.host') && !doorwayHost.contains('alpha') && !doorwayHost.contains('staging')) {
        return 'elohim-frank-prod.elohim-prod.svc.cluster.local:8090'
    }
    // Fallback: swap doorway→edgenode and port
    return doorwayHost.replace('https://', '').replace('http://', '').replace('doorway', 'edgenode').replaceAll(':\\d+', ':8090')
}

/**
 * Per-human storage endpoints across environments.
 * Each human has a dedicated StatefulSet in their assigned environment.
 *
 * Reads topology from genesis/orchestrator/environments/topology.json when available.
 * Falls back to alpha-concentration default (all 5 agents in alpha) if the file
 * is missing or unparseable.
 */
def getHumanStorageUrls(String ignored) {
    def topoPath = "genesis/orchestrator/environments/topology.json"
    if (fileExists(topoPath)) {
        try {
            def topo = new groovy.json.JsonSlurper().parseText(readFile(topoPath))
            return topo.humans.collect { h ->
                [
                    humanId:     h.humanId,
                    service:     h.resourcePrefix,
                    namespace:   h.namespace,
                    storageUrl:  h.storageUrl.replaceFirst('^https?://', ''),
                    genesisPeer: (h.genesisPeer == true),
                ]
            }
        } catch (Exception e) {
            echo "WARN: Failed to parse topology.json, using alpha-concentration fallback: ${e.message}"
        }
    }

    // Fallback: alpha-concentration when topology.json is missing/unparseable.
    // Genesis peers (genesisPeer:true) ingest content directly during seeding;
    // everyone else replicates via P2P. Both flags below mirror the active
    // entries in genesis/orchestrator/data/deployments.json — when adam returns
    // (shem replacement), restore his row with genesisPeer:true.
    def humans = [
        [humanId: 'human-matthew-manager',  service: 'elohim-matthew-alpha',   namespace: 'elohim-alpha', genesisPeer: true],
        [humanId: 'human-jessica-spouse',   service: 'elohim-jessica-alpha',   namespace: 'elohim-alpha', genesisPeer: false],
        [humanId: 'human-timothy-tutor',    service: 'elohim-timothy-alpha',   namespace: 'elohim-alpha', genesisPeer: false],
    ]
    return humans.collect { h ->
        h + [storageUrl: "${h.service}.${h.namespace}.svc.cluster.local:8090"]
    }
}

/**
 * Build comma-separated CONDUCTOR_URLS for non-suspended humans whose
 * agencyPhase is node, doorway, or device. Each URL points at the conductor's
 * app WebSocket port; the seeder derives admin port (= app port - 1) per the
 * existing socat convention in K8s.
 */
def getConductorAppUrls() {
    def topoPath = "genesis/orchestrator/environments/topology.json"
    def humans = []
    if (fileExists(topoPath)) {
        try {
            def topo = new groovy.json.JsonSlurper().parseText(readFile(topoPath))
            humans = topo.humans ?: []
        } catch (e) {
            echo "WARN: topology.json parse failed for conductor URLs: ${e.message}"
        }
    }
    if (humans.isEmpty()) {
        // Fallback: alpha-concentration default (mirrors getHumanStorageUrls).
        humans = [
            [name: 'matthew', service: 'elohim-matthew-alpha', namespace: 'elohim-alpha', agencyPhase: 'doorway'],
            [name: 'jessica', service: 'elohim-jessica-alpha', namespace: 'elohim-alpha', agencyPhase: 'device'],
            [name: 'timothy', service: 'elohim-timothy-alpha', namespace: 'elohim-alpha', agencyPhase: 'device'],
        ]
    }
    def urls = humans
        .findAll { ['node', 'doorway', 'device'].contains(it.agencyPhase) }
        .findAll { !it.suspended }
        .collect { "ws://${it.service}.${it.namespace}.svc.cluster.local:4445" }
    return urls.join(',')
}

/**
 * Probe each conductor's admin WebSocket port for reachability before
 * invoking the seeder. Returns [ready: [...urls], unready: [...urls]]
 * and writes a structured conductor-readiness.json artifact.
 *
 * Aligns with the "seed whoever is ready" principle: partial-cluster
 * operation is the steady state, not an exception. If timothy's admin
 * WS is down, we want to seed adam/jessica/matthew and report timothy
 * as unready — not waste 150s of WebSocket-timeout-loop trying to seed
 * 5 humans against a dead conductor.
 *
 * The probe is a 2-second TCP connect to the admin port (= app port - 1
 * per the socat convention; see seed-conductor-identities.ts:106-115).
 * TCP success is necessary but not sufficient for WS handshake; if the
 * conductor TCP-accepts but rejects the WS upgrade, the seeder will
 * still surface that as a per-peer failure. The probe just eliminates
 * the obvious "pod is dead" case fast.
 *
 * @param urlsString  comma-separated app URLs from getConductorAppUrls()
 * @param stageLabel  human-readable stage name (for the artifact)
 * @return            [ready: [...urls], unready: [...urls],
 *                     readyDetails: [...{url, host, adminPort}],
 *                     unreadyDetails: [...{url, host, adminPort, reason}]]
 */
def probeConductorReadiness(String urlsString, String stageLabel) {
    def readyDetails = []
    def unreadyDetails = []

    def urls = (urlsString ?: '').split(',').collect { it.trim() }.findAll { it }
    urls.each { String appUrl ->
        // Strip ws:// then split host:port. Defensive against malformed
        // entries from topology.json — we don't want a typo to throw and
        // cascade-fail the whole seed stage.
        def stripped = appUrl.replaceFirst(/^wss?:\/\//, '')
        def parts = stripped.split(':')
        if (parts.size() < 2 || !parts[1].isInteger()) {
            echo "[probe] ⚠️  Malformed URL — skipping: ${appUrl}"
            unreadyDetails.add([url: appUrl, reason: 'malformed-url'])
            return
        }
        def host = parts[0]
        def appPort = parts[1].toInteger()
        def adminPort = appPort - 1

        // Sanity check on host shape — K8s DNS uses [a-z0-9.-]+ only.
        // Anything else likely came from a broken topology entry; treat
        // as unready rather than risk shell interpolation surprises.
        if (!(host ==~ /[a-z0-9.\-]+/)) {
            echo "[probe] ⚠️  Suspicious host shape — skipping: ${host}"
            unreadyDetails.add([url: appUrl, host: host, reason: 'suspicious-host'])
            return
        }

        // 2-second TCP probe via /dev/tcp (no nc dependency required).
        // returnStatus: 0 on connect, non-zero on timeout / refused / DNS fail.
        def probeExit = sh(
            script: "timeout 2 bash -c 'echo > /dev/tcp/${host}/${adminPort}' 2>/dev/null",
            returnStatus: true
        )

        if (probeExit == 0) {
            readyDetails.add([url: appUrl, host: host, adminPort: adminPort])
            echo "[probe] ✅ ${host}:${adminPort} reachable"
        } else {
            unreadyDetails.add([url: appUrl, host: host, adminPort: adminPort, reason: 'tcp-timeout-or-refused'])
            echo "[probe] ❌ ${host}:${adminPort} unreachable (admin WS not accepting TCP)"
        }
    }

    // Emit structured artifact. Schema is intentionally compatible with
    // future stageAnnotations work that would feed conductor-readiness
    // into actual-build-graph.json's per-pipeline result map.
    def report = [
        schemaVersion: '1',
        probedAt: new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC')),
        stage: stageLabel,
        commitSha: env.GIT_COMMIT_FULL ?: env.GIT_COMMIT ?: '',
        readyCount: readyDetails.size(),
        unreadyCount: unreadyDetails.size(),
        partial: readyDetails.size() > 0 && unreadyDetails.size() > 0,
        allReady: unreadyDetails.isEmpty(),
        allUnready: readyDetails.isEmpty(),
        ready: readyDetails,
        unready: unreadyDetails,
    ]
    writeJSON(file: 'conductor-readiness.json', json: report, pretty: 2)
    archiveArtifacts(artifacts: 'conductor-readiness.json', allowEmptyArchive: true, fingerprint: true)

    return [
        ready: readyDetails.collect { it.url },
        unready: unreadyDetails.collect { it.url },
        readyDetails: readyDetails,
        unreadyDetails: unreadyDetails,
    ]
}

def shouldRunStep(String stepName) {
    def steps = (params.STEPS ?: 'all').split(',').collect { it.trim() }
    return steps.contains('all') || steps.contains(stepName)
}

pipeline {
    agent {
        kubernetes {
            cloud 'kubernetes'
            yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccount: ee-jenkins
  nodeSelector:
    node-type: edge
  containers:
  - name: builder
    image: harbor.ethosengine.com/ethosengine/ci-builder:latest
    command:
    - cat
    tty: true
    resources:
      requests:
        ephemeral-storage: "2Gi"
        memory: "2Gi"
      limits:
        ephemeral-storage: "5Gi"
        memory: "4Gi"
  - name: playwright
    image: harbor.ethosengine.com/ethosengine/ci-playwright:latest
    command:
    - cat
    tty: true
    resources:
      requests:
        ephemeral-storage: "2Gi"
        memory: "2Gi"
      limits:
        ephemeral-storage: "5Gi"
        memory: "4Gi"
'''
        }
    }

    parameters {
        string(
            name: 'TARGET_HOST',
            defaultValue: '',
            description: 'Target host URL (auto-detected from branch if empty)'
        )
        booleanParam(
            name: 'SEED_DATA',
            defaultValue: true,
            description: 'Seed the database with content from genesis/data/lamad'
        )
        string(
            name: 'SEED_IDS',
            defaultValue: '',
            description: 'Specific content IDs to seed (comma-separated). Empty = all content'
        )
        booleanParam(
            name: 'RESET_STORAGE',
            defaultValue: false,
            description: 'Reset storage databases before seeding (deletes content.db and restarts pods to run fresh migrations)'
        )
        string(name: 'STEPS', defaultValue: 'all', description: 'Comma-separated build steps to run. "all" runs everything.')
        booleanParam(
            name: 'DEPLOY_ONLY',
            defaultValue: false,
            description: 'No-op for this pipeline (genesis runs as a normal seed when triggered). Accepted so the orchestrator can propagate the flag uniformly. Operator can set SKIP_GENESIS on the orchestrator to skip seeding entirely on a deploy-only run.'
        )
    }

    environment {
        NO_COLOR = '1'
        NPM_TOKEN = credentials('ee-nexus-npm-token')
    }

    options {
        skipDefaultCheckout(true)
        timeout(time: 60, unit: 'MINUTES')  // M1 topology seeds + E2E (~25-35 min); 60 absorbs pod-flap archival waits
        buildDiscarder(logRotator(numToKeepStr: '20'))
        overrideIndexTriggers(false)  // Only orchestrator or manual triggers - no webhook/branch indexing
    }

    // No triggers - orchestrator handles triggering genesis after all builds complete
    // triggers { }

    stages {
        stage('Check Trigger') {
            steps {
                script {
                    def validTrigger = currentBuild.getBuildCauses().any { cause ->
                        cause._class.contains('UpstreamCause') || cause._class.contains('UserIdCause')
                    }
                    if (!validTrigger) {
                        echo "⏭️ PIPELINE SKIPPED - Use orchestrator or manual trigger"
                        currentBuild.result = 'NOT_BUILT'
                        currentBuild.displayName = "#${env.BUILD_NUMBER} SKIPPED"
                        env.PIPELINE_SKIPPED = 'true'
                    } else {
                        echo "✅ Valid trigger: ${currentBuild.getBuildCauses()*.shortDescription.join(', ')}"
                    }
                }
            }
        }

        stage('Checkout') {
            when { expression { env.PIPELINE_SKIPPED != 'true' } }
            steps {
                container('builder') {
                    script {
                        sh 'git config --global --add safe.directory "*"'

                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: "*/${env.BRANCH_NAME ?: 'dev'}"]],
                            extensions: [
                                [$class: 'CloneOption', shallow: true, noTags: true, depth: 1],
                                [$class: 'CleanBeforeCheckout']
                            ],
                            userRemoteConfigs: [[
                                url: 'https://github.com/ethosengine/elohim.git',
                                credentialsId: 'ee-bot-pat'
                            ]]
                        ])

                        // Enable pnpm via corepack (uses packageManager field in root package.json)
                        sh 'corepack enable'
                        sh 'pnpm --version'

                        echo """
═══════════════════════════════════════════════════════════
🌱 GENESIS PIPELINE
═══════════════════════════════════════════════════════════
Branch: ${env.BRANCH_NAME ?: 'dev'}
Seed Data: ${params.SEED_DATA}
Seed IDs: ${params.SEED_IDS ?: '(all)'}
═══════════════════════════════════════════════════════════
                        """
                    }
                }
            }
        }

        stage('Resolve Hosts') {
            when { expression { env.PIPELINE_SKIPPED != 'true' } }
            steps {
                container('builder') {
                    script {
                        // Auto-detect target host based on branch if not specified
                        def targetHost = params.TARGET_HOST
                        if (!targetHost) {
                            if (env.BRANCH_NAME == 'main') {
                                targetHost = 'https://elohim.host'
                            } else if (env.BRANCH_NAME == 'staging' || env.BRANCH_NAME ==~ /staging-.+/) {
                                targetHost = 'https://staging.elohim.host'
                            } else {
                                // dev, feat-*, claude/* branches → alpha
                                targetHost = 'https://alpha.elohim.host'
                            }
                            echo "Auto-detected target host from branch '${env.BRANCH_NAME}': ${targetHost}"
                        }

                        env.TARGET_HOST = targetHost
                        def doorwayHost = resolveDoorwayHost(targetHost, '')
                        def internalDoorway = resolveInternalDoorwayUrl(doorwayHost)

                        env.RESOLVED_DOORWAY_HOST = doorwayHost
                        env.INTERNAL_DOORWAY_URL = internalDoorway
                        env.INTERNAL_STORAGE_URL = resolveInternalStorageUrl(doorwayHost)

                        echo "✅ Target host: ${targetHost}"
                        echo "✅ Doorway API (external): ${doorwayHost}"
                        echo "✅ Doorway API (internal): ${internalDoorway}"
                        echo "✅ Storage API (internal): ${env.INTERNAL_STORAGE_URL}"
                    }
                }
            }
        }

        stage('Reset Storage') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.RESET_STORAGE }
            }}
            steps {
                container('builder') {
                    script {
                        def humans = getHumanStorageUrls('alpha')

                        echo """
═══════════════════════════════════════════════════════════
🗑️  RESETTING STORAGE DATABASES
═══════════════════════════════════════════════════════════
"""
                        for (human in humans) {
                            sh """#!/bin/bash
                                set -euo pipefail
                                echo "Resetting ${human.service}..."

                                # Delete content.db and restart pod for fresh migrations
                                kubectl exec -n ${human.namespace} ${human.service}-0 -c elohim-storage -- rm -f /data/content.db 2>/dev/null || true
                                kubectl delete pod -n ${human.namespace} ${human.service}-0 --wait=false

                                echo "   ✅ ${human.humanId} reset initiated"
                            """
                        }

                        // Wait for pods to begin restarting
                        sh '''#!/bin/bash
                            echo ""
                            echo "Waiting for pods to restart..."
                            sleep 30
                        '''

                        for (human in humans) {
                            sh """#!/bin/bash
                                set -euo pipefail
                                echo "Waiting for ${human.service}..."
                                kubectl wait --for=condition=Ready pod/${human.service}-0 -n ${human.namespace} --timeout=120s
                                echo "   ✅ ${human.service} ready"
                            """
                        }

                        echo """
═══════════════════════════════════════════════════════════
✅ ALL STORAGE DATABASES RESET
═══════════════════════════════════════════════════════════
"""
                    }
                }
            }
        }

        stage('Install Seeder') {
            when { allOf { expression { env.PIPELINE_SKIPPED != 'true' }; expression { params.SEED_DATA } } }
            steps {
                container('builder') {
                    dir('genesis/seeder') {
                        sh '''
                            echo "Installing seeder dependencies..."
                            pnpm install --frozen-lockfile
                            echo "✅ Seeder ready"
                        '''
                    }
                }
            }
        }

        stage('Generate Schema Types') {
            when { allOf { expression { env.PIPELINE_SKIPPED != 'true' }; expression { params.SEED_DATA } } }
            steps {
                container('builder') {
                    sh '''#!/bin/bash
                        set -euo pipefail

                        echo "Generating TypeScript enum constants from protocol JSON schemas..."

                        # JSON Schema is the single source of truth — codegen produces both TS and Rust
                        pnpm run schema:codegen:ts

                        echo "✅ Schema types generated"
                    '''
                }
            }
        }

        stage('Validate Constants') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
                expression { shouldRunStep('validate-seeds') }
            }}
            steps {
                container('builder') {
                    sh '''#!/bin/bash
                        set -euo pipefail

                        echo "Validating humanId references against humans.json..."
                        python3 genesis/scripts/validate-human-ids.py

                        echo "✅ HumanId validation passed"
                    '''
                    // TODO: Enable manifest codegen verification once app manifest is stable
                    // sh '''#!/bin/bash
                    //     set -euo pipefail
                    //     echo "Verifying manifest codegen is up to date..."
                    //     pnpm -w run manifest:codegen:verify
                    //     echo "✅ Manifest codegen verified"
                    // '''
                    dir('genesis/seeder') {
                        sh '''#!/bin/bash
                            set -euo pipefail

                            echo "Type-checking seeder (compile-time enum enforcement)..."
                            # Filter out workspace package resolution errors (TS2307) —
                            # these are CI install issues, not code bugs. Fail only on
                            # real type errors (enum mismatches, invalid assignments, etc.)
                            TSC_OUTPUT=$(npx tsc --noEmit 2>&1 || true)
                            REAL_ERRORS=$(echo "$TSC_OUTPUT" | grep "error TS" | grep -v "TS2307" || true)
                            if [ -n "$REAL_ERRORS" ]; then
                                echo "$REAL_ERRORS"
                                echo "❌ TypeScript type errors found — fix before seeding"
                                exit 1
                            fi
                            echo "✅ Type check passed"

                            echo "Running constants sync tests..."
                            npx vitest run --reporter=verbose

                            echo "✅ Constants validation passed"
                        '''
                    }
                }
            }
        }

        stage('Verify Target Health') {
            when { expression { env.PIPELINE_SKIPPED != 'true' } }
            steps {
                container('builder') {
                    script {
                        // Ensure jq is available for JSON parsing
                        sh '''
                            command -v jq >/dev/null 2>&1 || {
                                echo "Installing jq..."
                                apt-get update -qq && apt-get install -y -qq jq 2>/dev/null || apk add --no-cache jq
                            }
                        '''

                        def targetHost = env.TARGET_HOST
                        def doorwayHost = env.RESOLVED_DOORWAY_HOST
                        def internalDoorway = env.INTERNAL_DOORWAY_URL

                        echo "Verifying target site: ${targetHost}"
                        sh """
                            timeout 120s bash -c 'until curl -sf -o /dev/null "${targetHost}"; do
                                echo "Waiting for target site..."
                                sleep 5
                            done'
                            echo "✅ Target site responding: ${targetHost}"
                        """

                        // Use /status endpoint for comprehensive preflight checks
                        // This includes: conductor connectivity, storage health, cell discovery
                        echo "Verifying Doorway readiness (internal): ${internalDoorway}"
                        sh """#!/bin/bash
                            set -euo pipefail

                            MAX_ATTEMPTS=30
                            ATTEMPT=1
                            DOORWAY_READY=false
                            DOORWAY_BASE_URL=""

                            # First, wait for doorway to be reachable
                            while [ \$ATTEMPT -le \$MAX_ATTEMPTS ]; do
                                # Try internal DNS first
                                if curl -sf -o /dev/null "http://${internalDoorway}/health" 2>/dev/null; then
                                    DOORWAY_BASE_URL="http://${internalDoorway}"
                                    echo "✅ Doorway responding (via internal DNS)"
                                    break
                                fi
                                # Fall back to external DNS
                                if curl -sf -o /dev/null "${doorwayHost}/health" 2>/dev/null; then
                                    DOORWAY_BASE_URL="${doorwayHost}"
                                    echo "✅ Doorway responding (via external DNS)"
                                    break
                                fi
                                echo "Waiting for Doorway... (attempt \$ATTEMPT/\$MAX_ATTEMPTS)"
                                sleep 5
                                ATTEMPT=\$((ATTEMPT + 1))
                            done

                            if [ -z "\$DOORWAY_BASE_URL" ]; then
                                echo "❌ Doorway not responding after \$MAX_ATTEMPTS attempts"
                                exit 1
                            fi

                            # Now use /status for comprehensive preflight checks
                            echo ""
                            echo "════════════════════════════════════════════════════════════"
                            echo "🔍 PREFLIGHT CHECKS"
                            echo "════════════════════════════════════════════════════════════"

                            PREFLIGHT_ATTEMPTS=0
                            PREFLIGHT_MAX=24  # 2 minutes with 5s intervals
                            CONDUCTOR_READY=false

                            while [ \$PREFLIGHT_ATTEMPTS -lt \$PREFLIGHT_MAX ]; do
                                # /health returns JSON; /status returns HTML dashboard
                                STATUS_JSON=\$(curl -sf "\$DOORWAY_BASE_URL/health" 2>/dev/null || echo '{}')

                                # Parse health response
                                CONDUCTOR_CONNECTED=\$(echo "\$STATUS_JSON" | jq -r '.conductor.connected // false')
                                CONDUCTOR_WORKERS=\$(echo "\$STATUS_JSON" | jq -r '.conductor.connected_workers // 0')
                                HEALTHY=\$(echo "\$STATUS_JSON" | jq -r '.healthy // false')
                                STATUS=\$(echo "\$STATUS_JSON" | jq -r '.status // "unknown"')
                                ERROR_MSG=\$(echo "\$STATUS_JSON" | jq -r '.error // empty')

                                echo "  Healthy: \$HEALTHY  Status: \$STATUS"
                                echo "  Conductor: connected=\$CONDUCTOR_CONNECTED workers=\$CONDUCTOR_WORKERS"
                                if [ -n "\$ERROR_MSG" ]; then
                                    echo "  ⚠️  \$ERROR_MSG"
                                fi

                                # Check if ready — conductor must have workers connected
                                if [ "\$CONDUCTOR_CONNECTED" = "true" ] && [ "\$HEALTHY" = "true" ]; then
                                    echo ""
                                    echo "✅ Doorway ready for seeding"
                                    CONDUCTOR_READY=true
                                    break
                                fi

                                PREFLIGHT_ATTEMPTS=\$((PREFLIGHT_ATTEMPTS + 1))
                                if [ \$PREFLIGHT_ATTEMPTS -lt \$PREFLIGHT_MAX ]; then
                                    echo "  ⏳ Waiting for conductor/storage... (\$PREFLIGHT_ATTEMPTS/\$PREFLIGHT_MAX)"
                                    sleep 5
                                fi
                            done

                            if [ "\$CONDUCTOR_READY" != "true" ]; then
                                echo ""
                                echo "❌ PREFLIGHT FAILED: Doorway not ready for seeding"
                                echo "   Conductor connected: \$CONDUCTOR_CONNECTED"
                                echo "   Storage healthy: \$STORAGE_HEALTHY"
                                echo ""
                                echo "Check doorway and elohim-storage logs for issues."
                                exit 1
                            fi

                            # Verify SQLite database is available on elohim-storage (edgenode service)
                            echo ""
                            echo "🔍 Checking SQLite database availability..."
                            STORAGE_URL="http://${env.INTERNAL_STORAGE_URL}"
                            DB_STATS=\$(curl -sf "\$STORAGE_URL/db/stats" 2>/dev/null || echo '{}')
                            DB_READY=\$(echo "\$DB_STATS" | jq -r 'has("contentCount")' 2>/dev/null || echo 'false')

                            if [ "\$DB_READY" = "true" ]; then
                                echo "✅ SQLite database ready at \$STORAGE_URL"
                                CURRENT_CONTENT=\$(echo "\$DB_STATS" | jq -r '.contentCount // 0')
                                CURRENT_TAGS=\$(echo "\$DB_STATS" | jq -r '.uniqueTags // 0')
                                echo "   Current state: \$CURRENT_CONTENT content, \$CURRENT_TAGS tags"
                            else
                                echo "❌ SQLite database not available at \$STORAGE_URL"
                                echo "   Ensure ENABLE_CONTENT_DB=true is set on elohim-storage"
                                exit 1
                            fi

                            echo "════════════════════════════════════════════════════════════"
                        """
                    }
                }
            }
        }

        stage('Seed Database') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
                expression { shouldRunStep('seed-content') }
            }}
            steps {
                container('builder') {
                    script {
                        def humans = getHumanStorageUrls('alpha')
                        def genesisPeers = humans.findAll { it.genesisPeer == true }
                        if (genesisPeers.isEmpty()) {
                            error("No genesis peer found in topology — at least one human in deployments.json must have genesisPeer:true (and must not be suspended). See genesis/orchestrator/data/deployments.json.")
                        }
                        def replicaPeers = humans.findAll { it.genesisPeer != true }

                        echo "Genesis peers (direct ingest): ${genesisPeers.collect { it.humanId }.join(', ')}"
                        echo "Replica peers (P2P replication): ${replicaPeers.collect { it.humanId }.join(', ')}"

                        dir('genesis/seeder') {
                            for (gp in genesisPeers) {
                                sh """#!/bin/bash
                                    set -euo pipefail

                                    echo "═══════════════════════════════════════════════════════════"
                                    echo "🌱 SEEDING GENESIS PEER: ${gp.humanId}"
                                    echo "═══════════════════════════════════════════════════════════"
                                    echo "Storage: ${gp.storageUrl}"
                                    echo ""

                                    # Wait for genesis peer's storage to be ready
                                    for i in \$(seq 1 60); do
                                        if curl -sf "http://${gp.storageUrl}/health" > /dev/null 2>&1; then
                                            echo "✅ ${gp.service} storage is ready"
                                            break
                                        fi
                                        if [ \$i -eq 60 ]; then
                                            echo "❌ ${gp.service} storage not ready after 60 attempts"
                                            exit 1
                                        fi
                                        echo "   Waiting for ${gp.service} storage... (\$i/60)"
                                        sleep 2
                                    done

                                    # Direct seed: genesis peers ingest content via SQLite write.
                                    # Replica peers receive it via P2P identity-driven replication.
                                    # Idempotent — safe to run across multiple genesis peers in
                                    # sequence; each peer's SQLite settles to the same content set.
                                    STORAGE_URL="http://${gp.storageUrl}" npx tsx src/seed-sqlite.ts

                                    echo ""
                                    echo "✅ ${gp.humanId} seeded successfully"
                                    echo ""
                                """
                            }

                            for (peer in replicaPeers) {
                                sh """#!/bin/bash
                                    set -euo pipefail

                                    echo "═══════════════════════════════════════════════════════════"
                                    echo "⏳ WAITING FOR REPLICATION: ${peer.humanId}"
                                    echo "═══════════════════════════════════════════════════════════"
                                    echo "Storage: ${peer.storageUrl}"

                                    # Wait for this peer's storage to be ready
                                    for i in \$(seq 1 30); do
                                        if curl -sf "http://${peer.storageUrl}/health" > /dev/null 2>&1; then
                                            break
                                        fi
                                        sleep 2
                                    done

                                    # Poll /p2p/status until replication.caughtUp == true (timeout 600s)
                                    DEADLINE=\$((SECONDS + 600))
                                    while [ \$SECONDS -lt \$DEADLINE ]; do
                                        STATUS=\$(curl -sf "http://${peer.storageUrl}/p2p/status" 2>/dev/null || echo '{}')
                                        CAUGHT_UP=\$(echo "\$STATUS" | jq -r '.replication.caughtUp // false')
                                        COMPLETED=\$(echo "\$STATUS" | jq -r '.replication.completed // 0')
                                        PENDING=\$(echo "\$STATUS" | jq -r '.replication.pending // 0')

                                        # Done when caught up and nothing is pending.
                                        # COMPLETED=0 is valid when the peer already had everything
                                        # (prior seed / P2P sync), so don't gate on it.
                                        if [ "\$CAUGHT_UP" = "true" ] && [ "\$PENDING" = "0" ]; then
                                            echo "✅ ${peer.humanId} caught up: \$COMPLETED replicated this run, 0 pending"
                                            break
                                        fi

                                        echo "   ${peer.humanId}: \$COMPLETED completed, \$PENDING pending"
                                        sleep 10
                                    done

                                    if [ \$SECONDS -ge \$DEADLINE ]; then
                                        echo "❌ ${peer.humanId} replication timed out"
                                        exit 1
                                    fi
                                """
                            }

                            sh '''#!/bin/bash
                                echo "═══════════════════════════════════════════════════════════"
                                echo "📊 SEEDING SUMMARY"
                                echo "═══════════════════════════════════════════════════════════"
                            '''
                            for (human in humans) {
                                sh """#!/bin/bash
                                    STATS=\$(curl -sf "http://${human.storageUrl}/db/stats" 2>/dev/null || echo '{}')
                                    COUNT=\$(echo "\$STATS" | jq -r '.contentCount // 0')
                                    echo "   ${human.humanId}: \$COUNT content nodes"
                                """
                            }
                            sh '''#!/bin/bash
                                echo "═══════════════════════════════════════════════════════════"
                                echo "✅ ALL CONDUCTORS HAVE CONTENT (genesis seeded + others replicated)"
                                echo "═══════════════════════════════════════════════════════════"
                            '''
                        }
                    }
                }
            }
        }

        stage('Verify Seeding') {
            when { allOf { expression { env.PIPELINE_SKIPPED != 'true' }; expression { params.SEED_DATA } } }
            steps {
                container('builder') {
                    script {
                        def humans = getHumanStorageUrls('alpha')
                        def genesisPeers = humans.findAll { it.genesisPeer == true }
                        if (genesisPeers.isEmpty()) {
                            error("No genesis peer found in topology — at least one human in deployments.json must have genesisPeer:true (and must not be suspended).")
                        }
                        def genesisPeer = genesisPeers[0]
                        def genesisUrl = genesisPeer.storageUrl

                        sh '''#!/bin/bash
                            echo "═══════════════════════════════════════════════════════════"
                            echo "🔍 VERIFYING SEEDING"
                            echo "═══════════════════════════════════════════════════════════"
                        '''

                        for (human in humans) {
                            sh """#!/bin/bash
                                set -euo pipefail
                                STATS=\$(curl -sf "http://${human.storageUrl}/db/stats")
                                CONTENT=\$(echo "\$STATS" | jq -r '.contentCount // 0')
                                echo "   ${human.humanId}: \$CONTENT content"
                                if [ "\$CONTENT" -eq 0 ]; then
                                    echo "❌ ${human.humanId} has no content!"
                                    exit 1
                                fi
                            """
                        }

                        // Verify sophia assessment content on the first genesis peer.
                        // (Idempotent direct seeding means every genesis peer has the
                        // same content; the first one is sufficient for the spot-check.)
                        sh """#!/bin/bash
                            set -euo pipefail
                            echo ""
                            echo "🔬 Verifying assessment content on genesis peer (${genesisPeer.humanId})..."
                            for ASSESSMENT_ID in assessment-personal-values assessment-values-hierarchy; do
                                ASSESSMENT=\$(curl -sf "http://${genesisUrl}/db/content/\$ASSESSMENT_ID" || echo '{}')
                                FMT=\$(echo "\$ASSESSMENT" | jq -r '.contentFormat // empty')

                                if [ -z "\$FMT" ]; then
                                    echo "   ⚠️ Assessment '\$ASSESSMENT_ID' not found"
                                    continue
                                fi

                                if [ "\$FMT" = "markdown" ]; then
                                    echo "   ❌ Assessment '\$ASSESSMENT_ID' has format 'markdown' (likely defaulted from unknown format)"
                                    exit 1
                                fi

                                HAS_WIDGETS=\$(echo "\$ASSESSMENT" | jq -r '.contentBody' | jq -e '.[0].content.widgets | length > 0' 2>/dev/null && echo "yes" || echo "no")
                                if [ "\$HAS_WIDGETS" = "yes" ]; then
                                    echo "   ✅ Assessment '\$ASSESSMENT_ID': format=\$FMT, widgets present"
                                else
                                    echo "   ⚠️ Assessment '\$ASSESSMENT_ID': format=\$FMT, no widgets in content body"
                                fi
                            done

                            echo ""
                            echo "═══════════════════════════════════════════════════════════"
                            echo "✅ SEEDING VERIFIED"
                            echo "═══════════════════════════════════════════════════════════"
                        """
                    }
                }
            }
        }

        stage('Seed Humans') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
            }}
            steps {
                container('builder') {
                    script {
                        def doorwayHost = env.RESOLVED_DOORWAY_HOST
                        def adminKey = ''
                        try {
                            withCredentials([string(credentialsId: 'doorway-admin-bootstrap-key', variable: 'ADMIN_KEY')]) {
                                adminKey = env.ADMIN_KEY
                            }
                        } catch (e) {
                            echo "doorway-admin-bootstrap-key credential not found — seeding without admin promotion"
                        }
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            dir('genesis/seeder') {
                                withEnv(["API_KEY_ADMIN=${adminKey}"]) {
                                    sh """#!/bin/bash
                                        set -euo pipefail
                                        echo "═══════════════════════════════════════════════════════════"
                                        echo "SEED HUMANS"
                                        echo "═══════════════════════════════════════════════════════════"
                                        echo "Doorway: ${doorwayHost}"
                                        echo "Admin key: \${API_KEY_ADMIN:+provided}\${API_KEY_ADMIN:-not set}"
                                        echo ""
                                        DOORWAY_URL="${doorwayHost}" npx tsx src/seed-humans.ts
                                    """
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Seed Presences') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
            }}
            steps {
                container('builder') {
                    script {
                        def doorwayHost = env.RESOLVED_DOORWAY_HOST
                        def adminKey = ''
                        try {
                            withCredentials([string(credentialsId: 'doorway-admin-bootstrap-key', variable: 'ADMIN_KEY')]) {
                                adminKey = env.ADMIN_KEY
                            }
                        } catch (e) {
                            echo "doorway-admin-bootstrap-key credential not found — seeding without admin promotion"
                        }
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            dir('genesis/seeder') {
                                withEnv(["API_KEY_ADMIN=${adminKey}"]) {
                                    sh """#!/bin/bash
                                        set -euo pipefail
                                        echo "═══════════════════════════════════════════════════════════"
                                        echo "SEED PRESENCES"
                                        echo "═══════════════════════════════════════════════════════════"
                                        echo "Doorway: ${doorwayHost}"
                                        echo "Admin key: \${API_KEY_ADMIN:+provided}\${API_KEY_ADMIN:-not set}"
                                        echo ""
                                        DOORWAY_URL="${doorwayHost}" npx tsx src/seed-presences.ts
                                    """
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Seed Collectives') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
            }}
            steps {
                container('builder') {
                    script {
                        def doorwayHost = env.RESOLVED_DOORWAY_HOST
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            dir('genesis/seeder') {
                                sh """#!/bin/bash
                                    set -euo pipefail
                                    echo "═══════════════════════════════════════════════════════════"
                                    echo "SEED COLLECTIVES"
                                    echo "═══════════════════════════════════════════════════════════"
                                    echo "Doorway: ${doorwayHost}"
                                    echo ""
                                    DOORWAY_URL="${doorwayHost}" npx tsx src/seed-collectives.ts
                                """
                            }
                        }
                    }
                }
            }
        }

        stage('Seed Accounts') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
            }}
            steps {
                container('builder') {
                    script {
                        def doorwayHost = env.RESOLVED_DOORWAY_HOST
                        // SEEDER_TARGET_PEERS: comma-separated storage URLs for active
                        // compute peers (storage that is online and can receive imports).
                        //
                        // The package set being imported is the PRESENCE set — every human
                        // in deployments.json regardless of suspended flag, so suspended
                        // contributors retain their ContributorPresence on the network.
                        // The TARGET set is the COMPUTE set — only non-suspended humans'
                        // storage URLs, derived from topology.json (already filtered by the
                        // edge pipeline's `findAll { !it.suspended }`).
                        //
                        // Suspended humans (e.g. adam/pete/frank during shem outage) appear
                        // as authored sources in imported packages — never as POST targets.
                        // Contract: docs/superpowers/specs/2026-05-04-compute-commitment-substrate-floor-design.md.
                        //
                        // Override via env.SEEDER_TARGET_PEERS to force a specific target list
                        // (e.g. for staged rollouts or a single-peer dev seed).
                        def targetPeers
                        if ((env.SEEDER_TARGET_PEERS ?: '').trim()) {
                            targetPeers = env.SEEDER_TARGET_PEERS.trim()
                        } else {
                            def humans = getHumanStorageUrls('alpha')
                            // getHumanStorageUrls reads topology.json which is already filtered
                            // to non-suspended humans by the edge pipeline. Each storage URL is
                            // an active compute peer that can receive /account/import POSTs.
                            def computeUrls = humans.collect { "http://${it.storageUrl}" }
                            targetPeers = computeUrls.join(',')
                        }
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            dir('genesis/seeder') {
                                sh """#!/bin/bash
                                    set -euo pipefail
                                    echo "═══════════════════════════════════════════════════════════"
                                    echo "SEED ACCOUNTS"
                                    echo "═══════════════════════════════════════════════════════════"
                                    if [ -n "${targetPeers}" ]; then
                                      echo "Targets: ${targetPeers}"
                                    else
                                      echo "Doorway: ${doorwayHost}  (single target; set SEEDER_TARGET_PEERS to split)"
                                    fi
                                    echo ""
                                    DOORWAY_URL="${doorwayHost}" \\
                                    SEEDER_TARGET_PEERS="${targetPeers}" \\
                                      npx tsx src/seed-accounts.ts
                                """
                            }
                        }
                    }
                }
            }
        }

        stage('Seed Conductor Identities') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
            }}
            steps {
                container('builder') {
                    script {
                        def conductorUrls = getConductorAppUrls()
                        if (!conductorUrls) {
                            echo "WARN: no conductor URLs resolved — skipping seed-conductor-identities"
                            return
                        }

                        // Per-peer pre-flight probe. Skips dead peers entirely
                        // rather than letting the seeder waste ~150s on the
                        // 10s-WS-timeout × N-humans loop. Emits
                        // conductor-readiness.json for downstream investigation.
                        def probe = probeConductorReadiness(conductorUrls, 'Seed Conductor Identities')

                        if (probe.ready.isEmpty()) {
                            // All conductors unreachable — nothing to seed.
                            // Still mark UNSTABLE (not FAILED) per the
                            // partial-cluster-is-steady-state principle:
                            // a household with no peers ready today is
                            // recoverable, not a hard failure.
                            unstable("All ${probe.unready.size()} conductors unreachable — skipping seed (see conductor-readiness.json)")
                            return
                        }

                        if (!probe.unready.isEmpty()) {
                            unstable("${probe.unready.size()} of ${probe.ready.size() + probe.unready.size()} conductors unready — seeding ${probe.ready.size()} reachable peers (see conductor-readiness.json)")
                        }

                        def readyUrls = probe.ready.join(',')

                        // Run the seeder; capture exit code via returnStatus
                        // so we can interpret the partial-vs-total exit code
                        // split (0=clean, 2=partial, 1=total) without
                        // letting catchError swallow the distinction.
                        def seedExit = -1
                        dir('genesis/seeder') {
                            seedExit = sh(
                                script: """#!/bin/bash
                                    set -uo pipefail
                                    echo "═══════════════════════════════════════════════════════════"
                                    echo "SEED CONDUCTOR IDENTITIES"
                                    echo "═══════════════════════════════════════════════════════════"
                                    echo "Conductors (ready): ${readyUrls}"
                                    echo ""
                                    CONDUCTOR_URLS="${readyUrls}" \\
                                      npx tsx src/seed-conductor-identities.ts
                                """,
                                returnStatus: true,
                            )
                        }

                        // Archive the structured per-human artifact emitted
                        // by the seeder regardless of exit code (the script
                        // writes it before exiting). Read it to enrich the
                        // unstable() message with concrete counts.
                        if (fileExists('genesis/seeder/seed-results-conductor-identities.json')) {
                            archiveArtifacts(
                                artifacts: 'genesis/seeder/seed-results-conductor-identities.json',
                                fingerprint: true,
                                allowEmptyArchive: true,
                            )
                            def seedReport = readJSON(file: 'genesis/seeder/seed-results-conductor-identities.json')
                            def c = seedReport.counts ?: [:]
                            if (seedExit == 2) {
                                unstable("Seed Conductor Identities partial: ${c.succeeded ?: 0} succeeded (${c.created ?: 0} created + ${c.exists ?: 0} exists), ${c.failed ?: 0} failed (see seed-results-conductor-identities.json)")
                            } else if (seedExit == 1) {
                                unstable("Seed Conductor Identities total failure: 0 of ${c.total ?: 0} humans seeded (see seed-results-conductor-identities.json)")
                            } else if (seedExit != 0) {
                                unstable("Seed Conductor Identities exited ${seedExit} (unexpected — see console)")
                            }
                        } else if (seedExit != 0) {
                            // Script didn't even reach the writeFile call.
                            // Existing UNSTABLE behaviour preserved.
                            unstable("Seed Conductor Identities failed before writing seed-results — exit ${seedExit}")
                        }
                    }
                }
            }
        }

        stage('Seed Agent Peer Bindings') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
            }}
            steps {
                container('builder') {
                    script {
                        def conductorUrls = getConductorAppUrls()
                        if (!conductorUrls) {
                            echo "WARN: no conductor URLs resolved — skipping seed-agent-bindings"
                            return
                        }

                        // Probe again — a peer may have recovered or gone
                        // down between Seed Conductor Identities and now.
                        // The latest probe overwrites conductor-readiness.json
                        // (single-file, latest-wins) — sufficient for
                        // iteration 1; preserve-history is a follow-up.
                        def probe = probeConductorReadiness(conductorUrls, 'Seed Agent Peer Bindings')

                        if (probe.ready.isEmpty()) {
                            unstable("All ${probe.unready.size()} conductors unreachable — skipping seed (see conductor-readiness.json)")
                            return
                        }

                        if (!probe.unready.isEmpty()) {
                            unstable("${probe.unready.size()} of ${probe.ready.size() + probe.unready.size()} conductors unready — seeding ${probe.ready.size()} reachable peers (see conductor-readiness.json)")
                        }

                        def readyUrls = probe.ready.join(',')

                        // Same partial-vs-total exit-code interpretation
                        // pattern as Seed Conductor Identities above.
                        def seedExit = -1
                        dir('genesis/seeder') {
                            seedExit = sh(
                                script: """#!/bin/bash
                                    set -uo pipefail
                                    echo "═══════════════════════════════════════════════════════════"
                                    echo "SEED AGENT PEER BINDINGS"
                                    echo "═══════════════════════════════════════════════════════════"
                                    echo "Conductors (ready): ${readyUrls}"
                                    echo ""
                                    CONDUCTOR_URLS="${readyUrls}" \\
                                      npx tsx src/seed-agent-bindings.ts
                                """,
                                returnStatus: true,
                            )
                        }

                        if (fileExists('genesis/seeder/seed-results-agent-bindings.json')) {
                            archiveArtifacts(
                                artifacts: 'genesis/seeder/seed-results-agent-bindings.json',
                                fingerprint: true,
                                allowEmptyArchive: true,
                            )
                            def seedReport = readJSON(file: 'genesis/seeder/seed-results-agent-bindings.json')
                            def c = seedReport.counts ?: [:]
                            if (seedExit == 2) {
                                unstable("Seed Agent Peer Bindings partial: ${c.succeeded ?: 0} humans succeeded (${c.totalCreated ?: 0} bindings written), ${c.failed ?: 0} failed (see seed-results-agent-bindings.json)")
                            } else if (seedExit == 1) {
                                unstable("Seed Agent Peer Bindings total failure: 0 of ${c.total ?: 0} humans seeded (see seed-results-agent-bindings.json)")
                            } else if (seedExit != 0) {
                                unstable("Seed Agent Peer Bindings exited ${seedExit} (unexpected — see console)")
                            }
                        } else if (seedExit != 0) {
                            unstable("Seed Agent Peer Bindings failed before writing seed-results — exit ${seedExit}")
                        }
                    }
                }
            }
        }

        stage('Upload M1 Blob-Backed Content') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
            }}
            steps {
                container('builder') {
                    script {
                        def manifestoPath = 'genesis/docs/content/elohim-protocol/manifesto.md'
                        def internalDoorwayUrl = env.INTERNAL_DOORWAY_URL
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            sh """#!/bin/bash
                                set -euo pipefail
                                if [ ! -f "${manifestoPath}" ]; then
                                  echo "ERROR: ${manifestoPath} missing"; exit 1
                                fi
                                BLOB_SIZE=\$(wc -c < "${manifestoPath}")
                                BLOB_HASH=sha256-\$(sha256sum "${manifestoPath}" | awk '{print \$1}')
                                echo "═══════════════════════════════════════════════════════════"
                                echo "UPLOAD M1 BLOB-BACKED CONTENT"
                                echo "═══════════════════════════════════════════════════════════"
                                echo "File:   ${manifestoPath}"
                                echo "Size:   \$BLOB_SIZE bytes"
                                echo "Hash:   \$BLOB_HASH"
                                echo "Target: http://${internalDoorwayUrl}/admin/seed/blob"
                                echo ""
                                STATUS=\$(curl -s -o /tmp/upload.out -w '%{http_code}' \\
                                  -X PUT "http://${internalDoorwayUrl}/admin/seed/blob" \\
                                  -H "X-Blob-Hash: \$BLOB_HASH" \\
                                  -H 'Content-Type: application/octet-stream' \\
                                  --data-binary @"${manifestoPath}")
                                if [ "\$STATUS" != "200" ] && [ "\$STATUS" != "201" ] && [ "\$STATUS" != "409" ]; then
                                  echo "Upload failed: HTTP \$STATUS"
                                  cat /tmp/upload.out
                                  exit 1
                                fi
                                echo "Upload status: \$STATUS"
                                echo "\$BLOB_HASH" > /tmp/m1_blob_hash
                                echo "\$BLOB_SIZE" > /tmp/m1_blob_size
                            """
                            env.M1_BLOB_HASH = sh(script: 'cat /tmp/m1_blob_hash', returnStdout: true).trim()
                            env.M1_BLOB_SIZE_BYTES = sh(script: 'cat /tmp/m1_blob_size', returnStdout: true).trim()
                            echo "Exported: M1_BLOB_HASH=${env.M1_BLOB_HASH}, M1_BLOB_SIZE_BYTES=${env.M1_BLOB_SIZE_BYTES}"
                        }
                    }
                }
            }
        }

        stage('Seed Custody Commitments') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
                expression { env.M1_BLOB_HASH != null && env.M1_BLOB_HASH != '' }
            }}
            steps {
                container('builder') {
                    script {
                        def doorwayHost = env.RESOLVED_DOORWAY_HOST
                        def blobHash = env.M1_BLOB_HASH
                        def blobSize = env.M1_BLOB_SIZE_BYTES ?: '0'
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            dir('genesis/seeder') {
                                sh """#!/bin/bash
                                    set -euo pipefail
                                    echo "═══════════════════════════════════════════════════════════"
                                    echo "SEED CUSTODY COMMITMENTS (M1 matthew↔timothy pair)"
                                    echo "═══════════════════════════════════════════════════════════"
                                    echo "Doorway: ${doorwayHost}"
                                    echo "Blob:    ${blobHash} (${blobSize} bytes)"
                                    echo ""
                                    DOORWAY_URL="${doorwayHost}" \\
                                    M1_BLOB_HASH="${blobHash}" \\
                                    M1_BLOB_SIZE_BYTES="${blobSize}" \\
                                      npx tsx src/seed-commitments.ts
                                """
                            }
                        }
                    }
                }
            }
        }

        stage('Trigger M1 Cross-Pod Fetch') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
                expression { env.M1_BLOB_HASH != null && env.M1_BLOB_HASH != '' }
            }}
            steps {
                container('builder') {
                    script {
                        def blobHash = env.M1_BLOB_HASH
                        def timothyUrl = 'http://elohim-timothy-alpha.elohim-alpha.svc.cluster.local:8090'
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            sh """#!/bin/bash
                                set -euo pipefail
                                echo "═══════════════════════════════════════════════════════════"
                                echo "M1 CROSS-POD FETCH — timothy fetches blob ${blobHash} from matthew"
                                echo "═══════════════════════════════════════════════════════════"
                                # GET (not HEAD per memory feedback_head_vs_get_blob_asymmetry)
                                STATUS=\$(curl -s -o /dev/null -w '%{http_code}' \\
                                  "${timothyUrl}/blob/${blobHash}")
                                echo "Fetch status: \$STATUS"
                                if [ "\$STATUS" != "200" ]; then
                                  echo "Fetch failed — substrate did not propagate the blob"
                                  exit 1
                                fi
                                echo "Fetch successful — serve-blob EconomicEvent should be emitted"
                            """
                        }
                    }
                }
            }
        }

        stage('Warm Projection Cache') {
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.SEED_DATA }
            }}
            steps {
                container('builder') {
                    script {
                        def doorwayHost = env.RESOLVED_DOORWAY_HOST
                        sh """#!/bin/bash
                            set -euo pipefail

                            echo "═══════════════════════════════════════════════════════════"
                            echo "🔄 WARMING PROJECTION CACHE"
                            echo "═══════════════════════════════════════════════════════════"
                            echo "Doorway: ${doorwayHost}"
                            echo ""

                            RESP=\$(curl -sf -X POST "${doorwayHost}/admin/cache/warm" || echo '{}')
                            STATUS=\$(echo "\$RESP" | jq -r '.status // "error"')
                            PEERS=\$(echo "\$RESP" | jq -r '.peers // 0')

                            if [ "\$STATUS" = "warming" ]; then
                                echo "   ✅ Cache warm-up triggered (\$PEERS peer(s))"
                                echo "   ⏳ Waiting 10s for warm-up to complete..."
                                sleep 10
                            else
                                echo "   ⚠️ Cache warm-up returned: \$RESP"
                                echo "   Doorway may need restart to refresh projection cache"
                            fi
                        """
                    }
                }
            }
        }

        stage('E2E Verification') {
            when { expression { env.PIPELINE_SKIPPED != 'true' } }
            steps {
                container('builder') {
                    script {
                        def doorwayHost = env.RESOLVED_DOORWAY_HOST

                        // Install E2E driver dependencies
                        dir('genesis/a2o') {
                            sh 'pnpm install --frozen-lockfile 2>/dev/null || pnpm install'
                        }

                        // Always run API-level tests (@e2e tag, fast, no browser)
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            dir('genesis/a2o') {
                                sh """#!/bin/bash
                                    set -euo pipefail

                                    echo "═══════════════════════════════════════════════════════════"
                                    echo "🧪 E2E VERIFICATION (API)"
                                    echo "═══════════════════════════════════════════════════════════"
                                    echo "Doorway: ${doorwayHost}"
                                    echo ""

                                    E2E_DOORWAY_ALPHA="${doorwayHost}" \
                                    E2E_DOORWAY_STAGING="${doorwayHost}" \
                                        npx cucumber-js --tags '@e2e and not @browser-only and not @local' \
                                        --format progress-bar \
                                        --format json:reports/cucumber-report.json \
                                        --format html:reports/cucumber-report.html

                                    echo "✅ API E2E tests passed"
                                """
                            }
                        }

                        // Browser-mode tests (Playwright). Runs in the dedicated
                        // ci-playwright sidecar, which bundles chromium and the
                        // Playwright runtime. node_modules from the builder's
                        // pnpm install above are visible via the shared workspace.
                        env.PLAYWRIGHT_AVAILABLE = 'true'
                        catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
                            container('playwright') {
                                dir('genesis/a2o') {
                                    sh """#!/bin/bash
                                        set -euo pipefail

                                        echo "═══════════════════════════════════════════════════════════"
                                        echo "🧪 E2E VERIFICATION (BROWSER)"
                                        echo "═══════════════════════════════════════════════════════════"
                                        echo "Doorway: ${doorwayHost}"
                                        echo ""

                                        # Ensure the chromium build matches the workspace's
                                        # pnpm-resolved Playwright version. The sidecar image
                                        # bundles browsers, but a Playwright minor bump in the
                                        # workspace expects a different chromium build (see
                                        # 'chromium_headless_shell-XXXX' suffix). Idempotent.
                                        echo "🎭 ensuring matching chromium browser..."
                                        npx playwright install chromium 2>&1 | tail -5

                                        E2E_DEVICE_MODE=playwright \\
                                        E2E_DOORWAY_ALPHA="${doorwayHost}" \\
                                        E2E_STORAGE_URL="http://${env.INTERNAL_STORAGE_URL}" \\
                                            npx cucumber-js --tags '@e2e and @browser-only and not @wip' \\
                                            --format progress-bar \\
                                            --format json:reports/cucumber-report-browser.json \\
                                            --format html:reports/cucumber-report-browser.html

                                        echo "✅ Browser E2E tests passed"
                                    """
                                }
                            }
                        }

                        // Run BDD coverage gap scan (advisory)
                        catchError(buildResult: 'SUCCESS', stageResult: 'UNSTABLE') {
                            dir('genesis/a2o') {
                                sh """#!/bin/bash
                                    set -euo pipefail

                                    echo ""
                                    echo "📊 BDD Coverage Gap Scan"
                                    npx tsx scripts/scan-coverage.ts --ci --suggest 5
                                """
                            }
                        }

                        // --- Sprint-report aggregator (API run) ---
                        // Always runs (pass or fail). Non-blocking: report is informational, not a gate.
                        sh """
                          cd genesis/a2o
                          pnpm run build:sprint-report -- \\
                            --run-id \"${env.BUILD_TAG}\" \\
                            --profile \"\${CUCUMBER_PROFILE:-alpha}\" \\
                            --doorway \"\${E2E_DOORWAY_ALPHA:-}\" \\
                            || echo 'Sprint-report aggregator (API) failed (non-blocking)'
                        """

                        // --- Sprint-report aggregator (Browser run) ---
                        // Only emits when the browser stage actually ran. Profile=browser
                        // unlocks the Visual Validation 2x2 buckets and visual-regression
                        // findings in the markdown.
                        if (env.PLAYWRIGHT_AVAILABLE == 'true') {
                            sh """
                              cd genesis/a2o
                              pnpm run build:sprint-report -- \\
                                --run-id \"${env.BUILD_TAG}\" \\
                                --profile browser \\
                                --doorway \"\${E2E_DOORWAY_ALPHA:-}\" \\
                                --cucumber reports/cucumber-report-browser.json \\
                                --out-json reports/sprint-report-browser.json \\
                                --out-md reports/sprint-report-browser.md \\
                                || echo 'Sprint-report aggregator (Browser) failed (non-blocking)'
                            """
                        }

                        // Archive reports — includes per-feature screenshot subdirs
                        // when the browser stage produced any.
                        archiveArtifacts(
                            artifacts: 'genesis/a2o/reports/**',
                            allowEmptyArchive: true
                        )

                        // Publish cucumber reports through the Jenkins plugin so the
                        // build sidebar gets the "Cucumber Reports" link. Glob covers
                        // both the API report (cucumber-report.json) and the browser
                        // report (cucumber-report-browser.json) when present.
                        if (fileExists('genesis/a2o/reports/cucumber-report.json') ||
                            fileExists('genesis/a2o/reports/cucumber-report-browser.json')) {
                            cucumber([
                                reportTitle: 'A2O E2E Reports',
                                fileIncludePattern: 'cucumber-report*.json',
                                jsonReportDirectory: 'genesis/a2o/reports',
                                buildStatus: 'UNSTABLE',
                                sortingMethod: 'ALPHABETICAL',
                                trendsLimit: 10
                            ])
                        }
                    }
                }
            }
        }

    }

    post {
        success {
            script {
                echo """
═══════════════════════════════════════════════════════════
✅ GENESIS PIPELINE COMPLETE
═══════════════════════════════════════════════════════════
Target: ${env.TARGET_HOST}
Seeded: ${params.SEED_DATA}
IDs: ${params.SEED_IDS ?: '(all)'}
═══════════════════════════════════════════════════════════
                """
            }
        }
        failure {
            script {
                echo """
═══════════════════════════════════════════════════════════
❌ GENESIS PIPELINE FAILED
═══════════════════════════════════════════════════════════
Target: ${env.TARGET_HOST}
Seeded: ${params.SEED_DATA}
IDs: ${params.SEED_IDS ?: '(all)'}

Check the logs for details.
═══════════════════════════════════════════════════════════
                """
            }
        }
    }
}
