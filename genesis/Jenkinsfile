/**
 * Genesis Pipeline (elohim-genesis)
 *
 * Seeds content from genesis/data/lamad to Holochain via doorway.
 * Triggered by orchestrator after successful holochain/edge/app builds.
 *
 * Pipeline: checkout → resolve hosts → verify health → seed
 *
 * Auto-detects target environment from branch:
 *   - dev, feat-*, claude-* → alpha.elohim.host (doorway-alpha)
 *   - staging*              → staging.elohim.host (doorway-staging)
 *   - main                  → elohim.host (doorway)
 *
 * Parameters:
 *   - TARGET_HOST: Override auto-detected host (optional)
 *   - SEED_DATA: Enable/disable seeding (default: true)
 *   - SEED_IDS: Comma-separated list of specific IDs to seed (optional)
 *   - RESET_STORAGE: Reset storage databases before seeding (default: false)
 */

def resolveDoorwayHost(String targetHost, String explicitDoorway) {
    if (explicitDoorway) {
        return explicitDoorway
    }
    // Map target app URLs to environment-specific doorway URLs
    if (targetHost.contains('alpha.elohim.host')) {
        return 'https://doorway-alpha.elohim.host'
    } else if (targetHost.contains('staging.elohim.host')) {
        return 'https://doorway-staging.elohim.host'
    } else if (targetHost.contains('elohim.host') && !targetHost.contains('doorway')) {
        return 'https://doorway.elohim.host'
    }
    return targetHost.replaceFirst('://', '://doorway.')
}

def resolveInternalDoorwayUrl(String doorwayHost) {
    // Map external DNS to internal Kubernetes service DNS
    if (doorwayHost.contains('doorway-alpha.elohim.host')) {
        return 'elohim-doorway-alpha.elohim-alpha.svc.cluster.local:8080'
    } else if (doorwayHost.contains('doorway-staging.elohim.host')) {
        return 'elohim-doorway-staging.elohim-staging.svc.cluster.local:8080'
    } else if (doorwayHost.contains('doorway.elohim.host') && !doorwayHost.contains('doorway-')) {
        return 'elohim-doorway-prod.elohim-prod.svc.cluster.local:8080'
    }
    // Fallback for custom hosts
    return doorwayHost.replace('https://', '').replace('http://', '')
}

def resolveInternalStorageUrl(String doorwayHost) {
    // Points to a genesis peer's per-human storage for preflight checks.
    // The genesis peer set is declared in genesis/orchestrator/data/deployments.json
    // (genesisPeer:true) — but this resolver fires before topology.json is read,
    // so the per-env mapping is hardcoded. Keep these in sync with the active
    // genesis peer for each env.
    //   alpha:   matthew (adam is suspended pending shem replacement)
    //   staging: pete-staging was the genesis peer; suspended along with pete
    //            at the human level — point at matthew-staging when staging is
    //            re-enabled, otherwise this URL is dormant.
    //   prod:    frank-prod, same suspension story; revisit before prod runs.
    if (doorwayHost.contains('alpha.elohim.host')) {
        return 'elohim-matthew-alpha.elohim-alpha.svc.cluster.local:8090'
    } else if (doorwayHost.contains('staging.elohim.host')) {
        return 'elohim-pete-staging.elohim-staging.svc.cluster.local:8090'
    } else if (doorwayHost.contains('elohim.host') && !doorwayHost.contains('alpha') && !doorwayHost.contains('staging')) {
        return 'elohim-frank-prod.elohim-prod.svc.cluster.local:8090'
    }
    // Fallback: swap doorway→edgenode and port
    return doorwayHost.replace('https://', '').replace('http://', '').replace('doorway', 'edgenode').replaceAll(':\\d+', ':8090')
}

/**
 * Per-human storage endpoints across environments.
 * Each human has a dedicated StatefulSet in their assigned environment.
 *
 * Reads topology from genesis/orchestrator/environments/topology.json when available.
 * Falls back to alpha-concentration default (all 5 agents in alpha) if the file
 * is missing or unparseable.
 */
def getHumanStorageUrls(String ignored) {
    def topoPath = "genesis/orchestrator/environments/topology.json"
    if (fileExists(topoPath)) {
        try {
            def topo = new groovy.json.JsonSlurper().parseText(readFile(topoPath))
            return topo.humans.collect { h ->
                [
                    humanId:     h.humanId,
                    service:     h.resourcePrefix,
                    namespace:   h.namespace,
                    storageUrl:  h.storageUrl.replaceFirst('^https?://', ''),
                    genesisPeer: (h.genesisPeer == true),
                ]
            }
        } catch (Exception e) {
            echo "WARN: Failed to parse topology.json, using alpha-concentration fallback: ${e.message}"
        }
    }

    // Fallback: alpha-concentration when topology.json is missing/unparseable.
    // Genesis peers (genesisPeer:true) ingest content directly during seeding;
    // everyone else replicates via P2P. Mirrors the active alpha entries in
    // genesis/orchestrator/data/deployments.json: matthew + adam are the
    // genesis pair (matthew on-prem, adam on shem), jessica is the on-prem
    // non-genesis device that exercises P2P replication.
    def humans = [
        [humanId: 'human-matthew-manager',  service: 'elohim-matthew-alpha',   namespace: 'elohim-alpha', genesisPeer: true],
        [humanId: 'human-adam-firstman',    service: 'elohim-adam-alpha',      namespace: 'elohim-alpha', genesisPeer: true],
        [humanId: 'human-jessica-spouse',   service: 'elohim-jessica-alpha',   namespace: 'elohim-alpha', genesisPeer: false],
    ]
    return humans.collect { h ->
        h + [storageUrl: "${h.service}.${h.namespace}.svc.cluster.local:8090"]
    }
}

/**
 * Build comma-separated CONDUCTOR_URLS for non-suspended humans whose
 * agencyPhase is node, doorway, or device. Each URL points at the conductor's
 * app WebSocket port; the seeder derives admin port (= app port - 1) per the
 * existing socat convention in K8s.
 */
def getConductorAppUrls() {
    def topoPath = "genesis/orchestrator/environments/topology.json"
    def humans = []
    if (fileExists(topoPath)) {
        try {
            def topo = new groovy.json.JsonSlurper().parseText(readFile(topoPath))
            humans = topo.humans ?: []
        } catch (e) {
            echo "WARN: topology.json parse failed for conductor URLs: ${e.message}"
        }
    }
    if (humans.isEmpty()) {
        // Fallback: alpha-concentration default (mirrors getHumanStorageUrls).
        humans = [
            [name: 'matthew', service: 'elohim-matthew-alpha', namespace: 'elohim-alpha', agencyPhase: 'doorway'],
            [name: 'adam',    service: 'elohim-adam-alpha',    namespace: 'elohim-alpha', agencyPhase: 'doorway'],
            [name: 'jessica', service: 'elohim-jessica-alpha', namespace: 'elohim-alpha', agencyPhase: 'device'],
        ]
    }
    def urls = humans
        .findAll { ['node', 'doorway', 'device'].contains(it.agencyPhase) }
        .findAll { !it.suspended }
        .collect { "ws://${it.service}.${it.namespace}.svc.cluster.local:4445" }
    return urls.join(',')
}

/**
 * Derive shem availability from the durable home (genesis/manifests/cluster-state.yaml) — the CI
 * twin of humans.ts deriveRemoteComputeFromClusterState() / substrate-scope.ts. Returns
 * 'available'/'unavailable', or null when the file is unreadable (caller keeps the legacy
 * fail-open). Line-based parse (no YAML dep on the agent): walk `  <name>:` → `    available: <v>`;
 * shem available iff exactly `true`. shem block absent / no available: line → 'unavailable'
 * (the conservative read for a cross-node canvas).
 */
def deriveRemoteComputeFromClusterState() {
    def path = 'genesis/manifests/cluster-state.yaml'
    if (!fileExists(path)) { return null }
    boolean inShem = false
    for (String ln : readFile(path).split('\n')) {
        // A resource key: exactly 2-space indent then `<name>:` to EOL. `==~` returns a boolean, so
        // no non-serializable Matcher is retained across the loop — CPS-safe (the file's idiom).
        if (ln ==~ /^ {2}[A-Za-z0-9_-]+:\s*$/) {
            inShem = (ln.trim() == 'shem:')
            continue
        }
        if (!inShem) { continue }
        def t = ln.trim()
        if (t.startsWith('available:')) {
            def val = t.substring('available:'.length()).trim().split(/\s+/)[0]
            return (val == 'true') ? 'available' : 'unavailable'
        }
    }
    return 'unavailable'
}

/**
 * Probe the "remote" k8s node pool (shem) and return the substrate signal the whole pipeline
 * reconciles to: 'available' | 'unavailable'. (Never 'unknown' — a blind probe RECONCILES.)
 *
 * This is the single toggle the deployment-wait, seeder, and a2o test bench all key off (via
 * env.ELOHIM_REMOTE_COMPUTE_STATUS). The P2P substrate itself stays k8s-blind — this CI-layer probe
 * only exists so the planning/test scope reconciles to the available compute as the hardware shifts.
 *
 * Semantics:
 *   - shem Ready=True                                → 'available'
 *   - shem Ready=Unknown/False, or node absent       → 'unavailable'
 *   - cluster unreachable (kubectl blind from this agent) → RECONCILE to cluster-state.yaml (the
 *     durable home) instead of failing OPEN. A blind probe must NOT silently treat shem as up —
 *     that runs shem scenarios against down pods and masks the real test-layer signal. The two
 *     signal homes (cluster-state.yaml + ELOHIM_REMOTE_COMPUTE_STATUS) cannot disagree
 *     (project_ci_reconciles_to_substrate_signal). Only if cluster-state.yaml is itself unreadable
 *     do we keep the legacy fail-open ('available').
 *
 * The doc contract lives in genesis/a2o/src/framework/fixtures/humans.ts + substrate-scope.ts
 * (ELOHIM_REMOTE_COMPUTE_STATUS / isRemoteComputeAvailable / isHumanDeployed / @requires:<cap>).
 */
def probeRemotePoolStatus() {
    def status = sh(returnStdout: true, script: '''#!/bin/bash
        set -uo pipefail
        # Blind probe: if we can't even list nodes, say so — the caller reconciles to cluster-state.
        if ! kubectl get nodes >/dev/null 2>&1; then
            echo "unknown"; exit 0
        fi
        READY=$(kubectl get node shem \
            -o jsonpath='{.status.conditions[?(@.type=="Ready")].status}' 2>/dev/null || echo "")
        if [ "$READY" = "True" ]; then
            echo "available"
        else
            echo "unavailable"
        fi
    ''').trim()
    if (!(status in ['available', 'unavailable', 'unknown'])) { status = 'unknown' }
    if (status == 'unknown') {
        def derived = deriveRemoteComputeFromClusterState()
        if (derived != null) {
            echo "ℹ️  Probe blind (kubectl unreachable) — reconciling to cluster-state.yaml: shem=${derived}"
            return derived
        }
        echo "⚠️  Probe blind AND cluster-state.yaml unreadable — keeping legacy fail-open (available)."
        return 'available'
    }
    return status
}

/**
 * Personas that auto-skip when the remote pool (shem) is down: those whose
 * nodeTypes are ALL "remote" (no on-prem fallback) and are not hard-suspended.
 * Mirrors isAnyNodePoolAvailable() in humans.ts so the pipeline banner names
 * exactly the set the a2o runner will gate. Reads deployments.json (the same
 * source of truth the test bench reads). Returns [] on any parse failure
 * (fail-open: a banner is informational, never a gate).
 */
def remoteOnlyHumanRecords() {
    def path = 'genesis/orchestrator/data/deployments.json'
    if (!fileExists(path)) { return [] }
    try {
        def data = new groovy.json.JsonSlurper().parseText(readFile(path))
        return (data.humans ?: []).findAll { h ->
            def nt = h.nodeTypes ?: []
            !h.suspended && nt && nt.every { it == 'remote' }
        }
    } catch (Exception e) {
        echo "WARN: remoteOnlyHumanRecords() parse failed: ${e.message}"
        return []
    }
}

def remoteOnlyPersonas() {
    return remoteOnlyHumanRecords().collect { it.name }.findAll { it }.sort()
}

/** humanIds (e.g. 'human-adam-firstman') of remote-only personas — the seeder keys genesis-peer
 * holding off these, since the seeder topology carries humanId, not the short name. */
def remoteOnlyHumanIds() {
    return remoteOnlyHumanRecords().collect { it.humanId }.findAll { it }.sort()
}

/**
 * Bounded readiness probe for a single peer's storage /health. Returns true
 * if it answered within maxAttempts (×2s), false otherwise. The basis of the
 * "seed whoever is ready" discipline: a slow cold-starting peer still gets its
 * full wait, but a peer whose hardware is gone is skipped rather than
 * cascade-failing the stage. Never throws — callers branch on the boolean.
 */
def waitForStorageReady(String storageUrl, String label, int maxAttempts = 60) {
    return sh(returnStatus: true, script: """#!/bin/bash
        set -uo pipefail
        for i in \$(seq 1 ${maxAttempts}); do
            if curl -sf --max-time 5 "http://${storageUrl}/health" >/dev/null 2>&1; then
                echo "✅ ${label} storage is ready (\$i/${maxAttempts})"
                exit 0
            fi
            echo "   Waiting for ${label} storage... (\$i/${maxAttempts})"
            sleep 2
        done
        echo "⏭️  ${label} storage not ready after ${maxAttempts} attempts"
        exit 1
    """) == 0
}

/**
 * Probe Substrate stage body (extracted to keep the pipeline {} CPS method
 * under the 64KB JVM limit — see .claude/hooks/jenkinsfile-method-size.py).
 * Sets env.ELOHIM_REMOTE_COMPUTE_STATUS (the single signal the run reconciles to),
 * emits a loud reduced-scope banner, archives substrate-status.json, and
 * marks the build UNSTABLE (not FAILED) when the remote pool is down.
 */
def probeSubstrateScope() {
    def remoteComputeStatus = probeRemotePoolStatus()
    env.ELOHIM_REMOTE_COMPUTE_STATUS = remoteComputeStatus

    def skipped = (remoteComputeStatus == 'unavailable') ? remoteOnlyPersonas() : []

    echo """
═══════════════════════════════════════════════════════════
🛰️  SUBSTRATE PROBE — remote pool (shem): ${remoteComputeStatus.toUpperCase()}
═══════════════════════════════════════════════════════════"""
    if (remoteComputeStatus == 'unavailable') {
        echo """⚠️  REDUCED SCOPE — operating on available compute only.
   On-prem household (matthew, jessica, james) carries this run.
   Auto-skipped remote-only personas (${skipped.size()}): ${skipped.join(', ') ?: '(none declared)'}
   Seeder will seed whoever is ready; a2o will gate remote-only scenarios.
   This run is intentionally UNSTABLE (loud signal), not FAILED — re-run
   when shem returns to restabilize to full topology."""
    } else {
        // probeRemotePoolStatus() reconciles a blind probe to cluster-state.yaml, so the status is
        // always 'available' or 'unavailable' here — never a fail-open 'unknown'.
        echo "✅ Full topology available — no reduced-scope gating this run."
    }

    writeJSON(file: 'substrate-status.json', pretty: 2, json: [
        schemaVersion: '1',
        probedAt: new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC')),
        commitSha: env.GIT_COMMIT_FULL ?: env.GIT_COMMIT ?: '',
        remotePool: 'shem',
        remoteComputeStatus: remoteComputeStatus,
        reducedScope: (remoteComputeStatus == 'unavailable'),
        autoSkippedPersonas: skipped,
    ])
    archiveArtifacts(artifacts: 'substrate-status.json', allowEmptyArchive: true, fingerprint: true)

    if (remoteComputeStatus == 'unavailable') {
        unstable("Remote pool (shem) unavailable — running reduced scope; ${skipped.size()} remote-only personas auto-skipped")
    }
}

/**
 * Seed Database stage body (extracted for the 64KB CPS limit). Implements the
 * "seed whoever is ready" discipline so the content-seed stage reconciles to
 * the available compute instead of cascade-failing when a peer's hardware is
 * gone:
 *   - Genesis peers: seed each that becomes ready; SKIP (not fatal) any that
 *     don't. Fatal ONLY if zero genesis peers seeded (nothing to ingest from).
 *     Honors deployments.json's documented "pipeline tolerates 1..N genesis
 *     peers" contract.
 *   - Replica peers: wait for P2P catch-up; a down/lagging replica is SKIPPED
 *     (never fatal) — it reconverges via identity-driven replication when it
 *     returns.
 * Any skip marks the build UNSTABLE (loud signal), never silently green.
 */
def runContentSeedStage() {
    def humans = getHumanStorageUrls('alpha')
    def genesisPeers = humans.findAll { it.genesisPeer == true }

    // Substrate-aware genesis set: a remote-only genesis peer (e.g. adam, hard-pinned to shem) cannot
    // ingest while the remote pool is down — drop it so the seeder doesn't wait 120s on a known-down
    // peer and so no e2e expects content from it. The household genesis peer (matthew) carries the
    // run. This reconciles to the substrate signal (env override wins, else cluster-state) instead of
    // a static genesisPeer flag that drifts as shem comes and goes (feedback_shem_down_peers_are_held;
    // adam's genesisPeer:true stays correct-when-shem-is-up — the GATE is at consumption, here).
    def remoteStatus = env.ELOHIM_REMOTE_COMPUTE_STATUS
    if (!(remoteStatus in ['available', 'unavailable'])) {
        remoteStatus = deriveRemoteComputeFromClusterState() ?: 'available'
    }
    if (remoteStatus == 'unavailable') {
        def remoteIds = remoteOnlyHumanIds()
        def heldGenesis = genesisPeers.findAll { remoteIds.contains(it.humanId) }
        if (!heldGenesis.isEmpty()) {
            echo "🛰️  Holding remote-only genesis peer(s) while shem is down: ${heldGenesis.collect { it.humanId }.join(', ')} — household genesis (matthew) carries ingest."
        }
        genesisPeers = genesisPeers.findAll { !remoteIds.contains(it.humanId) }
    }

    if (genesisPeers.isEmpty()) {
        error("No genesis peer found in topology — at least one non-remote human in deployments.json must have genesisPeer:true (and must not be suspended), OR the remote pool must be available. See genesis/orchestrator/data/deployments.json + genesis/manifests/cluster-state.yaml.")
    }
    def replicaPeers = humans.findAll { it.genesisPeer != true }

    echo "Substrate signal: ELOHIM_REMOTE_COMPUTE_STATUS=${env.ELOHIM_REMOTE_COMPUTE_STATUS ?: 'unknown'} — seeding whoever is ready"
    echo "Genesis peers (direct ingest): ${genesisPeers.collect { it.humanId }.join(', ')}"
    echo "Replica peers (P2P replication): ${replicaPeers.collect { it.humanId }.join(', ')}"

    // ── Genesis peers: seed whoever is ready (fatal only if zero seeded) ──
    def seededGenesis = []
    def skippedGenesis = []
    for (gp in genesisPeers) {
        if (!waitForStorageReady(gp.storageUrl, gp.service, 60)) {
            echo "⏭️  Skipping genesis peer ${gp.humanId} — storage unreachable (seed-whoever-is-ready)"
            skippedGenesis << gp.humanId
            continue
        }
        dir('genesis/seeder') {
            sh """#!/bin/bash
                set -euo pipefail
                echo "═══════════════════════════════════════════════════════════"
                echo "🌱 SEEDING GENESIS PEER: ${gp.humanId} (${gp.storageUrl})"
                echo "═══════════════════════════════════════════════════════════"
                # Direct seed via SQLite write; replica peers receive it through
                # P2P identity-driven replication. Idempotent across genesis
                # peers — each peer's SQLite settles to the same content set.
                STORAGE_URL="http://${gp.storageUrl}" npx tsx src/seed-sqlite.ts
                echo "✅ ${gp.humanId} seeded successfully"
            """
        }
        seededGenesis << gp.humanId
    }
    if (seededGenesis.isEmpty()) {
        error("No genesis peer became ready — nothing seeded. At least one genesis peer's storage must answer (skipped: ${skippedGenesis.join(', ')}). If the remote pool is down, an on-prem genesis peer such as matthew must be healthy.")
    }
    if (!skippedGenesis.isEmpty()) {
        unstable("Seeded genesis peers: ${seededGenesis.join(', ')}; skipped unreachable: ${skippedGenesis.join(', ')} — partial-cluster steady state (seed whoever is ready)")
    }

    // ── Replica peers: wait for P2P catch-up; never fatal ──
    def laggingReplicas = []
    for (peer in replicaPeers) {
        if (!waitForStorageReady(peer.storageUrl, peer.service, 30)) {
            echo "⏭️  Replica ${peer.humanId} storage unreachable — will reconverge when it returns"
            laggingReplicas << peer.humanId
            continue
        }
        def rc = sh(returnStatus: true, script: """#!/bin/bash
            set -uo pipefail
            echo "⏳ WAITING FOR REPLICATION: ${peer.humanId} (${peer.storageUrl})"
            DEADLINE=\$((SECONDS + 600))
            while [ \$SECONDS -lt \$DEADLINE ]; do
                STATUS=\$(curl -sf "http://${peer.storageUrl}/p2p/status" 2>/dev/null || echo '{}')
                CAUGHT_UP=\$(echo "\$STATUS" | jq -r '.replication.caughtUp // false')
                COMPLETED=\$(echo "\$STATUS" | jq -r '.replication.completed // 0')
                PENDING=\$(echo "\$STATUS" | jq -r '.replication.pending // 0')
                # COMPLETED=0 is valid when the peer already had everything.
                if [ "\$CAUGHT_UP" = "true" ] && [ "\$PENDING" = "0" ]; then
                    echo "✅ ${peer.humanId} caught up: \$COMPLETED replicated this run, 0 pending"
                    exit 0
                fi
                echo "   ${peer.humanId}: \$COMPLETED completed, \$PENDING pending"
                sleep 10
            done
            echo "⏭️  ${peer.humanId} replication not caught up within 600s"
            exit 1
        """)
        if (rc != 0) {
            laggingReplicas << peer.humanId
        }
    }
    if (!laggingReplicas.isEmpty()) {
        unstable("Replica peers not yet caught up (reconverge when reachable): ${laggingReplicas.join(', ')}")
    }

    // ── Summary (graceful — curl failures fall through to 0) ──
    echo "═══════════════════════════════════════════════════════════"
    echo "📊 SEEDING SUMMARY (seeded: ${seededGenesis.join(', ')})"
    echo "═══════════════════════════════════════════════════════════"
    for (human in humans) {
        sh """#!/bin/bash
            STATS=\$(curl -sf "http://${human.storageUrl}/db/stats" 2>/dev/null || echo '{}')
            COUNT=\$(echo "\$STATS" | jq -r '.contentCount // 0')
            echo "   ${human.humanId}: \$COUNT content nodes"
        """
    }
}

/**
 * Verify Seeding stage body (extracted for the 64KB CPS limit). Reconciles to
 * available compute: verifies REACHABLE peers, tolerates unreachable ones
 * (UNSTABLE, not FAILED). Fatal only on a real seed defect — a reachable peer
 * that is empty, or zero reachable peers with content. The assessment
 * spot-check runs on the first REACHABLE genesis peer, never a skipped one.
 */
def runVerifySeedingStage() {
    def humans = getHumanStorageUrls('alpha')
    def genesisPeers = humans.findAll { it.genesisPeer == true }
    if (genesisPeers.isEmpty()) {
        error("No genesis peer found in topology — at least one human in deployments.json must have genesisPeer:true (and must not be suspended).")
    }

    echo "═══════════════════════════════════════════════════════════"
    echo "🔍 VERIFYING SEEDING (reachable peers only — reconcile to available compute)"
    echo "═══════════════════════════════════════════════════════════"

    def verified = []
    def unreachable = []
    def empty = []
    for (human in humans) {
        def count = sh(returnStdout: true, script: """#!/bin/bash
            set -uo pipefail
            STATS=\$(curl -sf --max-time 5 "http://${human.storageUrl}/db/stats" 2>/dev/null || echo '')
            if [ -z "\$STATS" ]; then echo "-1"; exit 0; fi
            echo "\$STATS" | jq -r '.contentCount // 0'
        """).trim()
        if (count == '-1' || count == '') {
            echo "   ⏭️  ${human.humanId}: storage unreachable — skipped (reconciled out this run)"
            unreachable << human.humanId
        } else if (count == '0') {
            echo "   ❌ ${human.humanId}: 0 content (reachable but empty — real failure)"
            empty << human.humanId
        } else {
            echo "   ✅ ${human.humanId}: ${count} content"
            verified << human.humanId
        }
    }

    if (!empty.isEmpty()) {
        error("Reachable peer(s) seeded empty (seed defect, not a substrate skip): ${empty.join(', ')}")
    }
    if (verified.isEmpty()) {
        error("No reachable peer has content — seeding cannot be verified. Unreachable: ${unreachable.join(', ')}")
    }
    if (!unreachable.isEmpty()) {
        unstable("Verified ${verified.join(', ')}; skipped unreachable peers: ${unreachable.join(', ')} (partial-cluster steady state)")
    }

    // Assessment spot-check on the first REACHABLE genesis peer (idempotent
    // direct seeding means every genesis peer holds the same content).
    def checkPeer = genesisPeers.find { verified.contains(it.humanId) }
    if (!checkPeer) {
        echo "⚠️  No reachable genesis peer for the assessment spot-check — skipping (replicas verified above)"
        return
    }
    def genesisUrl = checkPeer.storageUrl
    sh """#!/bin/bash
        set -euo pipefail
        echo ""
        echo "🔬 Verifying assessment content on genesis peer (${checkPeer.humanId})..."
        for ASSESSMENT_ID in assessment-personal-values assessment-values-hierarchy; do
            ASSESSMENT=\$(curl -sf "http://${genesisUrl}/db/content/\$ASSESSMENT_ID" || echo '{}')
            FMT=\$(echo "\$ASSESSMENT" | jq -r '.contentFormat // empty')
            if [ -z "\$FMT" ]; then
                echo "   ⚠️ Assessment '\$ASSESSMENT_ID' not found"
                continue
            fi
            if [ "\$FMT" = "markdown" ]; then
                echo "   ❌ Assessment '\$ASSESSMENT_ID' has format 'markdown' (likely defaulted from unknown format)"
                exit 1
            fi
            HAS_WIDGETS=\$(echo "\$ASSESSMENT" | jq -r '.contentBody' | jq -e '.[0].content.widgets | length > 0' 2>/dev/null && echo "yes" || echo "no")
            if [ "\$HAS_WIDGETS" = "yes" ]; then
                echo "   ✅ Assessment '\$ASSESSMENT_ID': format=\$FMT, widgets present"
            else
                echo "   ⚠️ Assessment '\$ASSESSMENT_ID': format=\$FMT, no widgets in content body"
            fi
        done
        echo ""
        echo "═══════════════════════════════════════════════════════════"
        echo "✅ SEEDING VERIFIED"
        echo "═══════════════════════════════════════════════════════════"
    """
}

/**
 * Probe each conductor's admin WebSocket port for reachability before
 * invoking the seeder. Returns [ready: [...urls], unready: [...urls]]
 * and writes a structured conductor-readiness.json artifact.
 *
 * Aligns with the "seed whoever is ready" principle: partial-cluster
 * operation is the steady state, not an exception. If a peer's admin
 * WS is down, we want to seed the rest and report it as unready — not
 * waste 150s of WebSocket-timeout-loop trying to seed against a dead
 * conductor.
 *
 * The probe is a 2-second TCP connect to the admin port (= app port - 1
 * per the socat convention; see seed-conductor-identities.ts:106-115).
 * TCP success is necessary but not sufficient for WS handshake; if the
 * conductor TCP-accepts but rejects the WS upgrade, the seeder will
 * still surface that as a per-peer failure. The probe just eliminates
 * the obvious "pod is dead" case fast.
 *
 * @param urlsString  comma-separated app URLs from getConductorAppUrls()
 * @param stageLabel  human-readable stage name (for the artifact)
 * @return            [ready: [...urls], unready: [...urls],
 *                     readyDetails: [...{url, host, adminPort}],
 *                     unreadyDetails: [...{url, host, adminPort, reason}]]
 */
def probeConductorReadiness(String urlsString, String stageLabel) {
    def readyDetails = []
    def unreadyDetails = []

    def urls = (urlsString ?: '').split(',').collect { it.trim() }.findAll { it }
    urls.each { String appUrl ->
        // Strip ws:// then split host:port. Defensive against malformed
        // entries from topology.json — we don't want a typo to throw and
        // cascade-fail the whole seed stage.
        def stripped = appUrl.replaceFirst(/^wss?:\/\//, '')
        def parts = stripped.split(':')
        if (parts.size() < 2 || !parts[1].isInteger()) {
            echo "[probe] ⚠️  Malformed URL — skipping: ${appUrl}"
            unreadyDetails.add([url: appUrl, reason: 'malformed-url'])
            return
        }
        def host = parts[0]
        def appPort = parts[1].toInteger()
        def adminPort = appPort - 1

        // Sanity check on host shape — K8s DNS uses [a-z0-9.-]+ only.
        // Anything else likely came from a broken topology entry; treat
        // as unready rather than risk shell interpolation surprises.
        if (!(host ==~ /[a-z0-9.\-]+/)) {
            echo "[probe] ⚠️  Suspicious host shape — skipping: ${host}"
            unreadyDetails.add([url: appUrl, host: host, reason: 'suspicious-host'])
            return
        }

        // 2-second TCP probe via /dev/tcp (no nc dependency required).
        // returnStatus: 0 on connect, non-zero on timeout / refused / DNS fail.
        def probeExit = sh(
            script: "timeout 2 bash -c 'echo > /dev/tcp/${host}/${adminPort}' 2>/dev/null",
            returnStatus: true
        )

        if (probeExit == 0) {
            readyDetails.add([url: appUrl, host: host, adminPort: adminPort])
            echo "[probe] ✅ ${host}:${adminPort} reachable"
        } else {
            unreadyDetails.add([url: appUrl, host: host, adminPort: adminPort, reason: 'tcp-timeout-or-refused'])
            echo "[probe] ❌ ${host}:${adminPort} unreachable (admin WS not accepting TCP)"
        }
    }

    // Emit structured artifact. Schema is intentionally compatible with
    // future stageAnnotations work that would feed conductor-readiness
    // into actual-build-graph.json's per-pipeline result map.
    def report = [
        schemaVersion: '1',
        probedAt: new Date().format("yyyy-MM-dd'T'HH:mm:ss'Z'", TimeZone.getTimeZone('UTC')),
        stage: stageLabel,
        commitSha: env.GIT_COMMIT_FULL ?: env.GIT_COMMIT ?: '',
        readyCount: readyDetails.size(),
        unreadyCount: unreadyDetails.size(),
        partial: readyDetails.size() > 0 && unreadyDetails.size() > 0,
        allReady: unreadyDetails.isEmpty(),
        allUnready: readyDetails.isEmpty(),
        ready: readyDetails,
        unready: unreadyDetails,
    ]
    // Filename comes from build-artifacts.json via env var set in Checkout.
    // Elvis fallback handles edge cases where Checkout's bootstrap was skipped
    // (e.g. helper invoked from a probe-only mode). Drift detection lives in
    // genesis/orchestrator/build-artifacts.test.mjs.
    def conductorReadinessFile = env.CONDUCTOR_READINESS_FILE ?: 'conductor-readiness.json'
    writeJSON(file: conductorReadinessFile, json: report, pretty: 2)
    archiveArtifacts(artifacts: conductorReadinessFile, allowEmptyArchive: true, fingerprint: true)

    return [
        ready: readyDetails.collect { it.url },
        unready: unreadyDetails.collect { it.url },
        readyDetails: readyDetails,
        unreadyDetails: unreadyDetails,
    ]
}

/**
 * Run a probe-then-seed stage: TCP-probe each conductor's admin WS,
 * pass only ready URLs to the named seeder script, parse the structured
 * seed-results-*.json artifact, archive it. Returns a Map describing
 * the run so the caller can format stage-specific UNSTABLE messages.
 *
 * Extracted from the two seed stages (Seed Conductor Identities + Seed
 * Agent Peer Bindings) which had ~80 lines of near-identical inline
 * logic. Keeps the pipeline { } CPS method under the 64KB JVM limit.
 *
 * @param stageLabel       human-readable stage name (for probe + console)
 * @param scriptName       seeder script under genesis/seeder/src/
 * @param seedResultsName  basename of the seed-results-*.json artifact
 * @return Map [skipped, exitCode, seedReport, seedResultsName]
 */
def runProbedSeeder(String stageLabel, String scriptName, String seedResultsName) {
    def conductorUrls = getConductorAppUrls()
    if (!conductorUrls) {
        echo "WARN: no conductor URLs resolved — skipping ${stageLabel}"
        return [skipped: true]
    }

    def probe = probeConductorReadiness(conductorUrls, stageLabel)

    if (probe.ready.isEmpty()) {
        // All conductors unreachable — partial-cluster principle:
        // mark UNSTABLE not FAILED, household is recoverable.
        unstable("All ${probe.unready.size()} conductors unreachable — skipping seed (see conductor-readiness.json)")
        return [skipped: true, allUnready: true]
    }

    if (!probe.unready.isEmpty()) {
        unstable("${probe.unready.size()} of ${probe.ready.size() + probe.unready.size()} conductors unready — seeding ${probe.ready.size()} reachable peers (see conductor-readiness.json)")
    }

    def readyUrls = probe.ready.join(',')

    // Run the seeder; capture exit code so we can interpret the
    // partial-vs-total split (0=clean, 2=partial, 1=total).
    def seedExit = -1
    dir('genesis/seeder') {
        seedExit = sh(
            script: """#!/bin/bash
                set -uo pipefail
                echo "═══════════════════════════════════════════════════════════"
                echo "${stageLabel.toUpperCase()}"
                echo "═══════════════════════════════════════════════════════════"
                echo "Conductors (ready): ${readyUrls}"
                echo ""
                CONDUCTOR_URLS="${readyUrls}" \\
                  npx tsx src/${scriptName}
            """,
            returnStatus: true,
        )
    }

    def seedResultsPath = "genesis/seeder/${seedResultsName}"
    def seedReport = null
    if (fileExists(seedResultsPath)) {
        archiveArtifacts(
            artifacts: seedResultsPath,
            fingerprint: true,
            allowEmptyArchive: true,
        )
        seedReport = readJSON(file: seedResultsPath)
    }

    return [
        skipped: false,
        exitCode: seedExit,
        seedReport: seedReport,
        seedResultsName: seedResultsName,
    ]
}

def shouldRunStep(String stepName) {
    def steps = (params.STEPS ?: 'all').split(',').collect { it.trim() }
    return steps.contains('all') || steps.contains(stepName)
}

/**
 * Seeds the EPR-projection REA commitments — one per (doorway, EPR, urlPath)
 * tuple — that the doorway's EprRouter polls from
 * /api/v1/commitments?action=project-epr and uses to dispatch path-prefix
 * routes (/, /lamad, /auth/portal) back through /apps/{slug}/* serving.
 *
 * Without these commitments alpha returns 404 for /lamad and serves the
 * landing bundle only via /apps/... (relative chunks 404 because
 * <base href="/"> resolves them to the root projection which doesn't exist).
 *
 * References:
 *   - genesis/seeder/src/seed-projections.ts (default set: 6 commitments —
 *     landing/lamad/imagodei across alpha-elohim-host + elohim-host)
 *   - doorway/doorway-service/src/main.rs:554-595 (EprRouter refresh loop)
 *   - doorway/doorway-service/src/server/http.rs:1354-1378 (dispatch site)
 *   - .claude/shifts/2026-05-26T08-30-deliver-epr-app-iter0.sprint-result.md
 *     (Gap A diagnosis — this stage closes it)
 *   - genesis/docs/superpowers/plans/2026-05-23-spa-blob-deploy-drift.md
 *     (related substrate work — dev response §682-695 confirms
 *     `storage-api-key-admin` is the canonical credential)
 *
 * Idempotent: re-runs collapse to 409 (id content-addressed over
 * steward_peer_id + action + scope per seed-projections.ts:130).
 *
 * Body extracted to a helper above pipeline {} so the giant pipeline block
 * stays under the 64KB CPS method-size limit (see .claude/hooks/jenkinsfile-
 * method-size.py for the gate).
 */
def seedProjectionsStage() {
    def doorwayHost = env.RESOLVED_DOORWAY_HOST
    def apiKey = ''
    try {
        withCredentials([string(credentialsId: 'storage-api-key-admin', variable: 'ADMIN_KEY')]) {
            apiKey = env.ADMIN_KEY
        }
    } catch (e) {
        echo "storage-api-key-admin credential not visible — seeding without admin auth (may 401)"
    }
    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
        dir('genesis/seeder') {
            withEnv(["DOORWAY_API_KEY=${apiKey}"]) {
                sh """#!/bin/bash
                    set -euo pipefail
                    echo "═══════════════════════════════════════════════════════════"
                    echo "SEED PROJECTIONS (EPR project-epr commitments)"
                    echo "═══════════════════════════════════════════════════════════"
                    echo "Doorway: ${doorwayHost}"
                    echo "Admin key: \${DOORWAY_API_KEY:+provided}\${DOORWAY_API_KEY:-not set}"
                    echo ""
                    DOORWAY_URL="${doorwayHost}" npx tsx src/seed-projections.ts
                """
            }
        }
    }

    // Force a doorway pod restart so the EprRouter's boot-time fetch
    // (main.rs:567 — fetch_projections_from_storage) picks up the freshly
    // seeded project-epr commitments. The router only refreshes at boot
    // OR via SSE 'projection.registered' events (storage_events_subscriber.rs:238),
    // and the SSE path is currently flaky in alpha (warmup.lastError to
    // emma-alpha visible on /health/startup). A pod-delete is the
    // deterministic refresh — the Deployment controller recreates the
    // pod immediately, and its boot loads the now-populated commitments.
    //
    // RBAC note: `ee-jenkins` service account cannot `get deployments`
    // in elohim-alpha (RBAC-forbidden error observed in build #1041 when
    // we tried `kubectl rollout restart deployment/...`). But it CAN
    // manage pods directly — the Reset Storage stage at line ~538 uses
    // `kubectl delete pod` against storage pods successfully. So we use
    // the pods API here too. Hedge across two label conventions then
    // fall back to grep, so cluster label drift doesn't silently miss.
    //
    // Empirically observed in build #1039 that Seed Projections created
    // 6 commitments but doorway-alpha's running pod (commit b45ad43,
    // pre-seed) never picked them up — proving the pod restart is the
    // missing handoff. Wrapped in catchError so an RBAC issue doesn't
    // mask the seed itself succeeding.
    catchError(buildResult: 'UNSTABLE', stageResult: 'UNSTABLE') {
        def deployment = ''
        def namespace = ''
        if (doorwayHost.contains('doorway-alpha.elohim.host')) {
            deployment = 'elohim-doorway-alpha'
            namespace = 'elohim-alpha'
        } else if (doorwayHost.contains('doorway-staging.elohim.host')) {
            deployment = 'elohim-doorway-staging'
            namespace = 'elohim-staging'
        } else if (doorwayHost.contains('doorway.elohim.host') && !doorwayHost.contains('doorway-')) {
            deployment = 'elohim-doorway-prod'
            namespace = 'elohim-prod'
        }

        if (deployment && namespace) {
            sh """#!/bin/bash
                set -uo pipefail
                echo "═══════════════════════════════════════════════════════════"
                echo "RESTART DOORWAY POD — refresh EprRouter post-seed"
                echo "═══════════════════════════════════════════════════════════"
                echo "Namespace: ${namespace}"
                echo "Target:    pods matching '${deployment}'"
                echo ""

                # Try canonical k8s recommended label first, then a common
                # alternative, then a grep-by-name fallback. Each branch is
                # gated on the prior branch failing (-z stdout check).
                PODS=\$(kubectl get pods -n ${namespace} -l app.kubernetes.io/name=${deployment} -o name 2>/dev/null || true)
                if [ -z "\$PODS" ]; then
                    PODS=\$(kubectl get pods -n ${namespace} -l app=${deployment} -o name 2>/dev/null || true)
                fi
                if [ -z "\$PODS" ]; then
                    PODS=\$(kubectl get pods -n ${namespace} -o name 2>/dev/null | grep -F "${deployment}" || true)
                fi

                if [ -n "\$PODS" ]; then
                    echo "Deleting pods:"
                    echo "\$PODS" | sed 's/^/  /'
                    echo ""
                    echo "\$PODS" | xargs -r kubectl delete -n ${namespace} --wait=false
                    echo ""
                    echo "✓ doorway pods deleted; Deployment controller will recreate"
                    echo "  New pod's boot will fetch project-epr commitments from storage"
                    echo "  → EprRouter populated → / and /lamad serve 200"
                    echo ""
                    echo "  Verify (60s after this stage):"
                    echo "    curl -s https://alpha.elohim.host/version  # commit should flip off b45ad43"
                    echo "    curl -sI https://alpha.elohim.host/lamad  # should be 200"
                else
                    echo "WARNING: no doorway pods matched any selector in ${namespace}"
                    echo "  Tried: -l app.kubernetes.io/name=${deployment}"
                    echo "         -l app=${deployment}"
                    echo "         pod name grep '${deployment}'"
                    kubectl get pods -n ${namespace} 2>&1 | head -20 || true
                    exit 1
                fi
            """
        } else {
            echo "Skipping doorway pod restart — unrecognized doorwayHost: ${doorwayHost}"
        }
    }
}

pipeline {
    agent {
        kubernetes {
            cloud 'kubernetes'
            yaml '''
apiVersion: v1
kind: Pod
spec:
  serviceAccount: ee-jenkins
  nodeSelector:
    node-type: edge
  containers:
  - name: builder
    image: harbor.ethosengine.com/ethosengine/ci-builder:latest
    command:
    - cat
    tty: true
    resources:
      requests:
        ephemeral-storage: "2Gi"
        memory: "2Gi"
      limits:
        ephemeral-storage: "5Gi"
        memory: "4Gi"
  - name: playwright
    image: harbor.ethosengine.com/ethosengine/ci-playwright:latest
    command:
    - cat
    tty: true
    resources:
      requests:
        ephemeral-storage: "2Gi"
        memory: "2Gi"
      limits:
        ephemeral-storage: "5Gi"
        memory: "4Gi"
'''
        }
    }

    parameters {
        string(
            name: 'TARGET_HOST',
            defaultValue: '',
            description: 'Target host URL (auto-detected from branch if empty)'
        )
        booleanParam(
            name: 'SEED_DATA',
            defaultValue: true,
            description: 'Seed the database with content from genesis/data/lamad'
        )
        string(
            name: 'SEED_IDS',
            defaultValue: '',
            description: 'Specific content IDs to seed (comma-separated). Empty = all content'
        )
        booleanParam(
            name: 'RESET_STORAGE',
            defaultValue: false,
            description: 'Reset storage databases before seeding (deletes content.db and restarts pods to run fresh migrations)'
        )
        string(name: 'STEPS', defaultValue: 'all', description: 'Comma-separated build steps to run. "all" runs everything.')
        booleanParam(
            name: 'DEPLOY_ONLY',
            defaultValue: false,
            description: 'No-op for this pipeline (genesis runs as a normal seed when triggered). Accepted so the orchestrator can propagate the flag uniformly. Operator can set SKIP_GENESIS on the orchestrator to skip seeding entirely on a deploy-only run.'
        )
    }

    environment {
        NO_COLOR = '1'
        NPM_TOKEN = credentials('ee-nexus-npm-token')
    }

    options {
        skipDefaultCheckout(true)
        timeout(time: 60, unit: 'MINUTES')  // M1 topology seeds + E2E (~25-35 min); 60 absorbs pod-flap archival waits
        buildDiscarder(logRotator(numToKeepStr: '20'))
        overrideIndexTriggers(false)  // Only orchestrator or manual triggers - no webhook/branch indexing
    }

    // No triggers - orchestrator handles triggering genesis after all builds complete
    // triggers { }

    stages {
        stage('Check Trigger') {
            steps {
                script {
                    def validTrigger = currentBuild.getBuildCauses().any { cause ->
                        cause._class.contains('UpstreamCause') || cause._class.contains('UserIdCause')
                    }
                    if (!validTrigger) {
                        echo "⏭️ PIPELINE SKIPPED - Use orchestrator or manual trigger"
                        currentBuild.result = 'NOT_BUILT'
                        currentBuild.displayName = "#${env.BUILD_NUMBER} SKIPPED"
                        env.PIPELINE_SKIPPED = 'true'
                    } else {
                        echo "✅ Valid trigger: ${currentBuild.getBuildCauses()*.shortDescription.join(', ')}"
                    }
                }
            }
        }

        stage('Checkout') {
            when { expression { env.PIPELINE_SKIPPED != 'true' } }
            steps {
                container('builder') {
                    script {
                        sh 'git config --global --add safe.directory "*"'

                        checkout([
                            $class: 'GitSCM',
                            branches: [[name: "*/${env.BRANCH_NAME ?: 'dev'}"]],
                            extensions: [
                                [$class: 'CloneOption', shallow: true, noTags: true, depth: 1],
                                [$class: 'CleanBeforeCheckout']
                            ],
                            userRemoteConfigs: [[
                                url: 'https://github.com/ethosengine/elohim.git',
                                credentialsId: 'ee-bot-pat'
                            ]]
                        ])

                        // Enable pnpm via corepack (uses packageManager field in root package.json)
                        sh 'corepack enable'
                        sh 'pnpm --version'

                        echo """
═══════════════════════════════════════════════════════════
🌱 GENESIS PIPELINE
═══════════════════════════════════════════════════════════
Branch: ${env.BRANCH_NAME ?: 'dev'}
Seed Data: ${params.SEED_DATA}
Seed IDs: ${params.SEED_IDS ?: '(all)'}
═══════════════════════════════════════════════════════════
                        """

                        // Bootstrap canonical artifact filenames from the
                        // shared manifest (single source of truth across
                        // Groovy + TypeScript + JS). Downstream stages and
                        // the seeder TS scripts both read from the same
                        // build-artifacts.json so a rename propagates to
                        // every consumer automatically.
                        if (!fileExists('genesis/orchestrator/build-artifacts.json')) {
                            error 'genesis/orchestrator/build-artifacts.json missing — cannot bootstrap artifact names'
                        }
                        def artifactNames = readJSON(file: 'genesis/orchestrator/build-artifacts.json')
                        env.CONDUCTOR_READINESS_FILE = artifactNames.genesis.conductorReadiness
                        env.SEED_RESULTS_CONDUCTOR_IDENTITIES_FILE = artifactNames.genesis.seedResultsConductorIdentities
                        env.SEED_RESULTS_AGENT_BINDINGS_FILE = artifactNames.genesis.seedResultsAgentBindings
                    }
                }
            }
        }

        stage('Resolve Hosts') {
            when { expression { env.PIPELINE_SKIPPED != 'true' } }
            steps {
                container('builder') {
                    script {
                        // Auto-detect target host based on branch if not specified
                        def targetHost = params.TARGET_HOST
                        if (!targetHost) {
                            if (env.BRANCH_NAME == 'main') {
                                targetHost = 'https://elohim.host'
                            } else if (env.BRANCH_NAME == 'staging' || env.BRANCH_NAME ==~ /staging-.+/) {
                                targetHost = 'https://staging.elohim.host'
                            } else {
                                // dev, feat-*, claude/* branches → alpha
                                targetHost = 'https://alpha.elohim.host'
                            }
                            echo "Auto-detected target host from branch '${env.BRANCH_NAME}': ${targetHost}"
                        }

                        env.TARGET_HOST = targetHost
                        def doorwayHost = resolveDoorwayHost(targetHost, '')
                        def internalDoorway = resolveInternalDoorwayUrl(doorwayHost)

                        env.RESOLVED_DOORWAY_HOST = doorwayHost
                        env.INTERNAL_DOORWAY_URL = internalDoorway
                        env.INTERNAL_STORAGE_URL = resolveInternalStorageUrl(doorwayHost)

                        echo "✅ Target host: ${targetHost}"
                        echo "✅ Doorway API (external): ${doorwayHost}"
                        echo "✅ Doorway API (internal): ${internalDoorway}"
                        echo "✅ Storage API (internal): ${env.INTERNAL_STORAGE_URL}"
                    }
                }
            }
        }

        stage('Probe Substrate') {
            // Single substrate probe → env.ELOHIM_REMOTE_COMPUTE_STATUS. Every downstream
            // stage (Reset Storage, Seed Database, Verify Seeding, E2E) and the
            // a2o test bench reconcile their scope to this one signal. Re-running
            // the pipeline re-probes and restabilizes to the confirmed available
            // compute — the CI-layer expression of the protocol's reconciliation
            // principle. The remote pool flapping on/off is a steady state, not a
            // failure: when it's down we run TOLERANT (seed/test whoever is ready)
            // but LOUD (UNSTABLE + an explicit reduced-scope banner), honoring the
            // "Pending if shem is down is intentional fail-loud" directive in
            // genesis/orchestrator/data/deployments.json.
            when { expression { env.PIPELINE_SKIPPED != 'true' } }
            steps {
                container('builder') {
                    script { probeSubstrateScope() }
                }
            }
        }

        stage('Reset Storage') {
            // When to use RESET_STORAGE=true:
            //   "database is locked" errors in the Seed Database stage almost always
            //   indicate schema drift between a persisted DB and the current code's
            //   expectations — NOT SQLite concurrency. Signals: errors clustered in
            //   a single content namespace that SHIFTS between builds (e.g. all 100
            //   errors in preteen-* on build N, caregiver-* on build N+1), high
            //   "skipped" count (prior-run residue), or one batch reporting 0 inserted
            //   while neighbors succeed. SQLite pragmas already include journal_mode=WAL
            //   + busy_timeout=30000 (elohim/elohim-storage/src/db/mod.rs), so adding
            //   more pragma/retry logic is the wrong path. Set RESET_STORAGE=true to
            //   clear content.db and re-run migrations cleanly. Investigate real
            //   concurrency (uniform/random errors, not namespace-clustered) only after
            //   a clean run still reproduces.
            when { allOf {
                expression { env.PIPELINE_SKIPPED != 'true' }
                expression { params.RESET_STORAGE }
            }}
            steps {
                container('builder') {
                    script {
                        def humans = getHumanStorageUrls('alpha')

                        echo """
═══════════════════════════════════════════════════════════
🗑️  RESETTING STORAGE DATABASES
═══════════════════════════════════════════════════════════
"""
                        for (human in humans) {
                            sh """#!/bin/bash
                                set -euo pipefail
                                echo "Resetting ${human.service}..."

                                # Delete content.db and restart pod for fresh migrations
                                kubectl exec -n ${human.namespace} ${human.service}-0 -c elohim-storage -- rm -f /data/content.db 2>/dev/null || true
                                kubectl delete pod -n ${human.namespace} ${human.service}-0 --wait=false

                                echo "   ✅ ${human.humanId} reset initiated"
                            """
                        }

                        // Wait for pods to begin restarting
                        sh '''#!/bin/bash
                            echo ""
                            echo "Waiting for pods to restart..."
                            sleep 30
                        '''

                        // Wait for each pod to come back Ready, but tolerate a
                        // peer whose hardware is gone (reconcile to available
                        // compute) — a down pod restarts when it returns; don't
                        // hang 600s then cascade-fail the whole reset.
                        def resetUnreachable = []
                        for (human in humans) {
                            def rc = sh(returnStatus: true, script: """#!/bin/bash
                                set -uo pipefail
                                echo "Waiting for ${human.service}..."
                                if kubectl wait --for=condition=Ready pod/${human.service}-0 -n ${human.namespace} --timeout=600s 2>/dev/null; then
                                    echo "   ✅ ${human.service} ready (600s: embedded-HC cold start, see #1055)"
                                    exit 0
                                fi
                                echo "   ⏭️  ${human.service} not Ready within 600s — skipping (reconcile to available compute)"
                                exit 1
                            """)
                            if (rc != 0) { resetUnreachable << human.humanId }
                        }
                        if (!resetUnreachable.isEmpty()) {
                            unstable("Reset Storage: pods not Ready (restart when reachable): ${resetUnreachable.join(', ')}")
                        }

                        echo """
═══════════════════════════════════════════════════════════
✅ STORAGE DATABASES RESET (reachable peers)
═══════════════════════════════════════════════════════════
"""
                    }
                }
            }
        }

