# Genesis Seeder - Content Pipeline & Validation
#
# Validates, seeds, and verifies content in Holochain DHT.

set dotenv-load := false

# List available recipes
default:
    @just --list

# Install dependencies (skip if node_modules is current)
install:
    pnpm install --frozen-lockfile --ignore-scripts

# Validate seed data schemas
validate:
    pnpm run validate

# Run tests
test:
    pnpm exec vitest run

# Type-check without building
check:
    pnpm exec tsc --noEmit

# Quality gate: install + validate + type-check + test
#
# `check` is load-bearing, not decorative: CI's genesis `Validate Constants`
# stage runs `tsc --noEmit` over the WHOLE seeder tree (src/ AND src/__tests__/)
# via genesis/scripts/ci/typecheck-seeder.sh and exits 1 before any seeding.
# `vitest run` does NOT type-check — vite strips types — so a strict-TS error
# that lives only in a spec file passes `test` locally and fails the pipeline.
# That gap has now broken genesis twice: #1101 (TS2739, ProjectionSpec literal)
# and #1400/#1401 (TS2352/TS2493, zero-arg vi.fn tuple index). Keep `check`
# ahead of `test` so the local gate is a superset of the CI gate.
gate: install validate check test

# =============================================================================
# Seeding Recipes
# =============================================================================

# Seed conductor identities for node/device humans (run BEFORE seed-humans)
seed-conductors:
    pnpm run seed:conductors

# Seed humans via doorway registration (run AFTER seed-conductors)
seed-humans:
    pnpm run seed:humans

# Run the canonical household-formation ceremony across its member conductors.
# Set CONDUCTOR_URLS to comma-separated app WebSocket URLs; STORAGE_URL or
# DOORWAY_URL enables the idempotent collective/projection probe.
seed-household-formation:
    bash ../scripts/ci/seed-household-formation.sh "${CONDUCTOR_URLS:-}"

# Full seed: conductor identities first, then doorway registration
seed: seed-conductors seed-humans
