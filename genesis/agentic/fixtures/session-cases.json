      "ELOHIM_SESSION_ID": " declared ",
      "ELOHIM_SESSION_OWNER_PID": "200"
    },
    "processes": [
      [
        400,
        300,
        "python3",
        100,
        0,
        4000,
        {}
      ],
      [
        300,
        200,
        "bash",
        100,
        0,
        3000,
        {}
      ],
      [
        200,
        100,
        "codex",
        100,
        0,
        2000,
        {}
      ],
      [
        100,
        1,
        "claude",
        100,
        0,
        1000,
        {}
      ]
    ],
    "startPid": 400,
    "registry": {
      "version": 1,
      "runtimes": [
        {
          "id": "claude-code",
          "comm": [
            "claude"
          ],
          "sessionEnv": [
            "CLAUDE_CODE_SESSION_ID",
            "CLAUDE_SESSION_ID"
          ]
        },
        {
          "id": "codex",
          "comm": [
            "codex"
          ],
          "sessionEnv": [
            "CODEX_SESSION_ID",
            "CODEX_THREAD_ID"
          ]
        },
        {
          "id": "gemini",
          "comm": [
            "gemini"
          ],
          "sessionEnv": []
        },
        {
          "id": "antigravity",
          "comm": [
            "antigravity"
          ],
          "sessionEnv": []
        }
      ]
    },
    "expected": {
      "runtime": "declared",
      "session": "declared",
      "ownerPid": 200,
      "ownerStartTime": "2000",
      "source": "declared"
    }
  },
