#!/usr/bin/env bash
# cargo-pool — operator CLI for the cargo target pool.
#
# Subcommands:
#   status                    Tabular family overview (disk + last touched).
#   steward [--dry-run]       Run stewardship pass against worktrees.
#   key                       Print the slot path that the current PWD
#                             would use for native cargo builds.
#   prune family <name> [-y]  Wipe a family's slot tree.
#   prune --older-than DUR    Wipe slot subdirs whose .last-build is older
#                             than DUR (e.g. '7d', '36h'). Requires --yes
#                             non-interactively.
#   log [-n N]                Tail the event log (steward.log).
#   orphans                   Print orphan-worktrees.tsv.
#   key                       Slot path for current PWD.
#
# Design: genesis/docs/plans/cargo-target-pool-design.md
set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck disable=SC1091
source "$SCRIPT_DIR/pool-lib.sh"

cmd="${1:-help}"
[ "$#" -gt 0 ] && shift || true

usage() {
  cat <<'EOF'
cargo-pool — cargo target pool operator CLI

Usage:
  cargo-pool status
  cargo-pool steward [--dry-run]
  cargo-pool key
  cargo-pool estimate [worktree-path]
  cargo-pool legacy-targets [--clean] [--yes]
  cargo-pool node-modules [--clean [--stale|--all]] [--yes]
  cargo-pool angular-cache [--clean] [--older-than-days N] [--yes]
  cargo-pool watermark [show|update]
  cargo-pool prune family <name> [--yes]
  cargo-pool prune --older-than <duration> [--yes]
  cargo-pool prune --stale-incrementals [--older-than-days N] [--yes]
  cargo-pool log [-n N]
  cargo-pool orphans

Env:
  CARGO_TARGET_POOL_ROOT       (default /projects/.cargo-target-pool)
  POOL_PARENT_REPO             (default $CLAUDE_PROJECT_DIR or /projects/elohim)
  CARGO_TARGET_POOL_FAMILY     override family detection in `key`

Design: genesis/docs/plans/cargo-target-pool-design.md
EOF
}

confirm() {
  # confirm "Prompt: " — returns 0 on yes, 1 on no/non-tty
  if ! [ -t 0 ]; then return 1; fi
  read -r -p "$1" ans
  case "$ans" in y|Y|yes|YES) return 0 ;; *) return 1 ;; esac
}

cmd_status() {
  pool_init
  local pct status
  pct="$(disk_pct_used)"
  status="$(disk_status_for_pct "$pct")"
  echo "Pool root:    $POOL_ROOT"
  echo "Pool size:    $(human_bytes "$(pool_disk_bytes)")"
  echo "Volume:       $(disk_human_summary) (${pct}% used, status=$status)"
  case "$status" in
    critical) echo "              !! CRITICAL — see preflight banner or run: cargo-pool prune --stale-incrementals --yes" ;;
    warn)     echo "              !  Disk above 80%; consider cargo-pool prune --stale-incrementals" ;;
  esac
  echo
  printf '%-20s %-10s %-10s %s\n' FAMILY DISK SLOTS LAST_TOUCHED
  local fam fd disk slots last
  for fam in $(list_families); do
    fd="$POOL_ROOT/family/$fam"
    disk="$(human_bytes "$(dir_disk_bytes "$fd")")"
    slots="$(list_slots_for_family "$fam" | wc -l | tr -d ' ')"
    last="$(find "$fd" -name '.last-build' -printf '%T@ %p\n' 2>/dev/null \
      | sort -nr | head -1 | awk '{print $1}')"
    if [ -n "$last" ]; then
      last="$(date -u -d "@${last%.*}" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || echo "$last")"
    else
      last="-"
    fi
    printf '%-20s %-10s %-10s %s\n' "$fam" "$disk" "$slots" "$last"
  done

  # Legacy target/ dirs outside the pool — surface for operator triage.
  local legacy; legacy="$(legacy_native_bytes)"
  if [ "${legacy:-0}" -gt 0 ]; then
    echo
    echo "Legacy target/ dirs outside pool (native, recoverable): $(human_bytes "$legacy")"
    echo "  Review: cargo-pool legacy-targets"
    echo "  Clean:  cargo-pool legacy-targets --clean --yes"
  fi

  # Stale incrementals.
  local stale; stale="$(stale_incremental_bytes 3)"
  if [ "${stale:-0}" -gt 0 ]; then
    echo
    echo "Stale incremental hash dirs (>3d): $(human_bytes "$stale")"
    echo "  Review: cargo-pool prune --stale-incrementals"
    echo "  Clean:  cargo-pool prune --stale-incrementals --yes"
  fi

  # Stale node_modules (pnpm-lock drift) and .angular caches.
  local nm_stale ang_stale
  nm_stale="$(node_modules_stale_bytes)"
  ang_stale="$(angular_cache_stale_bytes 7)"
  if [ "${nm_stale:-0}" -gt 0 ]; then
    echo
    echo "Stale node_modules (lockfile newer than install): $(human_bytes "$nm_stale")"
    echo "  Review: cargo-pool node-modules"
    echo "  Clean:  cargo-pool node-modules --clean --yes"
  fi
  if [ "${ang_stale:-0}" -gt 0 ]; then
    echo
    echo "Old .angular caches (>7d): $(human_bytes "$ang_stale")"
    echo "  Review: cargo-pool angular-cache"
    echo "  Clean:  cargo-pool angular-cache --clean --yes"
  fi
}

cmd_steward() {
  pool_init
  local dry=0
  case "${1:-}" in --dry-run) dry=1 ;; esac
  echo "stewardship: walking $POOL_WORKTREES_DIR (dry=$dry)"
  steward_all_worktrees "$dry" \
    | awk -F'\t' '{printf "  %-14s %-14s %s [%s]\n", $1, $2, $3, $4}'
}

cmd_key() {
  local wt
  if ! wt="$(find_worktree_root "$PWD")"; then
    echo "cargo-pool key: $PWD is not inside a git worktree" >&2; return 1
  fi
  local family ws_rel slot
  family="$(detect_family "$wt")"
  # Walk up to find the workspace's Cargo.toml, then express path relative
  # to worktree root. For a given native cargo build, the workspace dir is
  # whatever has Cargo.toml + [workspace], or the nearest Cargo.toml.
  local d="$PWD" first=""
  while [ "$d" != "/" ] && [ -n "$d" ]; do
    if [ -f "$d/Cargo.toml" ]; then
      if grep -q '^\[workspace\]' "$d/Cargo.toml"; then ws_rel="${d#$wt/}"; break; fi
      [ -z "$first" ] && first="${d#$wt/}"
    fi
    d="$(dirname "$d")"
  done
  ws_rel="${ws_rel:-$first}"
  if [ -z "${ws_rel:-}" ]; then
    echo "cargo-pool key: no Cargo.toml found from $PWD" >&2; return 1
  fi
  slot="$(slot_path "$family" "$ws_rel" dev)"
  local slot_release; slot_release="$(slot_path "$family" "$ws_rel" release)"
  local wm_dev wm_rel
  wm_dev="$(read_slot_watermark "$slot")"
  wm_rel="$(read_slot_watermark "$slot_release")"
  echo "family=$family"
  echo "workspace=$ws_rel"
  echo "slot_dev=$slot"
  if [ "${wm_dev:-0}" -gt 0 ]; then
    echo "  hwm_dev=$(human_bytes "$wm_dev") (observed peak — used by estimate)"
  fi
  echo "slot_release=$slot_release"
  if [ "${wm_rel:-0}" -gt 0 ]; then
    echo "  hwm_release=$(human_bytes "$wm_rel")"
  fi
  echo
  echo "# Use:"
  echo "#   export CARGO_TARGET_DIR=\"$slot\""
  echo "#   cargo build"
}

cmd_prune() {
  case "${1:-}" in
    family)
      shift
      local fam="${1:?usage: cargo-pool prune family <name>}"
      shift || true
      local fd="$POOL_ROOT/family/$fam"
      if ! [ -d "$fd" ]; then
        echo "no such family: $fam" >&2; return 1
      fi
      local sz; sz="$(human_bytes "$(dir_disk_bytes "$fd")")"
      local yes=0
      [ "${1:-}" = "--yes" ] || [ "${1:-}" = "-y" ] && yes=1
      if [ "$yes" != 1 ]; then
        confirm "Wipe family '$fam' ($sz)? [y/N] " || { echo aborted; return 1; }
      fi
      rm -rf "$fd"
      echo "wiped: $fd ($sz)"
      ;;
    --older-than)
      shift
      local dur="${1:?usage: cargo-pool prune --older-than <duration> [--yes]}"
      shift || true
      local yes=0
      [ "${1:-}" = "--yes" ] || [ "${1:-}" = "-y" ] && yes=1
      # Convert duration to find -mtime arg. Accept '7d', '36h', or bare days.
      local mtime_arg
      case "$dur" in
        *d) mtime_arg="+${dur%d}" ;;
        *h) mtime_arg="+$(awk -v h="${dur%h}" 'BEGIN{print h/24}')" ;;
        *)  mtime_arg="+$dur" ;;
      esac
      if [ "$yes" != 1 ]; then
        echo "Would prune slot dirs whose .last-build is older than $dur"
        find "$POOL_ROOT/family" -mindepth 4 -maxdepth 4 -type f \
          -name '.last-build' -mtime "$mtime_arg" -print 2>/dev/null \
          | sed 's|/.last-build$||'
        confirm "Apply? [y/N] " || { echo aborted; return 1; }
      fi
      while IFS= read -r -d '' lb; do
        local slot; slot="$(dirname "$lb")"
        echo "removing $slot"
        rm -rf "$slot"
      done < <(find "$POOL_ROOT/family" -mindepth 4 -maxdepth 4 -type f \
        -name '.last-build' -mtime "$mtime_arg" -print0 2>/dev/null)
      ;;
    --stale-incrementals)
      shift
      local days=3 yes=0
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --older-than-days) days="${2:?}"; shift 2 ;;
          --yes|-y) yes=1; shift ;;
          *) echo "unknown flag: $1" >&2; return 2 ;;
        esac
      done
      local total; total="$(stale_incremental_bytes "$days")"
      if [ "${total:-0}" -eq 0 ]; then
        echo "(no stale incremental hash dirs older than ${days}d)"
        return 0
      fi
      if [ "$yes" != 1 ]; then
        echo "Stale incremental dirs older than ${days}d ($(human_bytes "$total") recoverable):"
        prune_stale_incrementals "$days" 0
        confirm "Prune all? [y/N] " || { echo aborted; return 1; }
      fi
      prune_stale_incrementals "$days" 1
      echo "# recovered: $(human_bytes "$total")"
      ;;
    *)
      echo "usage: cargo-pool prune family <name> [--yes]" >&2
      echo "       cargo-pool prune --older-than <duration> [--yes]" >&2
      echo "       cargo-pool prune --stale-incrementals [--older-than-days N] [--yes]" >&2
      return 2
      ;;
  esac
}

cmd_legacy_targets() {
  pool_init
  local clean=0 yes=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --clean) clean=1; shift ;;
      --yes|-y) yes=1; shift ;;
      *) echo "unknown flag: $1" >&2; return 2 ;;
    esac
  done

  if [ "$clean" = 0 ]; then
    echo "Legacy target/ dirs outside pool (CLASSIFICATION  SIZE  PATH):"
    list_legacy_targets | while IFS=$'\t' read -r cls bytes path; do
      printf '  %-10s %8s  %s\n' "$cls" "$(human_bytes "$bytes")" "$path"
    done
    echo
    local nat; nat="$(legacy_native_bytes)"
    echo "Native (safe to clean): $(human_bytes "${nat:-0}")"
    echo "WASM / typesrc / unknown: kept; see --clean only removes 'native'."
    return 0
  fi

  local total; total="$(legacy_native_bytes)"
  if [ "${total:-0}" -eq 0 ]; then
    echo "(no native legacy target/ dirs to clean)"
    return 0
  fi
  if [ "$yes" != 1 ]; then
    echo "Would clean native legacy target/ dirs ($(human_bytes "$total") recoverable):"
    clean_legacy_native_targets 1
    confirm "Proceed? [y/N] " || { echo aborted; return 1; }
  fi
  clean_legacy_native_targets 0
  echo "# recovered: $(human_bytes "$total")"
}

cmd_watermark() {
  pool_init
  case "${1:-show}" in
    update)
      record_all_slot_watermarks
      echo "Watermarks updated for all slots."
      ;;
    show|*)
      echo "Per-slot HWM (FAMILY  WORKSPACE  PROFILE  HWM  CURRENT_SIZE):"
      [ -d "$POOL_ROOT/family" ] || { echo "(no families)"; return 0; }
      local fam ws_dir prof slot wm cur
      while IFS= read -r slot; do
        prof="${slot##*/}"
        ws_dir="$(dirname "$slot")"
        local ws_flat; ws_flat="${ws_dir##*/}"
        local fam_dir; fam_dir="$(dirname "$ws_dir")"
        fam="${fam_dir##*/}"
        wm="$(read_slot_watermark "$slot")"
        cur="$(dir_disk_bytes "$slot")"
        printf '  %-8s %-32s %-8s %8s  %s\n' \
          "$fam" "$ws_flat" "$prof" \
          "$(human_bytes "${wm:-0}")" "$(human_bytes "${cur:-0}")"
      done < <(find "$POOL_ROOT/family" -mindepth 3 -maxdepth 3 -type d \
        \( -name dev -o -name release \) 2>/dev/null | sort)
      ;;
  esac
}

cmd_node_modules() {
  pool_init
  local clean=0 yes=0 mode=stale
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --clean) clean=1; shift ;;
      --stale) mode=stale; shift ;;
      --all)   mode=all; shift ;;
      --yes|-y) yes=1; shift ;;
      *) echo "unknown flag: $1" >&2; return 2 ;;
    esac
  done

  if [ "$clean" = 0 ]; then
    echo "node_modules trees outside pool / sophia (CLASSIFICATION  SIZE  PATH):"
    list_node_modules | while IFS=$'\t' read -r cls bytes path; do
      printf '  %-8s %8s  %s\n' "$cls" "$(human_bytes "$bytes")" "$path"
    done
    echo
    echo "  stale  = pnpm-lock.yaml newer than .modules.yaml (install drift)"
    echo "  fresh  = lockfile matches install marker"
    echo "  active = a subagent process has CWD inside the containing worktree"
    echo "  unknown = no lockfile found (left alone)"
    local s n; s="$(node_modules_stale_bytes)"; n="$(node_modules_nuke_bytes)"
    echo
    echo "Stale recoverable:    $(human_bytes "${s:-0}")"
    echo "Full nuke recoverable: $(human_bytes "${n:-0}") (excludes active)"
    return 0
  fi

  local total
  if [ "$mode" = "stale" ]; then
    total="$(node_modules_stale_bytes)"
  else
    total="$(node_modules_nuke_bytes)"
  fi
  if [ "${total:-0}" -eq 0 ]; then
    echo "(no node_modules in '$mode' class to clean)"
    return 0
  fi
  if [ "$yes" != 1 ]; then
    echo "Would clean node_modules ($mode mode, $(human_bytes "$total") recoverable):"
    clean_node_modules "$mode" 1
    confirm "Proceed? [y/N] " || { echo aborted; return 1; }
  fi
  clean_node_modules "$mode" 0
  echo "# recovered: $(human_bytes "$total")"
  echo "# remember: run 'pnpm install' in each cleaned project before building"
}

cmd_angular_cache() {
  pool_init
  local clean=0 yes=0 days=7
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --clean) clean=1; shift ;;
      --older-than-days) days="${2:?}"; shift 2 ;;
      --yes|-y) yes=1; shift ;;
      *) echo "unknown flag: $1" >&2; return 2 ;;
    esac
  done

  if [ "$clean" = 0 ]; then
    echo ".angular caches (AGE  SIZE  PATH):"
    list_angular_caches | while IFS=$'\t' read -r age bytes path; do
      if [ "$age" = "active" ]; then
        printf '  %-8s %8s  %s\n' "active" "$(human_bytes "$bytes")" "$path"
      else
        printf '  %-8s %8s  %s\n' "${age}d" "$(human_bytes "$bytes")" "$path"
      fi
    done
    local t; t="$(angular_cache_total_bytes)"
    echo
    echo "Total non-active: $(human_bytes "${t:-0}")"
    echo "Stale (>${days}d):  $(human_bytes "$(angular_cache_stale_bytes "$days")")"
    return 0
  fi

  local total; total="$(angular_cache_stale_bytes "$days")"
  if [ "${total:-0}" -eq 0 ]; then
    echo "(no .angular caches older than ${days}d to clean)"
    return 0
  fi
  if [ "$yes" != 1 ]; then
    echo "Would clean .angular caches older than ${days}d ($(human_bytes "$total") recoverable):"
    clean_angular_caches "$days" 1
    confirm "Proceed? [y/N] " || { echo aborted; return 1; }
  fi
  clean_angular_caches "$days" 0
  echo "# recovered: $(human_bytes "$total")"
}

cmd_estimate() {
  pool_init
  local wt="${1:-$PWD}"
  if ! wt="$(find_worktree_root "$wt")"; then
    echo "estimate: $1 is not inside a git worktree" >&2; return 1
  fi
  local family budget est free verdict
  family="$(detect_family "$wt")"
  budget="$(disk_budget_for_worktree "$wt")"
  est="$(echo "$budget" | cut -f1)"
  free="$(echo "$budget" | cut -f2)"
  verdict="$(echo "$budget" | cut -f3)"
  echo "worktree:  $wt"
  echo "family:    $family"
  echo "estimate:  ~${est} GB (HWM × 1.2 where observed; else 10G cold / 3G warm)"
  echo "free:      ${free} GB"
  echo "verdict:   $verdict"

  # Per-workspace breakdown so the operator sees which estimate comes from
  # ground truth (HWM) vs hardcoded fallback.
  echo
  echo "Per-workspace basis (workspace : peak observed | source):"
  local ws slot wm sib
  for ws in "${NATIVE_WORKSPACES[@]}"; do
    [ -d "$wt/$ws" ] || continue
    slot="$(slot_path "$family" "$ws" dev)"
    if [ -d "$slot" ]; then
      wm="$(read_slot_watermark "$slot")"
      if [ "${wm:-0}" -gt 0 ]; then
        printf '  %-40s %8s | this slot HWM\n' "$ws" "$(human_bytes "$wm")"
      else
        printf '  %-40s %8s | warm slot (no HWM yet)\n' "$ws" "3.0G"
      fi
    else
      sib="$(cross_family_watermark "$ws")"
      if [ "${sib:-0}" -gt 0 ]; then
        printf '  %-40s %8s | sibling-family HWM (cold slot)\n' "$ws" "$(human_bytes "$sib")"
      else
        printf '  %-40s %8s | hardcoded cold fallback\n' "$ws" "10.0G"
      fi
    fi
  done
  case "$verdict" in
    short) echo "           !! BUDGET SHORT — clean before dispatching:"
           echo "              cargo-pool prune --stale-incrementals --yes"
           echo "              cargo-pool legacy-targets --clean --yes" ;;
    tight) echo "           !  Tight — consider cleanup before parallel waves" ;;
  esac
}

cmd_log() {
  local n=20
  case "${1:-}" in -n) n="${2:-20}" ;; esac
  pool_init
  tail -n "$n" "$(pool_steward_log)" 2>/dev/null
}

cmd_orphans() {
  pool_init
  echo "== Logged orphans (merged-dirty worktrees, deduped by wt+branch+class) =="
  if [ -s "$(pool_orphan_log)" ]; then
    # Awk dedupe keeps the first-seen timestamp per (wt, branch, classification)
    # tuple. The raw log can contain pre-dedupe-fix bloat; this presents a
    # sane operator view without rewriting historical data.
    awk -F'\t' '!seen[$2 FS $3 FS $4]++' "$(pool_orphan_log)"
  else
    echo "(none)"
  fi

  # Live scan: any worktree with uncommitted work but no active subagent.
  # These are crash-recovery candidates worth surfacing to the operator —
  # do not auto-clean.
  echo
  echo "== Uncommitted-orphan worktrees (live scan: dirty + no active process) =="
  local out; out="$(list_uncommitted_orphans)"
  if [ -z "$out" ]; then
    echo "(none)"
  else
    echo "$out" | while IFS=$'\t' read -r wt branch count first; do
      printf '  %s  (branch=%s, %s dirty file(s))\n' "$wt" "$branch" "$count"
      printf '    first: %s\n' "$first"
    done
  fi
}

case "$cmd" in
  status)         cmd_status "$@" ;;
  steward)        cmd_steward "$@" ;;
  key)            cmd_key "$@" ;;
  prune)          cmd_prune "$@" ;;
  legacy-targets) cmd_legacy_targets "$@" ;;
  node-modules)   cmd_node_modules "$@" ;;
  angular-cache)  cmd_angular_cache "$@" ;;
  estimate)       cmd_estimate "$@" ;;
  watermark)      cmd_watermark "$@" ;;
  log)            cmd_log "$@" ;;
  orphans)        cmd_orphans "$@" ;;
  help|-h|--help) usage ;;
  *) usage; exit 2 ;;
esac
