#!/usr/bin/env python3
"""
held-tool-watch — a SENSOR for a tool call that has been pending a while, seen from OUTSIDE its
session. It senses, calls and says; it never judges, approves, cancels, retries or signals a session.

On 2026-11-23 a coordinating session's tool call sat pending for about seven hours (very likely an
approval prompt nobody saw), and another for 45 minutes, while the device kept exchanging. Nothing
told the steward, the sibling device or `berth status`. This script reads the transcripts the harness
already writes and hands what it senses to the native fold.

  held-tool-watch scan    [--transcripts DIR] [--sense-after-s 120] [--now UNIX] [--json]
                          [--sessions-json FILE] [--stasis-root DIR] [--tail-bytes N]
      Read only. Candidates out; exit 0 when none, 3 when some.
  held-tool-watch observe [same flags] [--bin-store DIR]
      One pass, then exit. For each candidate, call
        <the TARGET session's pinned epr> session stasis observe --session S --source watcher:held-tool
            --tool T --pending-since <RFC3339 of the pending tool_use> [--agent A] --journal-root R
      Exit 0 when the pass ran (whether it observed, skipped or found nothing); 1 on any internal
      error or a failed observe call, with one line on stderr each. Never 2: a hook exit 2 blocks the
      tool call it runs beside, and this script must never raise into one.
  held-tool-watch announce [same flags] [--bin-store DIR]
      `observe`, then make it visible, once: for each observed call whose session's native status
      (read through the same pinned epr) has an open incident, `berth say --session held-tool-watch
      --to <each live session moored here or on a sibling device, the held one excepted>` one line
      `held-tool@1 open device= session= agent= tool= since= — <fixed words>` (at most eight sessions
      over the incident's life, then the household once; the household when none is listed); for each
      call announced earlier whose transcript now holds its result (or is gone), one line
      `held-tool@1 resumed ...` to the same addressees. A line carries those five fields and fixed
      words only: never the call's input, its id, a command, a path or the cause. Same exit contract
      as `observe`.
  held-tool-watch run [same flags] [--bin-store DIR] [--every 60] [--passes N]
      The device runner: one per device (a lock beside the stasis root), an `announce` pass in a fresh
      process every --every seconds, and, only after a recorded device opt-in, a `carry` child on its
      own cadence (default 60 s). The child never delays announce sensing. The last pass outputs are
      `held-tool-watch.last-pass.txt` and
      `held-tool-watch.last-carry.txt` there.
      A failing pass doubles the wait to 15 min; one stderr line per change of state. Each pass runs
      in its own process group, and the group is killed when the pass ends or times out (no pid is
      enumerated; a descendant that calls setsid itself escapes). It exits when the device's off switch is set
      (`held-tool-watch.off` there, or HELD_TOOL_WATCH=off) or its script is gone.
  held-tool-watch carry on [--until <duration|ISO-8601-UTC>]|off|status
      Create/remove/read the untracked device-local opt-in beside the runner lock, and append the
      actor, act time and until-time to `held-tool-watch.log`. Durations use h/d/w (default 7d).
      The default is OFF; the legacy carry.off file and HELD_TOOL_CARRY=off always win. An expired
      opt-in is OFF and says so once. A status read starts no subprocess and reads no misses.
  held-tool-watch carry [--bin-store DIR] [--stasis-root DIR] [--repo-root DIR]
      One opted-in unattended pass. The only authority to execute a candidate is an admitted
      device's signed miss naming its exact SHA. Fetch that SHA, make a detached worktree, and use
      THIS runner checkout's orchestrator modules to recompute the candidate tree's closure as data.
      Cargo and rustc run from a private directory outside the candidate, with this device's Cargo
      home and trusted toolchain/env; checkout hooks, LFS and attributes filters are disabled, so
      candidate code first executes when its vouched-for gate recipe starts. Hold a berth cargo seat
      for that gate's life, and yield through `gate-live stop --now` if local dev integration, a
      foreign cargo holder, or an interactive gate begins, the switch turns off, the parent runner
      exits, or the deadline arrives. Release the carry claim
      when no verdict was recorded, remove its worktree and exact `-wt-<worktree>` cargo slot only
      after gate-live records the run closed and `/proc` names no user, and release the seat. A stop
      that cannot be confirmed preserves the claim and assets. If a released carry's verdict arrives
      later, both verdicts stand and a red from either vetoes reuse. An older epr carry reader ignores
      `env:release=1` and waits until settlement or expiry. The carry lock serializes cleanup but does
      not prove descendants are gone. The wrapper never pushes, lands, or writes a gate verdict.

The flow store. A pass in which nothing is new spawns no `epr` that reads `.eprfs/status/flows.jsonl`:
moorings and siblings come from `berth status --json --no-peer`, `berth said` reads berth's unlocked
note stream at the remembered channel root, and resumption is read from the transcript. Each such
reader holds the store's shared lock for seconds while it decodes the whole log, and `epr flow note`
(which berth gives 5 s) waits for all of them; the 2026-11-25 passes held it about 10 s a minute.
Only a first line for an incident reads the native status and the full `berth status --json` once.

Cost. Only transcripts modified within --recent-s (default 24 h) are read, newest first, each from a
256 KiB tail that grows (to --tail-bytes) only while it holds no complete record, all within
--max-pass-bytes (default 64 MiB) per pass; one line says when that budget is spent. So a session
held longer than --recent-s whose transcript nobody has touched is no longer seen (it was announced
long before, and its resumed line still comes: that read ignores the window). A tail starts at the
first record boundary after its cut; a torn last record makes that file unknown for the pass, never
pending, and a resumed line is said only from a tail that reaches back to the call. Measured on
this device (409 sessions with transcripts, 2026-11-25): every session scanned took 11.05 s and read
827 MiB before these bounds, 0.14 s and 3.4 MiB after.

Thresholds. `--sense-after-s` (default 120) is the only one: the sensor reports a call pending longer
than that. It judges nothing else; the native Incident records the interval and `elohim_epr_rea::Bound`
judges its age. Pending is NOT sensed when the tool is long-running by design: Agent / Task /
Workflow / Monitor / TaskOutput; Bash with `run_in_background: true`; Bash with an explicit
`timeout` until that timeout plus a 30 s grace. A killed subagent whose last line is a tool_use looks
the same as a held one. `cause` (scan only) is `approval-evidence` when a `permission-requested` entry
in the dialogue-stasis journal names the tool_use id as its `precedingToolUseId`; otherwise `unknown`.

No state of its own. `--pending-since` is the pending tool_use's own transcript timestamp, so observing
the same call on every run names the same (session, agent, tool, pending-since), and the native side
folds those repeats into one incident. `announce` names that same key in each line's fields, and
"once" is read, for the life of the incident, from the record the saying makes: the notes this watcher said, as folded in this device's channel
store (`berth said --session held-tool-watch`), which is also what crosses to the siblings. A line is
said to an addressee only when no line of that kind and key to that addressee is in the record; if the
record cannot be read, nothing is said that pass. A note that did not reach the store (`berth say`
exit 1) is said again next pass. The script keeps no marker or announce-once file; the two lock files
order writers and record nothing. Held state is the native Incident: nothing is announced unless the
target's own epr shows an open incident, and `berth status` renders `held` from that same read.
Resumption is read from the transcript (the call's result appears), because no native verb lets an
outside observer record it: the native Silence incident closes at that agent's next turn end.

Compatibility (the hazard this design answers). A session keeps the epr build it was pinned to when
it started, and an epr older than `observe` rejects the unknown event kind `tool-pending-observed`
and aborts replay of that session's stasis journal. This script writes into ANOTHER session's
journal, so it writes ONLY through the TARGET session's own pinned epr: the writer is then never newer
than that session's reader. On this device a session's pin is the JSON file
`<bin-store>/epr/sessions/<session id>` ({"cid", "session", ...}, the key encoded as
device-runtime's `Store::pin_path` encodes it) and its binary is `<bin-store>/epr/<cid>/epr`; the
bin-store root comes from `--bin-store`, else from the path the native `epr bin resolve --tool epr
--json` prints (`<root>/epr/<cid>/epr`), so the native layout decides it, not this script. Before
writing, the pinned binary's `session stasis --help` must list `stasis observe`.
  - pinned epr lacks the verb: nothing written; one line
    `held-tool-watch: session <id> runs an epr without stasis observe; not observed`.
  - pin cannot be determined (no store, no pin file, a pin naming another session or a malformed
    CID, a missing binary): nothing written; one line saying why.
  - the session has no stasis journal (observe exits 2): nothing was written; one line.
A residual this does not cover: a reader of ALL sessions' journals (`epr session stasis status`
with no `--session`, as `berth status` runs it) under an older epr still meets the new kind in the
observed session's journal. That reader is the observer's device tooling, not the held session.

Registration (2026-11-25, the steward's direction "stop waiting and work on it"): the hook
`held-tool-ensure` (PostToolUse and SessionStart in Claude Code, PostToolUse and SessionStart in Codex)
starts `held-tool-watch run` detached when this device has no runner, in a few milliseconds and never
more. A held session fires no hooks, so the runner, not any hook, does the sensing: a device with one
session is covered from that session's first tool call, until the workspace restarts. Not covered: a
device where no session has started since its last restart; Codex sessions (their transcripts are
not read, only Claude Code's). The runner is not supervised by the device's ark: `epr device run`
declares only bin-store tools, and this script is not one.
"""
import argparse
import contextlib
import datetime
import fcntl
import hashlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time

LONG_RUNNING_TOOLS = {"Agent", "Task", "Workflow", "Monitor", "TaskOutput"}
TIMEOUT_GRACE_S = 30
SHAPE_CHARS = 80
DEFAULT_TAIL_BYTES = 8 * 1024 * 1024  # the most one transcript's tail may grow to
FIRST_TAIL_BYTES = 256 * 1024
EVIDENCE_TAIL_BYTES = 1024 * 1024  # of each dialogue-stasis journal segment, read only for a candidate
DEFAULT_RECENT_S = 24 * 3600  # a transcript untouched longer than this is not read
DEFAULT_PASS_BYTES = 64 * 1024 * 1024  # the most one pass reads, all files together
DEFAULT_CARRY_EVERY_S = 60
DEFAULT_CARRY_OPT_IN_S = 7 * 24 * 60 * 60
MAX_CARRY_PASS_S = 90 * 60
MAX_CARRY_VALID_S = 2 * 60 * 60  # epr flow intend --carry's native ceiling
HERE = os.path.dirname(os.path.realpath(__file__))
REPO_ROOT = os.path.dirname(os.path.dirname(os.path.dirname(HERE)))


# ---------------------------------------------------------------- locations

def main_checkout(root):
    """A linked worktree's main checkout (as berth finds it), else root."""
    try:
        with open(os.path.join(root, ".git")) as f:
            marker = f.read().strip()
        if not marker.startswith("gitdir: "):
            return root
        git_dir = os.path.realpath(os.path.join(root, marker[8:]))
        with open(os.path.join(git_dir, "commondir")) as f:
            common = os.path.realpath(os.path.join(git_dir, f.read().strip()))
        if os.path.basename(common) == ".git" and os.path.isdir(common):
            return os.path.dirname(common)
    except OSError:
        pass
    return root


def stasis_root():
    return os.path.join(main_checkout(REPO_ROOT), ".eprfs", "status", "stasis")


def transcripts_root():
    config = os.environ.get("CLAUDE_CONFIG_DIR")
    if config:
        return os.path.join(config, "projects")
    if os.path.isdir("/projects/.claude-config/projects"):
        return "/projects/.claude-config/projects"
    return os.path.expanduser("~/.claude/projects")


def berth_bin():
    return os.environ.get("BERTH_BIN") or os.path.join(HERE, "berth")


# ---------------------------------------------------------------- redaction

_MASK = "<masked>"
_SECRET_PATTERNS = [
    (re.compile(r"(?i)(authorization:\s*)(bearer\s+|basic\s+|token\s+)?\S+"), r"\1" + _MASK),
    (re.compile(r"(?i)\bbearer\s+\S+"), "bearer " + _MASK),
    (re.compile(r"(?i)(\b[\w.-]*(?:token|key|secret|passw(?:or)?d|pwd|auth|credential)[\w.-]*\s*[=:]\s*)(\"[^\"]*\"|'[^']*'|\S+)"),
     r"\1" + _MASK),
    (re.compile(r"(?i)(--?[\w-]*(?:token|key|secret|passw(?:or)?d|auth)[\w-]*[ =])(\"[^\"]*\"|'[^']*'|\S+)"),
     r"\1" + _MASK),
    (re.compile(r"(\w+://[^\s/:@]+:)[^\s/@]+@"), r"\1" + _MASK + "@"),
    (re.compile(r"\?[^\s'\"]+"), "?" + _MASK),
    (re.compile(r"\b(?:ghp_|gho_|ghs_|github_pat_|sk-|xox[abpr]-|AKIA|eyJ)[A-Za-z0-9_\-.]{8,}"), _MASK),
    (re.compile(r"[A-Za-z0-9+/_\-]{32,}={0,2}"), _MASK),
]


def redact(text):
    """The first SHAPE_CHARS characters of a command, with token-, key-, password-, URL-query-like
    strings masked FIRST (so a secret straddling the cut cannot survive half-shown)."""
    # Bounded first: a few of the patterns are quadratic on one long word, and only the first
    # SHAPE_CHARS are ever shown (a secret cut here lies far past them).
    text = " ".join(str(text)[:16 * SHAPE_CHARS].split())
    for pattern, replacement in _SECRET_PATTERNS:
        text = pattern.sub(replacement, text)
    return text[:SHAPE_CHARS]


def shape_of(tool, inputs):
    if not isinstance(inputs, dict):
        return "<opaque input>"
    if tool == "Bash":
        return redact(inputs.get("command", ""))
    for field in ("file_path", "path", "pattern", "url", "query"):
        if isinstance(inputs.get(field), str):
            return redact(inputs[field])
    return "<" + tool + ">"


# ---------------------------------------------------------------- transcripts

def parse_ts(value):
    if not isinstance(value, str):
        return None
    try:
        return datetime.datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


class BudgetExceeded(Exception):
    """The pass has read its byte budget (--max-pass-bytes)."""


class Budget:
    """Bytes one pass may read from transcripts and journals, in total; None is unbounded."""

    def __init__(self, limit=None):
        self.left, self.read, self.hit = limit, 0, False

    def take(self, n):
        if self.left is not None:
            if n > self.left:
                self.hit = True
                raise BudgetExceeded()
            self.left -= n
        self.read += n


def read_tail(path, tail_bytes, budget=None, first=FIRST_TAIL_BYTES):
    """(lines, whole) of the file's tail. A cut lands mid-record, so the tail starts at the first
    record boundary after it: the partial first line is dropped, never parsed. The tail starts at
    `first` and doubles, up to tail_bytes, only while it holds no complete record (one huge last
    line); an unresolved tool_use is near the end, so most files cost one small read. `whole` says the
    tail reached the start of the file. The final element is whatever follows the last newline."""
    try:
        with open(path, "rb") as f:
            size = f.seek(0, os.SEEK_END)
            want = min(first, tail_bytes) if tail_bytes else size
            while True:
                start = max(0, size - want)
                if budget is not None:
                    budget.take(size - start)
                f.seek(start)
                lines = f.read(size - start).split(b"\n")
                if start:
                    lines = lines[1:]
                if start == 0 or want >= tail_bytes or any(line.strip() for line in lines[:-1]):
                    return lines, start == 0
                want = min(want * 2, tail_bytes)
    except OSError:
        return [], True


def read_lines(path, tail_bytes, budget=None):
    return read_tail(path, tail_bytes, budget)[0]


def transcript_calls(path, tail_bytes=DEFAULT_TAIL_BYTES, budget=None, first=FIRST_TAIL_BYTES):
    """{uses: {id: call}, results: {id}, whole, torn} from the transcript's tail. `torn` is a trailing
    record still being written (no newline, not whole JSON): a result may be inside it, so the file
    says nothing this pass. A line that is not a JSON object anywhere else raises ValueError: the
    sensor cannot say what it missed."""
    uses, results, torn = {}, set(), False
    lines, whole = read_tail(path, tail_bytes, budget, first)
    for number, raw in enumerate(lines):
        if not raw.strip():
            continue
        try:
            row = json.loads(raw)
        except (ValueError, UnicodeDecodeError):
            row = None
        if not isinstance(row, dict):
            if number == len(lines) - 1:
                torn = True  # the last record is mid-write: unknown this pass
                continue
            raise ValueError(f"malformed transcript {path}: a non-final line is not a JSON object")
        message = row.get("message")
        blocks = message.get("content") if isinstance(message, dict) else None
        if not isinstance(blocks, list):
            continue
        for block in blocks:
            if not isinstance(block, dict):
                continue
            kind = block.get("type")
            if kind == "tool_result" and isinstance(block.get("tool_use_id"), str):
                results.add(block["tool_use_id"])
            elif kind == "tool_use" and isinstance(block.get("id"), str):
                when = parse_ts(row.get("timestamp"))
                if when is not None and block["id"] not in uses:
                    uses[block["id"]] = dict(id=block["id"], tool=str(block.get("name", "unknown")),
                                             input=block.get("input"), at=when)
    return dict(uses=uses, results=results, whole=whole, torn=torn)


def dangling_calls(path, tail_bytes=DEFAULT_TAIL_BYTES, budget=None):
    """tool_use blocks in the transcript's tail with no tool_result of the same id, oldest first; none
    while the last record is torn (unknown this pass)."""
    t = transcript_calls(path, tail_bytes, budget)
    if t["torn"]:
        return []
    return sorted((u for i, u in t["uses"].items() if i not in t["results"]), key=lambda u: u["at"])


def long_running_limit(tool, inputs, sense_after_s):
    """Seconds a pending call may age before it counts as held, or None when it is never held."""
    if tool in LONG_RUNNING_TOOLS:
        return None
    inputs = inputs if isinstance(inputs, dict) else {}
    if tool == "Bash":
        if inputs.get("run_in_background") is True:
            return None
        timeout = inputs.get("timeout")
        if isinstance(timeout, (int, float)) and not isinstance(timeout, bool) and timeout > 0:
            return max(sense_after_s, timeout / 1000 + TIMEOUT_GRACE_S)
    return sense_after_s


def find_transcripts(root, session):
    """[(agent, path)]: the main transcript wherever a project directory holds it, and each subagent's."""
    found = []
    if not os.path.isdir(root):
        return found
    for project in sorted(os.listdir(root)):
        main = os.path.join(root, project, session + ".jsonl")
        if os.path.isfile(main):
            found.append(("main", main))
            sub = os.path.join(root, project, session, "subagents")
            if os.path.isdir(sub):
                for name in sorted(os.listdir(sub)):
                    if name.startswith("agent-") and name.endswith(".jsonl"):
                        found.append((name[len("agent-"):-len(".jsonl")], os.path.join(sub, name)))
    return found


def approval_evidence(root, session, budget=None):
    """tool_use ids a dialogue-stasis journal ties to a permission request (the tail of each segment)."""
    ids = set()
    directory = os.path.join(root, session)
    try:
        names = sorted(n for n in os.listdir(directory) if n.startswith("events") and n.endswith(".jsonl"))
    except OSError:
        return ids
    for name in names:
        for raw in read_lines(os.path.join(directory, name), EVIDENCE_TAIL_BYTES, budget):
            try:
                row = json.loads(raw)
            except (ValueError, UnicodeDecodeError):
                continue
            if isinstance(row, dict) and row.get("kind") == "permission-requested":
                source = row.get("source")
                tool_id = source.get("precedingToolUseId") if isinstance(source, dict) else None
                if isinstance(tool_id, str) and tool_id:
                    ids.add(tool_id)
    return ids


def moored_status(sessions_json=None, runner=None):
    """`berth status --json --no-peer` (or an injected file): this device's live moorings and the live
    sibling moorings folded in its channel store. --no-peer spawns no epr and takes no lock on the
    flow store, so a pass that reads it never delays a writer there."""
    if sessions_json:
        with open(sessions_json) as f:
            return json.load(f)
    code, out, err = (runner or run_command)([berth_bin(), "status", "--json", "--no-peer"], timeout=30)
    if code != 0:
        raise RuntimeError(f"berth status exited {code}: {' '.join(err.split())[:120]}")
    return json.loads(out)


def moored_sessions(sessions_json=None, runner=None, data=None):
    """Session ids moored on this device."""
    data = moored_status(sessions_json, runner) if data is None else data
    rows = data.get("moorings", []) if isinstance(data, dict) else data
    return [r["session"] if isinstance(r, dict) else r for r in rows
            if (isinstance(r, dict) and isinstance(r.get("session"), str)) or isinstance(r, str)]


def scan(sessions, transcripts, sense_after_s, now, stasis=None, tail_bytes=DEFAULT_TAIL_BYTES,
         recent_s=DEFAULT_RECENT_S, budget=None, warn=None):
    """Held candidates. Reads only transcripts modified within recent_s (wall clock: a held session's
    transcript was written when its call began), newest first, each from its tail, all within one
    byte budget; when the budget is spent the rest are not read and one line says so."""
    warn = warn or (lambda line: print(line, file=sys.stderr))
    budget = budget or Budget()
    floor = time.time() - recent_s if recent_s else None
    files = []
    for session in sessions:
        for agent, path in find_transcripts(transcripts, session):
            try:
                mtime = os.stat(path).st_mtime
            except OSError:
                continue
            if floor is None or mtime >= floor:
                files.append((-mtime, session, agent, path))
    held, evidence = [], {}
    for _, session, agent, path in sorted(files):
        try:
            calls = dangling_calls(path, tail_bytes, budget)
            found = []
            for call in calls:
                limit = long_running_limit(call["tool"], call["input"], sense_after_s)
                age = now - call["at"]
                if limit is None or age <= limit:
                    continue
                found.append((call, age))
            if found and stasis and session not in evidence:
                evidence[session] = approval_evidence(stasis, session, budget)
        except BudgetExceeded:
            warn(f"held-tool-watch: read budget of {budget.read} bytes spent; "
                 f"{len(files)} transcripts eligible, the rest not read this pass")
            break
        for call, age in found:
            held.append(dict(session=session, agent=agent, tool=call["tool"], toolUseId=call["id"],
                             shape=shape_of(call["tool"], call["input"]), pendingS=int(age),
                             calledAt=call["at"],
                             cause="approval-evidence" if call["id"] in evidence.get(session, ()) else "unknown"))
    return held


def render_line(h):
    return (f"held  {h['session'][:8]}  {h['agent']}  {h['tool']}  {h['pendingS']}s  "
            f"cause: {h['cause']}  {h['shape']}")


# ---------------------------------------------------------------- the target session's own epr

WATCHER_SOURCE = "watcher:held-tool"
NO_VERB_LINE = "held-tool-watch: session {session} runs an epr without stasis observe; not observed"
NO_PIN_LINE = "held-tool-watch: session {session} has no determinable epr pin ({why}); not observed"
NO_JOURNAL_LINE = "held-tool-watch: session {session} has no stasis journal; not observed"
_CID = re.compile(r"^baf[a-z2-7]{20,}$")


PASS_GRACE_S = 0.5


def run_command(argv, timeout=60, cwd=None, env=None):
    """(returncode, stdout, stderr) of one call inside a pass. EPR_BIN is dropped from the inherited
    environment so the named binary runs; an explicit environment (the carry gate's device-head
    EPR_BIN) is preserved. The child stays in the pass's process group; on its own timeout only that
    child is killed, through its unreaped Popen (its pid cannot have been reused), and TimeoutExpired
    is raised. Anything it started is in the pass's group and ends with the pass (run_pass)."""
    env = dict(env) if env is not None else {k: v for k, v in os.environ.items() if k != "EPR_BIN"}
    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            text=True, env=env, cwd=cwd)
    try:
        out, err = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()
        raise
    return proc.returncode, out, err


def _exited(pid):
    """True once the child has exited, WITHOUT reaping it: while it is a zombie its pid, and so the
    process group named after it, cannot be reused."""
    return os.waitid(os.P_PID, pid, os.WEXITED | os.WNOHANG | os.WNOWAIT) is not None


def run_pass(argv, timeout, cancelled=None):
    """(returncode or None on timeout, stdout, stderr) of one pass, run in its own session and process
    group. When the pass has exited (or its timeout has come), and before it is reaped, its whole group
    is sent TERM, then KILL after PASS_GRACE_S: every process the pass started, forked before or after
    any snapshot, ends with it. No pid is enumerated. A descendant that calls setsid itself leaves the
    group and escapes; berth and epr do not."""
    with tempfile.TemporaryFile() as out, tempfile.TemporaryFile() as err:
        proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=out, stderr=err, start_new_session=True)
        end = time.monotonic() + timeout
        while (not _exited(proc.pid) and time.monotonic() < end
               and not (cancelled is not None and cancelled())):
            time.sleep(0.05)
        timed_out = not _exited(proc.pid)
        for sig in (signal.SIGTERM, signal.SIGKILL):
            try:
                os.killpg(proc.pid, sig)
            except ProcessLookupError:
                break
            if sig == signal.SIGTERM:
                time.sleep(PASS_GRACE_S)
        code = proc.wait()
        out.seek(0)
        err.seek(0)
        return (None if timed_out else code, out.read().decode("utf-8", "replace"),
                err.read().decode("utf-8", "replace"))


def start_async_pass(argv):
    """Start the carry as its own child/session while the announce scheduler keeps running."""
    out, err = tempfile.TemporaryFile(), tempfile.TemporaryFile()
    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=out, stderr=err,
                            start_new_session=True)
    return {"proc": proc, "out": out, "err": err}


def poll_async_pass(job):
    """None while running, else `(code, stdout, stderr)` and close its scratch files."""
    code = job["proc"].poll()
    if code is None:
        return None
    job["out"].seek(0)
    job["err"].seek(0)
    answer = (code, job["out"].read().decode("utf-8", "replace"),
              job["err"].read().decode("utf-8", "replace"))
    job["out"].close()
    job["err"].close()
    return answer


def pin_name(session):
    """device-runtime `Store::pin_path`'s file name for a session key, or None when it would hash."""
    name = "".join(chr(b) if (chr(b).isascii() and chr(b).isalnum()) or chr(b) in "_.-" else f"%{b:02x}"
                   for b in session.encode())
    if not name or len(name) > 200:
        return None
    return name.replace(".", "%2e") if name in (".", "..") else name


def native_bin_store(runner=run_command):
    """The bin-store root, from the path the native `epr bin resolve --tool epr --json` prints."""
    code, out, _ = runner(["epr", "bin", "resolve", "--tool", "epr", "--json"])
    if code != 0:
        return None
    path = json.loads(out).get("path")
    if not isinstance(path, str):
        return None
    tool_dir = os.path.dirname(os.path.dirname(path))  # <root>/epr/<cid>/epr -> <root>/epr
    return os.path.dirname(tool_dir) if os.path.basename(tool_dir) == "epr" else None


def pinned_epr(session, bin_store):
    """(path to the session's pinned epr, None) or (None, why)."""
    if not bin_store:
        return None, "no bin-store"
    name = pin_name(session)
    if name is None:
        return None, "session key not encodable here"
    tool_dir = os.path.join(bin_store, "epr")
    try:
        with open(os.path.join(tool_dir, "sessions", name)) as f:
            pin = json.load(f)
    except FileNotFoundError:
        return None, "no pin file"
    except (OSError, ValueError) as error:
        return None, f"unreadable pin: {type(error).__name__}"
    if not isinstance(pin, dict) or pin.get("session") != session:
        return None, "pin names another session"
    cid = pin.get("cid")
    if not isinstance(cid, str) or not _CID.match(cid):
        return None, "pin has no valid cid"
    binary = os.path.join(tool_dir, cid, "epr")
    if not os.access(binary, os.X_OK):
        return None, f"pinned binary {cid[:16]}… absent"
    return binary, None


def has_observe(binary, runner=run_command):
    code, out, err = runner([binary, "session", "stasis", "--help"], timeout=20)
    return code == 0 and "stasis observe" in out + err


def observe_argv(h, journal_root):
    argv = ["session", "stasis", "observe", "--session", h["session"], "--source", WATCHER_SOURCE,
            "--tool", h["tool"], "--pending-since", rfc3339(h["calledAt"])]
    if h["agent"] != "main":
        argv += ["--agent", h["agent"]]
    return argv + ["--journal-root", journal_root]


def rfc3339(t):
    return datetime.datetime.fromtimestamp(t, datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def observe_pass(held, journal_root, bin_store, runner=run_command, say=print, warn=None, observed=None):
    """Call each candidate's own session's pinned epr. Returns the number of failed calls; each
    candidate the native side recorded is appended to `observed` as (candidate, pinned binary)."""
    warn = warn or (lambda line: print(line, file=sys.stderr))
    failed, verbs = 0, {}
    for h in held:
        session = h["session"]
        binary, why = pinned_epr(session, bin_store)
        if binary is None:
            say(NO_PIN_LINE.format(session=session, why=why))
            continue
        if binary not in verbs:
            verbs[binary] = has_observe(binary, runner)
        if not verbs[binary]:
            say(NO_VERB_LINE.format(session=session))
            continue
        code, _, err = runner([binary] + observe_argv(h, journal_root))
        if code == 0:
            if observed is not None:
                observed.append((h, binary))
            continue
        if code == 2 and "no journal" in err:
            say(NO_JOURNAL_LINE.format(session=session))
            continue
        failed += 1
        detail = " ".join(err.split())[:160] or "no output"
        warn(f"held-tool-watch: observe for session {session} failed (exit {code}): {detail}")
    return failed


# ---------------------------------------------------------------- unattended gate carry

CARRY_STOP_FILE = "held-tool-watch.carry.off"
CARRY_ON_FILE = "held-tool-watch.carry.on"
CARRY_EXPIRY_SAID_FILE = "held-tool-watch.carry.expired.said"
CARRY_LOCK = "held-tool-watch.carry.lock"
LAST_CARRY = "held-tool-watch.last-carry.txt"
DECLINE_LEDGER = "held-tool-watch.carry-declines.jsonl"
WATCH_LOG = "held-tool-watch.log"
_PROJECT = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$")
_OID = re.compile(r"^[0-9a-f]{40,64}$")
_CLOSURE = re.compile(r"^[0-9a-f]{64}$")

_CLOSURE_PROGRAM = r"""
import { pathToFileURL } from 'url';
const trusted = process.env.HELD_TOOL_CARRY_TRUSTED_ROOT;
const candidate = process.env.HELD_TOOL_CARRY_CANDIDATE_ROOT;
const commit = process.env.HELD_TOOL_CARRY_COMMIT;
const load = async p => import(pathToFileURL(`${trusted}/${p}`).href);
const { loadGateRegistry } = await load('genesis/orchestrator/pipeline-registry.mjs');
const { gateChildEnv } = await load('genesis/orchestrator/gate-runner.mjs');
const { carryExecutionEnv, gateEvidence } = await load('genesis/orchestrator/gate-evidence.mjs');
const project = loadGateRegistry(candidate).get(process.env.HELD_TOOL_CARRY_PROJECT);
const trustedProject = loadGateRegistry(trusted).get(process.env.HELD_TOOL_CARRY_PROJECT);
if (!project) throw new Error('gate project absent at commit');
if (!trustedProject) throw new Error('gate project absent from trusted runner');
// Candidate manifest/env is key material, never process authority. The device checkout supplies
// the gate policy and cargo environment used to evaluate it.
const env = gateChildEnv(trustedProject, process.env, trusted, { warn: () => {} });
delete env.GATE_EVIDENCE;
let cargoEnv = {};
try { cargoEnv = JSON.parse(env.GATE_CARGO_ENV || '{}'); } catch {}
const executionEnv = carryExecutionEnv(env, cargoEnv, process.env.HELD_TOOL_CARRY_CARGO_HOME);
const execution = { cwd: process.env.HELD_TOOL_CARRY_EXECUTION_ROOT, env: executionEnv };
const evidence = gateEvidence(project, { env, root: candidate, commit, cargoEnv, execution, warn: () => {} });
process.stdout.write(JSON.stringify({ key: evidence.key || null, line: evidence.line || '' }));
"""


def device_head_epr(bin_store):
    """The authoritative device head binary, never a session pin."""
    if not bin_store:
        return None, "no bin-store"
    tool = os.path.join(bin_store, "epr")
    try:
        with open(os.path.join(tool, "current.json")) as f:
            current = json.load(f)
    except (OSError, ValueError) as error:
        return None, f"epr head unreadable: {type(error).__name__}"
    cid = current.get("cid") if isinstance(current, dict) else None
    if not isinstance(cid, str) or not _CID.match(cid):
        return None, "epr head has no valid cid"
    binary = os.path.join(tool, cid, "epr")
    if not os.access(binary, os.X_OK):
        return None, f"epr head binary {cid[:16]}… absent"
    return binary, None


def _one_line(value, limit=220):
    return " ".join(str(value or "").split())[:limit]


def carry_line(miss, reason):
    project = miss.get("project", "?") if isinstance(miss, dict) else "?"
    event = miss.get("event", "?") if isinstance(miss, dict) else "?"
    return f"held-tool-watch carry: {project} {str(event)[:16]}… — {_one_line(reason)}"


def _carry_actor():
    for name in ("ELOHIM_SESSION_ID", "CODEX_SESSION_ID", "CLAUDE_CODE_SESSION_ID", "CLAUDE_SESSION_ID"):
        if os.environ.get(name):
            return os.environ[name]
    return os.environ.get("USER") or os.environ.get("LOGNAME") or "unknown-user"


def parse_carry_until(value, now):
    """An h/d/w duration from now, or an absolute ISO 8601 instant explicitly in UTC."""
    if value is None:
        return now + DEFAULT_CARRY_OPT_IN_S
    duration = re.fullmatch(r"([1-9][0-9]*)([hdw])", value)
    if duration:
        unit_s = {"h": 3600, "d": 86400, "w": 7 * 86400}[duration.group(2)]
        return now + int(duration.group(1)) * unit_s
    try:
        instant = datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError as error:
        raise ValueError("--until must be a duration like 12h, 3d, 1w or an ISO 8601 UTC date") from error
    if instant.tzinfo is None or instant.utcoffset() != datetime.timedelta(0):
        raise ValueError("--until date must name UTC with Z or +00:00")
    return instant.timestamp()


def _write_carry_until(path, until):
    """Replace the switch atomically, so a concurrent pass never mistakes a renewal for legacy."""
    directory = os.path.dirname(path)
    fd, pending = tempfile.mkstemp(prefix=f".{CARRY_ON_FILE}.", dir=directory, text=True)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(rfc3339(until) + "\n")
        os.replace(pending, path)
    finally:
        try:
            os.unlink(pending)
        except FileNotFoundError:
            pass


def _carry_until(status_dir):
    """(until timestamp, rendered UTC). A legacy/malformed switch expires at its own mtime."""
    path = os.path.join(status_dir, CARRY_ON_FILE)
    try:
        stat = os.stat(path)
        with open(path) as f:
            value = f.readline().strip()
    except FileNotFoundError:
        return None
    try:
        instant = datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))
        if instant.tzinfo is None or instant.utcoffset() != datetime.timedelta(0):
            raise ValueError("not UTC")
        until = instant.timestamp()
    except ValueError:
        until = stat.st_mtime
    return until, rfc3339(until)


def _say_carry_expired_once(status_dir, until_text, say):
    marker = os.path.join(status_dir, CARRY_EXPIRY_SAID_FILE)
    try:
        fd = os.open(marker, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    except FileExistsError:
        return
    with os.fdopen(fd, "w") as f:
        f.write(until_text + "\n")
    say(f"carry opt-in expired at {until_text}; run held-tool-watch carry on to renew")


def carry_state(status_dir, now=None, say=print):
    """(off|on|expired, until text). This is the one read used by every pass and poll."""
    if (stopped(status_dir) or os.environ.get("HELD_TOOL_CARRY") == "off"
            or os.path.exists(os.path.join(status_dir, CARRY_STOP_FILE))):
        return "off", None
    switch = _carry_until(status_dir)
    if switch is None:
        return "off", None
    until, until_text = switch
    if (time.time() if now is None else now) < until:
        return "on", until_text
    _say_carry_expired_once(status_dir, until_text, say)
    return "expired", until_text


def carry_switch(args):
    """Record or read the device-local opt-in. No miss or subprocess is touched here."""
    status_dir = os.path.dirname(args.stasis_root or stasis_root())
    on_file = os.path.join(status_dir, CARRY_ON_FILE)
    os.makedirs(status_dir, exist_ok=True)
    if args.until is not None and args.state != "on":
        raise ValueError("--until is valid only with carry on")
    if args.state in ("on", "off"):
        if args.state == "on":
            renewal = os.path.isfile(on_file)
            now = time.time() if args.now is None else args.now
            until = parse_carry_until(args.until, now)
            until_text = rfc3339(until)
            _write_carry_until(on_file, until)
            try:
                os.unlink(os.path.join(status_dir, CARRY_EXPIRY_SAID_FILE))
            except FileNotFoundError:
                pass
        else:
            renewal = False
            until_text = None
            try:
                os.unlink(on_file)
            except FileNotFoundError:
                pass
        act = "renewal" if renewal else ("opt-in" if args.state == "on" else "off")
        line = (f"{rfc3339(time.time() if args.now is None else args.now)} carry={args.state} "
                + (f"until={until_text} " if until_text else "")
                + f"action={act} by={_carry_actor()}")
        with open(os.path.join(status_dir, WATCH_LOG), "a") as log:
            log.write(line + "\n")
    state, until_text = carry_state(status_dir, args.now)
    shown = f"on until {until_text}" if state == "on" else (
        f"expired at {until_text}" if state == "expired" else "off")
    last = "no carry pass recorded"
    try:
        with open(os.path.join(status_dir, LAST_CARRY)) as f:
            last = " ".join(f.readline().split()) or last
    except OSError:
        pass
    print(f"carry {shown}; last: {last}")
    return 0


def _decline_key(miss):
    raw = "\0".join(str(miss.get(k, "")) for k in ("intent", "project", "closure"))
    return hashlib.sha256(raw.encode()).hexdigest()


def decline_once(status_dir, repo, miss, reason, runner=run_command):
    """Tell the household once per miss identity, then append the local untracked receipt."""
    key = _decline_key(miss)
    ledger = os.path.join(status_dir, DECLINE_LEDGER)
    try:
        with open(ledger) as f:
            if any(json.loads(line).get("key") == key for line in f if line.strip()):
                return
    except (OSError, ValueError):
        pass
    text = (f"carry-decline@1 miss={str(miss.get('event', '?'))[:24]} "
            f"announcer={_one_line(miss.get('announcer'), 80)} project={_one_line(miss.get('project'), 80)} "
            f"closure={str(miss.get('closure', '?'))[:16]} reason={_one_line(reason, 160)}")
    code, _, _ = runner([berth_bin(), "say", "--session", ANNOUNCER, text], timeout=30, cwd=repo)
    if code != 0:
        return
    os.makedirs(status_dir, exist_ok=True)
    with open(ledger, "a") as f:
        f.write(json.dumps({"key": key, "at": rfc3339(time.time()), "reason": _one_line(reason)},
                           sort_keys=True) + "\n")


def cargo_pool_root():
    declared = os.environ.get("CARGO_TARGET_POOL_ROOT")
    if declared and os.path.isdir(declared):
        return os.path.realpath(declared)
    default = "/projects/.cargo-target-pool"
    return os.path.realpath(default) if os.path.isdir(default) else None


def _carry_slots(pool, worktree):
    """The gate's linked-worktree suffix has one exact basename; return contained matches only."""
    suffix = f"-wt-{os.path.basename(worktree)}"
    family = os.path.join(pool, "family")
    found = []
    for root, dirs, _ in os.walk(family):
        for name in list(dirs):
            path = os.path.realpath(os.path.join(root, name))
            if name.endswith(suffix) and (path == pool or path.startswith(pool + os.sep)):
                found.append(path)
                dirs.remove(name)
    return found


def carry_enabled(status_dir, now=None, say=print):
    """The bounded recorded device opt-in, with explicit off controls winning over it."""
    return carry_state(status_dir, now, say)[0] == "on"


def carry_stopped(status_dir):
    return not carry_enabled(status_dir)


def _json_call(runner, argv, *, timeout=30, cwd=None, env=None):
    code, out, err = runner(argv, timeout=timeout, cwd=cwd, env=env)
    if code != 0:
        raise RuntimeError(f"exit {code}: {_one_line(err) or 'no output'}")
    try:
        return json.loads(out)
    except ValueError as error:
        raise RuntimeError("invalid JSON") from error


def _remove_carry_worktree(repo, path, runner=run_command, pool=None):
    """Remove one validated carry worktree and only its exact linked-worktree cargo slots."""
    parent = os.path.realpath(os.path.join(repo, ".worktrees"))
    target = os.path.realpath(path)
    if os.path.dirname(target) != parent or not os.path.basename(target).startswith("carry-"):
        raise ValueError(f"refusing non-carry worktree {path}")
    runner(["git", "-C", repo, "worktree", "remove", "--force", target], timeout=60)
    if os.path.exists(target):
        shutil.rmtree(target)
    if pool:
        for slot in _carry_slots(pool, target):
            shutil.rmtree(slot)


def _gate_events(path):
    try:
        with open(path) as stream:
            return [json.loads(line) for line in stream if line.strip()]
    except (OSError, ValueError):
        return []


def _gate_run_closed(path):
    return bool(path and any(event.get("kind") == "run-close" for event in _gate_events(path)))


def _gate_verdict_recorded(path, project):
    return bool(path and any(event.get("kind") == "gate-verdict" and event.get("project") == project
                             for event in _gate_events(path)))


def _closed_carry_run(repo, worktree):
    """The closed gate-live run for a stale carry worktree, if the local record proves one."""
    match = re.fullmatch(r"carry-([0-9a-f]{12})-(.+)", os.path.basename(worktree))
    if not match:
        return None
    short, project = match.groups()
    runs = os.path.join(main_checkout(repo), ".eprfs", "status", "gate-live", "runs")
    try:
        names = sorted(os.listdir(runs), reverse=True)
    except OSError:
        return None
    for name in names:
        path = os.path.join(runs, name)
        events = _gate_events(path)
        opened = next((event for event in events if event.get("kind") == "run-open"), None)
        candidate = opened.get("candidate", {}) if isinstance(opened, dict) else {}
        if (str(candidate.get("sha", "")).startswith(short)
                and candidate.get("target") == f"held-tool-carry:{project}"
                and any(event.get("kind") == "run-close" for event in events)):
            return path
    return None


def _path_is_within(path, parent):
    path, parent = os.path.realpath(path), os.path.realpath(parent)
    return path == parent or path.startswith(parent + os.sep)


def _carry_paths_in_use(worktree, pool=None, proc_root="/proc"):
    """Whether a process cwd or CARGO_TARGET_DIR names this carry's retained assets."""
    targets = [os.path.realpath(worktree)]
    if pool:
        targets.extend(_carry_slots(pool, worktree))
    try:
        pids = [name for name in os.listdir(proc_root) if name.isdigit()]
    except OSError:
        return True
    for pid in pids:
        proc = os.path.join(proc_root, pid)
        try:
            cwd = os.path.realpath(os.readlink(os.path.join(proc, "cwd")))
            if any(_path_is_within(cwd, target) for target in targets):
                return True
        except FileNotFoundError:
            continue
        except (OSError, PermissionError):
            return True
        try:
            with open(os.path.join(proc, "environ"), "rb") as stream:
                entries = stream.read().split(b"\0")
        except FileNotFoundError:
            continue
        except (OSError, PermissionError):
            return True
        for entry in entries:
            if entry.startswith(b"CARGO_TARGET_DIR="):
                value = os.fsdecode(entry.split(b"=", 1)[1])
                if value and not os.path.isabs(value):
                    value = os.path.join(cwd, value)
                if value and any(_path_is_within(value, target) for target in targets):
                    return True
    return False


def sweep_carry_worktrees(repo, older_than_s, runner=run_command, now=None, say=print, pool=None):
    """Remove only stale assets whose run is closed and whose paths no process still names."""
    now = time.time() if now is None else now
    parent = os.path.join(repo, ".worktrees")
    try:
        names = os.listdir(parent)
    except OSError:
        return
    for name in names:
        path = os.path.join(parent, name)
        if not name.startswith("carry-") or not os.path.isdir(path):
            continue
        try:
            stale = now - os.stat(path).st_mtime > older_than_s
        except OSError:
            continue
        if stale:
            try:
                if not _closed_carry_run(repo, path):
                    say(f"held-tool-watch carry: stale {name} retained — no closed gate-live run")
                    continue
                if _carry_paths_in_use(path, pool):
                    say(f"held-tool-watch carry: stale {name} retained — process still names its assets")
                    continue
                _remove_carry_worktree(repo, path, runner, pool)
                say(f"held-tool-watch carry: swept stale {name}")
            except (OSError, ValueError, RuntimeError) as error:
                say(f"held-tool-watch carry: stale {name} not removed — {_one_line(error)}")


@contextlib.contextmanager
def _closure_execution_root():
    """A private writable directory whose ancestry has no Cargo or rustup discovery files."""
    candidates = [os.environ.get("TMPDIR"), "/tmp", "/projects/.cargo-target-pool/family/cd"]
    last = None
    for parent in dict.fromkeys(path for path in candidates if path):
        try:
            execution_root = tempfile.mkdtemp(prefix="held-tool-closure-", dir=parent)
            os.chmod(execution_root, 0o700)
        except OSError as error:
            last = error
            continue
        cursor = os.path.realpath(execution_root)
        unsafe = None
        while True:
            if (os.path.exists(os.path.join(cursor, ".cargo"))
                    or os.path.exists(os.path.join(cursor, "rust-toolchain"))
                    or os.path.exists(os.path.join(cursor, "rust-toolchain.toml"))):
                unsafe = cursor
                break
            ancestor = os.path.dirname(cursor)
            if ancestor == cursor:
                break
            cursor = ancestor
        if unsafe:
            shutil.rmtree(execution_root, ignore_errors=True)
            last = RuntimeError(f"closure execution ancestor carries cargo/rustup config: {unsafe}")
            continue
        try:
            yield execution_root
        finally:
            shutil.rmtree(execution_root, ignore_errors=True)
        return
    raise RuntimeError(f"no safe writable closure execution root: {_one_line(last)}")


def recompute_closure(trusted_root, worktree, commit, project, runner=run_command, timeout=300):
    """Use runner JS and a private non-candidate cwd; the candidate is manifest/tree data."""
    env = dict(os.environ)
    env["HELD_TOOL_CARRY_PROJECT"] = project
    env["HELD_TOOL_CARRY_TRUSTED_ROOT"] = trusted_root
    env["HELD_TOOL_CARRY_CANDIDATE_ROOT"] = worktree
    env["HELD_TOOL_CARRY_COMMIT"] = commit
    env.pop("GATE_EVIDENCE", None)
    cargo_home = os.path.realpath(env.get("CARGO_HOME") or os.path.join(os.path.expanduser("~"), ".cargo"))
    if _path_is_within(cargo_home, worktree):
        raise RuntimeError("device cargo home is inside the candidate")
    with _closure_execution_root() as execution_root:
        env["HELD_TOOL_CARRY_CARGO_HOME"] = cargo_home
        env["HELD_TOOL_CARRY_EXECUTION_ROOT"] = execution_root
        data = _json_call(runner, ["node", "--input-type=module", "--eval", _CLOSURE_PROGRAM],
                          timeout=timeout, cwd=trusted_root, env=env)
    key = data.get("key") if isinstance(data, dict) else None
    if not isinstance(key, str) or not _CLOSURE.match(key):
        why = data.get("line") if isinstance(data, dict) else ""
        raise RuntimeError(f"closure unavailable: {_one_line(why) or 'no key'}")
    return key


def _claim_cargo(repo, session, ttl_s, runner):
    code, out, err = runner(
        [berth_bin(), "claim", "cargo", "--session", session, "--class", "verify", "--ttl",
         str(max(1, int(ttl_s))), "--note", "held-tool carry gate"],
        timeout=60, cwd=repo,
    )
    return code == 0, _one_line(out or err) or f"exit {code}"


def _release_cargo(repo, session, runner):
    runner([berth_bin(), "release", "cargo", "--session", session], timeout=30, cwd=repo)


def _release_carry(head, repo, commitment, runner):
    argv = [head, "flow", "intend", "--release-carry", commitment, "--json", "--root", repo]
    last = ""
    for _ in range(2):
        code, out, err = runner(argv, timeout=30, cwd=repo)
        if code == 0:
            return True, _one_line(out)
        last = _one_line(err or out) or f"exit {code}"
    return False, last


def _claim_commitment(output):
    try:
        commitment = json.loads(output)["commitment"]
    except (ValueError, KeyError, TypeError):
        return None
    return commitment if isinstance(commitment, str) and _CID.match(commitment) else None


def _capacity_refusal(repo, pool, runner):
    ram = os.path.join(repo, "genesis", "agentic", "bin", "ram-guard")
    code, out, err = runner([ram, "status", "--brief"], timeout=30, cwd=repo)
    if code != 0 or not re.search(r"\bRAM-GUARD\s+OK\b", out):
        return f"RAM guard refused: {_one_line(err or out) or f'exit {code}'}"
    code, out, err = runner([berth_bin(), "room", "cargo", "--json"], timeout=30, cwd=repo)
    try:
        room = json.loads(out) if code == 0 else {}
    except ValueError:
        room = {}
    if room.get("verdict") != "admit":
        return f"cargo seats refused: {_one_line(room.get('reason') or err or out) or f'exit {code}'}"
    cargo_pool = os.path.join(repo, "genesis", "agentic", "bin", "cargo-pool")
    env = dict(os.environ)
    env["CARGO_TARGET_POOL_ROOT"] = pool
    code, out, err = runner([cargo_pool, "status"], timeout=30, cwd=repo, env=env)
    if code != 0 or not re.search(r"\bstatus=ok\b", out):
        return f"cargo pool pressure refused: {_one_line(err or out) or f'exit {code}'}"
    return None


def _dev_integration_holder(repo, runner):
    holder = _json_call(runner, [berth_bin(), "who", "dev-integration"], cwd=repo)
    return holder.get("holder") if isinstance(holder, dict) else None


def _cargo_holder(repo, runner, own=None):
    """A cargo holder other than `own`. `berth who cargo` prints a list (the lease has several
    seats); a single record or null is accepted too, so either shape is read."""
    rows = _json_call(runner, [berth_bin(), "who", "cargo"], cwd=repo)
    if isinstance(rows, dict):
        rows = [rows]
    if not isinstance(rows, list):
        return None
    for row in rows:
        holder = row.get("holder") if isinstance(row, dict) else None
        if isinstance(holder, str) and holder and holder != own:
            return holder
    return None


def _interactive_gate_holder(repo, now=None):
    """The holder of a non-stale open `just gate` run, never a carrier's own gate-live run."""
    runs = os.path.join(main_checkout(repo), ".eprfs", "status", "gate-live", "runs")
    try:
        names = sorted(os.listdir(runs), reverse=True)
    except OSError:
        return None
    instant = time.time() if now is None else now
    for name in names:
        path = os.path.join(runs, name)
        try:
            if instant - os.path.getmtime(path) > 6 * 60 * 60:
                continue
        except OSError:
            continue
        events = _gate_events(path)
        opened = next((event for event in events if event.get("kind") == "run-open"), None)
        if not isinstance(opened, dict) or any(event.get("kind") == "run-close" for event in events):
            continue
        candidate = opened.get("candidate")
        if not isinstance(candidate, dict) or candidate.get("target") != "just gate":
            continue
        holder = opened.get("session")
        return holder if isinstance(holder, str) and holder else os.path.splitext(name)[0]
    return None


def _parent_alive(pid):
    if not pid:
        return True
    try:
        os.kill(pid, 0)
        return True
    except OSError:
        return False


def _stop_carried_gate(gate_live, trusted_root, run_log, reason, runner):
    """Ask gate-live at most three times; exit zero or an already-closed record confirms stop."""
    argv = ["node", gate_live, "stop", "--run", run_log, "--now", "--reason", reason]
    last = ""
    for _ in range(3):
        try:
            code, out, err = runner(argv, timeout=45, cwd=trusted_root)
        except (OSError, RuntimeError, subprocess.SubprocessError) as error:
            code, out, err = 1, "", str(error)
        if code == 0 or _gate_run_closed(run_log):
            return True, ""
        last = _one_line(err or out) or f"exit {code}"
    return _gate_run_closed(run_log), last


def run_carried_gate(trusted_root, worktree, commit, project, env, deadline, stop_reason,
                     runner=run_command):
    """Run the authorized gate; return only after its gate-live record proves it closed."""
    gate_live = os.path.join(trusted_root, "genesis", "orchestrator", "gate-live.mjs")
    opened = _json_call(
        runner,
        ["node", gate_live, "open", "--sha", commit, "--target", f"held-tool-carry:{project}"],
        timeout=30,
        cwd=trusted_root,
    )
    run_log = opened.get("path") if isinstance(opened, dict) else None
    if not isinstance(run_log, str) or not run_log:
        raise RuntimeError("gate-live open returned no run path")
    gate_env = dict(env)
    gate_env["GATE_LIVE_RUN"] = run_log
    with tempfile.TemporaryFile() as out, tempfile.TemporaryFile() as err:
        try:
            proc = subprocess.Popen(["just", "gate", project], cwd=worktree, env=gate_env,
                                    stdin=subprocess.DEVNULL, stdout=out, stderr=err)
        except OSError as error:
            try:
                code, _, _ = runner(["node", gate_live, "close", "--run", run_log,
                                     "--outcome", "failed"], timeout=30, cwd=trusted_root)
            except (OSError, RuntimeError, subprocess.SubprocessError):
                code = 1
            settled = code == 0 and _gate_run_closed(run_log)
            return 1, "", _one_line(error), None, run_log, settled, False
        stopped = None
        stop_error = ""
        while proc.poll() is None and stopped is None:
            try:
                stopped = stop_reason()
            except (OSError, RuntimeError, subprocess.SubprocessError) as error:
                stopped = f"gate supervision failed: {_one_line(error)}"
            if stopped is None and time.monotonic() >= deadline:
                stopped = "carry deadline reached"
            if stopped is None:
                time.sleep(0.2)
        if stopped is not None and proc.poll() is None:
            confirmed, stop_error = _stop_carried_gate(
                gate_live, trusted_root, run_log, stopped, runner)
            if not confirmed:
                return 1, "", f"gate stop unconfirmed after 3 attempts: {stop_error}", stopped, run_log, False, False
            try:
                proc.wait(timeout=45)
            except subprocess.TimeoutExpired:
                return 1, "", "gate stop was recorded but its process still runs", stopped, run_log, False, False
        code = proc.wait()
        outcome = "interrupted" if stopped is not None else ("passed" if code == 0 else "failed")
        try:
            close_code, _, close_err = runner(
                ["node", gate_live, "close", "--run", run_log, "--outcome", outcome],
                timeout=30, cwd=trusted_root)
        except (OSError, RuntimeError, subprocess.SubprocessError) as error:
            close_code, close_err = 1, str(error)
        settled = _gate_run_closed(run_log)
        if not settled:
            detail = _one_line(close_err) or f"exit {close_code}"
            return code, "", f"gate-live close unconfirmed: {detail}", stopped, run_log, False, False
        out.seek(0)
        err.seek(0)
        return (code, out.read().decode(errors="replace"), err.read().decode(errors="replace"),
                stopped, run_log, True, _gate_verdict_recorded(run_log, project))


def _eligible_misses(data, now):
    if not isinstance(data, dict):
        return []
    me = data.get("device")
    rows = []
    for miss in data.get("misses") or []:
        if not isinstance(miss, dict) or not miss.get("announcer") or miss.get("announcer") == me:
            continue
        wait = miss.get("waitUntil")
        if not isinstance(wait, (int, float)) or wait <= now:
            continue
        if miss.get("carriedBy"):
            continue
        rows.append(miss)
    return sorted(rows, key=lambda row: (row.get("waitUntil", 0), -(row.get("p90S") or 0),
                                          row.get("project", "")))


def cmd_carry(args, runner=run_command, gate_runner=None):
    """One opt-in pass. The carry lock proves the one-worktree/one-slot bound and safe sweep."""
    if args.state in ("on", "off", "status"):
        return carry_switch(args)
    repo = os.path.realpath(args.repo_root or main_checkout(REPO_ROOT))
    root = args.stasis_root or stasis_root()
    status_dir = os.path.dirname(root)
    # Default off is deliberately before the device-head read: no misses and no subprocess.
    if not carry_enabled(status_dir, args.now):
        return 0
    with file_lock(os.path.join(status_dir, CARRY_LOCK), 0) as mine:
        if not mine:
            return 0
        return _cmd_carry_locked(args, repo, status_dir, runner, gate_runner or run_carried_gate)


def _cmd_carry_locked(args, repo, status_dir, runner, gate_runner):
    say = print
    store = args.bin_store or native_bin_store(runner)
    head, why = device_head_epr(store)
    if head is None:
        say(f"held-tool-watch carry: no device-head epr — {why}")
        return 1
    try:
        # The full output, not `--misses`: under --json, --misses prints only the misses list
        # (epr-cli peer.rs render_intents), and carry also needs `device` to skip its own misses.
        data = _json_call(runner, [head, "peer", "intents", "--json", "--root", repo], cwd=repo)
        now = time.time() if args.now is None else args.now
        misses = _eligible_misses(data, now)
        if not misses:
            say("held-tool-watch carry: no open sibling miss with a future waitUntil")
            return 0
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        say(f"held-tool-watch carry: setup failed — {_one_line(error)}; no miss claimed")
        return 1
    pool = cargo_pool_root()
    if pool is None:
        reason = "no cargo pool (set CARGO_TARGET_POOL_ROOT or provide /projects/.cargo-target-pool)"
        decline_once(status_dir, repo, misses[0], reason, runner)
        say(carry_line(misses[0], reason))
        return 0
    sweep_carry_worktrees(repo, args.carry_deadline_s or MAX_CARRY_PASS_S, runner, now, say, pool)

    started = time.monotonic()
    for miss in misses:
        project, commit = miss.get("project"), miss.get("commit")
        announced, p90 = miss.get("closure"), miss.get("p90S")
        if (not isinstance(project, str) or not _PROJECT.match(project)
                or not isinstance(commit, str) or not _OID.match(commit)
                or not isinstance(announced, str) or not _CLOSURE.match(announced)
                or not isinstance(p90, int) or isinstance(p90, bool) or p90 < 0):
            say(carry_line(miss, "admitted miss lacks a valid project, commit, closure, or p90"))
            continue
        if carry_stopped(status_dir) or not _parent_alive(args.parent_pid):
            reason = "switched off before claim" if carry_stopped(status_dir) else "runner parent exited"
            decline_once(status_dir, repo, miss, reason, runner)
            say(carry_line(miss, reason))
            return 0
        worktree = os.path.join(repo, ".worktrees", f"carry-{commit[:12]}-{project}")
        pass_s = args.carry_deadline_s or min(MAX_CARRY_PASS_S, p90 * 3 + 600)
        carry_session = f"held-tool-carry-{os.getpid()}"
        seat = False
        commitment = None
        failure = None
        gate_started = False
        gate_settled = True
        run_log = None
        verdict_recorded = False
        try:
            seat_deadline = time.monotonic() + max(0, args.carry_seat_wait_s)
            while True:
                seat, seat_reason = _claim_cargo(repo, carry_session, pass_s, runner)
                if seat or time.monotonic() >= seat_deadline or carry_stopped(status_dir):
                    break
                time.sleep(min(2, max(0, seat_deadline - time.monotonic())))
            if not seat:
                reason = f"no cargo seat after waiting: {seat_reason}"
                decline_once(status_dir, repo, miss, reason, runner)
                say(carry_line(miss, reason))
                return 0
            # The admitted signed miss's exact SHA is the authority. A self ref is neither fetched
            # nor accepted as authority; the candidate's JS remains data until the gate begins.
            code, _, err = runner(["git", "-C", repo, "fetch", "--no-tags", "origin", commit], timeout=120)
            if code != 0:
                reason = f"commit SHA not fetchable: {_one_line(err) or f'exit {code}'}"
                decline_once(status_dir, repo, miss, reason, runner)
                say(carry_line(miss, reason))
                continue
            code, _, _ = runner(["git", "-C", repo, "cat-file", "-e", f"{commit}^{{commit}}"], timeout=30)
            if code != 0:
                reason = "fetched object is not the admitted miss's commit"
                decline_once(status_dir, repo, miss, reason, runner)
                say(carry_line(miss, reason))
                continue
            os.makedirs(os.path.dirname(worktree), exist_ok=True)
            checkout_env = dict(os.environ)
            checkout_env.update({"GIT_LFS_SKIP_SMUDGE": "1", "GIT_ATTR_NOSYSTEM": "1"})
            checkout = [
                "git", "-c", "core.hooksPath=/dev/null", "-c", "core.attributesFile=/dev/null",
                "-c", "core.fsmonitor=false", "-c", "filter.lfs.smudge=",
                "-c", "filter.lfs.clean=", "-c", "filter.lfs.process=",
                "-c", "filter.lfs.required=false", "-C", repo, "worktree", "add", "--detach",
                worktree, commit,
            ]
            code, _, err = runner(checkout, timeout=120, env=checkout_env)
            if code != 0:
                say(carry_line(miss, f"detached worktree setup failed: {_one_line(err) or f'exit {code}'}"))
                continue
            code, out, err = runner(
                ["git", "-c", "core.fsmonitor=false", "-C", worktree, "status", "--porcelain",
                 "--untracked-files=all"], timeout=30, env=checkout_env)
            if code != 0 or out.strip():
                say(carry_line(miss, f"exact-commit worktree is not clean: {_one_line(err or out)}"))
                continue
            remaining = max(1, pass_s - (time.monotonic() - started))
            computed = recompute_closure(REPO_ROOT, worktree, commit, project, runner, timeout=remaining)
            if computed != announced:
                reason = f"closure mismatch: announced {announced[:12]}, computed {computed[:12]}"
                decline_once(status_dir, repo, miss, reason, runner)
                say(carry_line(miss, reason))
                continue
            # Capacity and local integration are read again at the last safe point before candidate
            # code is authorized to run.
            if carry_stopped(status_dir) or not _parent_alive(args.parent_pid):
                reason = "switched off before gate" if carry_stopped(status_dir) else "runner parent exited"
                decline_once(status_dir, repo, miss, reason, runner)
                say(carry_line(miss, reason))
                return 0
            holder = _dev_integration_holder(repo, runner)
            if holder:
                reason = f"local dev-integration is held by {holder}"
                decline_once(status_dir, repo, miss, reason, runner)
                say(carry_line(miss, reason))
                return 0
            holder = _cargo_holder(repo, runner, carry_session)
            if holder:
                reason = f"local cargo is held by {holder}"
                decline_once(status_dir, repo, miss, reason, runner)
                say(carry_line(miss, reason))
                return 0
            holder = _interactive_gate_holder(repo, now)
            if holder:
                reason = f"interactive gate is held by {holder}"
                decline_once(status_dir, repo, miss, reason, runner)
                say(carry_line(miss, reason))
                return 0
            remaining_wait = int(miss["waitUntil"] - now)
            valid_for = min(MAX_CARRY_VALID_S, max(600, p90 * 3), remaining_wait)
            if valid_for <= 0:
                say(carry_line(miss, "waitUntil passed before claim"))
                continue
            claim = [head, "flow", "intend", "--carry", miss["intent"], "--project", project,
                     "--closure", announced, "--miss", miss["event"], "--valid-for", str(valid_for),
                     "--json", "--root", repo]
            code, claim_out, err = runner(claim, timeout=30, cwd=repo)
            if code != 0:
                say(carry_line(miss, f"claim failed: {_one_line(err) or f'exit {code}'}; no claim to release"))
                return 1
            commitment = _claim_commitment(claim_out)
            if not commitment:
                replay_code, replay_out, replay_err = runner(claim, timeout=30, cwd=repo)
                commitment = _claim_commitment(replay_out) if replay_code == 0 else None
                if commitment:
                    released, release_why = _release_carry(head, repo, commitment, runner)
                    detail = ("replayed claim released" if released else
                              f"claim release failed after retry: {release_why}")
                else:
                    replay_why = (_one_line(replay_err or replay_out)
                                  or (f"exit {replay_code}" if replay_code else "no commitment"))
                    detail = f"claim replay could not recover commitment: {replay_why}"
                commitment = None
                reason = f"claim returned no commitment; {detail}; gate not started"
                decline_once(status_dir, repo, miss, reason, runner)
                say(carry_line(miss, reason))
                return 1
            capacity = _capacity_refusal(repo, pool, runner)
            if capacity:
                failure = capacity
                decline_once(status_dir, repo, miss, capacity, runner)
                say(carry_line(miss, f"{capacity}; gate not started"))
                return 0
            gate_env = dict(os.environ)
            gate_env.update({"EPR_BIN": head, "GATE_DEFER": "off", "GATE_CARRY": "off",
                             "GATE_CARRY_WAIT": "off"})
            gate_env.pop("GATE_EVIDENCE", None)
            deadline = started + pass_s
            holder_check = [0.0]

            def stop_reason():
                if carry_stopped(status_dir):
                    return "carry switched off"
                if not _parent_alive(args.parent_pid):
                    return "runner parent exited"
                if time.monotonic() - holder_check[0] >= 1:
                    holder_check[0] = time.monotonic()
                    holder_now = _dev_integration_holder(repo, runner)
                    if holder_now:
                        return f"local landing started ({holder_now})"
                    cargo_now = _cargo_holder(repo, runner, carry_session)
                    if cargo_now:
                        return f"local cargo started ({cargo_now})"
                    gate_now = _interactive_gate_holder(repo, now)
                    if gate_now:
                        return f"interactive gate started ({gate_now})"
                return None

            gate_started = True
            gate_settled = False
            result = gate_runner(
                REPO_ROOT, worktree, commit, project, gate_env, deadline, stop_reason, runner=runner)
            (code, _, err, stopped_reason, run_log, gate_settled,
             verdict_recorded) = result
            if not gate_settled:
                failure = f"gate stop/close unconfirmed: {_one_line(err)}"
                say(carry_line(miss, f"{failure}; claim, worktree, target slot and cargo seat retained"))
                return 1
            if stopped_reason:
                failure = stopped_reason
                say(carry_line(miss, f"yielded: {stopped_reason}; gate stopped and unrecorded claim released"))
                return 1
            if code != 0:
                failure = f"gate exited {code}: {_one_line(err)}"
                suffix = "only the gate's verdict stands" if verdict_recorded else "unrecorded claim released"
                say(carry_line(miss, f"{failure}; {suffix}"))
                return 1
            if not verdict_recorded:
                failure = "gate exited green but emitted no gate verdict"
                say(carry_line(miss, f"{failure}; unrecorded claim released"))
                return 1
            say(carry_line(miss, "gate green; its device-head verdict is the only verdict written"))
            return 0
        except (OSError, RuntimeError, subprocess.SubprocessError) as error:
            failure = f"setup failed: {_one_line(error)}"
            suffix = ("gate state unconfirmed; claim, worktree, target slot and cargo seat retained"
                      if gate_started else "carry released if claimed, no runner verdict written")
            say(carry_line(miss, f"{failure}; {suffix}"))
            return 1
        finally:
            safe_after_gate = not gate_started or gate_settled
            if commitment and not verdict_recorded and safe_after_gate:
                released, why = _release_carry(head, repo, commitment, runner)
                if not released:
                    say(carry_line(miss, f"carry claim release failed after retry: {why}"))
            if os.path.exists(worktree) and safe_after_gate:
                try:
                    if _carry_paths_in_use(worktree, pool):
                        say(carry_line(miss, "carry assets retained — process still names worktree or target slot"))
                    else:
                        _remove_carry_worktree(repo, worktree, runner, pool)
                except (OSError, ValueError, RuntimeError) as error:
                    say(carry_line(miss, f"carry asset cleanup failed: {_one_line(error)}"))
            if seat and safe_after_gate:
                _release_cargo(repo, carry_session, runner)
    return 0


# ---------------------------------------------------------------- announcing, once, from the record

ANNOUNCER = "held-tool-watch"  # the berth sender of every line this watcher says
MARK = "held-tool@1"
MAX_ADDRESSEES = 8  # distinct sessions told of one incident over its whole life; then the household, once
LOOP_LOCK = "held-tool-watch.run.lock"  # .claude/hooks/held-tool-ensure.py LOCK_NAME
STOP_FILE = "held-tool-watch.off"  # .claude/hooks/held-tool-ensure.py STOP_NAME
ANNOUNCE_LOCK = "held-tool-watch.announce.lock"
LAST_PASS = "held-tool-watch.last-pass.txt"
BACKOFF_CAP_S = 15 * 60
_TOKEN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:@+-]{0,199}$")
_FIELD = re.compile(r"(\w+)=(\S+)")
NOTE_FIELDS = ("device", "session", "agent", "tool", "since")


def berth_run(argv, runner):
    return runner([berth_bin()] + argv, timeout=60)


def token(value):
    """A value for a line that crosses devices: shaped, or `?`."""
    value = str(value)
    return value if _TOKEN.match(value) else "?"


def incident_key(session, agent, tool, since):
    """The native incident key (session, agent, tool, pending-since) as one string. It names one held
    call on every pass, and it is recomputed from a said line's own fields, so the record of the line
    is what makes it once."""
    return "\0".join([session, agent, tool, since])


def short_device(device):
    return f"{device[:16]}…{device[-4:]}" if device and len(device) > 24 else (device or "this device")


def note_fields(h, device):
    """Everything a line carries off the device: these five, and fixed words. Never the call's input,
    its id, a command, a path or the cause."""
    return dict(device=token(device or "local"), session=token(h["session"]), agent=token(h["agent"]),
                tool=token(h["tool"]), since=rfc3339(h["calledAt"]))


def open_line(f):
    return (f"{MARK} open " + " ".join(f"{k}={f[k]}" for k in NOTE_FIELDS) +
            f" — a {f['tool']} call of session {f['session'][:8]} ({f['agent']}) on {short_device(f['device'])} "
            f"has been pending since {f['since'][11:16]}Z: very likely a prompt nobody has seen, and its "
            f"terminal needs the steward. Nothing here approves, cancels or retries it; one more line "
            f"follows when it resumes.")


def resumed_line(f):
    return (f"{MARK} resumed " + " ".join(f"{k}={f.get(k, '?')}" for k in NOTE_FIELDS) +
            f" — that {f.get('tool', '?')} call of session {f.get('session', '?')[:8]} is no longer pending "
            f"(answered, or its session ended).")


def parse_mark(text):
    """(kind, fields) of a line this watcher said, else None."""
    if not isinstance(text, str) or not text.startswith(MARK + " "):
        return None
    head = text.split(" — ", 1)[0].split()
    if len(head) < 2:
        return None
    return head[1], dict(_FIELD.findall(" ".join(head[2:])))


def native_open_incidents(binary, session, journal_root, runner):
    """The ids of the session's open native incidents, read through ITS OWN pinned epr (so the reader is
    never older than what the writer wrote), or None when that read fails."""
    code, out, _ = runner([binary, "session", "stasis", "status", "--session", session, "--json",
                           "--journal-root", journal_root], timeout=30)
    if code != 0:
        return None
    try:
        data = json.loads(out)
    except ValueError:
        return None
    ids = []
    for row in data.get("sessions", []) if isinstance(data, dict) else []:
        if isinstance(row, dict) and row.get("session") == session:
            ids += [i["id"] for i in row.get("openIncidents") or []
                    if isinstance(i, dict) and isinstance(i.get("id"), str)]
    return ids


def addressees(status, held_session):
    """Every live session moored here or on a sibling device, other than the held one, local first: the
    sessions whose next tool call (berth-note-inject) or Monitor shows an addressed note."""
    found = []
    for section in ("moorings", "siblings"):
        for row in status.get(section) or []:
            session = row.get("session") if isinstance(row, dict) else None
            if (isinstance(session, str) and _TOKEN.match(session) and session not in (held_session, ANNOUNCER)
                    and session not in found):
                found.append(session)
    return found


def still_pending(transcripts, session, agent, tool, since, tail_bytes=DEFAULT_TAIL_BYTES, budget=None):
    """True while a call of that tool begun at `since` has no result in its transcript; False once it
    has one, or once the whole transcript is read and holds no such call, or the transcript is gone;
    None (unknown: never say resumed on it) while the tail is torn, unreadable, or has not reached
    back to the call. The tail grows for this file until it holds the call or the file's start."""
    for name, path in find_transcripts(transcripts, session):
        if name != agent:
            continue
        size = FIRST_TAIL_BYTES
        while True:
            try:
                t = transcript_calls(path, size, budget, first=size)
            except (ValueError, BudgetExceeded):
                return None
            if t["torn"]:
                return None
            calls = [u for u in t["uses"].values() if u["tool"] == tool and rfc3339(u["at"]) == since]
            if calls:
                return any(u["id"] not in t["results"] for u in calls)
            if t["whole"]:
                return False
            if size >= tail_bytes:
                return None
            size = min(size * 2, tail_bytes)
    return False


def berth_json(argv, runner):
    code, out, err = berth_run(argv, runner)
    if code != 0:
        raise RuntimeError(f"berth {argv[0]} exited {code}: {' '.join(err.split())[:120] or 'no output'}")
    return json.loads(out)


def announce_pass(observed, journal_root, transcripts, now, runner=run_command, warn=None,
                  tail_bytes=DEFAULT_TAIL_BYTES, budget=None, moored=None):
    """Say each call the native side holds open once to each addressee (at most MAX_ADDRESSEES over the
    incident's life, then the household once), and once more to each of them when it has resumed.
    "Once" is read from the record the saying makes: the notes this watcher said, as folded in this
    device's channel store (`berth said`), for as long as that record holds them. Returns failures.

    Cost and the flow store. Every `epr` that reads the flow store holds its shared lock for seconds
    while it decodes the whole log, and a writer (`epr flow note`, which berth gives 5 s) waits for
    all of them. So a pass in which nothing is new spawns no such reader: `berth said` reads berth's
    unlocked note stream, recipients come from `moored` (the --no-peer status the scan already read),
    and resumption is read from the transcript. Only a FIRST line for an incident reads the native
    status (through the target's pinned epr) and the full `berth status --json` once, for the device
    id; later lines take the device id from the first."""
    warn = warn or (lambda line: print(line, file=sys.stderr))
    try:
        notes = berth_json(["said", "--session", ANNOUNCER, "--json"], runner)
    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
        warn(f"held-tool-watch: cannot read what was already said ({error}); nothing said this pass")
        return 1
    told, resumed, fields = {}, set(), {}
    for note in notes if isinstance(notes, list) else []:
        parsed = parse_mark(note.get("text")) if isinstance(note, dict) else None
        if not parsed or not all(parsed[1].get(k) for k in ("session", "agent", "tool", "since")):
            continue
        kind, f = parsed
        key = incident_key(f["session"], f["agent"], f["tool"], f["since"])
        if kind == "open":
            told.setdefault(key, []).append(note.get("to"))
            fields.setdefault(key, f)
        elif kind == "resumed":
            resumed.add((key, note.get("to")))

    def say(line, to):
        code, _, err = berth_run(["say", "--session", ANNOUNCER] + (["--to", to] if to else []) + [line],
                                 runner)
        if code != 0:
            warn(f"held-tool-watch: berth say failed (exit {code}): {' '.join(err.split())[:160] or 'no output'}")
            return 1
        return 0

    device_read = []

    def device_id():
        """This device's id, read once per pass and only for a first line (the full status spawns the
        peer reads)."""
        if not device_read:
            try:
                status = berth_json(["status", "--json"], runner)
                device_read.append(status.get("device") if isinstance(status, dict) else None)
            except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:
                warn(f"held-tool-watch: device id unreadable ({error}); the line says `local`")
                device_read.append(None)
        return device_read[0]

    failed, current = 0, set()
    for h, binary in observed:
        key = incident_key(token(h["session"]), token(h["agent"]), token(h["tool"]), rfc3339(h["calledAt"]))
        current.add(key)
        already = told.get(key, [])
        if already:
            f = fields[key]  # said before: the native side held it open then; the device id is in it
        else:
            incidents = native_open_incidents(binary, h["session"], journal_root, runner)
            if incidents is None:
                warn(f"held-tool-watch: native status of session {h['session']} unreadable; not announced")
                failed += 1
                continue
            if not incidents:
                continue  # the native side holds nothing open: held state is the Incident, not this script
            f = note_fields(h, device_id())
        sessions = [s for s in addressees(moored or {}, h["session"]) if s not in already]
        named = sum(1 for t in already if t)
        if not already and not sessions:
            failed += say(open_line(f), None)
            continue
        for to in sessions:
            if named < MAX_ADDRESSEES:
                failed += say(open_line(f), to)
                named += 1
            elif None not in already:
                failed += say(open_line(f), None)  # the household once, past the cap
                break
    for key, f in sorted(fields.items()):
        if key in current or all((key, to) in resumed for to in told[key]):
            continue
        if still_pending(transcripts, f["session"], f["agent"], f["tool"], f["since"], tail_bytes,
                         budget) is not False:
            continue  # still pending, or unknown: never say resumed on a guess
        for to in dict.fromkeys(told[key]):
            if (key, to) not in resumed:
                failed += say(resumed_line(f), to)
    return failed


@contextlib.contextmanager
def file_lock(path, wait_s):
    """True once this process holds an exclusive lock on `path`, False when another holds it past
    wait_s (0 = one try). The lock orders writers; it records nothing."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o644)
    try:
        end = time.monotonic() + wait_s
        while True:
            try:
                fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if time.monotonic() >= end:
                    yield False
                    return
                time.sleep(0.2)
        yield True
    finally:
        os.close(fd)


# ---------------------------------------------------------------- CLI

def sensed(args, runner=None, budget=None, data=None):
    now = args.now if args.now is not None else time.time()
    sessions = moored_sessions(args.sessions_json, runner, data)
    return scan(sessions, args.transcripts or transcripts_root(), args.sense_after_s, now,
                args.stasis_root or stasis_root(), args.tail_bytes, args.recent_s,
                budget or Budget(args.max_pass_bytes or None))


def cmd_scan(args, runner=run_command):
    held = sensed(args)
    if args.json:
        print(json.dumps(held, sort_keys=True))
    else:
        for h in held:
            print(render_line(h))
    return 3 if held else 0


def cmd_observe(args, runner=run_command):
    held = sensed(args)
    if not held:
        return 0
    bin_store = args.bin_store or native_bin_store(runner)
    return 1 if observe_pass(held, args.stasis_root or stasis_root(), bin_store, runner) else 0


def cmd_announce(args, runner=run_command):
    now = args.now if args.now is not None else time.time()
    budget = Budget(args.max_pass_bytes or None)
    moored = moored_status(args.sessions_json)
    held = sensed(args, budget=budget, data=moored)
    root = args.stasis_root or stasis_root()
    observed, failed = [], 0
    if held:
        failed = observe_pass(held, root, args.bin_store or native_bin_store(runner), runner, observed=observed)
    with file_lock(os.path.join(os.path.dirname(root), ANNOUNCE_LOCK), 30) as mine:
        if not mine:
            print("held-tool-watch: another announce pass holds the lock; this one said nothing",
                  file=sys.stderr)
            return 1
        failed += announce_pass(observed, root, args.transcripts or transcripts_root(), now, runner,
                                tail_bytes=args.tail_bytes, budget=budget, moored=moored)
    return 1 if failed else 0


def stopped(status_dir):
    """The device's off switch: HELD_TOOL_WATCH=off in the runner's environment, or the stop file the
    hook writes when a session runs with HELD_TOOL_WATCH=off (removed by one with =on)."""
    return os.environ.get("HELD_TOOL_WATCH") == "off" or os.path.exists(os.path.join(status_dir, STOP_FILE))


def cmd_run(args, runner=run_command):
    """The one device runner; announce keeps cadence while at most one carry child runs."""
    root = args.stasis_root or stasis_root()
    script = os.path.realpath(__file__)
    # Only what differs from the defaults is passed on: `--tail-bytes` is the most one tail may GROW
    # to (each read starts at FIRST_TAIL_BYTES), and naming it in every pass's argv read as an 8 MiB read.
    announce_args = []
    for flag, value, default in (("--sense-after-s", args.sense_after_s, 120),
                                 ("--tail-bytes", args.tail_bytes, DEFAULT_TAIL_BYTES),
                                 ("--recent-s", args.recent_s, DEFAULT_RECENT_S),
                                 ("--max-pass-bytes", args.max_pass_bytes, DEFAULT_PASS_BYTES)):
        if value != default:
            announce_args += [flag, str(value)]
    for flag, value in (("--transcripts", args.transcripts), ("--sessions-json", args.sessions_json),
                        ("--stasis-root", args.stasis_root), ("--bin-store", args.bin_store)):
        if value:
            announce_args += [flag, value]
    carry_args = []
    for flag, value in (("--stasis-root", args.stasis_root), ("--bin-store", args.bin_store),
                        ("--repo-root", args.repo_root), ("--carry-deadline-s", args.carry_deadline_s)):
        if value is not None:
            carry_args += [flag, str(value)]
    carry_args += ["--parent-pid", str(os.getpid()), "--carry-seat-wait-s", str(args.carry_seat_wait_s)]
    status_dir = os.path.dirname(root)

    def line(text):
        print(f"held-tool-watch run: {rfc3339(time.time())} {text}", file=sys.stderr, flush=True)

    with file_lock(os.path.join(status_dir, LOOP_LOCK), 0) as mine:
        if not mine:
            return 0  # this device already has its runner
        passes, carry_job = 0, None
        state = {"announce": None, "carry": None}
        announce_wait, carry_wait = args.every, args.carry_every
        now = time.monotonic()
        announce_due = carry_due = now
        while True:
            if not os.path.isfile(script):
                line("script gone; exiting")
                break
            if stopped(status_dir):
                line("switched off (HELD_TOOL_WATCH=off); exiting")
                break
            # Poll the same bounded switch even while a carry child is live. The child cooperatively
            # observes the same state in its gate stop callback and owns stop + release cleanup.
            carry_on = carry_enabled(
                status_dir, say=lambda text: print(text, file=sys.stderr, flush=True))
            now = time.monotonic()
            if carry_job is not None:
                finished = poll_async_pass(carry_job)
                if finished is not None:
                    code, out, err = finished
                    carry_job = None
                    try:
                        with open(os.path.join(status_dir, LAST_CARRY), "w") as f:
                            f.write(f"{rfc3339(time.time())} exit {code}\n{out[-4096:]}{err[-4096:]}")
                    except OSError:
                        pass
                    now_state = "passing" if code == 0 else f"failing (exit {code})"
                    carry_wait = (args.carry_every if code == 0 else
                                  min(BACKOFF_CAP_S, max(1.0, carry_wait * 2)))
                    carry_due = time.monotonic() + carry_wait
                    if now_state != state["carry"]:
                        tail = " ".join((err or "").split())[-200:]
                        line("carry " + now_state +
                             (f", next pass in {int(carry_wait)} s: {tail}" if code != 0 else ""))
                        state["carry"] = now_state
            if carry_job is None and now >= carry_due:
                if carry_on:
                    carry_job = start_async_pass([sys.executable, script, "carry", *carry_args])
                else:
                    carry_due = now + args.carry_every
            if now >= announce_due:
                code, out, err = run_pass([sys.executable, script, "announce", *announce_args],
                                          timeout=max(60, 3 * args.every))
                if code is None:
                    err += "held-tool-watch: announce pass timed out; its process group was killed\n"
                try:
                    with open(os.path.join(status_dir, LAST_PASS), "w") as f:
                        f.write(f"{rfc3339(time.time())} exit {code}\n{out[-4096:]}{err[-4096:]}")
                except OSError:
                    pass
                now_state = "passing" if code == 0 else ("timing out" if code is None else f"failing (exit {code})")
                announce_wait = (args.every if code == 0 else
                                 min(BACKOFF_CAP_S, max(1.0, announce_wait * 2)))
                announce_due = time.monotonic() + announce_wait
                if now_state != state["announce"]:
                    tail = " ".join((err or "").split())[-200:]
                    line(now_state + (f", next pass in {int(announce_wait)} s: {tail}" if code != 0 else ""))
                    state["announce"] = now_state
                passes += 1
                if args.passes and passes >= args.passes:
                    break
            next_due = min(announce_due, carry_due if carry_job is None else now + 0.1)
            time.sleep(max(0.01, min(0.1, next_due - time.monotonic())))
    return 0


class _Parser(argparse.ArgumentParser):
    """A usage error is an internal error like any other: one line, exit 1 (argparse would exit 2)."""
    def error(self, message):
        raise ValueError(f"usage: {message}")


def parser():
    p = _Parser(prog="held-tool-watch", description=__doc__.strip().split("\n\n")[0])
    sub = p.add_subparsers(dest="cmd", required=True, parser_class=_Parser)
    for name, run in (("scan", cmd_scan), ("observe", cmd_observe), ("announce", cmd_announce),
                      ("carry", cmd_carry), ("run", cmd_run)):
        s = sub.add_parser(name)
        if name in ("scan", "observe", "announce", "run"):
            s.add_argument("--transcripts")
            s.add_argument("--sense-after-s", type=float, default=120)
            s.add_argument("--sessions-json")
            s.add_argument("--tail-bytes", type=int, default=DEFAULT_TAIL_BYTES)
            s.add_argument("--recent-s", type=float, default=DEFAULT_RECENT_S)
            s.add_argument("--max-pass-bytes", type=int, default=DEFAULT_PASS_BYTES)
        if name in ("observe", "announce", "carry", "run"):
            s.add_argument("--bin-store")
        if name in ("scan", "observe", "announce", "carry", "run"):
            s.add_argument("--stasis-root")
        if name in ("carry", "run"):
            s.add_argument("--repo-root")
            s.add_argument("--carry-deadline-s", type=float,
                           default=float(os.environ["HELD_TOOL_CARRY_DEADLINE_S"])
                           if os.environ.get("HELD_TOOL_CARRY_DEADLINE_S") else None)
            s.add_argument("--carry-seat-wait-s", type=float,
                           default=float(os.environ.get("HELD_TOOL_CARRY_SEAT_WAIT_S", "60")))
        if name not in ("run",):
            s.add_argument("--now", type=float)
        if name == "scan":
            s.add_argument("--json", action="store_true")
        if name == "carry":
            s.add_argument("state", nargs="?", choices=("pass", "on", "off", "status"), default="pass")
            s.add_argument("--until")
            s.add_argument("--parent-pid", type=int)
        if name == "run":
            s.add_argument("--every", type=float, default=60)
            s.add_argument("--carry-every", type=float,
                           default=float(os.environ.get("HELD_TOOL_CARRY_EVERY_S", DEFAULT_CARRY_EVERY_S)))
            s.add_argument("--passes", type=int, default=0)
        s.set_defaults(run=run)
    return p


def main(argv, runner=run_command):
    """Never raises: every failure is one stderr line and exit 1 (never 2, which a hook reads as a
    block). KeyboardInterrupt is a failure too."""
    try:
        p = parser()
        args = p.parse_args(argv)
        return args.run(args, runner=runner)
    except SystemExit as stop:  # --help
        return 0 if stop.code in (0, None) else 1
    except BaseException as error:  # noqa: BLE001 — the sensor's own failure must be a line, never silence
        print(f"held-tool-watch: {type(error).__name__}: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
