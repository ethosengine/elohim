#!/usr/bin/env bash
# Usage: landing-pick -C <worktree> <commit>... | --continue | --abort
set -euo pipefail
unset EPR_BIN

bad() { printf '%s\n' "${0##*/}: $1" >&2; exit 2; }
refuse() { printf '%s\n' "${0##*/}: $1" >&2; exit 3; }
[[ $# -ge 3 && $1 == -C && -n $2 ]] || bad 'expected -C <worktree> first, then arguments'
wt=$2
shift 2
printf '%s\n' 'Git fallback: cherry-pick — brit has no cherry-pick verb'
mode=pick
if [[ $1 == --continue || $1 == --abort ]]; then
    [[ $# == 1 ]] || bad 'recovery accepts no additional arguments'
    mode=$1
else
    for revision in "$@"; do
        [[ -n $revision && $revision != -* ]] || bad 'expected commits or ranges'
        git -C "$wt" rev-parse --verify "${revision%%..*}^{commit}" >/dev/null 2>&1 || bad 'invalid commit or range'
        if [[ $revision == *..* ]]; then
            [[ $revision != *...* ]] || bad 'use a two-dot range'
            git -C "$wt" rev-parse --verify "${revision#*..}^{commit}" >/dev/null 2>&1 || bad 'invalid range end'
        fi
    done
fi
git_dir=$(git -C "$wt" rev-parse --path-format=absolute --git-dir 2>/dev/null) || bad 'not a worktree'
common_dir=$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir)
[[ $git_dir != "$common_dir" ]] || refuse 'main checkout is not allowed'
branch=$(git -C "$wt" symbolic-ref --quiet --short HEAD) || refuse 'a current branch is required'
[[ $branch != dev && $branch != main ]] || refuse 'dev and main are not allowed'
if [[ $mode == pick ]]; then
[[ -z $(git -C "$wt" status --porcelain --untracked-files=no) ]] || refuse 'tracked files have uncommitted changes'
else
    # Recovery necessarily permits the conflicted index or staged resolution.
    [[ -f $git_dir/CHERRY_PICK_HEAD || -d $git_dir/sequencer ]] || refuse 'no cherry-pick in progress'
    if [[ $mode == --continue ]]; then
        git -C "$wt" diff --quiet || refuse 'stage the conflict resolution before continuing'
    fi
fi
if git -C "$wt" -c core.editor=true cherry-pick "$@"; then
    git -C "$wt" rev-parse --short HEAD
else
    status=$?
    conflicts=$(git -C "$wt" diff --name-only --diff-filter=U)
    if [[ -n $conflicts ]]; then
        printf '%s\n' "$conflicts"
        exit 4
    fi
    exit "$status"
fi
