#!/usr/bin/env bash
# rust-analyzer's package check or workspace build scripts; stdout is cargo JSON.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=pool-lib.sh
source "$SCRIPT_DIR/pool-lib.sh"

if [[ $# != 2 || $1 != rust ]]; then
  echo 'usage: lsp-flycheck rust <saved_file>|--build-scripts' >&2
  exit 2
fi
build_scripts=0
[[ $2 != --build-scripts ]] || build_scripts=1

# Inspect manifests without invoking cargo (metadata also takes build resources).
metadata="$(python3 - "$2" <<'PY'
import pathlib
import subprocess
import sys
import tomllib

build_scripts = sys.argv[1] == '--build-scripts'
saved = pathlib.Path.cwd() / 'Cargo.toml' if build_scripts else pathlib.Path(sys.argv[1]).resolve()
root = pathlib.Path(subprocess.check_output(
    ['git', '-C', str(saved.parent), 'rev-parse', '--show-toplevel'], text=True).strip())
if build_scripts:
    # rust-analyzer invokes this command once per Cargo workspace, from its root.
    data = tomllib.loads(saved.read_text())
    if 'workspace' not in data and 'package' not in data:
        sys.exit('lsp-flycheck: no Cargo workspace at build-scripts root')
    print(saved)
    print(data.get('package', {}).get('name', 'workspace'))
    print(saved)
    print(root)
    print(saved.parent.relative_to(root))
    sys.exit(0)
package_dir = None
workspace = None
for directory in (saved.parent, *saved.parent.parents):
    manifest = directory / 'Cargo.toml'
    if manifest.is_file():
        data = tomllib.loads(manifest.read_text())
        if package_dir is None and 'package' in data:
            package_dir = directory
            package = data['package']
            if 'workspace' in package:
                workspace = (directory / package['workspace']).resolve()
        if package_dir is not None and 'workspace' in data:
            workspace = workspace or directory
            break
    if directory == root:
        break
if package_dir is None:
    sys.exit('lsp-flycheck: no owning Cargo package')
print(saved)
print(package['name'])
print(package_dir / 'Cargo.toml')
print(root)
print((workspace or package_dir).relative_to(root))
PY
)"
mapfile -t fields <<< "$metadata"
saved_file="${fields[0]}"
pkg="${fields[1]}"
manifest="${fields[2]}"
root="${fields[3]}"
workspace="${fields[4]}"
dev_slot="$(slot_path "$(detect_family "$root")" "$workspace" dev)"
export CARGO_TARGET_DIR="${dev_slot%/dev}/lsp"
export CARGO_BUILD_JOBS=1
case "$workspace/" in
  elohim/holochain/dna/*) unset RUSTUP_TOOLCHAIN ;;
  *)
    export RUSTUP_TOOLCHAIN=1.96.1
    # The storage crate supplies the custom getrandom backend; other native crates do not.
    [[ $workspace == elohim/elohim-storage ]] || export RUSTFLAGS=
    ;;
esac
# Berth must read this checkout's policy even when invoked from a package directory.
export CLAUDE_PROJECT_DIR="$root"
guard="$SCRIPT_DIR/../../../.claude/hooks/cargo-disk-guard.py"

ttl_s="${LSP_FLYCHECK_TTL_S:-600}"
margin_s="${LSP_FLYCHECK_MARGIN_S:-30}"
python3 - "$ttl_s" "$margin_s" <<'PY'
import sys
try:
    ttl, margin = map(int, sys.argv[1:])
    # Reserve the timeout's ten-second KILL grace inside the lease as well.
    if not 10 < margin < ttl:
        raise ValueError
except ValueError:
    sys.exit('lsp-flycheck: lease seconds must exceed margin seconds, and margin must exceed 10')
PY

own_holder=
busy_builds() {
  local holders
  # who returns null, one legacy lease object, or an array of live slot leases.
  holders="$("$SCRIPT_DIR/berth" who cargo 2>/dev/null)" || holders=null
  python3 - "$holders" "$guard" "$own_holder" <<'PY'
import json
import runpy
import sys
try:
    rows = json.loads(sys.argv[1])
    rows = [rows] if isinstance(rows, dict) else rows or []
    holders = [row['holder'] for row in rows if row['holder'] != sys.argv[3]]
except (ValueError, KeyError, TypeError):
    holders = []
guard = runpy.run_path(sys.argv[2])
holders.extend(f'pid {pid}: {cmd}' for pid, cmd, yieldable in guard['running_heavy']()
               if not yieldable)
print(', '.join(holders))
PY
}

warning() {
  python3 - "$pkg" "$manifest" "$saved_file" "$1" <<'PY'
import json
import sys
pkg, manifest, saved, message = sys.argv[1:]
print(json.dumps({'reason': 'compiler-message', 'package_id': pkg,
                  'manifest_path': manifest,
                  'target': {'kind': ['lib'], 'name': pkg, 'src_path': saved},
                  'message': {'message': message, 'level': 'warning', 'spans': [],
                              'children': [], 'code': None, 'rendered': message + '\n'}}))
PY
  exit 0
}

defer() {
  warning "flycheck deferred: build slot held by $1"
}

# Build-script/proc-macro output is needed for the entire analysis session.
# Unlike save-triggered flycheck, wait for admission instead of skipping it.
if [[ $build_scripts == 1 ]]; then
  poll_s="${LSP_FLYCHECK_POLL_S:-10}"
  wait_max_s="${LSP_FLYCHECK_WAIT_MAX_S:-1800}"
  wait_deadline="$(python3 - "$poll_s" "$wait_max_s" <<'PY'
import math
import sys
import time
try:
    poll, maximum = map(float, sys.argv[1:])
    if not all(math.isfinite(value) and value > 0 for value in (poll, maximum)):
        raise ValueError
except ValueError:
    sys.exit('lsp-flycheck: poll and wait limits must be positive finite seconds')
print(time.monotonic() + maximum)
PY
)"
fi

wait_or_defer() {
  [[ $build_scripts == 1 ]] || defer "$1"
  printf 'lsp build-scripts waiting: build slot held by %s\n' "$1" >&2
  python3 - "$wait_deadline" "$poll_s" "$wait_max_s" <<'PY'
import sys
import time
deadline, poll = map(float, sys.argv[1:3])
remaining = deadline - time.monotonic()
if remaining > 0:
    time.sleep(min(poll, remaining))
if time.monotonic() >= deadline:
    sys.exit(f'lsp build-scripts timed out after {sys.argv[3]} seconds waiting for admission')
PY
}

leased=0
cargo_pid=
release_lease() {
  if [[ $leased == 1 ]]; then
    "$SCRIPT_DIR/berth" release cargo >&2
    leased=0
    own_holder=
  fi
}

cleanup() {
  local status=$?
  trap - EXIT
  if [[ -n $cargo_pid ]]; then
    # Cargo does not forward SIGTERM to every compiler child. Cancel only this
    # flycheck's marked descendants, leaves first, then reap the cargo driver.
    CARGO_GUARD_PROC_DIR=/proc python3 - "$cargo_pid" "$guard" <<'PY'
import os
import runpy
import signal
import sys
guard = runpy.run_path(sys.argv[2])
root = int(sys.argv[1])
tree = {}
for name in os.listdir(guard['PROC_DIR']):
    if name.isdigit() and int(name) != os.getpid():
        stat = guard['proc_stat'](name)
        if stat is not None:
            tree[int(name)] = stat
descendants = []
for pid in tree:
    parent, seen = pid, set()
    while parent in tree and parent not in seen:
        seen.add(parent)
        if parent == root:
            descendants.append((len(seen), pid))
            break
        parent = tree[parent][1]
for _, pid in sorted(descendants, reverse=True):
    stat = guard['proc_stat'](pid)
    if stat is not None and stat[2] == tree[pid][2] and guard['flycheck_marked'](pid):
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
PY
    wait "$cargo_pid" 2>/dev/null || true
  fi
  release_lease || true
  exit "$status"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

note="lsp flycheck $pkg"
[[ $build_scripts == 0 ]] || note="lsp build-scripts $workspace"
while true; do
  claim_started="$(python3 -c 'import time; print(time.monotonic())')"
  claim_status=0
  claim_output="$("$SCRIPT_DIR/berth" claim cargo --class lsp --ttl "$ttl_s" --note "$note" 2>&1)" || claim_status=$?
  case "$claim_status" in
    0)
      leased=1
      own_state="$("$SCRIPT_DIR/berth" session-show)"
      own_holder="$(python3 -c 'import json, sys; print(json.loads(sys.argv[1])["mooring"]["session"])' "$own_state")"
      ;;
    3)
      busy="$(busy_builds)"
      wait_or_defer "${busy:-$claim_output}"
      continue
      ;;
    4) printf '%s\n' "$claim_output" >&2 ;;
    *) printf '%s\n' "$claim_output" >&2; exit "$claim_status" ;;
  esac
  # Re-check only after claiming: spare capacity does not authorize competition.
  busy="$(busy_builds)"
  if [[ -n $busy ]]; then
    release_lease
    wait_or_defer "$busy"
    continue
  fi
  break
done

cd "$(dirname "$manifest")"
# Admission and contention checks consume this lease too. Never start cargo on
# an already-spent budget; leave the margin for forced termination and release.
check_seconds="$(python3 - "$claim_started" "$ttl_s" "$margin_s" <<'PY'
import sys
import time
started, ttl, margin = map(float, sys.argv[1:])
remaining = ttl - margin - (time.monotonic() - started)
print(f'{remaining:.3f}' if remaining >= 0.001 else '')
PY
)"
[[ -n $check_seconds ]] || warning 'flycheck exceeded its lease; stopped'
export ELOHIM_LSP_FLYCHECK=1
if [[ $build_scripts == 1 ]]; then
  timeout --signal=TERM --kill-after=10 "$check_seconds" cargo check --workspace --message-format=json --all-targets &
else
  timeout --signal=TERM --kill-after=10 "$check_seconds" cargo check --message-format=json -p "$pkg" --all-targets &
fi
cargo_pid=$!
status=0
wait "$cargo_pid" || status=$?
cargo_pid=
if [[ $status == 124 || $status == 137 ]]; then
  warning 'flycheck exceeded its lease; stopped'
fi
exit "$status"
