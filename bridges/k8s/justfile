# Invoked through the manifest gate runner, which resolves the native pool slot.
gate:
    bash ../../genesis/orchestrator/gate-steps.sh \
      fmt -- env CARGO_BUILD_JOBS=2 cargo fmt --all -- --check \
      ::: lint -- env CARGO_BUILD_JOBS=2 node ../../genesis/orchestrator/cargo-lint.mjs --workspace --all-targets --locked -- -D warnings \
      ::: test -- env CARGO_BUILD_JOBS=2 cargo test --workspace --locked
