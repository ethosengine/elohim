# Doorway App - Angular Admin UI

set dotenv-load := false

# List available recipes
default:
    @just --list

# Install dependencies
install:
    pnpm install

# Start dev server (builds the elements first via prestart)
dev:
    pnpm start

# Build the identity elements the device approval page hosts (their dist is
# what `elohim-imagodei/register` resolves to)
elements:
    pnpm run elements

# Build
build: elements
    pnpm exec ng build --configuration=development

# Lint
lint:
    pnpm exec eslint src --ext .ts,.html

# Run unit tests
test:
    pnpm exec vitest run --config vite.config.ts

# Quality gate: lint + build + test
gate: lint build test
