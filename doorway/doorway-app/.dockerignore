# The image is a thin nginx copy of dist/ (the Angular build happens in the
# pnpm workspace BEFORE docker build — see Dockerfile header). Keep the
# context minimal: only nginx.conf and dist/ are COPY'd.
node_modules
.angular

# Local dev artifacts not needed in image
*.log
.DS_Store
coverage
.vscode
.idea
.git
.gitignore
README.md
CLAUDE.md

# Sources are not copied into the image (built dist/ only)
src
