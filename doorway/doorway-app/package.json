{
  "name": "doorway-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run --config vite.config.ts",
    "test:watch": "vitest --config vite.config.ts",
    "test:coverage": "vitest run --config vite.config.ts --coverage",
    "lint": "npx eslint src --ext .ts,.html",
    "lint:fix": "npx eslint src --ext .ts,.html --fix",
    "format": "npx prettier --write \"src/**/*.{ts,html,css,scss}\"",
    "format:check": "npx prettier --check \"src/**/*.{ts,html,css,scss}\""
  },
  "private": true,
  "dependencies": {
    "@elohim/identity": "workspace:*",
    "@elohim/service": "workspace:*",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-browser-dynamic": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.0",
    "@angular/cli": "^22.1.0",
    "@angular/compiler-cli": "^22.1.0",
    "@analogjs/vite-plugin-angular": "^2.6.4",
    "@analogjs/vitest-angular": "^2.6.4",
    "@vitest/coverage-v8": "^4.0.18",
    "jsdom": "^28.1.0",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18",
    "typescript": "~6.0.3",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "angular-eslint": "^22.1.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
