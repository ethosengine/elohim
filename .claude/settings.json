{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/durability-guard.py\"",
            "timeout": 10,
            "statusMessage": "Session durability guard..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/load-project-context.py\"",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/participant-standing.py\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/scripts/clean-caches.sh\" 2>&1 | grep -E '\\[clean-caches\\]' || true",
            "timeout": 300,
            "statusMessage": "Checking disk usage...",
            "async": true
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/genesis/agentic/bin/pool-preflight.sh\"",
            "timeout": 15,
            "statusMessage": "Cargo target pool stewardship..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ram-guard.py\" --event session",
            "timeout": 10,
            "statusMessage": "RAM guard (workspace memory limit)..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/ci-harvest.py\" --hook",
            "timeout": 90,
            "statusMessage": "Harvesting CI results since cursor...",
            "async": true
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/scripts/runtime-harvest.py\" --hook",
            "timeout": 90,
            "statusMessage": "Harvesting runtime self-reports from the alpha doorways...",
            "async": true
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/delivery-gate.py\"",
            "timeout": 15,
            "statusMessage": "Delivery gate (advisory)..."
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/device-arrive.sh\"",
            "timeout": 30,
            "statusMessage": "Device arrival..."
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-projection.py\" --event session",
            "timeout": 60,
            "statusMessage": "Run-plane projection cache (stocks fold)...",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/genesis/agentic/bin/pool-postflight.sh\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pickup-semantic-surfacing.py\" --event prompt",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-projection.py\" --event prompt",
            "timeout": 8
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ram-guard.py\" --event prompt",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "ELOHIM_HOOK_RUNTIME_PID=$PPID python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/device-head-notice.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-tool-memory.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Grep|Glob|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pickup-semantic-surfacing.py\" --event tool",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/sensitive-file-protection.py\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/seed-data-validation.py\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/managed-surface-context.py\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/cargo-disk-guard.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ram-guard.py\" --event pretool",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/rust-holochain-validation.py\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/claude-md-structural-signal.py\"",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/covenant-subagent-stamp.py\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "mcp__sonarqube__search_sonar_issues_in_projects",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/sonar-issues-guard.py\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/epr-meta-resolver.py\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/native-seam-guidance.py\"; [ -f \"$f\" ] && python3 \"$f\" claude || exit 0",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/rust-style.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/gate-live-inject.py\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/valueflow-observer.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/claude-md-drift-signal.py\"",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/memory-coherence-signal.py\"",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/memory-index-projection.py\" --hook",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/cite-seal-signal.py\"",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/sovereignty-guard-signal.py\"",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/placement-drift-signal.py\"",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/map-drift-signal.py\"",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-check.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-check.py\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/testid-audit.py\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/epr-link-check.py\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/blind-reader-review.py\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/p2p-plan-audit.py\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/p2p-schema-audit.py\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/jenkinsfile-method-size.py\"",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lsp-edit-event.py\"",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "mcp__jenkins__getBuild",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ci-result-formatter.py\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/deprecation-sentinel.py\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ram-guard.py\" --event posttool",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/lsp-edit-event.py\"",
            "timeout": 2
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/covenant-subagent-stamp.py\"",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git push origin dev)",
      "Bash(EPR_META_ACK=1 git push origin dev)",
      "Bash(python3 .claude/scripts/epr-meta-git-gate.py *)",
      "Bash(python3 .claude/scripts/habits-project.py)",
      "Bash(python3 .claude/scripts/habits-project.py *)",
      "Bash(python3 .claude/scripts/_lib/__tests__/*)",
      "Bash(python3 .claude/shifts/measure-*.py)",
      "Bash(node genesis/orchestrator/graph-walker.mjs)",
      "Bash(node genesis/orchestrator/gate-runner.mjs *)",
      "Bash(curl -s https://jenkins.ethosengine.com/job/*/api/json*)",
      "Bash(curl -s https://jenkins.ethosengine.com/job/*/job/*/api/json*)",
      "Bash(curl -s https://jenkins.ethosengine.com/job/*/job/*/*/api/json*)"
    ],
    "ask": [
      "Bash(git *reset --hard*)",
      "Bash(git *reset --merge*)",
      "Bash(git *reset --keep*)",
      "Bash(git *checkout -B*)",
      "Bash(git *checkout -f*)",
      "Bash(git *checkout --force*)",
      "Bash(git *checkout --orphan*)",
      "Bash(git *checkout .*)",
      "Bash(git *checkout -- .*)",
      "Bash(git *checkout :/*)",
      "Bash(git *restore .*)",
      "Bash(git *restore -- .*)",
      "Bash(git *restore :/*)",
      "Bash(git *clean -*f*)",
      "Bash(git *clean *--force*)",
      "Bash(git *push*--force*)",
      "Bash(git *push* -f*)",
      "Bash(git *push*--delete*)",
      "Bash(git *push* -d *)",
      "Bash(git *push* +*)",
      "Bash(git *branch*-D*)",
      "Bash(git *branch* -f*)",
      "Bash(git *branch*--force*)",
      "Bash(git *switch -C*)",
      "Bash(git *switch --force-create*)",
      "Bash(git rebase*)",
      "Bash(git -C /projects/elohim rebase*)",
      "Bash(git -C /projects/elohim/ rebase*)",
      "Bash(git *rebase*-i*)",
      "Bash(git *rebase*--interactive*)",
      "Bash(git *rebase*--onto*)",
      "Bash(git *rebase*--root*)",
      "Bash(git *rebase*--exec*)",
      "Bash(git *rebase* -x *)",
      "Bash(git *filter-branch*)",
      "Bash(git *reflog expire*)",
      "Bash(git *reflog delete*)",
      "Bash(git *gc *--prune*)",
      "Bash(git *update-ref*)",
      "Bash(git *stash drop*)",
      "Bash(git *stash clear*)",
      "Bash(git *worktree remove*--force*)",
      "Bash(git *worktree remove* -f*)",
      "Bash(git *rm -*r* .*)",
      "Bash(git *rm --recursive* .*)",
      "Bash(git *submodule foreach*)",
      "Bash(git *symbolic-ref -d*)",
      "Bash(git *symbolic-ref --delete*)",
      "Bash(git *symbolic-ref * refs/*)",
      "Bash(rm -*r* .)",
      "Bash(rm -*r* ./)",
      "Bash(rm -*r* ..)",
      "Bash(rm -*r* ~*)",
      "Bash(rm -*r* /)"
    ]
  },
  "extraKnownMarketplaces": {
    "elohim-workspace": {
      "source": { "source": "directory", "path": "./.claude/marketplace" }
    }
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "elohim-lsp@elohim-workspace": true
  }
}
