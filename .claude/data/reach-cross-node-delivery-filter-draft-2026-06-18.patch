+    /// Req-free, testable core of the HTTP reach gate. Returns `None` when the
+    /// requester is allowed to receive `content_id` at `reach` (commons/public,
+    /// any tier <= community, or an authorized human); returns
+    /// `Some((status, json_body))` when access must be denied.
+    ///
+    /// Behavior-equivalent to the former inline Layer-1.5 block in
+    /// `handle_db_content_by_id`: deny-by-default when the requester cannot be
+    /// resolved for restricted content, and delegate the per-tier decision to
+    /// `epr_service::authorize_reach_for_human` (the single source of truth).
+    /// Pulled out so BOTH the local serve path and the P2P cross-node fallback
+    /// can apply the identical gate (closes FINDING 1 of
+    /// `http-reach-cross-node-fallback-bypass`).
+    fn reach_gate_decision(
+        conn: &mut diesel::SqliteConnection,
+        app_ctx: &db::AppContext,
+        reach: &str,
+        identity: Option<String>,
+        content_id: &str,
+    ) -> Option<(StatusCode, String)> {
+        // Tiers at or below community are ambient on the HTTP path (the coarse
+        // is_public/auth-required gate already ran upstream). Only tiers ABOVE
+        // community (familiar / trusted / intimate / self) get the steward gate.
+        if crate::epr_service::reach_level_index(reach)
+            <= crate::epr_service::reach_level_index("community")
+        {
+            return None;
+        }
+
+        let requester = match identity {
+            Some(idv) => match crate::db::humans::get_human_by_id(conn, &idv)
+                .ok()
+                .flatten()
+            {
+                Some(h) => Some(h),
+                None => crate::db::humans::get_human_by_agent_key(conn, &idv)
+                    .ok()
+                    .flatten(),
+            },
+            None => None,
+        };
+
+        match requester {
+            Some(human) => {
+                let reach_gate = crate::epr_service::EprService::new(
+                    None,
+                    None,
+                    None,
+                    crate::p2p::trust_cache::PeerTrustCache::new(),
+                );
+                if let Err(reason) =
+                    reach_gate.authorize_reach_for_human(conn, app_ctx, reach, &human, content_id)
+                {
+                    Some((
+                        StatusCode::FORBIDDEN,
+                        format!(
+                            r#"{{"error":"Reach denied","requiredReach":"{}","reason":"{}"}}"#,
+                            reach, reason
+                        ),
+                    ))
+                } else {
+                    None
+                }
+            }
+            // Deny-by-default: restricted content + unresolvable requester.
+            None => Some((
+                StatusCode::FORBIDDEN,
+                format!(
+                    r#"{{"error":"Reach authorization required","requiredReach":"{}"}}"#,
+                    reach
+                ),
+            )),
+        }
+    }
+
+    /// HTTP wrapper around `reach_gate_decision`: resolves the requester's
+    /// identity from the request (X-Agent-Cid header / active session, the
+    /// pre-existing doorway-injected trust boundary — NOT widened here), then
+    /// applies the reach gate. Returns `Some(403_response)` to deny, `None` to
+    /// allow. Called from BOTH the local serve path (Layer 1.5) and the P2P
+    /// cross-node fallback so coverage is symmetric.
+    fn enforce_http_reach(
+        &self,
+        req: &Request<Incoming>,
+        conn: &mut diesel::SqliteConnection,
+        reach: &str,
+        content_id: &str,
+    ) -> Option<Response<Full<Bytes>>> {
+        let identity = crate::api::account::extract_agent_cid(req, conn)
+            .ok()
+            .flatten();
+        let app_ctx = db::AppContext::default_lamad();
+        Self::reach_gate_decision(conn, &app_ctx, reach, identity, content_id).map(
+            |(status, body)| {
+                Response::builder()
+                    .status(status)
+                    .header(header::CONTENT_TYPE, "application/json")
+                    .body(Full::new(Bytes::from(body)))
+                    .unwrap()
+            },
+        )
+    }
