+// =============================================================================
+// reach_gate_decision — the req-free core of the HTTP reach gate, shared by the
+// local serve path (Layer 1.5) and the P2P cross-node fallback. These DB-backed
+// tests prove the decision the FALLBACK now applies against the HTTP requester
+// (FINDING 1 of http-reach-cross-node-fallback-bypass). They mirror the
+// epr_service reach harness (households stack, humans.id populated).
+// =============================================================================
+#[cfg(test)]
+mod reach_gate_decision_tests {
+    use super::*;
+
+    fn mk_human(conn: &mut diesel::SqliteConnection, id: &str, agent_key: Option<&str>) {
+        use diesel::RunQueryDsl;
+        diesel::insert_or_ignore_into(crate::db::diesel_schema::humans::table)
+            .values(&crate::db::models::NewHuman {
+                id: id.to_string(),
+                agent_pub_key: agent_key.map(|s| s.to_string()),
+                display_name: id.to_string(),
+                bio: None,
+                affinities: "[]".to_string(),
+                profile_reach: "commons".to_string(),
+                location: None,
+                profile_photo_url: None,
+                h_app_id: "lamad".to_string(),
+                household_id: None,
+            })
+            .execute(conn)
+            .expect("insert human");
+    }
+
+    fn mk_content(
+        conn: &mut diesel::SqliteConnection,
+        ctx: &db::AppContext,
+        id: &str,
+        reach: &str,
+        created_by: Option<&str>,
+    ) {
+        crate::db::content_diesel::create_content(
+            conn,
+            ctx,
+            crate::db::content_diesel::CreateContentInput {
+                id: id.to_string(),
+                title: id.to_string(),
+                description: None,
+                content_type: "concept".to_string(),
+                content_format: "markdown".to_string(),
+                blob_hash: None,
+                blob_cid: None,
+                content_size_bytes: None,
+                metadata_json: None,
+                reach: reach.to_string(),
+                created_by: created_by.map(|s| s.to_string()),
+                tags: vec![],
+                content_body: Some("body".to_string()),
+                dht_anchor_hash: None,
+            },
+        )
+        .expect("create content");
+    }
+
+    /// commons/public is ambient — allowed regardless of requester identity
+    /// (including no identity at all). Matches the pre-refactor inline gate,
+    /// which never fired for reach <= community.
+    #[test]
+    fn commons_allows_anyone_including_anonymous() {
+        let pool = crate::test_util::test_pool();
+        let mut conn = pool.get().unwrap();
+        let ctx = db::AppContext::new("lamad");
+        mk_content(&mut conn, &ctx, "c-commons", "commons", None);
+        assert!(
+            HttpServer::reach_gate_decision(&mut conn, &ctx, "commons", None, "c-commons")
+                .is_none(),
+            "commons must be allowed with no requester identity"
+        );
+    }
+
+    /// community-tier is left at coarse auth on the HTTP path (FINDING 2 design
+    /// choice): the gate does not fire for reach <= community, so the decision
+    /// is None even for an unresolvable requester.
+    #[test]
+    fn community_tier_is_not_gated_here() {
+        let pool = crate::test_util::test_pool();
+        let mut conn = pool.get().unwrap();
+        let ctx = db::AppContext::new("lamad");
+        mk_content(&mut conn, &ctx, "c-comm", "community", None);
+        assert!(
+            HttpServer::reach_gate_decision(&mut conn, &ctx, "community", None, "c-comm").is_none(),
+            "community is ambient on the HTTP path (coarse auth upstream)"
+        );
+    }
+
+    /// Restricted content + unresolvable requester ⇒ deny-by-default with the
+    /// "Reach authorization required" body. This is the core fallback-bypass
+    /// fix: a cross-node fetch whose HTTP caller can't be resolved is refused.
+    #[test]
+    fn restricted_unresolvable_requester_denied_by_default() {
+        let pool = crate::test_util::test_pool();
+        let mut conn = pool.get().unwrap();
+        let ctx = db::AppContext::new("lamad");
+        mk_content(&mut conn, &ctx, "c-priv", "private", Some("human-creator"));
+        let decision = HttpServer::reach_gate_decision(
+            &mut conn, &ctx, "private", None, // unresolvable
+            "c-priv",
+        );
+        match decision {
+            Some((status, body)) => {
+                assert_eq!(status, StatusCode::FORBIDDEN);
+                assert!(
+                    body.contains("Reach authorization required"),
+                    "unexpected body: {body}"
+                );
+            }
+            None => panic!("restricted + unresolvable must be denied"),
+        }
+    }
+
+    /// Restricted content fetched on behalf of an UNAUTHORIZED resolvable human
+    /// ⇒ deny with the "Reach denied" body (authorize_reach_for_human Err). This
+    /// is the disclosure case the finding warns about, now closed on the
+    /// fallback path.
+    #[test]
+    fn restricted_unauthorized_human_denied() {
+        let pool = crate::test_util::test_pool();
+        let mut conn = pool.get().unwrap();
+        let ctx = db::AppContext::new("lamad");
+        mk_human(&mut conn, "human-creator", Some("uhCAk-creator"));
+        mk_human(&mut conn, "human-other", Some("uhCAk-other"));
+        mk_content(&mut conn, &ctx, "c-priv2", "private", Some("human-creator"));
+        let decision = HttpServer::reach_gate_decision(
+            &mut conn,
+            &ctx,
+            "private",
+            Some("human-other".to_string()),
+            "c-priv2",
+        );
+        match decision {
+            Some((status, body)) => {
+                assert_eq!(status, StatusCode::FORBIDDEN);
+                assert!(body.contains("Reach denied"), "unexpected body: {body}");
+            }
+            None => panic!("non-creator must be denied private content"),
+        }
+    }
+
+    /// Restricted content fetched on behalf of its CREATOR ⇒ allowed (None). The
+    /// gate is strictly tightening, not blanket-denying: the authorized
+    /// principal still passes.
+    #[test]
+    fn restricted_creator_allowed() {
+        let pool = crate::test_util::test_pool();
+        let mut conn = pool.get().unwrap();
+        let ctx = db::AppContext::new("lamad");
+        mk_human(&mut conn, "human-creator2", Some("uhCAk-creator2"));
+        mk_content(
+            &mut conn,
+            &ctx,
+            "c-priv3",
+            "private",
+            Some("human-creator2"),
+        );
+        assert!(
+            HttpServer::reach_gate_decision(
+                &mut conn,
+                &ctx,
+                "private",
+                Some("human-creator2".to_string()),
+                "c-priv3",
+            )
+            .is_none(),
+            "creator may read own private content"
+        );
+    }
+}
