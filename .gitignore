# Rust/Holochain
target/
# cargo-target-pool creates symlinks named "target"; the rule above only
# matches directories, so we need a separate non-directory pattern.
target
target-pool/
*.happ
*.dna
bindings/

# Local holochain dev-stack scratch (cargo-pool / hc-dev-orchestrator)
**/local-dev/
research/matrix/pinecone

# Genesis blob cache (regenerated during pack/seed)
genesis/.blob-cache/
/elohim/research/A2A/
/elohim/research/a2a-go/

# Ephemeral SonarQube data (regenerated by sonar-issues-summary.sh)
.claude/sonar-issues-raw.json
.claude/sonar-issues-summary.json
genesis/research/repos/
.superpowers/

# MemPalace (vector store + temporal entity-graph; PVC-persisted, regenerable via mempalace mine)
/.mempalace/
# Per-source init artifacts (config + entities mempalace writes into mined directories)
**/mempalace.yaml
**/entities.json


# memory-kit is the PROCESS-artifact tier (comet retention via memkit-retention.py).
# Reports/proposals/snapshots are transient + regenerable — keep only the guide + the trajectory spine.
.claude/memory-kit/*.md
!.claude/memory-kit/CLAUDE.md
!.claude/memory-kit/TRAJECTORY.md
.claude/memory-kit/*.json
.claude/memory-kit/*.lock
.claude/data/push-lease.json
# epr-meta in-flight coverage-nudge debounce state — ephemeral per-session nudge suppression, regenerable
.claude/data/epr-meta-advice.json
# epr flow value-chain sidecar — derived/operational (append-only flow records + label index);
# reconstruction = re-run `epr flow project`. Never source-of-truth.
.eprfs/
.stage0-logs/
