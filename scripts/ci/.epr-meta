epr-meta-version: 1
id: scripts-ci-governance
covers: subtree
purpose: >
  Bash entrypoints invoked by the Jenkins pipelines and — critically — by the deploy container
  (render gates, mount verification, conductor-config validation). One class of drift is
  gate-surfaced here: a script that runs in the deploy container reaches for an interpreter or
  library that container does not have (PyYAML/python/pip). The deploy container is bash+coreutils
  ONLY; edge #1183 failed all seven human deploys on a single PyYAML import — the validator that was
  supposed to guard defect #1 could not run in its own container (museum defect class #5). The
  requirement is written into each deploy script's header; this rule surfaces it at edit time.
rules:
  - id: deploy-scripts-bash-coreutils-only
    class: inject
    when: { write: "*.sh", contains-any: ["python", "PyYAML", "pip install", "pip3", "import yaml", "env python"] }
    dedupe-of: "each deploy script's own header requirement (bash + coreutils only), scarred by edge #1183"
