{
  "manifestVersion": "1.0",
  "pipeline": "elohim-steward",
  "jenkinsPath": "steward/device/Jenkinsfile",
  "manualOnly": true,
  "triggersGenesis": false,
  "longRunning": true,
  "dependsOn": ["elohim-holochain"],
  "description": "Steward desktop app — Tauri + Holochain conductor",
  "steps": {
    "cargo-build-steward": {
      "description": "Build steward Rust binary and Tauri app (Linux target)",
      "inputs": {
        "sources": [
          "steward/node/src/**",
          "steward/node/Cargo.toml",
          "steward/node/Cargo.lock",
          "steward/device/src-tauri/**",
          "steward/device/package.json",
          "steward/device/flake.nix",
          "crates/**",
          "elohim/elohim-storage/**",
          "crates/elohim-views/**",
          "elohim/elohim-bitswap/**",
          "elohim/elohim-agent/elohim-agent-service/**",
          "elohim/elohim-agent/specialists/defender/**",
          "elohim/constitution/**",
          "elohim/Cargo.toml",
          "elohim/epr/**",
          "elohim/epr-rea/**",
          "elohim/epr-index/**",
          "elohim/ark/core/**",
          "elohim/elohim-cache-core/**",
          "elohim/elohim-chrome-asset/**",
          "elohim/elohim-compute/**",
          "elohim/elohim-error/**",
          "elohim/elohim-facings/**",
          "elohim/elohim-peer-fabric/**",
          "elohim/elohim-render/**",
          "elohim/elohim-settings/**",
          "elohim/sdk/domains/lamad/types/**",
          "elohim/sdk/domains/shefa/types/**",
          "bridges/did/Cargo.toml",
          "bridges/did/did-bridge/**",
          "bridges/did/did-types/**",
          "bridges/valueflows/Cargo.toml",
          "bridges/valueflows/valueflows-bridge/**",
          "bridges/valueflows/valueflows-types/**",
          "vendor/iroh-quinn-proto-0.13.0/**"
        ],
        "buildProcess": ["steward/device/Jenkinsfile"]
      },
      "outputs": {
        "artifacts": ["steward-binary"],
        "verify": null
      },
      "depends": ["elohim-holochain:build-happ"],
      "executor": {
        "stage": "Build Steward App - Linux",
        "function": null
      }
    }
  },
  "gate": {
    "projects": {
      "steward-node": {
        "dir": "steward/node",
        "run": {
          "kind": "just",
          "recipe": "gate",
          "cargo": { "workspace": "steward/node", "profile": "dev", "rustflags": "" }
        }
      }
    }
  },
  "deployment": {}
}
