# The manifest gate runner supplies the native pool slot and toolchain.
gate:
    # The story consumes the built public export; refuse that story if its build fails.
    bash ../../genesis/orchestrator/gate-steps.sh \
      fmt -- rustfmt --edition 2021 --check src/app_lifecycle.rs tests/app_lifecycle.rs \
      ::: lint -- node ../../genesis/orchestrator/cargo-lint.mjs --locked --all-targets -- -D warnings \
      ::: test-rust -- cargo test --locked --test app_lifecycle \
      ::: test-schema -- node --test ../../elohim/sdk/schemas/tests/app-lifecycle.test.mjs \
      ::: typecheck -- pnpm --dir ../../elohim/sdk/storage-client-ts exec tsc -p tsconfig.lifecycle-contract.json \
      ::: test-ts -- pnpm --dir ../../elohim/sdk/storage-client-ts exec vitest run tests/app-lifecycle.test.ts \
      ::: test-story -- bash -c 'pnpm --dir ../../elohim/sdk/storage-client-ts run build && pnpm --dir ../../genesis/a2o exec cucumber-js --profile app-lifecycle'
