# Doorway App - Angular Admin UI

set dotenv-load := false

# List available recipes
default:
    @just --list

# Install dependencies
install:
    pnpm install

# Start dev server
dev:
    pnpm start

# Build
build:
    pnpm exec ng build --configuration=development

# Lint
lint:
    pnpm exec eslint src --ext .ts,.html

# Quality gate: lint + build
gate: lint build
