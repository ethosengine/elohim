[submodule "sophia"]
	path = sophia
	url = https://github.com/ethosengine/sophia.git
[submodule "elohim/brit"]
	path = elohim/brit
	url = https://github.com/ethosengine/brit.git
[submodule "elohim/rakia"]
	path = elohim/rakia
	url = https://github.com/ethosengine/rakia.git
[submodule "che-devworkspaces"]
	path = che-devworkspaces
	url = https://github.com/ethosengine/che-devworkspaces.git
# The pinned conductor fork. update=none → NOT auto-cloned by CI/checkout: CI reads
# the committed gitlink SHA, which is the conductor image tag (elohim/conductor-image/README.md).
# The tx5 and kitsune2 reference forks were retired 2026-09-23 (Holochain 0.7 has no tx5
# and resolves kitsune2 from crates.io); their GitHub forks remain the record.
[submodule "elohim/holochain-conductor"]
	path = elohim/holochain-conductor
	url = https://github.com/ethosengine/holochain.git
	branch = elohim-0.7
	update = none
